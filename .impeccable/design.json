  "narrative": {
    "northStar": "Lanterne",
    "overview": "Une seule source de lumière : sur chaque écran, une seule chose est éclairée (la phrase, le chiffre, la capture) et le reste se tait. Le jour est une aube sur pierre claire où la nuit entre par des actes de veille sombres ; la nuit est un clair de lune bleuté où la lanterne pose un halo ambré sur la zone active.\n\nInstrument Serif porte les titres et la voix de Charles ; Instrument Sans le texte et les chiffres-preuves. Direction retenue le 13 octobre 2026, avec trois greffes de Banc d’essai : la fiche technique en tableau à filets, l’index des étiquettes de preuve et « Voir le projet → » sur chaque carte, l’acte bleu nuit de « La suite » avec un aplat bleu roi derrière « Discutons ».",
    "keyCharacteristics": [
      "Pierre claire le jour, suie bleutée la nuit ; un changement de lumière à chaque partie.",
      "Instrument Serif pour la voix, Instrument Sans pour le texte et les preuves.",
      "Bleu roi pour ce qui se clique, colza pour un chiffre sourcé, lanterne pour la zone éclairée.",
      "Jour et nuit, clavier, mouvement réduit, impression et lecture sans JavaScript."
    ],
    "rules": [
      {
        "name": "The Single Light Rule",
        "body": "Une seule zone éclairée par écran (.foyer) : un seul halo de jour, une seule lueur de lanterne la nuit.",
        "section": "colors"
      },
      {
        "name": "The Click Rule",
        "body": "Le bleu roi (la lune, la nuit) ne porte que ce qui se clique.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "Le colza souligne un seul chiffre sourcé par preuve ; la valeur reste écrite, avec sa source et sa date.",
        "section": "colors"
      },
      {
        "name": "The Legibility Rule",
        "body": "Les figures et captures gardent leurs légendes, leurs proportions et une variante lisible à 390 px.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do écrire toute valeur dans site/src/styles/jetons.css, jour et nuit, et vérifier ses contrastes.",
      "Do garder une seule zone éclairée et une seule action principale par écran.",
      "Do montrer des captures réelles, entières ou annotées, avec leur provenance.",
      "Do poser chaque illustration par <Visuel id>, avec sa consigne complète au registre."
    ],
    "donts": [
      "Don’t réintroduire D « Mode d’emploi », A « Édition reliée » ni le reste de B ; « mode d’emploi » ne reste qu’en clin d’œil.",
      "Don’t ajouter d’ornement, de cadre doré ni de lexique de jeu : la nuit ne doit jamais rappeler Nocturne.",
      "Don’t présenter une image générée comme une capture ou une donnée.",
      "Don’t recadrer une capture au point de masquer ce qu’elle prouve."
    ]
  }
}
