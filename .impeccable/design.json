      "kind": "button",
      "refersTo": "button-primary",
      "description": "Pilule de 48 px, une seule action principale par écran ; bleu roi le jour, lanterne la nuit. Source : site/src/components/ui/Bouton.astro et site/src/styles/global.css.",
      "html": "<a class=\"ds-bouton\" href=\"/contact\">Discutons&nbsp;→</a>",
      "css": ".ds-bouton{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 24px;border:0;border-radius:var(--r3,999px);background:var(--bouton,#1f4fd1);color:var(--bouton-texte,#ffffff);font:600 1rem/1.2 var(--police-texte,Instrument Sans,system-ui,sans-serif);letter-spacing:.01em;text-decoration:none;cursor:pointer;transition:background-color 200ms cubic-bezier(.2,.7,.2,1)}.ds-bouton:hover{background:var(--bouton-survol,#173fae)}.ds-bouton:focus-visible{outline:2px solid var(--focus,#1f4fd1);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-bouton{transition:none}}"
    },
