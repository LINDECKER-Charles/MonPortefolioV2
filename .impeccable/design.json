      "html": "<div class=\"ds-preuve\"><span class=\"ds-preuve__valeur\"><mark>20</mark></span><span class=\"ds-preuve__libelle\">contributeurs formés</span><span class=\"ds-preuve__source\">Témoignage, confirmé le 13/10/2026</span></div>",
      "css": ".ds-preuve{display:grid;gap:4px;font-family:var(--police-texte,Instrument Sans,system-ui,sans-serif);color:var(--encre,#141312)}.ds-preuve__valeur{font-size:clamp(2rem,1.4rem + 1.6vw,2.875rem);font-weight:600;line-height:1;font-variant-numeric:tabular-nums lining-nums}.ds-preuve mark{background:var(--surligneur,#f2cf3a);color:var(--sur-surligneur,#141312);border-radius:4px;padding:0 .08em}.ds-preuve__libelle{font-size:1rem}.ds-preuve__source{font-size:.875rem;color:var(--eteint,#59544c)}"
    },
