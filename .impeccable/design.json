      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:.5em;min-height:48px;padding:11px 22px;border:1px solid var(--bleu,#1f4fd1);border-radius:var(--rayon,4px);font:700 1rem/1.2 var(--font-texte,Atkinson Hyperlegible Next,system-ui,sans-serif);cursor:pointer;transition:background-color .15s ease,border-color .15s ease,color .15s ease}.ds-button:focus-visible{outline:2px solid var(--bleu,#1f4fd1);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--bleu,#1f4fd1);color:var(--sur-bleu,#ffffff)}.ds-primary:hover{background:var(--bleu-survol,#173ca6);border-color:var(--bleu-survol,#173ca6)}"
    },
    {
      "name": "Bouton contour",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Action secondaire ; source : site/src/styles/global.css.",
      "html": "<button class=\"ds-button ds-outline\" type=\"button\">Voir les projets</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:.5em;min-height:48px;padding:11px 22px;border:1px solid var(--bleu,#1f4fd1);border-radius:var(--rayon,4px);font:700 1rem/1.2 var(--font-texte,Atkinson Hyperlegible Next,system-ui,sans-serif);cursor:pointer;transition:background-color .15s ease,border-color .15s ease,color .15s ease}.ds-button:focus-visible{outline:2px solid var(--bleu,#1f4fd1);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-outline{background:transparent;color:var(--bleu,#1f4fd1)}.ds-outline:hover{background:color-mix(in srgb,var(--bleu,#1f4fd1) 9%,transparent)}"
    },
    {
      "name": "Bouton à pictogramme",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Commande compacte ; source : site/src/styles/global.css.",
      "html": "<button class=\"ds-icon\" type=\"button\" aria-label=\"Ouvrir le sommaire\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\"/></svg></button>",
      "css": ".ds-icon{display:inline-grid;place-items:center;width:44px;height:44px;padding:0;border:1px solid var(--filet,#d8dde5);border-radius:var(--rayon,4px);background:transparent;color:var(--encre,#14161b);cursor:pointer;transition:border-color .15s ease,color .15s ease}.ds-icon:hover{border-color:var(--bleu,#1f4fd1);color:var(--bleu,#1f4fd1)}.ds-icon:focus-visible{outline:2px solid var(--bleu,#1f4fd1);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-icon{transition:none}}"
    },
    {
      "name": "Navigation principale",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "État courant par trait inférieur ; source : site/src/components/layout/Entete.astro.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigation principale\"><a href=\"/\">Accueil</a><a href=\"/projets\" aria-current=\"page\">Projets</a><a href=\"/contact\">Contact</a></nav>",
      "css": ".ds-nav{display:flex;gap:clamp(16px,2vw,28px);font-family:var(--font-texte,Atkinson Hyperlegible Next,system-ui,sans-serif);}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;padding-top:2px;border-bottom:2px solid transparent;color:var(--graphite,#59606d);text-decoration:none;font-size:.9375rem}.ds-nav a:hover{color:var(--encre,#14161b)}.ds-nav a[aria-current]{border-color:var(--bleu,#1f4fd1);color:var(--encre,#14161b);font-weight:700}.ds-nav a:focus-visible{outline:2px solid var(--bleu,#1f4fd1);outline-offset:3px;}"
    },
    {
      "name": "Métadonnée de fiche",
      "kind": "chip",
      "refersTo": "metadata",
      "description": "Texte simple, sans capsule ; source : site/src/components/accueil/Fiche.astro.",
      "html": "<span class=\"ds-metadata\">Projet open source</span>",
      "css": ".ds-metadata{font-family:var(--font-texte,Atkinson Hyperlegible Next,system-ui,sans-serif);color:var(--graphite,#59606d);font-size:var(--t-petit,1rem);line-height:1.4}"
    },
    {
      "name": "Planche de figure",
      "kind": "card",
      "refersTo": "figure-panel",
      "description": "Surface des dessins ; source : site/src/styles/global.css.",
      "html": "<div class=\"ds-panel\"><svg viewBox=\"0 0 220 70\" width=\"220\" height=\"70\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-label=\"Une planche au trait\"><path d=\"M15 55h190M15 55V10M30 45l45-10 45 6 45-25 30-5\"/></svg></div>",
      "css": ".ds-panel{background:var(--blanc,#ffffff);border:1px solid var(--filet,#d8dde5);border-radius:var(--rayon,4px);padding:clamp(10px,2.4vw,28px);color:var(--bleu,#1f4fd1)}.ds-panel svg{display:block;max-width:100%;height:auto}"
    },
    {
      "name": "Choix natif League Of Database",
      "kind": "custom",
      "refersTo": "lod-choice",
      "description": "Labels des radios de patch ; même principe pour fiches et langues. Sources : site/src/pages/projets/league-of-database.astro et site/src/styles/league-of-database.css.",
      "html": "<fieldset class=\"ds-choices\"><legend>Comparer deux versions de la fiche · Ahri, niveau 1</legend><input class=\"ds-sr\" type=\"radio\" name=\"ds-patch\" id=\"ds-archive\" checked /><input class=\"ds-sr\" type=\"radio\" name=\"ds-patch\" id=\"ds-current\" /><div class=\"ds-choice-labels\"><label for=\"ds-archive\"><span>Patch</span><strong>3.6.14</strong></label><label for=\"ds-current\"><span>Patch</span><strong>16.20.1</strong></label></div></fieldset>",
      "css": ".ds-choices{margin:0;padding:0;border:0;min-width:0;font-family:var(--font-texte,Atkinson Hyperlegible Next,system-ui,sans-serif);color:var(--encre,#14161b)}.ds-choices legend{color:var(--graphite,#59606d);font-size:.9375rem;margin-bottom:20px}.ds-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}.ds-choice-labels{display:flex;gap:12px}.ds-choice-labels label{display:flex;gap:10px;align-items:baseline;cursor:pointer;border:1px solid var(--trait-doux,#aab2bf);border-radius:var(--rayon,4px);padding:12px 22px;transition:background-color 180ms ease,color 180ms ease}.ds-choice-labels span{font-size:.9375rem}.ds-choice-labels strong{font-size:1.125rem}.ds-choice-labels label:hover{border-color:var(--bleu,#1f4fd1)}#ds-archive:checked~.ds-choice-labels label[for=ds-archive],#ds-current:checked~.ds-choice-labels label[for=ds-current]{color:var(--sur-bleu,#ffffff);background:var(--bleu,#1f4fd1);border-color:var(--bleu,#1f4fd1)}#ds-archive:focus-visible~.ds-choice-labels label[for=ds-archive],#ds-current:focus-visible~.ds-choice-labels label[for=ds-current]{outline:2px solid var(--bleu,#1f4fd1);outline-offset:3px;}@media(max-width:799px){.ds-choice-labels{gap:8px}.ds-choice-labels label{flex:1;justify-content:center;padding:12px;gap:6px}.ds-choice-labels span{font-size:.875rem}.ds-choice-labels strong{font-size:1rem}}@media(prefers-reduced-motion:reduce){.ds-choice-labels label{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Mode d’emploi",
    "overview": "Le « Mode d’emploi » validé donne au portfolio la clarté d’un manuel : papier froid, encre nette, figures légendées et annotations au stylo bleu. Atkinson porte la lecture ; Newsreader apporte la voix personnelle. Le logo livre-lanterne reste l’identité de la marque.\n\nLes pages de projets laissent les réalisations occuper l’espace. Les captures authentiques et les figures expliquent les usages ; le texte précise ce que le visuel ne suffit pas à comprendre. Le thème nuit adapte la même hiérarchie sans transformer tout le portfolio en décor de jeu.",
    "keyCharacteristics": [
      "Papier et encre, filets fins et espaces généreux.",
      "Bleu des actions et annotations ; jaune réservé aux preuves.",
      "Titres nets, notes en italique et médias lisibles.",
      "Jour et nuit, clavier, mouvement réduit et impression."
    ],
    "rules": [
      {
        "name": "The Blue Ink Rule",
        "body": "Le bleu porte les liens, commandes, tracés et notes de l’auteur. Le pétrole reste propre à League Of Database.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "Le surligneur jaune souligne un seul chiffre sourcé par preuve ; la valeur reste écrite et lisible.",
        "section": "colors"
      },
      {
        "name": "The Legibility Rule",
        "body": "Les figures et captures gardent leurs légendes, leurs proportions et une variante adaptée à la largeur disponible.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do reprendre les variables du socle et leurs variantes nuit.",
      "Do utiliser le logo existant et des captures authentiques, avec provenance.",
      "Do garder les choix, le focus et les légendes visibles au clavier et sur petit écran.",
      "Do réserver les overrides d’une étude de cas à sa propre surface."
    ],
    "donts": [
      "Don’t réintroduire les directions visuelles écartées dans le portfolio.",
      "Don’t inventer une preuve chiffrée ou présenter des captures comme une application interactive.",
      "Don’t faire du pétrole ou de la composition League Of Database une règle de toutes les pages.",
      "Don’t recadrer une capture au point de masquer l’information qu’elle démontre."
    ]
  }
}
