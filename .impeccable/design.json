      "css": ".ds-lien{display:inline-flex;align-items:center;min-height:48px;color:var(--accent,#1f4fd1);font:400 1.0625rem/1.4 var(--police-texte,Instrument Sans,system-ui,sans-serif);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:.22em}.ds-lien:hover{color:var(--accent-survol,#173fae);text-decoration-thickness:2px}.ds-lien:focus-visible{outline:2px solid var(--focus,#1f4fd1);outline-offset:3px;border-radius:4px}"
