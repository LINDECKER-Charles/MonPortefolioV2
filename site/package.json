{
  "name": "portfolio-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio de Charles Lindecker, version 2 : un mode d'emploi (Astro, rendu statique)",
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "scripts": {
    "prepare": "git -C .. config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "astro dev",
    "build": "astro build && node tools/verifier-site.mjs dist && node --disable-warning=ExperimentalWarning tools/visuels-manquants.mjs --resume",
    "check": "astro check",
    "test": "vitest run && node --test \"server/*.test.mjs\"",
    "test:e2e": "playwright test",
    "visuels": "node --disable-warning=ExperimentalWarning tools/visuels-manquants.mjs",
    "visuels:doc": "node --disable-warning=ExperimentalWarning tools/generer-visuels.mjs",
    "visuels:rendre": "node --disable-warning=ExperimentalWarning tools/rendre-visuels.mjs",
    "blog:demo": "node --env-file-if-exists=../.env --disable-warning=ExperimentalWarning tools/articles-demo.mjs",
    "serve": "node --env-file-if-exists=../.env server/server.mjs",
    "preview": "npm run build && npm run serve"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "astro": "7.3.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  }
}
