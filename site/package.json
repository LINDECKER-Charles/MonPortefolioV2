{
  "name": "portfolio-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio de Charles Lindecker, version 2 : un mode d'emploi (Astro, rendu statique)",
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node tools/verifier-site.mjs dist",
    "check": "astro check",
    "test": "vitest run && node --test \"server/*.test.mjs\"",
    "test:e2e": "playwright test",
    "serve": "node --env-file-if-exists=../.env server/server.mjs",
    "preview": "npm run build && npm run serve"
  },
  "dependencies": {
    "astro": "7.3.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.3"
  }
}
