---
/**
 * L’index des étiquettes de preuve, en tête de la vitrine : ce que chaque
 * projet prouve, dans l’ordre des cartes, chaque entrée menant à sa carte.
 *
 *   <IndexPreuves entrees={[
 *     { id: 'pvz', preuve: 'Une équipe formée et menée' },
 *     { id: 'lodb', preuve: 'Un système en production' },
 *   ]} />
 *
 * Les numéros reprennent le `rang` des CarteProjet, sur deux chiffres.
 * Liens d’ancre (↓), la flèche collée au dernier mot. Une colonne à filets
 * sur ordinateur, à côté du titre ; sous 860 px, une seule ligne défilable,
 * avec une ombre au bord qui dit la suite (règle E7) : le chiffre de la carte
 * vedette reste au premier écran (E1).
 */
import { typo } from '../../lib/typo';

interface Props {
  entrees: readonly { id: string; preuve: string }[];
  label?: string;
}

const { entrees, label = 'Ce que prouve chaque projet' } = Astro.props;
---

<nav class="index-preuves" aria-label={label}>
  <ol>
    {entrees.map(({ id, preuve }, i) => (
      <li>
        <a href={`#${id}`}>
          <span class="index-preuves__rang" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span>{typo(preuve)}</span><span class="fleche" aria-hidden="true">&nbsp;↓</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--trait);
  }

  li + li {
    border-top: 1px solid var(--filet);
  }

  /* En bloc, pas en flex : la flèche reste collée au dernier mot. */
  a {
    display: block;
    min-height: 44px;
    padding: var(--s2) 0;
    color: var(--encre);
    font-family: var(--police-titre);
    font-style: italic;
    font-size: var(--t-m);
    line-height: 1.2;
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .index-preuves__rang {
    margin-right: var(--s2);
    font-family: var(--police-texte);
    font-style: normal;
    font-size: var(--t-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--eteint);
  }

  .fleche {
    font-size: var(--t-xs);
    color: var(--accent);
  }

  @media (max-width: 860px) {
    ol {
      display: flex;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      background:
        linear-gradient(to left, var(--fond) 30%, transparent) right / 48px 100% no-repeat local,
        radial-gradient(farthest-side at 100% 50%, color-mix(in srgb, var(--encre) 18%, transparent), transparent) right / 14px 100% no-repeat scroll;
    }

    ol::-webkit-scrollbar {
      display: none;
    }

    li {
      flex: none;
      scroll-snap-align: start;
    }

    li + li {
      border-top: 0;
      border-left: 1px solid var(--filet);
    }

    a {
      padding: var(--s2) var(--s4) var(--s2) var(--s3);
      white-space: nowrap;
    }

    li:first-child a {
      padding-left: 0;
    }
  }
</style>
