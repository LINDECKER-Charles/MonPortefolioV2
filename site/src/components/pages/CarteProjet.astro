---
/**
 * Carte de projet de la vitrine (/projets) et des renvois entre projets.
 * Toute la carte mène à la page du projet (le nom est le lien, étiré sur la
 * carte) ; « Voir le projet → » le dit à l’œil ; les liens publics restent
 * cliquables à part, mesurés en `lien-sortant`.
 *
 *   vedette  pleine largeur, visuel à gauche (PvZ Fusion)
 *   ligne    visuel et texte côte à côte, une demi-largeur ; empilés (visuel
 *            au-dessus) dans une famille de trois cartes au-delà de 1 100 px
 *            (Vitrine colonnes={3})
 *
 *   <Vitrine labelledby="famille-equipe-titre">
 *     <CarteProjet variante="vedette" rang={1} id="pvz" niveau={3} href="/projets/pvz-fusion"
 *       nom="PvZ Fusion, pôle francophone" preuve="Une équipe formée et menée"
 *       besoin="Rattraper, à plusieurs, la traduction française d’un jeu qui sort une nouvelle version chaque mois environ."
 *       chiffre={{ valeur: '20', libelle: 'personnes formées au pôle francophone' }}
 *       role="Lead du pôle, mainteneur du projet multilingue"
 *       statut={{ texte: 'En cours, bénévole' }}
 *       liens={[{ href: 'https://github.com/Teyliu/PVZF-Translation', libelle: 'Projet multilingue (GitHub)' }]}>
 *       <Visuel slot="visuel" id="PRJ-01" />
 *     </CarteProjet>
 *   </Vitrine>
 *
 * `preuve` : l’étiquette de preuve (ce que le projet prouve), numérotée par
 * `rang` sur deux chiffres (« 01 »), comme dans l’index de la vitrine
 * (IndexPreuves).
 * `pli` marque le chiffre de la carte pour le contrôle du premier écran
 * (`data-pli`, règle E1). Les liens publics disent de quel projet ils sont
 * (« Code de gup », le nom en texte masqué). Le visuel vient du slot
 * « visuel », posé sur un acte de veille (la nuit dans le jour) ; une carte
 * sans visuel (slot vide) n’a que son texte, sur toute sa largeur. Un projet
 * en dépôt privé sans lien public (`prive`) le dit à la place des liens,
 * « Dépôt privé », dans le vocabulaire de sa fiche (FicheProjet).
 */
import type { ImageMetadata } from 'astro';
import Statut from '../ui/Statut.astro';
import { attributsMesure, type Emplacement } from '../../lib/liens';
import { typo } from '../../lib/typo';

interface Props {
  variante?: 'vedette' | 'ligne';
  id?: string;
  rang?: number;
  href: string;
  nom: string;
  preuve: string;
  besoin: string;
  chiffre?: { valeur: string; libelle: string };
  role: string;
  statut: { texte: string; etat?: 'actif' | 'ouvert' | 'eteint' };
  liens?: { href: string; libelle: string }[];
  /** Dépôt privé (VITRINE, `prive`) : sans lien public, la carte le dit. */
  prive?: boolean;
  technos?: { src: ImageMetadata; alt: string; mono?: boolean }[];
  /** Emplacement de mesure des liens publics. */
  emplacement?: Emplacement;
  /** Niveau du titre : h2 dans la vitrine, h3 sous un titre de section. */
  niveau?: 2 | 3;
  as?: 'li' | 'article';
  /** Marque du premier écran posée sur le chiffre (`data-pli`, règle E1). */
  pli?: 'preuve';
}

const {
  variante = 'ligne',
  id,
  rang,
  href,
  nom,
  preuve,
  besoin,
  chiffre,
  role,
  statut,
  liens = [],
  prive = false,
  technos = [],
  emplacement = 'preuves',
  niveau = 2,
  as: Element = 'li',
  pli,
} = Astro.props;
const Titre = niveau === 3 ? 'h3' : 'h2';
const sansLienPrive = prive && liens.length === 0;
/** Le visuel du slot, rendu d’abord : un slot vide (carte en attente de visuel) ne pose pas de panneau. */
const visuel = Astro.slots.has('visuel') ? (await Astro.slots.render('visuel')).trim() : '';
/** « de gup », « d’Omnicard » : le projet d’un lien public, pour les lecteurs d’écran. */
const duProjet = /^[aeiouyhâéèêîôû]/i.test(nom) ? ` d’${nom}` : ` de ${nom}`;
---

<Element class:list={['carte-projet', `carte-projet--${variante}`, { 'carte-projet--sans-visuel': !visuel }]} id={id}>
  {visuel && <div class="carte-projet__visuel acte-veille" set:html={visuel} />}
  <div class="carte-projet__corps">
    <p class="carte-projet__preuve">
      {rang && <span class="carte-projet__rang" aria-hidden="true">{String(rang).padStart(2, '0')}</span>}
      {typo(preuve)}
    </p>
    <Titre class="carte-projet__nom">
      <a href={href}>{nom}</a>
    </Titre>
    <p class="carte-projet__besoin">{typo(besoin)}</p>
    {chiffre && <p class="carte-projet__chiffre" data-pli={pli}><b>{chiffre.valeur}</b><small>{typo(chiffre.libelle)}</small></p>}
    <span class="carte-projet__voir" aria-hidden="true">Voir le projet<span class="fleche">&nbsp;→</span></span>
    <dl class="carte-projet__fiche">
      <dt>Rôle</dt>
      <dd>{typo(role)}</dd>
      <dt>Statut</dt>
      <dd><Statut etat={statut.etat}>{typo(statut.texte)}</Statut></dd>
    </dl>
    {
      (liens.length > 0 || sansLienPrive || technos.length > 0) && (
        <div class="carte-projet__bas">
          {sansLienPrive && <p class="carte-projet__prive">Dépôt privé</p>}
          {liens.length > 0 && (
            <ul class="carte-projet__liens">
              {liens.map((lien) => (
                <li>
                  <a href={lien.href} rel="external" {...attributsMesure(lien.href, { emplacement })}>
                    {typo(lien.libelle)}<span class="sr">{duProjet}</span><span class="fleche" aria-hidden="true">&nbsp;↗</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          {technos.length > 0 && (
            <ul class="carte-projet__technos" aria-label="Technologies">
              {technos.map(({ src, alt, mono }) => (
                <li><img class:list={{ 'carte-projet__logo--mono': mono }} src={src.src} width="22" height="22" alt={alt} title={alt} loading="lazy" /></li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </div>
</Element>

<style>
  .carte-projet {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--filet);
    border-radius: var(--r2);
    background: var(--surface);
    box-shadow: var(--ombre-1);
    transition: box-shadow var(--d-ui) var(--courbe), border-color var(--d-ui) var(--courbe);
  }

  .carte-projet:hover {
    border-color: var(--trait);
    box-shadow: var(--ombre-2);
  }

  .carte-projet__visuel {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    padding: clamp(14px, 2vw, 24px);
  }

  .carte-projet__visuel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(60% 70% at 50% 55%, var(--lanterne-halo), transparent);
  }

  /* Une image générée est une gravure à fond perdu, avec sa lanterne
     dessinée : elle remplit tout le panneau, sans passe-partout ni lueur
     ajoutée. Les captures gardent leur marge. */
  .carte-projet__visuel:has(:global(.visuel--jour-nuit)) {
    align-items: stretch;
    padding: 0;
  }

  .carte-projet__visuel:has(:global(.visuel--jour-nuit))::before {
    content: none;
  }

  .carte-projet__visuel > :global(.visuel--jour-nuit) {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }

  .carte-projet__corps {
    display: grid;
    gap: var(--s3);
    align-content: start;
    padding: var(--s5);
  }

  .carte-projet__preuve {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-family: var(--police-titre);
    font-style: italic;
    font-size: var(--t-l);
    line-height: 1.2;
    color: var(--eteint);
  }

  .carte-projet__rang {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid var(--trait);
    border-radius: 50%;
    font-family: var(--police-texte);
    font-style: normal;
    font-size: var(--t-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--encre);
  }

  .carte-projet__nom {
    font-size: var(--t-xl);
    line-height: 1.02;
  }

  .carte-projet__nom a {
    color: var(--encre);
    text-decoration: none;
  }

  /* Toute la carte mène au projet ; les liens publics passent au-dessus. */
  .carte-projet__nom a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--r2);
  }

  .carte-projet__nom a:focus-visible {
    outline: none;
  }

  .carte-projet__nom a:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .carte-projet:hover .carte-projet__nom a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }

  .carte-projet__besoin {
    font-size: var(--t-s);
    line-height: 1.5;
  }

  .carte-projet__chiffre {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--s2);
  }

  .carte-projet__chiffre b {
    font-family: var(--police-texte);
    font-weight: 600;
    font-size: var(--t-2xl);
    line-height: 1;
    letter-spacing: var(--ls-titre);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .carte-projet__chiffre small {
    font-size: var(--t-xs);
    line-height: 1.3;
    color: var(--eteint);
  }

  .carte-projet__voir {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 32px;
    font-size: var(--t-s);
    font-weight: 600;
    color: var(--accent);
  }

  .carte-projet:hover .carte-projet__voir {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .carte-projet__fiche {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s1) var(--s4);
    margin: var(--s1) 0 0;
    padding-top: var(--s3);
    border-top: 1px solid var(--filet);
    font-size: var(--t-xs);
    line-height: 1.45;
  }

  .carte-projet__fiche dt {
    color: var(--eteint);
  }

  .carte-projet__fiche dd {
    margin: 0;
    color: var(--encre);
  }

  .carte-projet__bas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    margin-top: var(--s2);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .carte-projet__liens {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s4);
    font-size: var(--t-xs);
  }

  /* À la place des liens d’un dépôt privé : à la hauteur d’un lien, en texte éteint. */
  .carte-projet__prive {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .carte-projet__liens a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .carte-projet__technos {
    display: flex;
    align-items: center;
    gap: var(--s2);
  }

  .carte-projet__technos img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  :global(:root[data-theme='nuit']) .carte-projet__logo--mono {
    filter: invert(1);
  }

  .carte-projet--vedette {
    grid-column: 1 / -1;
    grid-template-rows: none;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
  }

  .carte-projet--vedette .carte-projet__corps {
    align-content: center;
    padding: var(--s5) var(--s6);
  }

  .carte-projet--vedette .carte-projet__nom {
    font-size: var(--t-2xl);
  }

  .carte-projet--ligne {
    grid-template-rows: none;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  }

  .carte-projet--ligne .carte-projet__corps {
    gap: var(--s2);
    padding: var(--s5) var(--s5) var(--s4);
  }

  /* Sans visuel : le texte seul, sur toute la carte. */
  .carte-projet--sans-visuel {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: none;
  }

  .carte-projet--sans-visuel .carte-projet__corps > :global(*) {
    max-width: 44rem;
  }

  /* Dans une famille de trois (Vitrine colonnes={3}), au-delà de 1 100 px :
     le visuel au-dessus du texte, sur les deux rangées de la ligne partagées
     en sous-grille, pour que les trois visuels aient la même hauteur. */
  @media (min-width: 1101px) {
    :global(.vitrine--trois) > .carte-projet--ligne {
      grid-row: span 2;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: subgrid;
      row-gap: 0;
    }

    :global(.vitrine--trois) > .carte-projet--sans-visuel .carte-projet__corps {
      grid-row: 1 / -1;
    }
  }

  @media (max-width: 860px) {
    .carte-projet--vedette,
    .carte-projet--ligne {
      grid-template-columns: minmax(0, 1fr);
    }

    .carte-projet__visuel {
      padding: 10px;
    }

    .carte-projet__visuel:has(:global(.visuel--jour-nuit)) {
      padding: 0;
    }

    .carte-projet--vedette .carte-projet__corps,
    .carte-projet--ligne .carte-projet__corps {
      gap: var(--s2);
      padding: var(--s4);
    }

    .carte-projet--vedette .carte-projet__nom {
      font-size: var(--t-xl);
    }
  }
</style>
