---
/**
 * Une capture réelle dans son cadre d’appareil (règle B7) : un cadre par
 * type, sans marque, coins selon les jetons.
 *
 *   navigateur  barre à trois points et adresse (`adresse`)
 *   telephone   cadre arrondi qui dessine l’appareil, capture entière (9:19,5)
 *   terminal    capture déjà fenêtrée, sans cadre ajouté
 *
 * Le jour, un cadre sombre au trait ; la nuit et dans les actes sombres, le
 * cadre s’efface derrière un halo de lanterne : les interfaces sombres s’y
 * fondent.
 *
 *   <CadreCapture type="navigateur" adresse="league-of-data-base.com/fr"
 *     src={capture} alt="…ce que la capture prouve…" legende="…" agrandir />
 *
 * `ratio` recadre la vue (object-fit: cover, `position` en object-position) ;
 * sans lui, la capture est montrée entière ; `ratioMobile` recadre sous
 * 860 px seulement. `agrandir` fait de l’image un
 * lien vers sa version pleine taille, ouverte dans la visionneuse de la page
 * (<Visionneuse />, à poser une fois) ; sans JavaScript, le lien ouvre
 * l’image. Le slot par défaut se superpose à la vue (cibles, loupe :
 * CaptureAnnotee) ; le slot « legende » remplace la légende texte ; le slot
 * « media » remplace l’image (vidéo).
 */
import type { ImageMetadata } from 'astro';
import { getImage, Picture } from 'astro:assets';
import Picto from './Picto.astro';
import { typo } from '../../lib/typo';

interface Props {
  type?: 'navigateur' | 'telephone' | 'terminal';
  /** Adresse affichée dans la barre du navigateur (sans https://). */
  adresse?: string;
  src?: ImageMetadata;
  /** Ce que la capture prouve (règle A5), pas ce qu’elle montre en vrac. */
  alt?: string;
  legende?: string;
  /** Recadrage de la vue, au format aspect-ratio (« 16 / 10 »). */
  ratio?: string;
  /** Recadrage sous 860 px, s’il diffère (« 5 / 7 » pour un téléphone coupé). */
  ratioMobile?: string;
  position?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  agrandir?: boolean;
  class?: string;
}

const {
  type = 'navigateur',
  adresse,
  src,
  alt = '',
  legende,
  ratio,
  ratioMobile,
  position = '50% 0',
  widths,
  sizes = '(max-width: 860px) 100vw, 50vw',
  loading = 'lazy',
  agrandir = false,
  class: classe,
} = Astro.props;

const largeurs = src ? widths ?? [...new Set([Math.min(640, src.width), Math.min(1280, src.width)])] : [];
const pleineTaille = src && agrandir ? await getImage({ src, format: 'webp', width: Math.min(src.width, 2400) }) : undefined;
const style = [ratio && `--ratio:${ratio}`, ratioMobile && `--ratio-mobile:${ratioMobile}`, `--position:${position}`].filter(Boolean).join(';');
const aLegende = Boolean(legende) || Astro.slots.has('legende');
---

<figure class:list={['capture', `capture--${type}`, { 'capture--recadree': ratio, 'capture--recadree-mobile': ratioMobile }, classe]}>
  <div class="capture__cadre">
    {type === 'navigateur' && (
      <div class="capture__barre" aria-hidden="true">
        <span class="capture__points"></span>
        {adresse && <span class="capture__adresse">{adresse}</span>}
      </div>
    )}
    <div class="capture__vue" style={style}>
      {
        Astro.slots.has('media') ? (
          <slot name="media" />
        ) : src && pleineTaille ? (
          <a class="capture__agrandir" href={pleineTaille.src} data-agrandir data-legende={legende ? typo(legende) : alt}>
            <Picture src={src} formats={['avif']} fallbackFormat="webp" widths={largeurs} sizes={sizes} alt={alt} loading={loading} decoding="async" />
            <span class="capture__loupe-picto" aria-hidden="true"><Picto nom="interface/agrandir" /></span>
          </a>
        ) : (
          src && <Picture src={src} formats={['avif']} fallbackFormat="webp" widths={largeurs} sizes={sizes} alt={alt} loading={loading} decoding="async" />
        )
      }
      <slot />
    </div>
  </div>
  {
    aLegende && (
      <figcaption class="capture__legende">
        <slot name="legende">{legende && typo(legende)}</slot>
      </figcaption>
    )
  }
</figure>

<style>
  .capture {
    position: relative;
    isolation: isolate;
    margin: 0;
  }

  /* La nuit, un halo de lanterne derrière la capture. */
  .capture::before {
    content: '';
    position: absolute;
    inset: -10% -8%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(closest-side, var(--lanterne-halo), transparent);
    opacity: 0;
    transition: opacity var(--d-scene) var(--courbe);
  }

  :global(:root[data-theme='nuit']) .capture::before,
  :global(.acte-veille) .capture::before,
  :global(.acte-bleu) .capture::before {
    opacity: 1;
  }

  .capture__cadre {
    overflow: hidden;
    border: 1px solid var(--trait);
    border-radius: var(--r2);
    background: var(--cadre);
    box-shadow: var(--ombre-1);
  }

  :global(:root[data-theme='nuit']) .capture__cadre,
  :global(.acte-veille) .capture__cadre,
  :global(.acte-bleu) .capture__cadre {
    border-color: var(--cadre-point);
  }

  .capture__barre {
    display: flex;
    align-items: center;
    gap: var(--s3);
    height: 28px;
    padding-inline: var(--s3);
    overflow: hidden;
    border-bottom: 1px solid var(--cadre-filet);
    background: var(--cadre-barre);
    color: var(--cadre-texte);
    font-size: var(--t-xs);
    white-space: nowrap;
  }

  .capture__points {
    flex: none;
    width: 34px;
    height: 8px;
    background: radial-gradient(circle 4px at 4px 4px, var(--cadre-point) 98%, transparent) 0 0 / 13px 8px repeat-x;
  }

  .capture__adresse {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .capture__vue {
    position: relative;
  }

  .capture--recadree .capture__vue {
    aspect-ratio: var(--ratio);
    overflow: hidden;
  }

  .capture__vue :global(picture) {
    display: contents;
  }

  .capture__vue :global(img),
  .capture__vue :global(video) {
    display: block;
    width: 100%;
    height: auto;
  }

  .capture--recadree .capture__vue :global(img),
  .capture--recadree .capture__vue :global(video) {
    height: 100%;
    object-fit: cover;
    object-position: var(--position);
  }

  @media (max-width: 860px) {
    .capture--recadree-mobile .capture__vue {
      aspect-ratio: var(--ratio-mobile);
      overflow: hidden;
    }

    .capture--recadree-mobile .capture__vue :global(img),
    .capture--recadree-mobile .capture__vue :global(video) {
      height: 100%;
      object-fit: cover;
      object-position: var(--position);
    }
  }

  .capture__agrandir {
    display: block;
    height: 100%;
    cursor: zoom-in;
  }

  .capture__agrandir:focus-visible {
    outline-offset: -3px;
  }

  .capture__loupe-picto {
    position: absolute;
    right: var(--s2);
    bottom: var(--s2);
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r3);
    background: var(--voile-cible);
    color: var(--lune);
    opacity: 0;
    transition: opacity var(--d-ui) var(--courbe);
  }

  .capture__loupe-picto :global(svg) {
    width: 18px;
    height: 18px;
  }

  .capture__agrandir:hover .capture__loupe-picto,
  .capture__agrandir:focus-visible .capture__loupe-picto {
    opacity: 1;
  }

  .capture--telephone .capture__cadre {
    padding: 6px;
    border-radius: 26px;
  }

  .capture--telephone .capture__vue {
    overflow: hidden;
    border-radius: 20px;
  }

  .capture--terminal .capture__cadre {
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .capture__legende {
    display: flex;
    align-items: flex-start;
    gap: var(--s2);
    margin-top: var(--s3);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--eteint);
  }

  @media print {
    .capture::before,
    .capture__loupe-picto {
      display: none;
    }
  }
</style>
