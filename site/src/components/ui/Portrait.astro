---
/**
 * Une vraie photo de Charles, qui passe la nuit sous la lumière de la
 * lanterne (signature « allumage », direction « Lanterne »).
 *
 * Le jour, la photo telle quelle. La nuit, elle garde ses couleurs (le bleu
 * roi de la chemise est l’identité) : assombrie sous un voile de lune, avec
 * une lueur de lanterne sur le côté éclairé du visage. Filtres CSS
 * déterministes, aucune image régénérée, rien de sépia.
 *
 *   <Portrait src={photo} alt="…" widths={[360, 720]} sizes="…" />
 *
 * Le cadre prend la taille que lui donne son parent (largeur, ratio, rayon) ;
 * `cadrage` place le sujet (object-position), `lueur` le centre de la lueur
 * sur le visage, en pourcentages du cadre.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** object-position de la photo, « 50% 30% » par défaut. */
  cadrage?: string;
  /** Centre de la lueur de lanterne, « 48% 47% » par défaut. */
  lueur?: string;
  class?: string;
}

const { src, alt, widths = [480, 960], sizes = '100vw', loading = 'lazy', fetchpriority, cadrage = '50% 30%', lueur = '48% 47%', class: classe } = Astro.props;
---

<div class:list={['portrait', classe]} style={`--cadrage:${cadrage};--lueur:${lueur}`}>
  <Picture src={src} formats={['avif']} fallbackFormat="webp" widths={widths} sizes={sizes} alt={alt} loading={loading} fetchpriority={fetchpriority} decoding="async" />
</div>

<style>
  .portrait {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--suie);
  }

  .portrait :global(picture) {
    display: contents;
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--cadrage);
    transition: filter var(--d-scene) var(--courbe);
  }

  .portrait::before,
  .portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--d-scene) var(--courbe);
  }

  /* Le voile de lune, plus dense vers le haut et sur les bords. */
  .portrait::before {
    z-index: 1;
    background:
      linear-gradient(180deg, var(--voile-lune), transparent 62%),
      radial-gradient(78% 64% at 52% 46%, transparent 42%, var(--voile-portrait));
    mix-blend-mode: multiply;
  }

  /* La lanterne, sur le côté éclairé du visage. */
  .portrait::after {
    z-index: 2;
    background: radial-gradient(17% 13% at var(--lueur), var(--lueur-portrait), transparent 75%);
    mix-blend-mode: screen;
  }

  :global(:root[data-theme='nuit']) .portrait :global(img) {
    filter: brightness(0.66) saturate(0.92) contrast(1.06);
  }

  :global(:root[data-theme='nuit']) .portrait::before,
  :global(:root[data-theme='nuit']) .portrait::after {
    opacity: 1;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .portrait :global(img) {
      filter: brightness(0.66) saturate(0.92) contrast(1.06);
    }

    :global(:root:not([data-theme])) .portrait::before,
    :global(:root:not([data-theme])) .portrait::after {
      opacity: 1;
    }
  }

  @media print {
    .portrait :global(img) {
      filter: none !important;
    }

    .portrait::before,
    .portrait::after {
      display: none;
    }
  }
</style>
