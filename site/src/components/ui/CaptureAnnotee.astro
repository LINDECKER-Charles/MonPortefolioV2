---
/**
 * Capture annotée : la preuve dans l’écran réel. Un cadre au ratio commun
 * (16:10 par défaut), une cible numérotée sur ce qui prouve,
 * une loupe éclairée par la lanterne qui agrandit le détail (le texte y
 * redevient lisible à 390 px), une légende au même numéro.
 *
 *   <CaptureAnnotee src={capture} type="navigateur" adresse="league-of-data-base.com/fr"
 *     alt="Ahri au patch 3.6.14, en français : 380 points de vie de base."
 *     cible={{ x: 31, y: 42 }}
 *     loupe={{ x: 28, y: 38, zoom: 2.4, coin: 'bas-droite' }}
 *     legende="Le patch 3.6.14, en français : les valeurs d’origine." />
 *
 * Coordonnées en pourcentages : `cible` dans le cadre visible ; `loupe.x/y`
 * le point de l’image à centrer dans la loupe ; `zoom` son grossissement ;
 * `largeur` sa largeur en % du cadre (50 par défaut, + 6 sur mobile).
 * La loupe est décorative (le détail est dit par l’alt et la légende).
 * Accepte aussi les props de CadreCapture (agrandir, position, sizes…).
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import CadreCapture from './CadreCapture.astro';
import { typo } from '../../lib/typo';

interface Loupe {
  x: number;
  y: number;
  zoom: number;
  largeur?: number;
  /** Ratio de la loupe (« 4 / 3 » par défaut). */
  ratio?: string;
  coin?: 'bas-droite' | 'bas-gauche' | 'haut-droite' | 'haut-gauche';
}

interface Props {
  src: ImageMetadata;
  alt: string;
  legende: string;
  type?: 'navigateur' | 'telephone' | 'terminal';
  adresse?: string;
  ratio?: string;
  position?: string;
  /** La cible numérotée « 1 », reprise par la loupe et la légende. */
  cible?: { x: number; y: number };
  loupe?: Loupe;
  agrandir?: boolean;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { src, alt, legende, type = 'navigateur', adresse, ratio = '16 / 10', position, cible, loupe, agrandir = false, sizes, loading, class: classe } = Astro.props;
const detail = loupe ? await getImage({ src, format: 'webp', width: Math.min(src.width, 2000) }) : undefined;
const styleLoupe = loupe
  ? [`--lx:${loupe.x}%`, `--ly:${loupe.y}%`, `--lz:${loupe.zoom}`, `--lw:${loupe.largeur ?? 50}%`, `--lr:${loupe.ratio ?? '4 / 3'}`].join(';')
  : '';
---

<CadreCapture
  class:list={['capture-annotee', classe]}
  type={type}
  adresse={adresse}
  src={src}
  alt={alt}
  ratio={ratio}
  position={position}
  agrandir={agrandir}
  sizes={sizes}
  loading={loading}
>
  {cible && <span class="cible" style={`--cx:${cible.x}%;--cy:${cible.y}%`} aria-hidden="true"><span class="cible__num">1</span></span>}
  {
    loupe && detail && (
      <span class:list={['loupe', `loupe--${loupe.coin ?? 'bas-droite'}`]} style={styleLoupe} aria-hidden="true">
        <img src={detail.src} alt="" loading="lazy" decoding="async" />
        {cible && <span class="cible__num loupe__num">1</span>}
      </span>
    )
  }
  <Fragment slot="legende">
    {cible && <span class="cible__num legende__num" aria-hidden="true">1</span>}
    <span class="capture-annotee__texte">{typo(legende)}</span>
  </Fragment>
</CadreCapture>

<style>
  .cible {
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    translate: -50% -50%;
    width: 34px;
    height: 34px;
    border: 2px solid var(--lanterne);
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--voile-cible), 0 0 18px 2px var(--lanterne-eclat);
    pointer-events: none;
  }

  .cible__num {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--lanterne);
    color: var(--suie);
    font-size: var(--t-xs);
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .cible > .cible__num {
    position: absolute;
    left: -14px;
    top: -14px;
  }

  .loupe {
    position: absolute;
    width: var(--lw);
    aspect-ratio: var(--lr);
    overflow: hidden;
    border: 1.5px solid var(--lanterne);
    border-radius: var(--r2);
    background: var(--cadre);
    box-shadow: 0 0 0 4px var(--voile-cible), 0 0 44px -2px var(--lanterne-eclat);
    pointer-events: none;
  }

  .loupe > img {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--lz) * 100%);
    max-width: none;
    height: auto;
    translate: calc(-1 * var(--lx)) calc(-1 * var(--ly));
  }

  /* Fondu de bord : aucun glyphe n’est tranché net par le bord de la loupe. */
  .loupe::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 12px 5px var(--cadre);
  }

  .loupe__num {
    position: absolute;
    right: 6px;
    top: 6px;
    z-index: 1;
  }

  .loupe--bas-droite { right: 4%; bottom: 5%; }
  .loupe--bas-gauche { left: 4%; bottom: 5%; }
  .loupe--haut-droite { right: 3%; top: 6%; }
  .loupe--haut-gauche { left: 3%; top: 6%; }

  .legende__num {
    margin-top: -1px;
  }

  .capture-annotee__texte {
    color: var(--encre);
  }

  @media (max-width: 860px) {
    .loupe {
      width: calc(var(--lw) + 6%);
    }
  }
</style>
