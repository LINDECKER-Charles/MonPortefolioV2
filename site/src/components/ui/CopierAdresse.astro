---
/**
 * « Copier l'adresse » : pour le lecteur dont le navigateur n'a pas de
 * messagerie configurée — le cas courant au bureau, où un lien mailto ne fait
 * rien. Le bouton confirme ce qui s'est passé (pictogramme et libellé), et le
 * dit aussi aux lecteurs d'écran. Sans JavaScript, il n'apparaît pas :
 * l'adresse reste affichée en clair à côté.
 */
import Picto from './Picto.astro';

interface Props {
  adresse: string;
  emplacement: string;
}

const { adresse, emplacement } = Astro.props;
---

<button class="btn btn--contour copier" type="button" data-copier={adresse} data-emplacement={emplacement}>
  <span class="copier__icone copier__icone--repos"><Picto nom="interface/copier" /></span>
  <span class="copier__icone copier__icone--fait"><Picto nom="interface/copie" /></span>
  <span class="copier__libelle">Copier l’adresse</span>
</button>
<span class="sr" role="status" data-copier-statut></span>

<script>
  import { brancherCopie } from '../../scripts/copier';
  brancherCopie();
</script>

<style>
  .copier {
    display: none;
  }

  :global(.js) .copier {
    display: inline-flex;
  }

  .copier__icone {
    display: inline-flex;
  }

  .copier__icone :global(svg) {
    width: 20px;
    height: 20px;
  }

  .copier__icone--fait,
  .copier:global(.est-copie) .copier__icone--repos {
    display: none;
  }

  .copier:global(.est-copie) .copier__icone--fait {
    display: inline-flex;
  }
</style>
