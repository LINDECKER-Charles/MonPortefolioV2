---
/**
 * Le logo livre-lanterne : l’emblème, et le nom à côté quand il y a la place.
 * Toujours décoratif : le lien qui l’entoure porte le nom accessible.
 *
 * La nuit, l’emblème passe à l’encre de lune et seules les lumières de la
 * lanterne gardent leur couleur (LogoImage) ; la flamme s’entoure d’un halo,
 * qui s’allume avec la bascule (400 ms, aucun en mouvement réduit).
 *
 *   <Logo />            emblème et nom (le nom se masque sous 860 px)
 *   <Logo nom={false} /> emblème seul
 *
 * Le composant lit les dessins du registre (config/visuels.ts) dès qu’ils
 * sont livrés, et revient sinon aux images du logo validé
 * (src/assets/marque) :
 *   - GLO-01, l’emblème seul redessiné pour les petites tailles, remplace
 *     l’emblème illustré sous 860 px (en-tête mobile) ;
 *   - GLO-02, le logo horizontal, remplace l’emblème et le nom au-delà.
 * Insérés en ligne, ils suivent les jetons : encre le jour, lune la nuit,
 * flamme de la lanterne.
 */
import LogoImage from './LogoImage.astro';
import { svgEnLigne } from '../../lib/visuels';
import symbole from '../../assets/marque/logo-symbole.webp';
import nomImage from '../../assets/marque/logo-nom.webp';
import { cadrages, lumieres } from '../../assets/marque/cadrages.json';

interface Props {
  /** Affiche le nom à côté de l’emblème. */
  nom?: boolean;
  class?: string;
}

const { nom = true, class: classe } = Astro.props;
const dessins = import.meta.glob<string>('/src/assets/visuels/global/GLO-0[12].svg', { eager: true, query: '?raw', import: 'default' });
const emblemeSeul = dessins['/src/assets/visuels/global/GLO-01.svg'];
const horizontal = dessins['/src/assets/visuels/global/GLO-02.svg'];
const cadrage = cadrages.symbole;
const clips = lumieres.map(({ left, top, width, height }) => {
  const haut = ((top - cadrage.top) / cadrage.height) * 100;
  const droite = ((cadrage.left + cadrage.width - left - width) / cadrage.width) * 100;
  const bas = ((cadrage.top + cadrage.height - top - height) / cadrage.height) * 100;
  const gauche = ((left - cadrage.left) / cadrage.width) * 100;
  return `inset(${haut}% ${droite}% ${bas}% ${gauche}%)`;
});
---

<span class:list={['logo', { 'logo--compact': emblemeSeul, 'logo--horizontal': nom && horizontal }, classe]} aria-hidden="true">
  {
    nom && horizontal ? (
      <span class="logo__horizontal" set:html={svgEnLigne(horizontal, { alt: '' })} />
    ) : (
      <>
        <span class="logo__embleme"><LogoImage src={symbole} lumieres={clips} /></span>
        {nom && <span class="logo__nom"><LogoImage src={nomImage} /></span>}
      </>
    )
  }
  {emblemeSeul && <span class="logo__embleme logo__embleme--seul" set:html={svgEnLigne(emblemeSeul, { alt: '' })} />}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
    flex-shrink: 0;
  }

  .logo__embleme {
    position: relative;
    width: 52px;
    flex-shrink: 0;
  }

  /* Le halo de la flamme : son centre est à 50 % × 54 % de l’emblème
     (src/assets/marque/cadrages.json, lumière du milieu). */
  .logo__embleme::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 54%;
    width: 44px;
    height: 44px;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--lanterne-eclat), transparent);
    opacity: 0;
    scale: 0.4;
    pointer-events: none;
    transition: opacity var(--d-scene) var(--courbe), scale var(--d-scene) var(--courbe);
  }

  :global(:root[data-theme='nuit']) .logo__embleme::after {
    opacity: 1;
    scale: 1;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .logo__embleme::after {
      opacity: 1;
      scale: 1;
    }
  }

  .logo__nom {
    width: 122px;
  }

  .logo__horizontal {
    display: block;
    width: 190px;
    color: var(--encre);
  }

  /* Les dessins du registre : encre au trait du texte, vitre et flamme de la
     lanterne. */
  .logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .logo :global(.em-vitre) {
    fill: var(--suie);
  }

  .logo :global(.em-lumiere) {
    fill: var(--lanterne);
  }

  .logo__embleme--seul {
    display: none;
    width: 40px;
    color: var(--encre);
  }

  @media (max-width: 860px) {
    .logo__embleme {
      width: 44px;
    }

    .logo__nom,
    .logo__horizontal {
      display: none;
    }

    .logo--compact .logo__embleme:not(.logo__embleme--seul) {
      display: none;
    }

    .logo--compact .logo__embleme--seul {
      display: block;
      width: 40px;
    }
  }

  @media print {
    .logo__embleme::after {
      display: none;
    }
  }
</style>
