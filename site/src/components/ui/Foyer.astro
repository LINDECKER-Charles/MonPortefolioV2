---
/**
 * La zone éclairée : une par écran (direction « Lanterne »). Le jour, une
 * flaque de lumière douce derrière l’élément qui compte (la phrase, le
 * chiffre, la capture) ; la nuit, le halo chaud de la lanterne. Le reste de
 * l’écran se tait.
 *
 *   <Foyer>…</Foyer>
 *   <Foyer as="figure" class="…">…</Foyer>
 *
 * Classe : `.foyer` (global.css), utilisable aussi directement.
 */
interface Props {
  as?: 'div' | 'figure' | 'p' | 'header' | 'span';
  class?: string;
}

const { as: Element = 'div', class: classe } = Astro.props;
---

<Element class:list={['foyer', classe]}><slot /></Element>
