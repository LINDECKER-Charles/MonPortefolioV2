---
/**
 * Un emplacement de visuel de l’inventaire de la refonte (config/visuels.ts).
 *
 * Le fichier attendu existe : l’image s’affiche, au ratio du registre, avec
 * l’alt prévu. Il manque : un cadre hachuré au bon ratio, dans la lumière de
 * la direction « Lanterne », porte la commande — identifiant, méthode et
 * priorité, sujet, composition, format. La page garde ainsi sa mise en page
 * avant que l’image arrive, et `npm run visuels` liste ce qu’il reste à
 * produire.
 *
 *   <Visuel id="PRJ-01" sizes="(max-width: 860px) 100vw, 50vw" />
 *   <Visuel id="ACC-03" foyer />          la zone éclairée de l’écran
 *
 *   <Visuel id="GUP-01" largeur="320px" />    largeur d’affichage (bornée à 100 %)
 *   <Visuel id="PRJ-01" ratioMobile="16 / 10" />   remplace le ratio du registre
 *
 * Un identifiant absent du registre fait échouer le build : pas de faute de
 * frappe silencieuse. Le cadre s’adapte à sa taille (requêtes de conteneur sur
 * la largeur et la hauteur) : la consigne s’arrête net après quatre lignes,
 * deux dans un cadre bas, et disparaît sous 260 px de large ou 190 px de haut ;
 * le format tient sur une ligne ; sous 100 px, il ne reste que l’identifiant.
 * Aucun texte ne déborde du cadre : la page n’a rien à corriger.
 *
 * Les règles du composant ont la spécificité d’une classe (`:where`) : une
 * page qui passe `class` peut les surcharger sans sélecteur d’identifiant.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { fichiersAttendus, visuelParId } from '../../config/visuels';
import { typo } from '../../lib/typo';

interface Props {
  id: string;
  /** Remplace l’alt prévu du registre (par exemple une légende propre à la page). */
  alt?: string;
  /** Attribut `sizes` de l’image : largeur d’affichage selon la fenêtre. */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  /** La zone éclairée de l’écran (une seule par écran). */
  foyer?: boolean;
  /** Ratio d’affichage, s’il diffère du registre (« 16 / 10 »). */
  ratio?: string;
  /** Ratio sous 860 px, s’il diffère du registre. */
  ratioMobile?: string;
  /** Largeur d’affichage (longueur CSS : « 320px », « 60% »), bornée à 100 %. */
  largeur?: string;
  class?: string;
}

const { id, alt: altPropre, sizes = '100vw', loading = 'lazy', foyer = false, ratio: ratioPropre, ratioMobile: ratioMobilePropre, largeur, class: classe } = Astro.props;

const visuel = visuelParId(id);
if (!visuel) throw new Error(`<Visuel id="${id}"> : identifiant absent de src/config/visuels.ts`);

/** Fichiers déjà livrés : le dossier des visuels et les photos de Charles. */
const images = import.meta.glob<ImageMetadata>(
  ['/src/assets/visuels/**/*.{webp,png,jpg,jpeg,avif,svg}', '/src/assets/photos/*.webp'],
  { eager: true, import: 'default' },
);

const attendus = fichiersAttendus(visuel);
// Un emplacement qui reprend plusieurs fichiers (ACC-15) se compose de plusieurs <Visuel>.
const fichier = attendus.length === 1 ? attendus[0] : undefined;
const image = fichier ? images[`/${fichier}`] : undefined;

const alt = altPropre ?? visuel.alt;
const ratio = ratioPropre ?? visuel.ratio ?? '16 / 10';
const ratioMobile = ratioMobilePropre ?? visuel.ratioMobile;
const style = [`--visuel-ratio:${ratio}`, ratioMobile && `--visuel-ratio-mobile:${ratioMobile}`, largeur && `--visuel-largeur:${largeur}`].filter(Boolean).join(';');
const largeurs = image && image.format !== 'svg' ? [...new Set([Math.round(image.width / 2), image.width])].filter((l) => l >= 320 || l === image.width) : [];

const NATURE = { IMG: 'Image à générer', SVG: 'Dessin à faire', FIG: 'Figure à coder', CAP: 'Capture à faire', PHO: 'Photo réelle', OG: 'Image de partage' } as const;
const reprise = visuel.reprend?.length ? `reprend ${visuel.reprend.join(', ')}` : '';
const mobile = ratioMobile && !/mobile/.test(visuel.format) ? `${ratioMobile.replace(' / ', ':')} sur mobile` : '';
const format = [visuel.format, mobile, reprise].filter(Boolean).join(' · ');
---

{
  image ? (
    <figure class:list={['visuel', { foyer }, classe]} style={style} data-visuel={id}>
      {image.format === 'svg' ? (
        <img src={image.src} width={image.width} height={image.height} alt={alt} loading={loading} decoding="async" />
      ) : (
        <Picture src={image} formats={['avif']} fallbackFormat="webp" widths={largeurs} sizes={sizes} alt={alt} loading={loading} decoding="async" />
      )}
    </figure>
  ) : (
    <figure class:list={['visuel', 'visuel--manquant', { 'visuel--foyer': foyer, 'visuel--capture': visuel.methode === 'CAP' }, classe]} style={style} data-visuel={id} data-manquant>
      <div class="visuel__contenu">
        <p class="visuel__id">
          <strong>{id}</strong>
          <span>{NATURE[visuel.methode]} · {visuel.priorite === 'socle' ? 'socle' : 'élargi'}</span>
        </p>
        <p class="visuel__sujet">{typo(visuel.sujet)}</p>
        <p class="visuel__consigne">{typo(visuel.composition)}</p>
        <p class="visuel__format">{typo(format)}</p>
      </div>
    </figure>
  )
}

<style>
  /* Spécificité d’une classe (`:where`) : la classe d’une page l’emporte. */
  :where(.visuel) {
    width: var(--visuel-largeur, auto);
    max-width: 100%;
    margin: 0;
    aspect-ratio: var(--visuel-ratio);
    border-radius: var(--r2);
    overflow: hidden;
  }

  .visuel :global(img),
  .visuel :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* L’image manquante : un cadre hachuré qui ne se prend pas pour une image.
     Conteneur en largeur et en hauteur : la commande s’adapte au cadre. */
  :where(.visuel--manquant) {
    position: relative;
    isolation: isolate;
    container-type: size;
    border: 1px dashed var(--trait);
    background:
      repeating-linear-gradient(-45deg, var(--hachure) 0 1px, transparent 1px 7px),
      var(--emplacement);
    color: var(--encre);
  }

  /* La lueur neutre de la direction ; la lumière de la scène s’il est le foyer. */
  .visuel--manquant::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(60% 70% at 62% 42%, var(--lueur), transparent 70%);
  }

  .visuel--foyer::before {
    background: radial-gradient(55% 65% at 60% 45%, var(--lumiere), transparent 72%);
  }

  .visuel__contenu {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    padding: clamp(10px, 5cqi, 24px);
    overflow: hidden;
  }

  .visuel__contenu p {
    margin: 0;
  }

  .visuel__id {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    align-self: flex-start;
    max-width: 100%;
    padding: 2px var(--s2);
    border-radius: var(--r1);
    background: var(--encre);
    color: var(--fond);
    font-size: var(--t-xs);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--ls-petit);
    white-space: nowrap;
  }

  .visuel__id strong {
    font-weight: 600;
  }

  .visuel__id span {
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0.82;
  }

  .visuel--capture .visuel__id {
    background: var(--accent);
    color: var(--accent-texte);
  }

  /* Le texte s’arrête net (points de suspension), jamais tranché par le cadre. */
  .visuel__sujet,
  .visuel__consigne {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .visuel__sujet {
    flex: none;
    margin-top: auto !important;
    font-family: var(--police-titre);
    font-style: italic;
    font-size: var(--t-l);
    line-height: 1.1;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .visuel__consigne,
  .visuel__format {
    flex: none;
    max-width: 44ch;
    font-size: var(--t-xs);
    line-height: 1.4;
    color: var(--eteint);
  }

  .visuel__consigne {
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }

  .visuel__format {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-variant-numeric: tabular-nums;
  }

  @container (min-width: 520px) {
    .visuel__sujet {
      font-size: var(--t-xl);
    }
  }

  @container (max-height: 250px) {
    .visuel__consigne {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }
  }

  @container (max-width: 260px) or (max-height: 190px) {
    .visuel__consigne,
    .visuel__id span {
      display: none;
    }
  }

  @container (max-width: 150px) or (max-height: 140px) {
    .visuel__format {
      display: none;
    }

    .visuel__sujet {
      font-size: var(--t-xs);
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }
  }

  /* Vignette : l’identifiant seul, entier, au besoin sur deux lignes. */
  @container (max-width: 110px) or (max-height: 100px) {
    .visuel__sujet {
      display: none;
    }
  }

  @container (max-width: 100px) {
    .visuel__contenu {
      padding: var(--s1);
    }

    .visuel__id {
      padding: 1px var(--s1);
      white-space: normal;
    }
  }

  @media (max-width: 860px) {
    :where(.visuel) {
      aspect-ratio: var(--visuel-ratio-mobile, var(--visuel-ratio));
    }
  }
</style>
