---
/**
 * Un emplacement de visuel de l’inventaire de la refonte (config/visuels.ts).
 *
 * Le fichier attendu existe : l’image s’affiche, au ratio du registre, avec
 * l’alt prévu. Il manque : un cadre pointillé neutre, au même ratio, porte
 * l’identifiant et la consigne. La page garde ainsi sa mise en page avant que
 * l’image arrive, et `npm run visuels` liste ce qu’il reste à produire.
 *
 * Un identifiant absent du registre fait échouer le build : pas de faute de
 * frappe silencieuse. Le style final viendra avec la direction visuelle ; seuls
 * les jetons de global.css sont employés ici.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { fichiersAttendus, visuelParId } from '../../config/visuels';
import { typo } from '../../lib/typo';

interface Props {
  id: string;
  /** Remplace l’alt prévu du registre (par exemple une légende propre à la page). */
  alt?: string;
  /** Attribut `sizes` de l’image : largeur d’affichage selon la fenêtre. */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { id, alt: altPropre, sizes = '100vw', loading = 'lazy', class: classe } = Astro.props;

const visuel = visuelParId(id);
if (!visuel) throw new Error(`<Visuel id="${id}"> : identifiant absent de src/config/visuels.ts`);

/** Fichiers déjà livrés : le dossier des visuels et les photos de Charles. */
const images = import.meta.glob<ImageMetadata>(
  ['/src/assets/visuels/**/*.{webp,png,jpg,jpeg,avif,svg}', '/src/assets/photos/*.webp'],
  { eager: true, import: 'default' },
);

const attendus = fichiersAttendus(visuel);
// Un emplacement qui reprend plusieurs fichiers (ACC-15) se compose de plusieurs <Visuel>.
const fichier = attendus.length === 1 ? attendus[0] : undefined;
const image = fichier ? images[`/${fichier}`] : undefined;

const alt = altPropre ?? visuel.alt;
const ratio = visuel.ratio ?? '16 / 10';
const style = [`--visuel-ratio:${ratio}`, visuel.ratioMobile ? `--visuel-ratio-mobile:${visuel.ratioMobile}` : ''].filter(Boolean).join(';');
const largeurs = image && image.format !== 'svg' ? [...new Set([Math.round(image.width / 2), image.width])].filter((l) => l >= 320 || l === image.width) : [];
---

{
  image ? (
    <figure class:list={['visuel', classe]} style={style} data-visuel={id}>
      {image.format === 'svg' ? (
        <img src={image.src} width={image.width} height={image.height} alt={alt} loading={loading} decoding="async" />
      ) : (
        <Picture src={image} formats={['avif']} fallbackFormat="webp" widths={largeurs} sizes={sizes} alt={alt} loading={loading} decoding="async" />
      )}
    </figure>
  ) : (
    <figure class:list={['visuel', 'visuel--manquant', classe]} style={style} data-visuel={id} data-manquant>
      <p class="visuel__id">
        <strong>{id}</strong>
        <span>{visuel.methode} · {visuel.priorite === 'socle' ? 'socle' : 'élargi'}</span>
      </p>
      <p class="visuel__sujet">{typo(visuel.sujet)}</p>
      <p class="visuel__consigne">{typo(visuel.composition)}</p>
    </figure>
  )
}

<style>
  .visuel {
    margin: 0;
    aspect-ratio: var(--visuel-ratio);
    max-width: 100%;
  }

  .visuel :global(img),
  .visuel :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* L’image manquante : un cadre pointillé qui ne se prend pas pour une image. */
  .visuel--manquant {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s2);
    padding: var(--s4);
    overflow: hidden;
    border: 1px dashed var(--trait);
    border-radius: var(--rayon);
    background: var(--papier);
    color: var(--graphite);
    font-size: var(--t-etiquette);
    line-height: 1.35;
  }

  .visuel--manquant p {
    margin: 0;
  }

  .visuel__id {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s3);
    align-items: baseline;
  }

  .visuel__id strong {
    color: var(--encre);
    font-size: var(--t-petit);
    letter-spacing: 0.02em;
  }

  .visuel__sujet {
    color: var(--encre);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .visuel {
      aspect-ratio: var(--visuel-ratio-mobile, var(--visuel-ratio));
    }
  }
</style>
