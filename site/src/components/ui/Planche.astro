---
/**
 * Planche de notice : une illustration au trait livrée en masque alpha
 * (traits opaques sur fond transparent) et colorée en CSS. Elle prend donc la
 * couleur du texte qui l'entoure — bleu le jour, bleu de lune la nuit — sans
 * variante de fichier (règle 5 de docs/assets-a-generer.md).
 *
 * Deux résolutions (`image-set`), la seconde pour les écrans denses. Le
 * masque n'est appliqué qu'à l'approche de l'écran (src/scripts/planches.ts) :
 * les illustrations du bas de page ne concurrencent pas la photo de la
 * couverture au chargement. Sans JavaScript, il s'applique tout de suite.
 *
 * Décorative pour les lecteurs d'écran : le texte voisin porte le propos, la
 * légende (facultative) dit ce que montre le dessin.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { typo } from '../../lib/typo';

interface Props {
  src: ImageMetadata;
  legende?: string;
  /** Un bouton permet de rejouer l’animation du dessin. */
  anime?: boolean;
  /** Largeur d'affichage maximale, en pixels CSS : choisit les fichiers produits. */
  largeur?: number;
  /**
   * Hauteur d'affichage maximale : un dessin presque carré ne s'étire pas plus
   * haut qu'un dessin en bande. Les vignettes d'une marge gardent ainsi un
   * poids égal, et la marge ne dépasse pas le texte qu'elle accompagne.
   */
  hauteur?: number;
  class?: string;
}

const { src, legende, anime = false, largeur: largeurMax = 240, hauteur, class: classe } = Astro.props;
const largeur = hauteur ? Math.min(largeurMax, Math.round((hauteur * src.width) / src.height)) : largeurMax;

const vectoriel = src.format === 'svg';
const largeurs = [Math.min(src.width, Math.round(largeur * 1.8)), Math.min(src.width, Math.round(largeur * 2.7))];
const [normal, dense] = vectoriel
  ? [src, src]
  : await Promise.all(largeurs.map((width) => getImage({ src, width, format: 'webp', quality: 86 })));

const style = [
  `--planche-1x:url("${normal.src}")`,
  `--planche-2x:url("${dense.src}")`,
  `--planche-ratio:${src.width}/${src.height}`,
  `--planche-largeur:${largeur}px`,
].join(';');
---

<figure class:list={['planche', classe]} style={style}>
  {anime ? (
    <div class="planche__animation" data-figure-animation>
      <span class="planche__dessin" aria-hidden="true"></span>
      <button type="button" class="commande-figure planche__rejouer" data-rejouer
        aria-label={legende ? `Rejouer l’animation : ${typo(legende)}` : 'Rejouer l’animation de l’illustration'}>
        <span aria-hidden="true">↻</span>
      </button>
    </div>
  ) : <span class="planche__dessin" aria-hidden="true"></span>}
  {legende && <figcaption class="legende">{typo(legende)}</figcaption>}
</figure>

<style>
  .planche {
    width: min(100%, var(--planche-largeur));
    /* Le tracé de l'auteur : bleu le jour, bleu de lune la nuit. */
    color: var(--bleu);
  }

  .planche__dessin {
    display: block;
    width: 100%;
    aspect-ratio: var(--planche-ratio);
    background-color: currentColor;
    -webkit-mask: var(--planche-1x) center / contain no-repeat;
    mask: var(--planche-1x) center / contain no-repeat;
    -webkit-mask-image: -webkit-image-set(var(--planche-1x) 1x, var(--planche-2x) 2x);
    mask-image: image-set(var(--planche-1x) 1x, var(--planche-2x) 2x);
  }

  .planche__animation {
    position: relative;
    display: block;
  }

  .planche__rejouer { position: absolute; top: 0; right: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .planche__animation:global(.animation-en-cours) .planche__dessin { animation: planche-deployer .65s ease both; }
    @keyframes planche-deployer {
      0% { transform: scale(1); }
      55% { transform: scale(1.045); }
      100% { transform: scale(1); }
    }
  }

  /* Avec JavaScript, rien n'est téléchargé avant l'approche : la place est
     réservée par le ratio, le dessin arrive avant que le lecteur l'atteigne. */
  :global(.js) .planche__dessin:not(.est-proche) {
    background-color: transparent;
    -webkit-mask: none;
    mask: none;
  }

  @media print {
    .planche__rejouer { display: none; }
    .planche__dessin {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    :global(.js) .planche__dessin:not(.est-proche) {
      background-color: currentColor;
      -webkit-mask: var(--planche-1x) center / contain no-repeat;
      mask: var(--planche-1x) center / contain no-repeat;
    }
  }
</style>
