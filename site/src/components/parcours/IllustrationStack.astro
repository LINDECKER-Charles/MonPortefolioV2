---
/**
 * Pictos de repli des technologies sans logo officiel utilisable (CMP-10),
 * dessinés de la même main que les pictos du site : trait de 1,5 sur une
 * grille de 24, à l’encre du thème. Ils représentent la fonction de l’outil
 * et ne prétendent pas être des logos (src/assets/stacks/LISEZMOI.md).
 * Décoratifs : le lien qui les entoure porte le nom.
 *
 *   <IllustrationStack nom="SQL" taille="moyen" />
 */
export type OutilIllustre = 'SQL' | 'Axum' | 'SQLx' | 'Stockage S3 compatible' | 'Dompdf' | 'OpenTUI' | 'Make' | 'axe-core' | 'Claude' | 'Codex' | 'Kokoro' | 'Piper' | 'Nginx' | 'PHPUnit' | 'API Platform' | 'Leaflet';
interface Props {
  nom: OutilIllustre;
  taille?: 'grand' | 'moyen' | 'petit';
}
const { nom, taille = 'moyen' } = Astro.props;

/** Un dessin par fonction ; deux outils de même fonction (SQL, SQLx) se distinguent par un détail. */
const DESSINS: Record<OutilIllustre, string> = {
  SQL: 'M5 5.5c0-1.4 3.1-2.5 7-2.5s7 1.1 7 2.5-3.1 2.5-7 2.5-7-1.1-7-2.5Zm0 0v13c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-13M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5',
  SQLx: 'M4 5.5C4 4.1 6.9 3 10.5 3S17 4.1 17 5.5 14.1 8 10.5 8 4 6.9 4 5.5Zm0 0v12c0 1.4 2.9 2.5 6.5 2.5M17 5.5V10M4 11.5c0 1.4 2.9 2.5 6.5 2.5m3.5 3 2.5 2.5L21 14.5',
  Axum: 'M3.5 4h17v6h-17zM3.5 14h17v6h-17zM7 7h.01M7 17h.01M12 10v4',
  'Stockage S3 compatible': 'M4 6c0-1.4 3.6-2.5 8-2.5s8 1.1 8 2.5-3.6 2.5-8 2.5S4 7.4 4 6Zm0 0 2 12.5c.2 1.4 2.8 2.5 6 2.5s5.8-1.1 6-2.5L20 6',
  Dompdf: 'M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 15.5h6M9 9h2.5',
  OpenTUI: 'M3 4.5h18v15H3zM7 10l3 2.5L7 15M12.5 15.5H17',
  Make: 'M6 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Zm12 0a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Zm-6 12a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM7.5 8l3.3 7.8M16.5 8l-3.3 7.8',
  'axe-core': 'M12 2.7a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6ZM5 8.5l7 1.5 7-1.5M12 10v4.5m0 0-3.5 6m3.5-6 3.5 6',
  Claude: 'M4 5.5h16v10h-9l-4.5 3.5v-3.5H4zM8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01',
  Codex: 'm8 7-5 5 5 5M16 7l5 5-5 5M13.5 5l-3 14',
  Kokoro: 'M4 9.5h3.5L12 5.5v13l-4.5-4H4zM15.5 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11',
  Piper: 'M3 12h1.5M6.5 9v6M9.5 5.5v13M12.5 8v8M15.5 10v4M18.5 7v10M21 12h.01',
  Nginx: 'M8.5 5h7v14h-7zM3 12h5.5M15.5 12H21m-2.5-2.5L21 12l-2.5 2.5M11 8.5h2',
  PHPUnit: 'M9 3.5h6v3H9zM9 5H5.5v15.5h13V5H15M8.5 13.5l2.5 2.5 4.5-5',
  'API Platform': 'M12 3l7.8 4.5v9L12 21l-7.8-4.5v-9zM12 12V21M12 12l7.8-4.5M12 12 4.2 7.5',
  Leaflet: 'M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0c0 5.2-6.5 11-6.5 11ZM12 7.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z',
};
const pixels = { grand: 56, moyen: 28, petit: 18 }[taille];
---

<svg class:list={['logo-stack', 'illustration-stack', `illustration-stack--${taille}`]} viewBox="0 0 24 24" width={pixels} height={pixels} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={DESSINS[nom]} />
</svg>

<style>
  .illustration-stack { display: block; flex: none; color: var(--encre); }
  .illustration-stack--grand { width: 56px; height: 56px; }
  .illustration-stack--moyen { width: 28px; height: 28px; }
  .illustration-stack--petit { width: 18px; height: 18px; }
  :global(.techno:is(:hover, :focus-visible)) .illustration-stack { color: var(--accent); }
  @media (forced-colors: active) { .illustration-stack { color: CanvasText; } }
</style>
