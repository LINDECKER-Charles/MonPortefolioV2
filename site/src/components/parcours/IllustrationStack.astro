---
// Pictogrammes métier du portfolio, distincts des logos de marque.
export type OutilIllustre = 'SQL' | 'Axum' | 'SQLx' | 'Stockage S3 compatible' | 'Dompdf' | 'OpenTUI' | 'Make' | 'axe-core';
interface Props { nom: OutilIllustre; }
const { nom } = Astro.props;
---

<svg class="logo-stack illustration-stack" viewBox="0 0 64 64" width="32" height="32" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {nom === 'SQL' && (
    <>
      <ellipse cx="32" cy="13" rx="21" ry="8" />
      <path d="M11 13v34c0 4.4 9.4 8 21 8s21-3.6 21-8V13M11 30c0 4.4 9.4 8 21 8s21-3.6 21-8" />
      <path d="m23 43-5 4 5 4m18-8 5 4-5 4m-7-9-4 14" />
    </>
  )}
  {nom === 'Axum' && (
    <>
      <rect x="7" y="23" width="15" height="18" rx="3" />
      <rect x="42" y="6" width="15" height="15" rx="3" />
      <rect x="42" y="25" width="15" height="15" rx="3" />
      <rect x="42" y="44" width="15" height="15" rx="3" />
      <path d="M22 32h11V14h9m-9 18h9m-9 0v19h9M12 29l5 4-5 4" />
    </>
  )}
  {nom === 'SQLx' && (
    <>
      <ellipse cx="23" cy="13" rx="16" ry="7" />
      <path d="M7 13v31c0 4 7 7 16 7m16-38v18M7 29c0 4 7 7 16 7m-1-7 6 6 12-14" />
      <rect x="31" y="39" width="26" height="19" rx="3" />
      <path d="m37 44 5 4-5 4m11 0h4" />
    </>
  )}
  {nom === 'Stockage S3 compatible' && (
    <>
      <path d="M17 29H13a9 9 0 0 1-1-18 14 14 0 0 1 26-1 10 10 0 1 1 9 19h-5" />
      <path d="M17 29h30l-4 28H21l-4-28Z" />
      <path d="M24 29v-4a8 8 0 0 1 16 0v4m-10 13h8m-4-4v8" />
    </>
  )}
  {nom === 'Dompdf' && (
    <>
      <path d="M15 6h22l12 12v39H15V6Zm22 0v12h12" />
      <path d="M23 27h18m-18 7h12m-3 7v12m-5-5 5 5 5-5" />
      <path d="M10 23H6v23h4m43-23h5v23h-5" />
    </>
  )}
  {nom === 'OpenTUI' && (
    <>
      <rect x="5" y="9" width="54" height="46" rx="4" />
      <path d="M5 19h54m-46-5h1m5 0h1m5 0h1M13 28l5 4-5 4m11 0h8" />
      <rect x="12" y="43" width="18" height="5" rx="1" />
      <path d="M37 28h14m-14 7h14m-14 8h14" />
    </>
  )}
  {nom === 'Make' && (
    <>
      <path d="M13 10h13v17H13V10Zm25 0h13v17H38V10ZM20 27v10h25V27m-13 10v7" />
      <path d="m32 43 14 8-14 8-14-8 14-8Zm-14 8V39l14-8 14 8v12m-14-8V31" />
    </>
  )}
  {nom === 'axe-core' && (
    <>
      <circle cx="25" cy="12" r="5" />
      <path d="m8 23 17 4 17-4m-17 4v13m0 0L15 56m10-16 10 16" />
      <circle cx="48" cy="43" r="11" />
      <path d="m43 43 4 4 7-8" />
    </>
  )}
</svg>

<style>
  .illustration-stack { display: block; width: 32px; height: 32px; flex: 0 0 32px; color: var(--bleu); }
  @media (forced-colors: active) { .illustration-stack { color: CanvasText; } }
</style>
