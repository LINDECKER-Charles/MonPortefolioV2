<style>
  .illustration-hub {
    display: block;
    width: 100%;
    height: auto;
    color: inherit;
  }

  .illustration-hub path,
  .illustration-hub rect,
  .illustration-hub circle,
  .illustration-hub ellipse {
    vector-effect: non-scaling-stroke;
  }

  .illustration-hub__papier {
    fill: var(--hub-illustration-paper, transparent);
  }

  .illustration-hub__teinte {
    fill: currentColor;
    fill-opacity: 0.12;
    stroke: none;
  }

  .illustration-hub__plein {
    fill: currentColor;
    stroke: none;
  }

  .illustration-hub__accent {
    stroke-width: 2.2;
  }

  .illustration-hub__secondaire {
    opacity: 0.65;
    stroke-width: 1.35;
  }

  @media (max-width: 640px) {
    .illustration-hub__secondaire {
      display: none;
    }
  }

  @media (forced-colors: active) {
    .illustration-hub__papier {
      fill: Canvas;
    }

    .illustration-hub__teinte {
      fill-opacity: 0.2;
    }
  }
</style>
