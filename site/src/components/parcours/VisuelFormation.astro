<style>
  .visuel-formation {
    display: block;
    width: 100%;
    height: auto;
    color: var(--formation-visuel-encre, var(--accent));
  }

  .visuel-formation path,
  .visuel-formation rect,
  .visuel-formation circle,
  .visuel-formation ellipse {
    vector-effect: non-scaling-stroke;
  }

  .vf-papier {
    fill: var(--formation-visuel-papier, var(--surface));
  }

  .vf-teinte {
    fill: currentColor;
    fill-opacity: 0.1;
    stroke: none;
  }

  .vf-plein {
    fill: currentColor;
    stroke: none;
  }

  .vf-accent {
    stroke-width: 2.2;
  }

  .vf-scene {
    stroke-width: 2;
  }

  .vf-glyphe {
    fill: currentColor;
    stroke: none;
    font: 800 34px var(--police-texte);
  }

  .vf-secondaire {
    opacity: 0.55;
    stroke-width: 1.3;
  }

  @media (forced-colors: active) {
    .visuel-formation {
      color: CanvasText;
    }

    .vf-papier {
      fill: Canvas;
    }

    .vf-teinte {
      fill-opacity: 0.2;
    }
  }

  @media print {
    .visuel-formation {
      color: var(--accent);
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    .vf-papier {
      fill: var(--surface);
    }
  }
</style>
