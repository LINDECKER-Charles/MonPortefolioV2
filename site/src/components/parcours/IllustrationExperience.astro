<style>
  .illustration-experience { display: block; width: 100%; height: auto; color: inherit; }
  .illustration-experience path,
  .illustration-experience rect,
  .illustration-experience circle { vector-effect: non-scaling-stroke; }
  .illustration-experience__papier { fill: var(--experience-illustration-paper, var(--blanc)); }
  .illustration-experience__teinte { fill: currentColor; fill-opacity: .11; stroke: none; }
  .illustration-experience__plein { fill: currentColor; stroke: none; }
  .illustration-experience__accent { stroke-width: 2.2; }
  .illustration-experience__secondaire { opacity: .6; stroke-width: 1.2; }
  @media (forced-colors: active) {
    .illustration-experience__papier { fill: Canvas; }
    .illustration-experience__teinte { fill-opacity: .2; }
  }
</style>
