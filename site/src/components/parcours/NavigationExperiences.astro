---
interface Repere {
  id: string;
  date: string;
  titre: string;
}
interface Props { reperes: Repere[]; }
const { reperes } = Astro.props;
---

<aside class="sommaire-experiences">
  <div class="raccourcis-bureau">
    <p class="sommaire-experiences__titre">Dans ce parcours</p>
    <nav aria-label="Repères chronologiques">
      <ol role="list">
        {reperes.map((repere) => <li><a href={`#${repere.id}`} data-repere-experience>
          <span>{repere.date}</span><strong>{repere.titre}</strong>
        </a></li>)}
      </ol>
    </nav>
    <p class="sommaire-experiences__note">Du plus récent au plus ancien.</p>
  </div>
  <details class="raccourcis-mobile">
    <summary>Aller à une expérience</summary>
    <nav aria-label="Repères chronologiques">
      <ol role="list">
        {reperes.map((repere) => <li><a href={`#${repere.id}`} data-repere-experience>
          <span>{repere.date}</span><strong>{repere.titre}</strong>
        </a></li>)}
      </ol>
    </nav>
  </details>
</aside>

<script>
  const liens = [...document.querySelectorAll<HTMLAnchorElement>('[data-repere-experience]')];
  const etapes = [...document.querySelectorAll<HTMLElement>('.chronologie__etape')];
  function indiquer(id: string) {
    liens.forEach((lien) => {
      if (lien.hash === `#${id}`) lien.setAttribute('aria-current', 'location');
      else lien.removeAttribute('aria-current');
    });
  }
  let enAttente = false;
  const mettreAJour = () => {
    enAttente = false;
    const limite = window.innerHeight * .3;
    let courant = etapes[0]?.id;
    for (const etape of etapes) {
      if (etape.getBoundingClientRect().top <= limite) courant = etape.id;
    }
    if (courant) indiquer(courant);
  };
  const planifier = () => {
    if (enAttente) return;
    enAttente = true;
    window.requestAnimationFrame(mettreAJour);
  };
  mettreAJour();
  window.addEventListener('scroll', planifier, { passive: true });
  window.addEventListener('resize', planifier);
  window.addEventListener('pageshow', planifier);
  document.querySelectorAll('.experience-detail').forEach((detail) => detail.addEventListener('toggle', planifier));

  const sommaireMobile = document.querySelector<HTMLDetailsElement>('.raccourcis-mobile');
  sommaireMobile?.addEventListener('click', (evenement) => {
    if (evenement.target instanceof Element && evenement.target.closest('a[data-repere-experience]')) {
      sommaireMobile.open = false;
    }
  });
</script>

<style>
  .sommaire-experiences { position: sticky; top: calc(var(--hauteur-entete) + var(--s5)); align-self: start; }
  .sommaire-experiences__titre { margin-bottom: var(--s4); font-size: var(--t-petit); font-weight: 700; }
  ol { display: grid; gap: var(--s1); margin: 0; padding: 0; list-style: none; }
  a { display: grid; gap: 2px; min-height: 64px; padding: var(--s3) var(--s4); border-left: 2px solid var(--filet); color: var(--encre); text-decoration: none; }
  a span { font-size: var(--t-etiquette); color: var(--graphite); }
  a strong { font-size: var(--t-petit); font-weight: 500; line-height: 1.3; }
  a:hover { border-color: var(--bleu); background: var(--blanc); }
  a:hover strong { color: var(--bleu); text-decoration: underline; text-underline-offset: .2em; }
  a[aria-current='location'] { border-color: var(--bleu); background: var(--blanc); }
  a[aria-current='location'] strong { color: var(--bleu); font-weight: 700; }
  .sommaire-experiences__note { max-width: 24ch; padding: var(--s4) 0 0 var(--s4); font-size: var(--t-etiquette); color: var(--graphite); }
  .raccourcis-mobile { display: none; }
  @media (max-width: 900px) {
    .sommaire-experiences { position: static; }
    .raccourcis-bureau { display: none; }
    .raccourcis-mobile { display: block; border-block: 1px solid var(--filet); }
    summary { min-height: 48px; padding: var(--s3) var(--s2); color: var(--bleu); font-size: var(--t-petit); font-weight: 700; cursor: pointer; }
    nav { padding: var(--s2) 0 var(--s4); }
    ol { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s2); }
    a { min-height: 72px; padding: var(--s2) var(--s3); }
    a strong { font-size: .9375rem; }
  }
  @media print { .sommaire-experiences { display: none; } }
</style>
