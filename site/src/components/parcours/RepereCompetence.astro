---
/**
 * Pictos de repère de la page Compétences, au trait sur une grille de 48 :
 * le schéma « Interface ↔ API ↔ Données » (interface, backend, donnees), les
 * trois capacités de l’intégration IA (agents, mcp, voix ; CMP-09), et les
 * repères historiques des compétences humaines, remplacés dans la page par
 * les illustrations CMP-02 à CMP-08. Décoratifs, à la couleur du texte.
 */
interface Props {
  categorie:
    | 'interface'
    | 'backend'
    | 'donnees'
    | 'livraison'
    | 'pedagogie'
    | 'coordination'
    | 'ecoute'
    | 'communication'
    | 'creativite'
    | 'adaptation'
    | 'agents'
    | 'mcp'
    | 'voix';
}

const { categorie } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width="48"
  height="48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="repere-competence"
  aria-hidden="true"
  focusable="false"
>
  {categorie === 'interface' && (
    <>
      <rect x="5" y="8" width="38" height="32" rx="3" />
      <path d="M5 17h38" />
      <circle class="plein" cx="11" cy="12.5" r="1" />
      <circle class="plein" cx="16" cy="12.5" r="1" />
      <rect class="teinte" x="10" y="22" width="12" height="13" rx="1" />
      <rect x="10" y="22" width="12" height="13" rx="1" />
      <path d="M28 23h9m-9 6h9m-9 6h6" />
    </>
  )}

  {categorie === 'backend' && (
    <>
      <rect class="teinte" x="8" y="5" width="32" height="23" rx="3" />
      <rect x="8" y="5" width="32" height="23" rx="3" />
      <path d="m17 12-5 4 5 5m14-9 5 4-5 5m-5-10-4 11M24 28v7M11 35h26m-26 0v3m26-3v3" />
      <rect x="6" y="38" width="10" height="6" rx="1" />
      <rect x="32" y="38" width="10" height="6" rx="1" />
    </>
  )}

  {categorie === 'donnees' && (
    <>
      <path class="teinte" d="M5 11v23c0 3 5 5 11 5s11-2 11-5V11" />
      <path d="M5 11v23c0 3 5 5 11 5s11-2 11-5V11" />
      <ellipse cx="16" cy="11" rx="11" ry="5" />
      <path d="M5 22c0 3 5 5 11 5s11-2 11-5M31 17h11m-4-4 4 4-4 4M42 31H31m4-4-4 4 4 4" />
    </>
  )}

  {categorie === 'livraison' && (
    <>
      <path d="M7 8v33m0-18c0-8 10-7 10-15M7 35h9" />
      <circle cx="7" cy="9" r="3" />
      <circle cx="7" cy="39" r="3" />
      <circle cx="17" cy="7" r="3" />
      <path class="teinte" d="m19 25 11-5 12 5v13l-12 5-11-5V25Z" />
      <path d="m19 25 11-5 12 5v13l-12 5-11-5V25Zm0 0 11 5 12-5M30 30v13m-7-21 12 5" />
      <path d="m30 10 4 4 8-9" />
    </>
  )}

  {categorie === 'pedagogie' && (
    <>
      <path class="teinte" d="M24 14c-5-4-11-5-19-3v28c8-2 14-1 19 3V14Z" />
      <path d="M24 14c-5-4-11-5-19-3v28c8-2 14-1 19 3 5-4 11-5 19-3V11c-8-2-14-1-19 3Zm0 0v28" />
      <path d="m10 18 8 1m-8 7 8 1m-8 7 8 1m12-16 8-1m-8 9 8-1m-8 9 8-1" />
    </>
  )}

  {categorie === 'coordination' && (
    <>
      <circle cx="24" cy="9" r="4" />
      <path class="teinte" d="M16 23v-3c0-4 3-7 8-7s8 3 8 7v3H16Z" />
      <path d="M16 23v-3c0-4 3-7 8-7s8 3 8 7v3H16Zm8 0v5M11 28h26m-26 0v4m26-4v4" />
      <circle cx="11" cy="35" r="3" />
      <circle cx="37" cy="35" r="3" />
      <path d="M5 44v-1c0-3 2-5 6-5s6 2 6 5v1H5Zm26 0v-1c0-3 2-5 6-5s6 2 6 5v1H31Z" />
    </>
  )}

  {categorie === 'ecoute' && (
    <>
      <path d="M7 23v-6c0-6 4-11 10-11s11 5 11 11c0 7-4 9-8 13-2 2-2 4-3 7s-3 5-6 5c-3 0-5-2-5-5" />
      <path d="M12 18c0-4 2-6 5-6s5 3 5 6c0 5-3 5-5 7m-5-1c3-1 5 0 5 3" />
      <path class="teinte" d="M34 15h5c3 0 5 2 5 5s-2 5-5 5h-2l-5 4v-6c-2-1-3-2-3-4 0-2 2-4 5-4Z" />
      <path d="M34 15h5c3 0 5 2 5 5s-2 5-5 5h-2l-5 4v-6c-2-1-3-2-3-4 0-2 2-4 5-4Z" />
    </>
  )}

  {categorie === 'communication' && (
    <>
      <path class="teinte" d="M9 7h22c3 0 5 2 5 5v11c0 3-2 5-5 5H17l-9 7v-7c-3 0-4-2-4-5V12c0-3 2-5 5-5Z" />
      <path d="M9 7h22c3 0 5 2 5 5v11c0 3-2 5-5 5H17l-9 7v-7c-3 0-4-2-4-5V12c0-3 2-5 5-5Z" />
      <path d="M40 18c3 0 4 2 4 5v11c0 3-2 5-5 5v5l-7-5H22c-3 0-5-2-5-5M11 15h18m-18 7h12" />
    </>
  )}

  {categorie === 'creativite' && (
    <>
      <path class="teinte" d="M12 20c0-7 5-12 12-12s12 5 12 12c0 6-3 9-7 13H19c-4-4-7-7-7-13Z" />
      <path d="M12 20c0-7 5-12 12-12s12 5 12 12c0 6-3 9-7 13H19c-4-4-7-7-7-13Zm7 13h10v7H19v-7Zm2 11h6M24 33V23m-5-4 5 4 5-4M24 2v2M6 10l3 3m30 0 3-3M3 24h4m34 0h4" />
    </>
  )}

  {categorie === 'adaptation' && (
    <>
      <path d="M5 20A19 19 0 0 1 38 11m0-6v6h-6M43 28A19 19 0 0 1 10 37m0 6v-6h6" />
      <path class="teinte" d="M24 19c-3-2-6-3-10-2v14c4-1 7 0 10 2V19Z" />
      <path d="M24 19c-3-2-6-3-10-2v14c4-1 7 0 10 2 3-2 6-3 10-2V17c-4-1-7 0-10 2Zm0 0v14" />
    </>
  )}
  {categorie === 'agents' && (
    <>
      <path class="teinte" d="M6 8h28v20H20l-8 7v-7H6V8Z" />
      <path d="M6 8h28v20H20l-8 7v-7H6V8Z" />
      <path d="m14 15-3 3 3 3m12-6 3 3-3 3m-4-8-4 10" />
      <path d="M38 18h4v16h-4v5l-6-5H24v-2" />
    </>
  )}

  {categorie === 'mcp' && (
    <>
      <path class="teinte" d="M14 20h20v8a10 10 0 0 1-20 0v-8Z" />
      <path d="M14 20h20v8a10 10 0 0 1-20 0v-8ZM19 20v-9m10 9v-9M24 38v6M10 44h28" />
      <circle cx="24" cy="28" r="2.5" />
    </>
  )}

  {categorie === 'voix' && (
    <>
      <rect class="teinte" x="17" y="5" width="14" height="24" rx="7" />
      <rect x="17" y="5" width="14" height="24" rx="7" />
      <path d="M11 22a13 13 0 0 0 26 0M24 35v7m-7 0h14M5 17v8m36-8v8M44 19v4M2 19v4" />
    </>
  )}
</svg>

<style>
  .repere-competence {
    display: block;
    width: 100%;
    height: 100%;
  }

  .plein {
    fill: currentColor;
    stroke: none;
  }

  .teinte {
    fill: currentColor;
    fill-opacity: 0.08;
    stroke: none;
  }

  @media (forced-colors: active) {
    .teinte { fill-opacity: 0.15; }
  }
</style>
