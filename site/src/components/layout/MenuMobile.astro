---
import Picto from '../ui/Picto.astro';

interface Props {
  pages: { href: string; titre: string }[];
  chemin: string;
}

const { pages, chemin } = Astro.props;
const actif = (href: string) => href === '/' ? chemin === '/' : chemin === href || chemin.startsWith(`${href}/`);
---

<details class="menu-mobile" data-menu-mobile>
  <summary aria-controls="navigation-mobile">
    <span>Menu</span>
    <span class="menu-mobile__ouvrir"><Picto nom="interface/menu" /></span>
    <span class="menu-mobile__fermer"><Picto nom="interface/fermer" /></span>
  </summary>
  <nav id="navigation-mobile" aria-label="Navigation mobile">
    {pages.map(({ href, titre }) => <a href={href} aria-current={actif(href) ? 'page' : undefined}>{titre}</a>)}
  </nav>
</details>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu-mobile]');
  const commande = menu?.querySelector('summary');

  document.addEventListener('keydown', (evenement) => {
    if (evenement.key === 'Escape' && menu?.open) {
      menu.open = false;
      commande?.focus();
    }
  });
  document.addEventListener('click', (evenement) => {
    if (menu?.open && !menu.contains(evenement.target as Node)) menu.open = false;
  });
  menu?.addEventListener('click', (evenement) => {
    if ((evenement.target as Element).closest('a')) menu.open = false;
  });
  window.matchMedia('(min-width: 1100px)').addEventListener('change', (evenement) => {
    if (evenement.matches && menu) menu.open = false;
  });
</script>

<style>
  .menu-mobile { display: none; }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding-inline: 0;
    list-style: none;
    color: var(--encre);
    cursor: pointer;
    font-size: .9375rem;
    font-weight: 700;
  }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { width: 18px; height: 18px; }
  .menu-mobile__fermer { display: none; }
  .menu-mobile[open] .menu-mobile__ouvrir { display: none; }
  .menu-mobile[open] .menu-mobile__fermer { display: inline; }
  nav {
    position: absolute;
    top: calc(100% - 1px);
    left: 0;
    right: 0;
    display: grid;
    gap: 0;
    padding: var(--s3) var(--gouttiere) var(--s4);
    border-block: 1px solid var(--filet);
    background: var(--blanc);
    box-shadow: 0 16px 24px rgb(14 20 36 / .12);
  }
  a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-block: var(--s2);
    border-bottom: 1px solid var(--filet);
    color: var(--encre);
    text-decoration: none;
    font-size: 1.0625rem;
  }
  a:last-child { border-bottom: 0; }
  a[aria-current] { color: var(--bleu); font-weight: 700; }
  a[aria-current]::after { content: 'Page actuelle'; margin-left: auto; font-size: .8125rem; font-weight: 400; }
  a:hover { text-decoration: underline; }
  @media (max-width: 1099px) { .menu-mobile { display: block; } }
  @media (max-width: 760px) { summary { gap: 5px; font-size: .8125rem; } }
</style>
