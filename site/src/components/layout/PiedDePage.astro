---
/**
 * Pied de page de toutes les pages : la marque et la devise, les pages,
 * comment me trouver (l’adresse e-mail visible, à copier, LinkedIn, GitHub),
 * le site (mentions légales, archive de la V1 et CV quand ils existent, les
 * polices réellement employées), et le clin d’œil au « mode d’emploi » qui
 * a donné son nom à la première direction du site.
 *
 * Mesure : `contact-email`, `contact-copie` et `lien-sortant` (avec le nom
 * d’hôte), emplacement `pied-de-page`. L’adresse passe par CONTACT/MAILTO :
 * le serveur remplace le marqueur par l’adresse enregistrée.
 */
import CopierAdresse from '../ui/CopierAdresse.astro';
import Logo from '../ui/Logo.astro';
import { ARCHIVE_V1, CONTACT, CV, MAILTO, SITE } from '../../config/site';
import { PAGES_PRINCIPALES } from '../../config/navigation';

const annee = new Date().getFullYear();
const profils = [
  { href: CONTACT.linkedin, titre: 'LinkedIn' },
  { href: CONTACT.github, titre: 'GitHub' },
];
---

<footer class="pied">
  <div class="conteneur">
    <div class="pied__grille">
      <div class="pied__marque">
        <a class="pied__logo" href="/" aria-label={`${SITE.nom}, accueil`}><Logo /></a>
        <p class="pied__devise">Je maîtrise d’abord les règles du jeu. Ensuite, je les réinvente.</p>
      </div>

      <nav class="pied__pages" aria-label="Explorer le site">
        <h2 class="pied__titre">Pages</h2>
        <ul>
          {PAGES_PRINCIPALES.map(({ href, titre }) => <li><a href={href}>{titre}</a></li>)}
        </ul>
      </nav>

      <div class="pied__trouver">
        <h2 class="pied__titre">Me trouver</h2>
        <ul>
          <li class="pied__courriel">
            <a href={MAILTO} data-umami-event="contact-email" data-umami-event-emplacement="pied-de-page"><span data-adresse>{CONTACT.email}</span><span class="fleche" aria-hidden="true">&nbsp;↗</span></a>
            <CopierAdresse adresse={CONTACT.email} emplacement="pied-de-page" compact />
          </li>
          {
            profils.map(({ href, titre }) => (
              <li>
                <a href={href} rel="me external" data-umami-event="lien-sortant" data-umami-event-domaine={new URL(href).hostname} data-umami-event-emplacement="pied-de-page">
                  {titre}<span class="fleche" aria-hidden="true">&nbsp;↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="pied__site">
        <h2 class="pied__titre">Le site</h2>
        <ul>
          {CV && <li><a href={CV} download data-cv-telechargement="pied-de-page">Mon CV (PDF)</a></li>}
          {
            ARCHIVE_V1 && (
              <li>
                <a href={ARCHIVE_V1} rel="external" data-umami-event="lien-sortant" data-umami-event-domaine={new URL(ARCHIVE_V1).hostname} data-umami-event-emplacement="pied-de-page">
                  La première version de ce site<span class="fleche" aria-hidden="true">&nbsp;↗</span>
                </a>
              </li>
            )
          }
          <li><a href="/mentions-legales">Mentions légales</a></li>
        </ul>
        <p class="pied__colophon">Composé en Instrument Serif et Instrument Sans.</p>
      </div>
    </div>

    <div class="pied__bas">
      <p>© {annee} {SITE.nom}, {SITE.lieu}</p>
      <p class="pied__clin">Charles Lindecker, mode d’emploi&nbsp;: deuxième édition.</p>
    </div>
  </div>
</footer>

<script>
  import { brancherCv } from '../../scripts/cv';
  brancherCv();
</script>

<style>
  .pied {
    border-top: 1px solid var(--filet);
    padding-block: var(--s7) var(--s5);
    color: var(--eteint);
    font-size: var(--t-s);
  }

  .pied__grille {
    display: grid;
    grid-template-columns: 1.3fr repeat(3, 1fr);
    gap: var(--s6);
  }

  .pied__marque {
    display: grid;
    gap: var(--s3);
    align-content: start;
  }

  .pied__logo {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    min-height: 44px;
    border-radius: var(--r1);
  }

  .pied__devise {
    max-width: 22rem;
    font-family: var(--police-titre);
    font-style: italic;
    font-size: var(--t-l);
    line-height: 1.3;
    color: var(--encre);
  }

  .pied__titre {
    margin-bottom: var(--s2);
    font-family: var(--police-texte);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-petit);
    line-height: 1.5;
    color: var(--encre);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pied__pages ul {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    column-gap: var(--s6);
  }

  /* Cibles de 44 px de côté au moins (règle E7), même pour « Blog ». */
  li > a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--eteint);
    text-decoration: none;
  }

  li > a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .pied__courriel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--s3);
  }

  .pied__courriel > a {
    color: var(--encre);
    text-decoration: underline;
    text-decoration-color: var(--trait);
    overflow-wrap: anywhere;
  }

  .fleche {
    color: var(--accent);
  }

  .pied__colophon {
    margin-top: var(--s2);
    font-size: var(--t-xs);
    line-height: 1.5;
  }

  .pied__bas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s2) var(--s4);
    margin-top: var(--s6);
    padding-top: var(--s4);
    border-top: 1px solid var(--filet);
    font-size: var(--t-xs);
  }

  .pied__clin {
    font-family: var(--police-titre);
    font-style: italic;
    font-size: var(--t-s);
  }

  @media (max-width: 1100px) {
    .pied__grille {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 860px) {
    .pied {
      padding-block: var(--s5) var(--s4);
    }

    .pied__grille {
      gap: var(--s3) var(--s5);
    }

    .pied__marque,
    .pied__pages,
    .pied__trouver,
    .pied__site {
      grid-column: 1 / -1;
    }

    .pied__devise {
      display: none;
    }

    .pied__pages ul,
    .pied__site ul {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--s4);
    }

    .pied__trouver ul {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--s4);
    }

    .pied__courriel {
      flex-basis: 100%;
    }

    .pied__courriel :global(.copier--compact) {
      min-height: 44px;
      margin-block: 0;
    }

    .pied__bas {
      margin-top: var(--s5);
    }
  }

  @media print {
    .pied {
      padding-block: var(--s4) 0;
    }

    .pied__pages,
    .pied__devise {
      display: none;
    }
  }
</style>
