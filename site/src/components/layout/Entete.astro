---
/** Les pages restent à portée de main ; le sommaire appartient au récit de l’accueil. */
import Picto from '../ui/Picto.astro';
import Logo from '../ui/Logo.astro';
import MenuMobile from './MenuMobile.astro';
import { SITE } from '../../config/site';
import '../../styles/theme-transition.css';

interface Props {
  accueil?: boolean;
  chemin?: string;
}

const { accueil = false, chemin = Astro.url.pathname } = Astro.props;
const pages = [
  { href: '/', titre: 'Accueil' },
  { href: '/projets', titre: 'Projets' },
  { href: '/parcours', titre: 'Parcours' },
  { href: '/blog', titre: 'Blog' },
  { href: '/contact', titre: 'Contact' },
];
const actif = (href: string) => href === '/' ? chemin === '/' : chemin === href || chemin.startsWith(`${href}/`);
---

<header class="entete">
  <div class="wrap entete__in">
    <a class="marque" href={accueil ? '#top' : '/'} aria-label={`${SITE.nom}, ${SITE.sousTitre}`}>
      <Logo sousTitre decoratif />
    </a>
    <nav class="entete__nav" aria-label="Navigation principale">
      {pages.map(({ href, titre }) => <a href={href} aria-current={actif(href) ? 'page' : undefined}>{titre}</a>)}
    </nav>
    <div class="entete__actions">
      <a class="entete__contact-mobile" href="/contact" aria-current={actif('/contact') ? 'page' : undefined}>Contact</a>
      <button class="theme" type="button" aria-label="Mode nuit" aria-pressed="false" title="Passer en mode nuit" data-theme-bascule>
        <span class="theme__choix theme__jour" aria-hidden="true"><Picto nom="interface/soleil" /></span>
        <span class="theme__choix theme__nuit" aria-hidden="true"><Picto nom="interface/lune" /></span>
      </button>
      <MenuMobile pages={pages} chemin={chemin} />
    </div>
  </div>
</header>

<script>
  import { brancherTheme } from '../../scripts/theme';
  brancherTheme();
</script>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--voile);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--filet);
  }

  .entete__in {
    display: flex;
    align-items: center;
    gap: var(--s5);
    min-height: var(--hauteur-entete);
  }

  .marque {
    display: flex;
    align-items: center;
    min-width: 0;
    color: var(--encre);
    text-decoration: none;
    line-height: 1.2;
  }

  .entete__nav { display: flex; align-self: stretch; margin-left: auto; gap: clamp(16px, 2vw, 28px); }
  .entete__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-top: 2px;
    border-bottom: 2px solid transparent;
    color: var(--graphite);
    text-decoration: none;
    font-size: .9375rem;
    white-space: nowrap;
  }
  .entete__nav a:hover { color: var(--encre); }
  .entete__nav a[aria-current] { border-color: var(--bleu); color: var(--encre); font-weight: 700; }

  .entete__actions {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }
  .entete__contact-mobile { display: none; color: var(--encre); min-height: 44px; align-items: center; font-size: .9375rem; text-decoration: none; }
  .entete__contact-mobile:hover, .entete__contact-mobile[aria-current] { text-decoration: underline; }

  .theme {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-height: 44px;
    width: 64px;
    padding: 0;
    isolation: isolate;
    border: 0;
    border-radius: 18px;
    background: transparent;
    color: var(--graphite);
    cursor: pointer;
  }
  .theme::before {
    content: '';
    position: absolute;
    z-index: -2;
    inset: 6px 0;
    border: 1px solid var(--filet);
    border-radius: 16px;
    background: var(--papier);
  }
  .theme::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: 10px;
    left: 4px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bleu);
    transform: translateX(0);
    transition: transform .28s cubic-bezier(.2, .8, .2, 1);
  }
  .theme:hover::before { border-color: var(--bleu); }
  .theme:focus-visible { border-radius: 18px; }
  .theme__choix { display: inline-flex; align-items: center; justify-content: center; width: 50%; }
  .theme__choix :global(svg) { width: 16px; height: 16px; }
  .theme__jour { color: var(--sur-bleu); }
  :global(:root[data-theme='nuit']) .theme::after { transform: translateX(32px); }
  :global(:root[data-theme='nuit']) .theme__jour { color: var(--graphite); }
  :global(:root[data-theme='nuit']) .theme__nuit { color: var(--sur-bleu); }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .theme::after { transform: translateX(32px); }
    :global(:root:not([data-theme])) .theme__jour { color: var(--graphite); }
    :global(:root:not([data-theme])) .theme__nuit { color: var(--sur-bleu); }
  }

  @media (max-width: 1099px) {
    .entete__nav { display: none; }
    .entete__actions { margin-left: auto; }
    .entete__contact-mobile { display: inline-flex; }
  }

  @media (max-width: 760px) {
    .entete__in { gap: var(--s2); }
    .entete__actions { gap: var(--s2); }
    .marque :global(.logo__symbole) { width: 34px; }
    .marque :global(.logo__identite) { display: none; }
    .entete__contact-mobile { font-size: .8125rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme::after { transition: none; }
  }
  @media print {
    .entete {
      position: static;
      backdrop-filter: none;
    }

    .entete__actions, .entete__nav {
      display: none;
    }
  }
</style>
