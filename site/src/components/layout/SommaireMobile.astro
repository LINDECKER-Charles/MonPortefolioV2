---
/**
 * Le sommaire à portée de pouce : sous 1100 px, le repère de lecture de la
 * marge n'a pas la place d'exister. Un bouton de l'en-tête ouvre la liste des
 * chapitres, le chapitre en cours marqué comme dans le repère du bureau.
 *
 * API Popover : fermeture par Échap, par un clic en dehors ou par le choix
 * d'un chapitre ; le bouton expose son état (ouvert, fermé). Un navigateur
 * sans Popover ne montre ni le bouton ni la liste : le sommaire de la page
 * reste là.
 */
import Picto from '../ui/Picto.astro';
import { CHAPITRES } from '../../config/chapitres';
---

<button
  class="bouton-icone sommaire-bouton"
  type="button"
  popovertarget="sommaire-mobile"
  aria-label="Sommaire"
  title="Sommaire"
>
  <Picto nom="interface/sommaire" />
</button>

<nav id="sommaire-mobile" class="sommaire-mobile" popover aria-label="Sommaire du mode d’emploi">
  <p class="sommaire-mobile__titre" aria-hidden="true">Sommaire</p>
  <ol>
    {
      CHAPITRES.map((c) => (
        <li>
          <a href={`#${c.id}`} data-repere={c.id}>
            <span class="sommaire-mobile__num">{c.num}</span>
            <span>{c.titre}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const liste = document.getElementById('sommaire-mobile');
  liste?.addEventListener('click', (evenement) => {
    if ((evenement.target as Element).closest('a')) liste.hidePopover();
  });
</script>

<style>
  .sommaire-bouton,
  .sommaire-mobile {
    display: none;
  }

  @supports selector(:popover-open) {
    @media (max-width: 1099px) {
      .sommaire-bouton {
        display: inline-grid;
      }
    }

    .sommaire-mobile:popover-open {
      display: block;
    }
  }

  .sommaire-mobile {
    /* Sous l'en-tête, contre le bord droit : là où le pouce vient de toucher. */
    position: fixed;
    inset: auto var(--gouttiere) auto auto;
    top: calc(var(--hauteur-entete) + var(--s2));
    width: min(20rem, calc(100vw - 2 * var(--gouttiere)));
    max-height: calc(100dvh - var(--hauteur-entete) - var(--s5));
    overflow: auto;
    margin: 0;
    padding: var(--s4) var(--s4) var(--s3);
    border: 1px solid var(--filet);
    border-top: 4px solid var(--bleu);
    border-radius: var(--rayon);
    background: var(--blanc);
    color: var(--encre);
    box-shadow: 0 12px 32px rgb(20 22 27 / 0.16);
  }

  .sommaire-mobile::backdrop {
    background: rgb(14 20 36 / 0.18);
  }

  .sommaire-mobile__titre {
    font-size: var(--t-petit);
    font-weight: 700;
    color: var(--graphite);
    margin-bottom: var(--s2);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--filet);
  }

  a {
    display: flex;
    gap: 0.75em;
    align-items: center;
    min-height: 48px;
    padding: 6px 0 6px 16px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--encre);
    text-decoration: none;
    font-weight: 500;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  a[aria-current] {
    font-weight: 700;
    border-left-color: var(--bleu);
  }

  .sommaire-mobile__num {
    min-width: 1ch;
    color: var(--graphite);
    font-variant-numeric: tabular-nums;
  }
</style>
