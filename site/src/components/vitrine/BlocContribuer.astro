---
/**
 * « Contribuer » (#contribuer) : les deux projets ouverts aux contributions,
 * avec leur guide, puis tous les dépôts publics. Un acte de veille, la nuit
 * dans le jour. Les liens sont l’invitation open source du plan de marquage
 * (objectif O3 : `lien-sortant`, emplacement `discutons`, domaine
 * github.com). Le titre est la zone éclairée de l’écran (halo de lanterne).
 * Sur ordinateur, l’illustration PRJ-11 (une bande en 3:1) descend au pied
 * de la colonne du titre, alignée sur la fin de la liste ; sur mobile, elle
 * ferme le bloc en 3:2. Contenu : config/vitrine.ts (CONTRIBUER).
 */
import LienAction from '../ui/LienAction.astro';
import Visuel from '../ui/Visuel.astro';
import { CONTRIBUER, TOUS_LES_DEPOTS } from '../../config/vitrine';
import { typo } from '../../lib/typo';
---

<section class="contribuer conteneur" id="contribuer" aria-labelledby="contribuer-titre">
  <div class="contribuer__bloc acte-veille">
    <div class="contribuer__tete foyer">
      <h2 id="contribuer-titre">Contribuer</h2>
      <p class="chapeau">Deux projets ouverts aux contributions, avec leur guide.</p>
    </div>
    <ul class="contribuer__liste">
      {
        CONTRIBUER.map((projet) => (
          <li>
            <h3>{projet.nom}</h3>
            <p>{typo(projet.texte)}</p>
            <LienAction href={projet.lien.href} emplacement="discutons">{projet.lien.libelle}</LienAction>
          </li>
        ))
      }
      <li class="contribuer__tous">
        <LienAction href={TOUS_LES_DEPOTS} emplacement="discutons">Tous mes dépôts publics</LienAction>
      </li>
    </ul>
    <Visuel id="PRJ-11" alt="" acte sizes="(max-width: 860px) 100vw, 560px" class="contribuer__visuel" />
  </div>
</section>

<style>
  .contribuer {
    padding-top: var(--s6);
  }

  .contribuer__bloc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'tete liste'
      'visuel liste';
    gap: var(--s5) var(--s8);
    padding: clamp(24px, 4vw, 56px);
    border-radius: var(--r2);
  }

  h2 {
    font-size: var(--t-2xl);
  }

  .chapeau {
    margin-top: var(--s3);
    color: var(--eteint);
  }

  .contribuer__tete {
    grid-area: tete;
  }

  .contribuer__bloc :global(.contribuer__visuel) {
    grid-area: visuel;
    align-self: end;
    width: 100%;
  }

  .contribuer__liste {
    grid-area: liste;
    display: grid;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contribuer__liste li {
    padding-block: var(--s4);
    border-top: 1px solid var(--filet);
  }

  .contribuer__liste li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  h3 {
    font-size: var(--t-xl);
    line-height: 1.1;
  }

  .contribuer__liste p {
    margin-block: var(--s2) var(--s1);
    max-width: 44ch;
    font-size: var(--t-s);
    line-height: 1.5;
    color: var(--eteint);
  }

  .contribuer__tous :global(.lien-action) {
    font-size: var(--t-s);
  }

  @media (max-width: 860px) {
    .contribuer__bloc {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas:
        'tete'
        'liste'
        'visuel';
      gap: var(--s5);
    }
  }
</style>
