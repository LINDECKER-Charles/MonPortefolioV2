---
/**
 * « Aussi » : quatre projets publics sans page dédiée, en une rangée
 * compacte (deux colonnes sur mobile). Chacun : son emplacement de visuel
 * (PRJ-06 à PRJ-10), son nom, une phrase, ses liens publics mesurés en
 * `lien-sortant`. Contenu : config/vitrine.ts (AUSSI).
 */
import LienAction from '../ui/LienAction.astro';
import Visuel from '../ui/Visuel.astro';
import { AUSSI } from '../../config/vitrine';
import { typo } from '../../lib/typo';
---

<section class="aussi conteneur" id="aussi" aria-labelledby="aussi-titre">
  <div class="aussi__tete">
    <h2 id="aussi-titre">Aussi</h2>
    <p class="petit">Des projets publics, sans page dédiée.</p>
  </div>
  <ul class="aussi__liste">
    {
      AUSSI.map((projet) => (
        <li class="aussi__projet" id={projet.id}>
          <Visuel id={projet.visuel} alt="" sizes="(max-width: 860px) 45vw, 300px" class="aussi__visuel" />
          <h3>{projet.nom}</h3>
          <p>{typo(projet.description)}</p>
          <div class="aussi__liens">
            {projet.liens.map((lien) => <LienAction href={lien.href} emplacement="preuves">{lien.libelle}</LienAction>)}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .aussi {
    padding-top: var(--s8);
  }

  .aussi__tete {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s4);
    margin-bottom: var(--s5);
  }

  h2 {
    font-size: var(--t-2xl);
  }

  .aussi__liste {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s6) var(--s5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .aussi__projet {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    min-width: 0;
  }

  .aussi__projet :global(.aussi__visuel) {
    width: 100%;
    margin-bottom: var(--s2);
  }

  h3 {
    padding-top: var(--s3);
    border-top: 1px solid var(--trait);
    font-size: var(--t-xl);
    line-height: 1.1;
  }

  .aussi__projet p {
    font-size: var(--t-s);
    line-height: 1.5;
    color: var(--eteint);
  }

  .aussi__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s4);
    margin-top: auto;
  }

  .aussi__liens :global(.lien-action) {
    font-size: var(--t-s);
  }

  @media (max-width: 1100px) {
    .aussi__liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .aussi__liste {
      gap: var(--s5) var(--s4);
    }

    h3 {
      font-size: var(--t-l);
    }

    .aussi__projet p {
      font-size: var(--t-xs);
    }

    .aussi__liens :global(.lien-action) {
      font-size: var(--t-xs);
    }
  }
</style>
