---
/**
 * Rédaction : une feuille qui ressemble à l’article publié (server/blog.mjs) :
 * le titre en Instrument Serif, le résumé en chapeau juste dessous, puis le
 * texte à la mesure de l’article (.blog-editor-content reprend la
 * typographie de .blog-prose). C’est la zone éclairée de l’écran.
 *
 * Barre d’outils : carrés de 44 px pour les marques et les listes (nom
 * accessible par aria-label, info-bulle par title, état par aria-pressed),
 * libellés pour Lien, Image et Tableau, menus repliés pour le reste.
 * scripts/blog-editor.ts branche chaque `[data-editor]` et tient leurs états
 * (pressé, désactivé) à jour.
 */
const ICONES = {
  puces: 'M3 5a1 1 0 1 0 2 0a1 1 0 1 0-2 0M3 10a1 1 0 1 0 2 0a1 1 0 1 0-2 0M3 15a1 1 0 1 0 2 0a1 1 0 1 0-2 0M8 5h9M8 10h9M8 15h9',
  numeros: 'M3.2 3.6 4.4 3v4.2M3 8.9c.2-.5.7-.8 1.2-.8.6 0 1.1.4 1.1 1 0 .9-2.3 1.6-2.3 2.9h2.4M3 13.2c.3-.4.7-.6 1.2-.6.6 0 1.1.4 1.1 1s-.5 1-1.1 1c.7 0 1.2.4 1.2 1s-.5 1.1-1.2 1.1c-.5 0-1-.2-1.3-.6M8 5h9M8 10h9M8 15h9',
  lien: 'M8.5 11.5a3 3 0 0 0 4.2 0l2.6-2.6a3 3 0 0 0-4.2-4.2l-.9.9M11.5 8.5a3 3 0 0 0-4.2 0l-2.6 2.6a3 3 0 0 0 4.2 4.2l.9-.9',
  image: 'M4.5 4h11A1.5 1.5 0 0 1 17 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 14.5v-9A1.5 1.5 0 0 1 4.5 4ZM3.5 14l4-4 3 3 2-2 4 4M12 8a1 1 0 1 0 2 0a1 1 0 1 0-2 0',
  tableau: 'M4.5 4h11A1.5 1.5 0 0 1 17 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 14.5v-9A1.5 1.5 0 0 1 4.5 4ZM3 8h14M3 12h14M8 4v12M12.5 4v12',
  annuler: 'M7.5 4.5 4 8l3.5 3.5M4 8h8a4 4 0 0 1 0 8H9',
  retablir: 'M12.5 4.5 16 8l-3.5 3.5M16 8H8a4 4 0 0 0 0 8h3',
} as const;
---

<section class="blog-page blog-feuille foyer" data-blog-page="redaction" aria-label="Rédaction de l’article">
  <div class="blog-field blog-title-field">
    <label for="blog-title">Titre de l’article</label>
    <input id="blog-title" maxlength="160" required placeholder="Le sujet que vous voulez partager" />
  </div>

  <div class="blog-field blog-excerpt-field">
    <label for="blog-excerpt">Résumé</label>
    <textarea id="blog-excerpt" rows="2" maxlength="500" aria-describedby="blog-excerpt-help" placeholder="Ce que le lecteur va découvrir"></textarea>
    <p class="bo-help" id="blog-excerpt-help">Le chapeau de l’article&nbsp;: il ouvre la page publiée et présente l’article dans la liste du blog.</p>
  </div>

  <div class="blog-field blog-content-field">
    <label id="blog-content-label">Contenu de l’article</label>
    <div class="blog-editor-frame">
      <div class="blog-toolbar" role="group" aria-label="Mise en forme du texte">
        <div class="blog-toolbar-group">
          <label for="blog-block" class="bo-sr">Style du paragraphe</label>
          <select id="blog-block"><option value="paragraph">Paragraphe</option><option value="2">Titre 2</option><option value="3">Titre 3</option><option value="4">Titre 4</option><option value="code">Bloc de code</option></select>
        </div>
        <div class="blog-toolbar-group">
          <button class="blog-outil blog-outil--carre" type="button" data-editor="bold" aria-pressed="false" aria-label="Gras" title="Gras"><span class="blog-glyphe blog-glyphe--gras" aria-hidden="true">G</span></button>
          <button class="blog-outil blog-outil--carre" type="button" data-editor="italic" aria-pressed="false" aria-label="Italique" title="Italique"><span class="blog-glyphe blog-glyphe--italique" aria-hidden="true">I</span></button>
          <button class="blog-outil blog-outil--carre" type="button" data-editor="underline" aria-pressed="false" aria-label="Souligné" title="Souligné"><span class="blog-glyphe blog-glyphe--souligne" aria-hidden="true">S</span></button>
        </div>
        <div class="blog-toolbar-group">
          <button class="blog-outil blog-outil--carre" type="button" data-editor="bulletList" aria-pressed="false" aria-label="Liste" title="Liste à puces"><svg class="blog-icone" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d={ICONES.puces} /></svg></button>
          <button class="blog-outil blog-outil--carre" type="button" data-editor="orderedList" aria-pressed="false" aria-label="Liste numérotée" title="Liste numérotée"><svg class="blog-icone" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d={ICONES.numeros} /></svg></button>
        </div>
        <div class="blog-toolbar-group">
          <button class="blog-outil" type="button" id="blog-link"><svg class="blog-icone" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d={ICONES.lien} /></svg>Lien</button>
          <button class="blog-outil" type="button" id="blog-insert-image"><svg class="blog-icone" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d={ICONES.image} /></svg>Image</button>
          <button class="blog-outil" type="button" data-editor="table"><svg class="blog-icone" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d={ICONES.tableau} /></svg>Tableau</button>
        </div>
        <details class="blog-toolbar-more">
          <summary class="blog-outil">Autres formats</summary>
          <div class="blog-toolbar-menu">
            <button class="blog-outil" type="button" data-editor="strike" aria-pressed="false"><s>Barré</s></button>
            <button class="blog-outil" type="button" data-editor="code" aria-pressed="false">Code</button>
            <button class="blog-outil" type="button" data-editor="blockquote" aria-pressed="false">Citation</button>
            <button class="blog-outil" type="button" data-editor="unlink">Retirer le lien</button>
            <button class="blog-outil" type="button" data-editor="horizontalRule">Séparateur</button>
            <label for="blog-align" class="bo-sr">Alignement du paragraphe</label>
            <select id="blog-align"><option value="left">Aligner à gauche</option><option value="center">Centrer</option><option value="right">Aligner à droite</option><option value="justify">Justifier</option></select>
          </div>
        </details>
        <details class="blog-toolbar-more">
          <summary class="blog-outil">Modifier le tableau</summary>
          <div class="blog-toolbar-menu">
            <button class="blog-outil" type="button" data-editor="addRowAfter">Ajouter une ligne</button>
            <button class="blog-outil" type="button" data-editor="addColumnAfter">Ajouter une colonne</button>
            <button class="blog-outil" type="button" data-editor="deleteRow">Retirer la ligne</button>
            <button class="blog-outil" type="button" data-editor="deleteColumn">Retirer la colonne</button>
            <button class="blog-outil" type="button" data-editor="deleteTable">Retirer le tableau</button>
          </div>
        </details>
        <div class="blog-toolbar-group blog-toolbar-history">
          <button class="blog-outil blog-outil--carre" type="button" data-editor="undo" aria-label="Annuler" title="Annuler"><svg class="blog-icone" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d={ICONES.annuler} /></svg></button>
          <button class="blog-outil blog-outil--carre" type="button" data-editor="redo" aria-label="Rétablir" title="Rétablir"><svg class="blog-icone" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d={ICONES.retablir} /></svg></button>
        </div>
      </div>
      <div id="blog-editor"></div>
    </div>
    <p class="blog-writing-meta" id="blog-word-count">0 mot</p>
  </div>
</section>
