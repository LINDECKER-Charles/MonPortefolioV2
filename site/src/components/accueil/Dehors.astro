---
/**
 * En dehors du code : la personnalité, en annexe. Une touche, pas le décor
 * (brief § 5) : quatre entrées au pictogramme, et une remarque au stylo.
 */
import Picto from '../ui/Picto.astro';
import { DEMOS } from '../../config/site';
---

<div class="annexe">
  <article class="entree">
    <Picto nom="cartes" class="entree__picto" />
    <div>
      <h3>Gwent</h3>
      <p>Le jeu de cartes sur lequel j’ai appris à regarder mes défaites en face. J’entre au classement mondial avec une stratégie à contre-courant, puis passe plusieurs fois dans le top&nbsp;500.</p>
    </div>
  </article>
  <article class="entree">
    <Picto nom="lune" class="entree__picto" />
    <div>
      <h3>Bloodborne</h3>
      <p>
        Mon jeu préféré, et le point de départ de Bloodborne Legendary Run. Je développe une application compagnon
        sur Android, avec une API .NET et 990&nbsp;succès à débloquer.
      </p>
    </div>
  </article>
  <article class="entree">
    <Picto nom="saxophone" class="entree__picto" />
    <div>
      <h3>Shreksophone</h3>
      <p>
        Un projet qui tient en une phrase&nbsp;: on clique, Shrek joue du saxophone. Celui-ci, je l’ai fait pour le plaisir de l’absurde.
        {
          DEMOS.shreksophone ? (
            <a
              href={DEMOS.shreksophone}
              data-umami-event="lien-sortant"
              data-umami-event-domaine={new URL(DEMOS.shreksophone).hostname}
              data-umami-event-emplacement="dehors"
            >
              Essayer Shreksophone
            </a>
          ) : (
            <a
              href="https://github.com/LINDECKER-Charles/ShrekSophone"
              data-umami-event="lien-sortant"
              data-umami-event-domaine="github.com"
              data-umami-event-emplacement="dehors"
            >
              Voir son code
            </a>
          )
        }
      </p>
    </div>
  </article>
  <article class="entree">
    <Picto nom="cadenas" class="entree__picto" />
    <div>
      <h3>Root Me</h3>
      <p>
        Je pratique aussi la sécurité offensive sur les exercices de Root Me, en dehors du travail.
        <a
          href="https://www.root-me.org/HexAnti?lang=fr"
          data-umami-event="lien-sortant"
          data-umami-event-domaine="www.root-me.org"
          data-umami-event-emplacement="dehors">Voir mon profil</a
        >
      </p>
    </div>
  </article>
</div>
<p class="note dehors__sommeil">Je garde une place pour les projets qu’on fait simplement par plaisir.</p>

<style>
  .annexe {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s7);
    margin-top: var(--s7);
  }

  .entree {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    column-gap: var(--s5);
    align-items: start;
  }

  .entree :global(.entree__picto) {
    width: 48px;
    height: 48px;
    color: var(--bleu);
  }

  h3 {
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: 0;
    padding-top: 0.25rem;
  }

  p {
    margin-top: var(--s2);
    max-width: 30rem;
  }

  .dehors__sommeil {
    margin-top: var(--s7);
  }

  @media (min-width: 700px) {
    .annexe {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
