---
/**
 * Une lanterne allumée en allume d’autres (ACC-14,
 * src/assets/visuels/accueil/ACC-14.svg) : la première lanterne vacille,
 * une étincelle allume la deuxième, puis la troisième. Gardée le 13/10/2026 ;
 * la lanterne du logo devient le motif du collectif. La scène se joue à son
 * arrivée dans l’écran, puis se rejoue au clic ou au clavier
 * (scripts/figure-animations.ts). Au repos, et sans mouvement : les trois
 * lanternes allumées.
 *
 * Le dessin est le fichier du registre, inséré dans la page : ses calques
 * (`lt-lumiere`, `lt-particule`, `lt-metal`…) suivent les jetons.
 */
import dessin from '../../assets/visuels/accueil/ACC-14.svg?raw';

const legende = 'Une lanterne allumée en allume d’autres.';
const svg = dessin
  .replace(/<title>[\s\S]*?<\/title>/, '')
  .replace(/<svg\b[^>]*>/, '<svg class="lanternes__dessin" viewBox="0 0 320 240" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">');
---

<figure class="lanternes" data-scene="lanternes">
  <button type="button" class="lanternes__plan" data-rejouer data-figure-animation aria-label={`Rejouer l’animation : ${legende}`}>
    <Fragment set:html={svg} />
  </button>
  <figcaption class="lanternes__legende">{legende}</figcaption>
</figure>

<style>
  .lanternes {
    margin: 0;
  }

  .lanternes__plan {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--r2);
    background: transparent;
    color: var(--encre);
  }

  .lanternes__plan :global(.lanternes__dessin) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .lanternes__plan :global(.lt-metal) {
    fill: color-mix(in srgb, var(--trait) 24%, var(--surface));
  }

  .lanternes__plan :global(.lt-verre),
  .lanternes__plan :global(.lt-bruleur) {
    fill: var(--surface);
  }

  .lanternes__plan :global(.lt-verre),
  .lanternes__plan :global(.lt-reflet),
  .lanternes__plan :global(.lt-sol),
  .lanternes__plan :global(.lt-trajet),
  .lanternes__plan :global(.lt-hachure) {
    stroke: var(--trait);
  }

  .lanternes__plan :global(.lt-gravure) {
    stroke: var(--eteint);
  }

  .lanternes__plan :global(.lt-halo) {
    fill: var(--lanterne);
    opacity: 0.2;
  }

  .lanternes__plan :global(.lt-rayons) {
    stroke: var(--laiton);
  }

  .lanternes__plan :global(.lt-flamme) {
    fill: var(--lanterne);
    stroke: var(--laiton);
  }

  .lanternes__plan :global(.lt-coeur) {
    fill: var(--lanterne-survol);
  }

  .lanternes__plan :global(.lt-particule) {
    fill: var(--lanterne);
    opacity: 0;
  }

  .lanternes__legende {
    margin-top: var(--s2);
    font-family: var(--police-titre);
    font-style: italic;
    font-size: var(--t-m);
    color: var(--eteint);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lanternes__plan:global(.animation-en-cours) :global(.lt-lumiere--source) {
      animation: lanternes-source 2.7s ease both;
    }

    .lanternes__plan:global(.animation-en-cours) :global(.lt-lumiere--relais) {
      animation: lanternes-allumer 1s 0.8s ease both;
    }

    .lanternes__plan:global(.animation-en-cours) :global(.lt-lumiere--suite) {
      animation: lanternes-allumer 1s 1.7s ease both;
    }

    .lanternes__plan:global(.animation-en-cours) :global(.lt-particule--premiere) {
      animation: lanternes-transmettre-premiere 1s 0.15s ease-in-out both;
    }

    .lanternes__plan:global(.animation-en-cours) :global(.lt-particule--seconde) {
      animation: lanternes-transmettre-seconde 1s 1.05s ease-in-out both;
    }

    @keyframes lanternes-source {
      0% { opacity: 0.55; }
      18%, 100% { opacity: 1; }
    }

    @keyframes lanternes-allumer {
      0%, 10% { opacity: 0; }
      50% { opacity: 0.8; }
      70% { opacity: 0.6; }
      100% { opacity: 1; }
    }

    @keyframes lanternes-transmettre-premiere {
      0% { opacity: 0; transform: translate(70px, 127px); }
      15% { opacity: 1; }
      38% { transform: translate(104px, 101px); }
      65% { transform: translate(136px, 111px); }
      85% { opacity: 1; }
      100% { opacity: 0; transform: translate(158px, 149px); }
    }

    @keyframes lanternes-transmettre-seconde {
      0% { opacity: 0; transform: translate(160px, 149px); }
      15% { opacity: 1; }
      38% { transform: translate(188px, 120px); }
      65% { transform: translate(225px, 120px); }
      85% { opacity: 1; }
      100% { opacity: 0; transform: translate(258px, 149px); }
    }
  }

  @media print {
    .lanternes__plan :global(.lt-particule) {
      display: none;
    }
  }
</style>
