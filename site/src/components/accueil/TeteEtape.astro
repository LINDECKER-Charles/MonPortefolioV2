---
/**
 * La tête d'une étape : son repère de temps (facultatif) et son titre.
 */
interface Props {
  titre: string;
  quand?: string;
}

const { titre, quand } = Astro.props;
---

<div class="tete">
  {quand && <p class="tete__quand">{quand}</p>}
  <h3>{titre}</h3>
</div>

<style>
  .tete {
    margin-bottom: var(--s4);
  }

  .tete__quand {
    font-weight: 500;
    font-size: .9375rem;
    color: var(--bleu);
  }

  h3 {
    font-size: clamp(1.65rem, 2.3vw, 2.25rem);
    line-height: 1.1;
    margin-top: 0.35em;
    letter-spacing: -0.025em;
  }
</style>
