---
/**
 * Comment le pôle francophone avance : accueillir, former et relire, puis
 * laisser contribuer en autonomie (réponses C6 et C7). Trois scènes du
 * registre (ACC-21 à ACC-23) : chacune s’allume depuis sa lanterne à son
 * arrivée, puis se rejoue au clic ou au clavier (components/accueil/Scene).
 */
import Scene from './Scene.astro';

const etapes = [
  { titre: 'Accueillir', resume: 'Donner une place aux nouveaux.', visuel: 'ACC-21', nom: 'pole-accueillir', lumiere: [46, 24] },
  { titre: 'Former et relire', resume: 'Apprendre en contribuant.', visuel: 'ACC-22', nom: 'pole-former', lumiere: [50, 56] },
  { titre: 'Contribuer en autonomie', resume: 'Devenir un pilier du pôle.', visuel: 'ACC-23', nom: 'pole-autonomie', lumiere: [30, 48] },
] as const;
---

<figure class="collectif" id="fig-2">
  <p class="collectif__titre">Comment le pôle francophone avance</p>
  <ol class="collectif__etapes">
    {etapes.map((etape, i) => (
      <li class="collectif__etape">
        <Scene id={etape.visuel} nom={etape.nom} legende={etape.titre} lumiere={etape.lumiere} muette sizes="(max-width: 640px) 140px, 340px" class="collectif__scene" />
        <p class="collectif__nom"><span class="collectif__rang" aria-hidden="true">{i + 1}</span>{etape.titre}</p>
        <p class="collectif__resume">{etape.resume}</p>
      </li>
    ))}
  </ol>
  <figcaption class="collectif__legende">Accueillir, transmettre, puis laisser contribuer en autonomie&nbsp;: le fonctionnement du pôle.</figcaption>
</figure>

<style>
  .collectif {
    margin: 0;
  }

  .collectif__titre {
    font-size: var(--t-s);
    font-weight: 600;
    color: var(--encre);
  }

  .collectif__etapes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s6);
    margin: var(--s4) 0 0;
    padding: 0;
    list-style: none;
  }

  .collectif__etape {
    position: relative;
    min-width: 0;
  }

  /* La flèche du passage d’une étape à la suivante, entre deux scènes. */
  .collectif__etape + .collectif__etape::before {
    content: '→';
    position: absolute;
    top: calc((100% - 4.5rem) / 2);
    left: calc(-1 * var(--s6) / 2 - 0.6rem);
    width: 1.2rem;
    font-size: var(--t-l);
    line-height: 1;
    text-align: center;
    color: var(--laiton);
  }

  .collectif__nom {
    display: flex;
    align-items: baseline;
    gap: var(--s2);
    margin-top: var(--s3);
    font-family: var(--police-titre);
    font-size: var(--t-xl);
    line-height: 1.1;
    color: var(--encre);
  }

  .collectif__rang {
    font-family: var(--police-texte);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--eteint);
    font-variant-numeric: tabular-nums;
  }

  .collectif__resume {
    margin-top: var(--s1);
    font-size: var(--t-s);
    color: var(--eteint);
  }

  .collectif__legende {
    margin-top: var(--s4);
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  @media (max-width: 640px) {
    .collectif__etapes {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .collectif__etape {
      display: grid;
      grid-template-columns: 140px minmax(0, 1fr);
      column-gap: var(--s4);
      align-items: center;
      padding-block: var(--s4);
    }

    .collectif__etape + .collectif__etape {
      border-top: 1px solid var(--filet);
    }

    .collectif__etape + .collectif__etape::before {
      content: '↓';
      top: -0.7rem;
      left: 60px;
      padding-inline: var(--s1);
      background: var(--fond);
    }

    .collectif__etape :global(.collectif__scene) {
      grid-row: 1 / 3;
    }

    .collectif__nom {
      align-self: end;
      margin-top: 0;
      font-size: var(--t-l);
    }

    .collectif__resume {
      align-self: start;
    }
  }
</style>
