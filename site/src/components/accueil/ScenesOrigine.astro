<style>
  .scene-origine { display: block; width: 100%; height: auto; color: var(--bleu); }
  .origine-papier { fill: var(--blanc); }
  .origine-doux { stroke: var(--trait-doux); }
  .origine-lavage { fill: color-mix(in srgb, var(--bleu) 7%, var(--blanc)); }
  .plastique { fill: color-mix(in srgb, var(--bleu) 5%, transparent); }
  .origine-reflet { stroke: var(--bleu); opacity: .36; }
  .battant-gauche { transform-origin: 98px 194px; transform: skewY(12deg) scaleX(.42); }
  .battant-droit { transform-origin: 222px 194px; transform: skewY(-12deg) scaleX(.42); }

  @media (prefers-reduced-motion: no-preference) {
    :global(.animation-en-cours) .pc-panneau { animation: pc-panneau 2.2s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .pc-carte-mere { animation: pc-carte-mere 2.2s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .pc-disque { animation: pc-disque 2.2s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .pc-vis { animation: pc-vis 2.2s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .pc-guides { animation: pc-guides 2.2s ease both; }
    :global(.animation-en-cours) .carte-a-plastifier { animation: carte-plastifier 2.1s cubic-bezier(.45,0,.2,1) both; }
    :global(.animation-en-cours) .origine-reflet { animation: plastique-reflet 2.1s ease both; }
    :global(.animation-en-cours) .battant-gauche { animation: ouvrir-gauche 1.8s cubic-bezier(.45,0,.2,1) both; }
    :global(.animation-en-cours) .battant-droit { animation: ouvrir-droit 1.8s cubic-bezier(.45,0,.2,1) both; }
    :global(.animation-en-cours) .porte-horizon { animation: porte-horizon 1.8s ease both; }
    :global(.animation-en-cours) .dossier { animation: dossier-empiler 1.8s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .dossier--2 { animation-delay: .18s; }
    :global(.animation-en-cours) .dossier--3 { animation-delay: .36s; }
    :global(.animation-en-cours) .diplome-chrono { animation: chrono-poser 2.2s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .diplome-aiguilles { transform-origin: 299px 211px; animation: chrono-tourner 2.2s cubic-bezier(.45,0,.2,1) both; }
    :global(.animation-en-cours) .diplome-document { animation: diplome-poser 2.2s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .diplome-ruban { transform-origin: 554px 482px; animation: ruban-derouler 2.2s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .diplome-sceau { transform-origin: 554px 482px; animation: sceau-nouer 2.2s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .scene-tableau { animation: tableau-monter 2.2s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .scene-pupitre { animation: pupitre-monter 2.2s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .scene-formateur { animation: formateur-monter 2.2s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .scene-public { animation: public-monter 1.7s cubic-bezier(.22,.61,.36,1) both; }
    :global(.animation-en-cours) .scene-public--1 { animation-delay: .25s; }
    :global(.animation-en-cours) .scene-public--2 { animation-delay: .4s; }
    :global(.animation-en-cours) .scene-public--3 { animation-delay: .55s; }

    @keyframes pc-panneau { 0%, 12% { transform: translate(146px, -25px); } 85%, 100% { transform: translate(0, 0); } }
    @keyframes pc-carte-mere { 0%, 23% { transform: translate(74px, -17px); } 92%, 100% { transform: translate(0, 0); } }
    @keyframes pc-disque { 0%, 18% { transform: translate(-60px, -69px); } 88%, 100% { transform: translate(0, 0); } }
    @keyframes pc-vis { 0%, 5% { transform: translate(65px, 11px); } 78%, 100% { transform: translate(0, 0); } }
