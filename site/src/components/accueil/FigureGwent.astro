---
/**
 * Cartes originales au trait : reprendre la silhouette verticale, le cadre
 * ouvragé et les repères d’angle de Gwent, tout en racontant la méthode de
 * Charles. Aucun nom de carte ni composition de deck ne lui est attribué.
 * Références visuelles officielles consultées le 2026-10-08 :
 * https://www.playgwent.com/en/updates/price-of-power
 * https://www.playgwent.com/en/news/6591/gwent-cards-how-they-come-to-life
 * Récit : docs/questions.md, C8.
 */
const cartes = [
  {
    titre: 'Lire le jeu',
    resume: 'Comprendre ce qui se joue.',
  },
  {
    titre: 'Tester mes idées',
    resume: 'Apprendre de chaque tentative.',
  },
  {
    titre: 'Prendre le contre-pied',
    resume: 'Construire mon propre chemin.',
  },
];
---

<figure class="figure gwent" id="fig-gwent">
  <div class="gwent__plan">
    <ol class="gwent__cartes">
      {cartes.map((carte, i) => (
        <li>
          <div class="gwent__element" data-figure-animation>
            <div class="gwent__contenu">
              <span class="gwent__visuel">
              <svg class="gwent__carte" viewBox="0 0 188 270" aria-hidden="true" focusable="false">
                <path class="gwent__fond" d="M21 13h144l10 10v220l-10 10H21l-10-10V23z" />
                <path class="gwent__cadre" d="M25 19h136l8 8v212l-8 8H25l-8-8V27zM30 25h126l7 7v203l-7 6H30l-7-6V32z" />
                <path class="gwent__ornement" d="M78 19l16 7 16-7M78 247l16-7 16 7M17 107l6 8-6 8M169 143l-6 8 6 8" />
                <path class="gwent__voile" d="M24 173q31-37 65-11t73-19v91l-8 7H30l-6-7z" />
                {i === 0 && (
                  <>
                    <circle class="gwent__soleil" cx="133" cy="65" r="17" />
                    <path class="gwent__doux" d="M126 42l2-7M153 58l8-3M147 81l6 5M112 67h-9M52 91l22-20 31 27 37-15 21 11" />
                    <path class="gwent__trait" d="M55 178V94h10v-9h12v9h11v-9h11v9h10v84M63 94h36M54 151h56M76 123q6-12 13 0v13H76zM70 178v-14q13-17 27 0v14" />
                    <path class="gwent__doux" d="M68 106h8m14 0h10m-38 36h11m17 0h10M47 182h71M32 213l27-16 16 4M141 174l10-27 10 27m-11-13v26" />
                    <path class="gwent__anime" d="M92 234c-10-15 21-25 9-41-6-8-18-7-18-15" />
                  </>
                )}
                {i === 1 && (
                  <>
                    <path class="gwent__doux" d="M31 73h128M41 64h16m7 0h23m27 0h27M36 86h34m29 0h53" />
                    <path class="gwent__trait" d="m45 112 72-11 14 90-72 11zM56 125l51-8M58 138l34-5M62 164l37-5M64 177l48-7" />
                    <path class="gwent__trait" d="m98 155 30-70 13-10-1 18-31 65-13 10zM104 156l-6-3M126 90l9 4" />
                    <path class="gwent__anime" d="m75 150 6 5 12-15M57 228l25-20h37l30-18m-7-2 7 2-2 8" />
                    <circle class="gwent__trait" cx="48" cy="230" r="5" />
                    <circle class="gwent__doux" cx="145" cy="165" r="7" />
                    <path class="gwent__doux" d="m140 160 10 10m0-10-10 10M42 107l-8-3M147 117l8-4" />
                  </>
                )}
                {i === 2 && (
                  <>
                    <path class="gwent__doux" d="M37 169V97m-11 44 11-24 12 24m-14-39 7-17M146 156V82m-12 39 12-29 14 29M31 211c41-14 34-23 60-28s25 21 72 4M32 224c41-14 34-23 60-28s25 21 72 4" />
                    <path class="gwent__trait" d="M73 102h42l-5 64H78zM80 102V88q14-21 28 0v14M77 96h35M80 171h28M78 166l-5 9h42l-5-9M83 111v43m22-43v43M94 107v-7" />
                    <path class="gwent__anime" d="M94 124c-14 12-5 24 0 24s14-11 0-24M64 192l-14-4 8-6m-8 6 22-6M123 70l15-4-7-6m7 6-24-5" />
                    <path class="gwent__doux" d="M94 63V44M68 70l-10-13M122 87l17-6M64 91l-14-3" />
                    <path class="gwent__ornement" d="m94 202 9 9-9 9-9-9z" />
                  </>
                )}
                <path class="gwent__insigne" d="m29 8 20 20-20 20L9 28z" />
                <path class="gwent__cadre" d="m29 15 13 13-13 13-13-13z" />
                {i === 0 && <><path class="gwent__symbole" d="M21 28q8-10 16 0-8 10-16 0" /><circle class="gwent__symbole" cx="29" cy="28" r="2" /></>}
                {i === 1 && <path class="gwent__symbole" d="m23 33 8-12 4-1-1 4-9 11zM23 33l-2 3" />}
                {i === 2 && <path class="gwent__symbole" d="M25 35V24l10-3m-5-3 5 3-3 5M25 25l-4-4" />}
                <path class="gwent__insigne" d="m158 233 18 18-18 18-18-18z" />
                <path class="gwent__symbole" d="m158 242 8 9-8 9-8-9zM154 251h8" />
              </svg>
                <button type="button" class="commande-figure" data-rejouer aria-label={`Rejouer l’animation : ${carte.titre}`}><span aria-hidden="true">↻</span></button>
              </span>
              <span class="gwent__titre">{carte.titre}</span>
              <span class="gwent__resume">{carte.resume}</span>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <figcaption class="legende">Des cartes pour raconter ma méthode sur Gwent.</figcaption>
</figure>

<style>
  .gwent__plan { padding: 20px 0 0; }
  .gwent__cartes { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; padding: 0; margin: 0; }
  .gwent__cartes li { min-width: 0; }
  .gwent__contenu { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 4px; }
  .gwent__visuel { position: relative; display: block; width: 100%; max-width: 188px; margin-bottom: 16px; }
  .gwent__carte { width: 100%; display: block; color: var(--bleu); overflow: visible; }
  .gwent__visuel .commande-figure { position: absolute; top: 6px; right: 6px; cursor: pointer; }
  .gwent__fond, .gwent__insigne { fill: var(--blanc); stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; }
  .gwent__cadre, .gwent__ornement, .gwent__trait, .gwent__anime, .gwent__symbole, .gwent__doux, .gwent__soleil { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .gwent__soleil { fill: var(--blanc); }
  .gwent__doux { stroke: var(--trait-doux); stroke-width: 1.2; }
  .gwent__voile { fill: var(--bleu); opacity: .07; }
  .gwent__ornement { stroke-width: 1; }
  .gwent__trait, .gwent__anime { stroke-width: 1.8; }
  .gwent__titre { font-size: 1rem; font-weight: 700; color: var(--encre); }
  .gwent__resume { font-size: .875rem; color: var(--graphite); margin-top: 4px; }
  @media (prefers-reduced-motion: no-preference) {
    .gwent__element:global(.animation-en-cours) .gwent__carte { animation: gwent-sortir .65s cubic-bezier(.2,.8,.2,1); }
    .gwent__element:global(.animation-en-cours) .gwent__anime { stroke-dasharray: 260; animation: gwent-tracer .9s ease both; }
    @keyframes gwent-sortir { 0% { transform: translateY(0); } 45% { transform: translateY(-8px) rotate(-2deg); } 100% { transform: translateY(0); } }
    @keyframes gwent-tracer { from { stroke-dashoffset: 260; } to { stroke-dashoffset: 0; } }
  }
  @media (max-width: 640px) {
    .gwent__cartes { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .gwent__contenu { display: grid; grid-template-columns: 100px minmax(0, 1fr); column-gap: 22px; align-items: center; text-align: left; }
    .gwent__visuel { grid-column: 1; grid-row: 1 / 3; margin-bottom: 0; }
    .gwent__visuel .commande-figure { top: auto; right: -10px; bottom: -8px; }
    .gwent__titre { grid-column: 2; align-self: end; }
    .gwent__resume { grid-column: 2; }
    .gwent__cartes li + li { border-top: 1px solid var(--filet); padding-top: 22px; }
  }
  @media print { .commande-figure { display: none; } }
</style>
