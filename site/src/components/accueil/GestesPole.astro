---
/**
 * Comment j’organise le pôle, en quatre gestes (ACC-15 : les images de la
 * page PvZ Fusion, PVZ-05, PVZ-07, PVZ-08 et PVZ-11). Les textes viennent de
 * la même source que la page du projet (config/pvz-fusion.ts, témoignage
 * C7) : un outil, une phrase. Le détail se lit sur la page du projet.
 *
 * Replié par défaut (gardé le 13/10/2026 ; on replie, on ne retire pas) : la
 * page PvZ Fusion raconte déjà ces gestes avec les mêmes images, et le
 * chapitre « Emmener » s’y diluait. Ouvert, chaque geste est une vignette
 * carrée, légende en ligne, comme sur la page du projet : deux colonnes sur
 * ordinateur, une sur mobile. Un <details> natif : sans JavaScript, il s’ouvre
 * et se ferme pareil.
 *
 * Pas de « semaine type » : le relevé public n’établit pas une régularité
 * chaque semaine sur toute l’année (docs/prive/matiere-premiere.md). La cadence
 * « une pull request par semaine » reste celle que Charles rapporte.
 */
import LienAction from '../ui/LienAction.astro';
import Visuel from '../ui/Visuel.astro';
import { GESTES } from '../../config/pvz-fusion';
import { typo } from '../../lib/typo';
---

<details class="gestes">
  <summary class="gestes__titre"><span class="gestes__signe" aria-hidden="true"></span>Comment j’organise le pôle, en quatre gestes</summary>
  <ol class="gestes__liste">
    {
      GESTES.map((geste, i) => (
        <li class="geste">
          <div class="geste__visuel">
            <Visuel id={geste.visuel} alt="" sizes="(max-width: 860px) 128px, 176px" />
          </div>
          <div class="geste__texte">
            <p class="geste__outil"><span class="geste__rang" aria-hidden="true">{i + 1}</span>{typo(geste.outil)}</p>
            <p class="geste__titre">{typo(geste.titre)}</p>
          </div>
        </li>
      ))
    }
  </ol>
  <LienAction class="gestes__suite" href="/projets/pvz-fusion#semaine">Chaque geste en détail, sur la page PvZ Fusion</LienAction>
</details>

<style>
  .gestes {
    border-top: 1px solid var(--filet);
  }

  .gestes__titre {
    display: flex;
    align-items: center;
    gap: var(--s3);
    min-height: 48px;
    list-style: none;
    font-size: var(--t-s);
    font-weight: 600;
    color: var(--encre);
    cursor: pointer;
  }

  .gestes__titre::-webkit-details-marker {
    display: none;
  }

  .gestes__titre:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* Le signe d’ouverture : une croix dessinée, qui tourne en « × ». */
  .gestes__signe {
    position: relative;
    flex: none;
    width: 24px;
    height: 24px;
    border: 1px solid var(--laiton);
    border-radius: 50%;
    color: var(--encre);
    transition: transform var(--d-ui) var(--courbe);
  }

  .gestes__signe::before,
  .gestes__signe::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 10px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .gestes__signe::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .gestes[open] .gestes__signe {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .gestes__signe {
      transition: none;
    }
  }

  .gestes__liste {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s5) var(--s6);
    margin: var(--s3) 0 0;
    padding: 0;
    list-style: none;
  }

  /* Une vignette carrée, sa légende en ligne. */
  .geste {
    display: grid;
    grid-template-columns: 176px minmax(0, 1fr);
    gap: var(--s4);
    align-items: center;
    min-width: 0;
  }

  .geste__visuel {
    overflow: hidden;
    border-radius: var(--r2);
  }

  .geste__visuel :global(.visuel) {
    border-radius: 0;
  }

  .geste__outil {
    display: flex;
    align-items: baseline;
    gap: var(--s2);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-petit);
    color: var(--eteint);
  }

  .geste__rang {
    font-variant-numeric: tabular-nums;
    color: var(--laiton);
  }

  .geste__titre {
    margin-top: var(--s1);
    font-family: var(--police-titre);
    font-size: var(--t-l);
    line-height: 1.15;
    color: var(--encre);
  }

  .gestes :global(.gestes__suite) {
    margin-block: var(--s3) var(--s2);
  }

  @media (max-width: 1180px) {
    .gestes__liste {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s4);
    }
  }

  @media (max-width: 860px) {
    .geste {
      grid-template-columns: 128px minmax(0, 1fr);
      gap: var(--s3);
    }

    .geste__titre {
      font-size: var(--t-m);
    }
  }

  /* À l’impression, les gestes se lisent dépliés, là où le navigateur sait
     déplier un <details> par le style. */
  @media print {
    .gestes::details-content {
      content-visibility: visible;
    }

    .gestes__signe {
      display: none;
    }
  }
</style>
