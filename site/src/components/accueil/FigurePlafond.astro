---
/**
 * Le plafond (ACC-06). Ma progression sur Gwent : une montée irrégulière
 * pendant environ un an, quatre mois de plafond, puis le saut grâce au deck à
 * contre-courant. Un schéma, pas une mesure : aucune valeur sur l'axe
 * vertical, seules les durées sont sourcées (questionnaire C8).
 *
 * Le moment du site : la courbe se trace une fois, à son arrivée à l'écran,
 * puis les annotations apparaissent dans l'ordre de lecture, la percée à la
 * lumière de la lanterne (src/scripts/figure-plafond.ts) ; un clic ou le
 * clavier la retracent (src/scripts/figure-animations.ts). Mouvement réduit :
 * la figure arrive complète.
 *
 * Deux dessins, large et compact, un seul visible à la fois : le large à
 * partir de 720 px de large (requête de conteneur), sinon le compact.
 *
 * Les libellés ne grandissent pas avec le dessin : ils sont écrits en HTML,
 * posés sur le dessin à la place de leur point d’ancrage (en % du viewBox),
 * à la taille du texte du site — 14 px pour les axes, le corps courant pour
 * les deux annotations — à toutes les largeurs. Le dessin seul se met à
 * l’échelle ; le SVG garde son titre et sa description.
 */
const description =
  'Schéma de ma progression sur Gwent : une montée irrégulière pendant environ un an, un plafond de quatre mois, puis un saut jusqu’au classement mondial grâce à un deck à contre-courant.';

/** Un libellé, ancré comme le serait un <text> : x et y (ligne de base) dans le viewBox. */
interface Libelle {
  texte: string;
  x: number;
  y: number;
  ancre?: 'debut' | 'milieu' | 'fin';
  sorte?: 'axe' | 'fort' | 'note' | 'vertical';
  annot?: 1 | 2;
}

const DESSINS = {
  large: {
    largeur: 760,
    hauteur: 372,
    libelles: [
      { texte: 'Classement mondial', x: 98, y: 61, sorte: 'fort' },
      { texte: 'Plus près du classement mondial', x: 54, y: 190, sorte: 'vertical' },
      { texte: 'Vers 17 ans', x: 84, y: 352 },
      { texte: 'environ 1 an', x: 470, y: 352, ancre: 'milieu' },
      { texte: '+ 4 mois', x: 596, y: 352, ancre: 'milieu' },
      { texte: 'Temps', x: 732, y: 352, ancre: 'fin' },
      { texte: '4 mois de plafond', x: 533, y: 194, ancre: 'milieu', sorte: 'note', annot: 1 },
      { texte: 'Deck à contre-courant', x: 580, y: 104, ancre: 'fin', sorte: 'note', annot: 2 },
    ],
  },
  compacte: {
    largeur: 360,
    hauteur: 318,
    libelles: [
      { texte: 'Classement mondial', x: 54, y: 64, sorte: 'fort' },
      { texte: 'Plus près du classement', x: 20, y: 152, sorte: 'vertical' },
      { texte: 'Vers 17 ans', x: 44, y: 300 },
      { texte: 'environ 1 an', x: 226, y: 300, ancre: 'fin' },
      { texte: '+ 4 mois', x: 290, y: 300, ancre: 'milieu' },
      { texte: '4 mois de plafond', x: 252, y: 170, ancre: 'milieu', sorte: 'note', annot: 1 },
      { texte: 'Deck à contre-courant', x: 272, y: 100, ancre: 'fin', sorte: 'note', annot: 2 },
    ],
  },
} satisfies Record<string, { largeur: number; hauteur: number; libelles: Libelle[] }>;

const placer = (dessin: { largeur: number; hauteur: number }, l: Libelle) =>
  `--x:${Math.round((10000 * l.x) / dessin.largeur) / 100}%;--y:${Math.round((10000 * l.y) / dessin.hauteur) / 100}%`;
const classes = (l: Libelle) => [
  'f-l',
  `f-l--${l.sorte ?? 'axe'}`,
  `f-l--${l.ancre ?? 'debut'}`,
  l.annot && `annot annot--${l.annot}`,
];
---

<figure class="plafond foyer" id="fig-1">
  <button type="button" class="plafond__plan" data-plafond data-figure-animation data-rejouer disabled
    aria-label="Rejouer l’animation : le plafond sur Gwent">
    <span class="plafond__dessin plafond__large">
      <svg viewBox="0 0 760 372" role="img" aria-labelledby="f1-titre f1-desc">
        <title id="f1-titre">Le plafond, puis le saut</title>
        <desc id="f1-desc">{description}</desc>
        <rect class="f-plateau" x="470" y="40" width="126" height="282"></rect>
        <g class="f-axes">
          <path d="M84 322V34"></path>
          <path d="M78 44L84 34L90 44"></path>
          <path d="M84 322H732"></path>
          <path d="M722 316L732 322L722 328"></path>
          <path d="M470 322v7M596 322v7"></path>
        </g>
        <line class="f-seuil" x1="84" y1="72" x2="716" y2="72"></line>
        <polyline
          class="courbe"
          points="84,300 110,284 128,292 156,262 176,270 204,240 224,249 252,218 272,226 300,196 320,204 348,176 368,183 396,156 416,163 440,142 470,138 488,129 504,141 522,128 540,140 558,129 576,141 596,132 612,64 632,58 652,64 676,57 700,62"
        ></polyline>
        <g class="annot annot--1">
          <path class="f-accolade" d="M470 158v8h126v-8"></path>
        </g>
        <g class="annot annot--2">
          <path class="f-rappel" d="M588 98H599"></path>
          <circle class="f-plein" cx="603" cy="98" r="3.5"></circle>
        </g>
        <g class="annot annot--3">
          <polyline class="f-percee" points="596,132 612,64 632,58 652,64 676,57 700,62"></polyline>
          <circle class="f-eclat" cx="612" cy="64" r="16"></circle>
          <circle class="f-plein" cx="612" cy="64" r="6.5"></circle>
        </g>
      </svg>
      <span class="plafond__libelles" aria-hidden="true">
        {DESSINS.large.libelles.map((l) => <span class:list={classes(l)} style={placer(DESSINS.large, l)}>{l.texte}</span>)}
      </span>
    </span>
    <span class="plafond__dessin plafond__compacte">
      <svg viewBox="0 0 360 318" role="img" aria-labelledby="f1c-titre f1c-desc">
        <title id="f1c-titre">Le plafond, puis le saut</title>
        <desc id="f1c-desc">{description}</desc>
        <rect class="f-plateau" x="223" y="34" width="59" height="238"></rect>
        <g class="f-axes">
          <path d="M44 272V30"></path>
          <path d="M39 39L44 30L49 39"></path>
          <path d="M44 272H350"></path>
          <path d="M341 267L350 272L341 277"></path>
          <path d="M223 272v6M282 272v6"></path>
        </g>
        <line class="f-seuil" x1="44" y1="74" x2="344" y2="74"></line>
        <polyline
          class="courbe"
          points="44,250 56.1,237.6 64.4,243.8 77.4,220.6 86.7,226.8 99.7,203.6 109,210.5 122,186.6 131.3,192.7 144.3,169.5 153.6,175.7 166.6,154.1 175.9,159.5 188.9,138.6 198.1,144 209.3,127.8 223.2,124.7 231.6,117.7 239,127 247.4,116.9 255.7,126.2 264.1,117.7 272.4,127 281.7,120 289.1,67.4 298.4,62.8 307.7,67.4 318.9,62 330,65.9"
        ></polyline>
        <g class="annot annot--1">
          <path class="f-accolade" d="M223 140v6h59v-6"></path>
        </g>
        <g class="annot annot--2">
          <path class="f-rappel" d="M277 95H282"></path>
          <circle class="f-plein" cx="285" cy="95" r="3"></circle>
        </g>
        <g class="annot annot--3">
          <polyline class="f-percee" points="281.7,120 289.1,67.4 298.4,62.8 307.7,67.4 318.9,62 330,65.9"></polyline>
          <circle class="f-eclat" cx="289.1" cy="67.4" r="12"></circle>
          <circle class="f-plein" cx="289.1" cy="67.4" r="5"></circle>
        </g>
      </svg>
      <span class="plafond__libelles" aria-hidden="true">
        {DESSINS.compacte.libelles.map((l) => <span class:list={classes(l)} style={placer(DESSINS.compacte, l)}>{l.texte}</span>)}
      </span>
    </span>
  </button>
  <figcaption class="plafond__legende">Ma progression sur Gwent. Schéma, pas à l’échelle&nbsp;: seules les durées sont sourcées.</figcaption>
</figure>

<script>
  import { brancherPlafond } from '../../scripts/figure-plafond';
  brancherPlafond();
</script>

<style>
  .plafond {
    margin: 0;
    container: plafond / inline-size;
  }

  .plafond__plan {
    position: relative;
    display: block;
    width: 100%;
    padding: clamp(10px, 2.2vw, 24px);
    border: 1px solid var(--filet);
    border-radius: var(--r2);
    background: var(--surface);
    box-shadow: var(--ombre-1);
    color: inherit;
    text-align: left;
  }

  .plafond__plan svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Le large à partir de 720 px de large, le compact en dessous : chacun
     garde ses libellés lisibles sans qu’ils se touchent. */
  .plafond__large {
    display: none !important;
  }

  @container plafond (min-width: 720px) {
    .plafond__large {
      display: block !important;
    }

    .plafond__compacte {
      display: none !important;
    }
  }

  .f-plateau {
    fill: var(--acte);
    opacity: 0.6;
  }

  .f-axes {
    fill: none;
    stroke: var(--trait);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .f-seuil {
    stroke: var(--trait);
    stroke-width: 1;
    stroke-dasharray: 4 5;
  }

  /* Le dessin et ses libellés : le SVG se met à l’échelle, les libellés
     gardent la taille du texte du site. */
  .plafond__dessin {
    position: relative;
    display: block;
  }

  .plafond__libelles {
    position: absolute;
    inset: 0;
  }

  /* Un libellé posé sur son point d’ancrage, x et y du viewBox en % : c’est
     sa ligne de base, pas le haut de sa boîte, qui tombe sur le point. */
  .f-l {
    position: absolute;
    left: var(--x);
    top: var(--y);
    font-family: var(--police-texte);
    font-size: var(--t-xs);
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: var(--eteint);
    translate: var(--ancre, 0) -0.8em;
  }

  .f-l--milieu {
    --ancre: -50%;
  }

  .f-l--fin {
    --ancre: -100%;
  }

  .f-l--fort {
    font-weight: 600;
    color: var(--encre);
  }

  .f-l--note {
    font-family: var(--police-titre);
    font-style: italic;
    font-weight: 400;
    font-size: var(--t-m);
    color: var(--encre);
  }

  /* L’axe vertical se lit de bas en haut, centré sur son point, à gauche de
     l’axe. */
  .f-l--vertical {
    translate: none;
    transform: translate(calc(-50% - 0.45em), -50%) rotate(-90deg);
  }

  .courbe {
    fill: none;
    stroke: var(--encre);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .f-percee {
    fill: none;
    stroke: var(--laiton);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .f-accolade {
    fill: none;
    stroke: var(--encre);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .f-rappel {
    stroke: var(--laiton);
    stroke-width: 1.25;
  }

  .f-plein {
    fill: var(--laiton);
  }

  .f-eclat {
    fill: var(--lanterne-halo);
  }

  .plafond__legende {
    margin-top: var(--s3);
    font-size: var(--t-xs);
    line-height: 1.45;
    color: var(--eteint);
  }

  /* Préparé par le script : la courbe est cachée par son tiret, les
     annotations attendent la fin du tracé, dans l'ordre de la lecture. */
  .plafond__plan:global(.est-pret) .annot {
    opacity: 0;
  }

  .plafond__plan:global(.est-trace) .annot {
    opacity: 1;
    transition: opacity 0.45s ease;
  }

  .plafond__plan:global(.est-trace) .annot--1 {
    transition-delay: 1.45s;
  }

  .plafond__plan:global(.est-trace) .annot--3 {
    transition-delay: 1.7s;
  }

  .plafond__plan:global(.est-trace) .annot--2 {
    transition-delay: 1.95s;
  }

  @media print {
    .courbe {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
    }

    .annot {
      opacity: 1 !important;
      transition: none !important;
    }
  }
</style>
