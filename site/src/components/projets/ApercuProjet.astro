---
import { Picture } from 'astro:assets';
import type { ProjetActif } from '../../config/projets';
import VisuelBloodborne from './VisuelBloodborne.astro';
import gup from '../../assets/projets/gup-selection.webp';
import pvz from '../../assets/captures/pvz-fusion.webp';
interface Props { projet: ProjetActif }
const { projet } = Astro.props;
---

<div class:list={['miniature', `miniature--${projet.id}`]}>
  {projet.id === 'bloodborne' && <VisuelBloodborne compact />}
  {projet.id === 'gup' && <div class="mini-gup"><Picture src={gup} formats={['avif']} fallbackFormat="webp" widths={[812, 1624]} sizes="(min-width: 850px) 42vw, 100vw" alt="Dans l’interface GUP, les logiciels sont regroupés par source avec les versions disponibles et les mises à jour cochées." loading="lazy" /></div>}
  {projet.id === 'league' && <img class="mini-league" src="/images/league-of-database/apercus/histoire-ahri-1440.webp" srcset="/images/league-of-database/apercus/histoire-ahri-720.webp 720w, /images/league-of-database/apercus/histoire-ahri-1440.webp 1440w" sizes="(min-width: 850px) 42vw, calc(100vw - 48px)" alt="La fiche d’Ahri au patch 3.6.14 dans League Of Database, une encyclopédie multilingue des données de League of Legends." width="1440" height="1000" loading="lazy" decoding="async" />}
  {projet.id === 'pvz' && <>
    <div class="mini-pvz__decor"><Picture src={pvz} formats={['avif']} fallbackFormat="webp" widths={[480, 768]} sizes="(min-width: 850px) 30vw, 100vw" alt="Une partie de Plants vs. Zombies Fusion, avec les plantes fusionnées pour défendre le jardin." loading="lazy" /></div>
    <p class="mini-pvz__traduction">Le même jeu, en français.</p>
  </>}
</div>

<style>
  .miniature { position: relative; height: 245px; overflow: hidden; border-radius: 7px; isolation: isolate; }
  .miniature--gup { background: #202834; padding: 14px; }
  .mini-gup { height: 100%; overflow: hidden; border-radius: 4px; box-shadow: 0 8px 15px #0004; }
  .mini-gup :global(img) { display: block; height: 100%; width: 100%; object-fit: cover; object-position: right top; }
  .miniature--pvz { background: #0c341d; }
  .mini-pvz__decor { position: absolute; inset: 0; z-index: -1; }
  .mini-pvz__decor :global(picture), .mini-pvz__decor :global(img) { width: 100%; height: 100%; display: block; }
  .mini-pvz__decor :global(img) { object-fit: cover; }
  .mini-pvz__traduction { position: absolute; left: 16px; bottom: 16px; right: 16px; width: fit-content; padding: 8px 12px; color: #fff; background: #092312; border-radius: 4px; font-size: 1rem; font-weight: 700; line-height: 1.3; }
  .miniature--league { background: #061622; }
  .mini-league { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
</style>
