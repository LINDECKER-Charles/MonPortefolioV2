---
/**
 * REL-F1 · Le point d’accès : les outils de la machine passent par Relais,
 * qui tient les comptes, les permissions, la capacité et les conversations,
 * et lance lui-même ses versions épinglées de Claude Code et de Codex.
 * Figure en HTML (aucune image), de haut en bas à toutes les largeurs : elle
 * se lit à 390 px comme dans la colonne de la section. Données : POINT_ACCES
 * (config/relais.ts), avec leurs sources.
 */
import { POINT_ACCES } from '../../../config/relais';

interface Props {
  class?: string;
}

const { class: classe } = Astro.props;
---

<figure class:list={['acces', classe]} data-visuel="REL-F1">
  <div class="acces__etage">
    <p class="acces__titre" id="acces-outils">Les outils de la machine</p>
    <ul class="acces__puces" aria-labelledby="acces-outils">
      {
        POINT_ACCES.outils.map(({ nom, role }) => (
          <li>
            <b>{nom}</b>
            <span>{role}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="acces__lien"><span class="acces__fleche" aria-hidden="true">↓</span> une API locale, sur <code>127.0.0.1</code>, derrière une clé</p>
  <div class="acces__relais foyer">
    <p class="acces__nom" id="acces-relais">Relais</p>
    <ul aria-labelledby="acces-relais">
      {POINT_ACCES.relais.map((element) => <li>{element}</li>)}
    </ul>
  </div>
  <p class="acces__lien"><span class="acces__fleche" aria-hidden="true">↓</span> lance ses propres versions, épinglées</p>
  <div class="acces__etage">
    <p class="acces__titre" id="acces-agents">Les agents</p>
    <ul class="acces__puces" aria-labelledby="acces-agents">
      {
        POINT_ACCES.agents.map(({ nom, version }) => (
          <li>
            <b>{nom}</b>
            <span><code>{version}</code></span>
          </li>
        ))
      }
    </ul>
  </div>
  <figcaption class="acces__legende">Qui passe par Relais, ce qu’il tient pour eux et ce qu’il lance. Versions relevées le 14/10/2026.</figcaption>
</figure>

<style>
  .acces {
    display: grid;
    gap: var(--s3);
    margin: 0;
  }

  .acces code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  .acces__titre,
  .acces__nom {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-petit);
    line-height: 1.4;
    color: var(--eteint);
  }

  .acces__puces {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: var(--s2) 0 0;
    padding: 0;
    list-style: none;
  }

  .acces__puces li {
    display: grid;
    gap: 2px;
    padding: var(--s2) var(--s3);
    border: 1px solid var(--trait);
    border-radius: var(--r1);
    background: var(--surface);
    font-size: var(--t-xs);
    line-height: 1.35;
  }

  .acces__puces b {
    font-weight: 600;
    color: var(--encre);
  }

  .acces__puces span {
    color: var(--eteint);
  }

  .acces__lien {
    display: flex;
    align-items: baseline;
    gap: var(--s2);
    padding-left: var(--s3);
    font-size: var(--t-xs);
    line-height: 1.4;
    color: var(--eteint);
  }

  .acces__fleche {
    font-size: var(--t-l);
    line-height: 1;
    color: var(--encre);
  }

  .acces__relais {
    padding: var(--s4) var(--s5);
    border: 1px solid var(--trait);
    border-radius: var(--r2);
    background: var(--surface);
    box-shadow: var(--ombre-1);
  }

  .acces__nom {
    font-family: var(--police-titre);
    font-size: var(--t-xl);
    font-weight: 400;
    letter-spacing: var(--ls-titre);
    line-height: 1.1;
    color: var(--encre);
  }

  .acces__relais ul {
    display: grid;
    gap: var(--s1);
    margin: var(--s3) 0 0;
    padding: 0;
    list-style: none;
  }

  .acces__relais li {
    position: relative;
    padding-left: var(--s4);
    font-size: var(--t-s);
    line-height: 1.45;
  }

  .acces__relais li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--eteint);
  }

  .acces__legende {
    margin-top: var(--s2);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--eteint);
  }
</style>
