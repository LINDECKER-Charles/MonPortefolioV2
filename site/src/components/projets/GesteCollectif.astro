      <rect class="surface" x="53" y="56" width="58" height="28" rx="3" />
      <path class="doux" d="M62 65h36m-36 9h24" />
      <rect class="surface" x="53" y="92" width="58" height="24" rx="3" />
      <path class="doux" d="M62 101h28m-28 7h18" />
