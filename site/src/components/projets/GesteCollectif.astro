  {geste === 'livrer' && (
    <>
      <path class="repere" d="M29 138h264M278 25v7m-3-3h6M173 127v7m-3-3h6" />
      <path class="doux" d="M87 33h32c18 0 27 12 27 27v1c0 8 8 14 19 14M87 117h32c18 0 27-12 27-27v-1c0-8 8-14 19-14" />
      <path class="trait" d="M87 75h122m-8-7 8 7-8 7" />
      <path class="surface" d="M53 14h25l10 10v27H53Z" />
      <path class="doux" d="M78 14v10h10M61 32h17m-17 8h12" />
      <path class="surface" d="M53 56h25l10 10v27H53Z" />
      <path class="doux" d="M78 56v10h10M61 74h17m-17 8h12" />
