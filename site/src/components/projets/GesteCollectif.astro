      <text class="rang rang--secondaire" x="55" y="120.5">3</text>
      <circle class="papier" cx="93" cy="33" r="4" />
      <path class="trait" d="M85 45v-2a8 8 0 0 1 16 0v2M115 32h69m-69 10h46" />
      <circle class="surface" cx="93" cy="73" r="4" />
      <path class="doux" d="M85 84v-2a8 8 0 0 1 16 0v2M115 72h69m-69 9h46" />
      <circle class="surface" cx="93" cy="111" r="4" />
