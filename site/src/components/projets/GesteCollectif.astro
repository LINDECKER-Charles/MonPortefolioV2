</svg>

<style>
  .geste-collectif {
    display: block;
    width: 100%;
    height: auto;
    fill: none;
    stroke: var(--bleu);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .papier { fill: var(--blanc); }
  .surface { fill: var(--papier); stroke: var(--trait-doux); }
  .accent { fill: color-mix(in srgb, var(--bleu) 9%, var(--blanc)); }
  .trait { stroke: var(--bleu); }
  .doux { stroke: var(--trait-doux); stroke-width: 1.3; }
  .repere { stroke: var(--filet); stroke-width: 1; }
  .plein { fill: var(--bleu); stroke: none; }
  .rang {
    fill: var(--bleu);
    stroke: none;
    text-anchor: middle;
    font: 700 18px var(--font-texte);
  }
  .rang--secondaire { fill: var(--encre); font-size: 16px; }
</style>
