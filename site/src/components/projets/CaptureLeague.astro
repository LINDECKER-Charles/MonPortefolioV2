---
interface Props {
  nom: string;
  alt: string;
  largeur?: number;
  hauteur?: number;
  prioritaire?: boolean;
  classe?: string;
  adaptatif?: boolean;
  tailles?: string;
}
const {
  nom, alt, largeur = 1440, hauteur = 1000, prioritaire = false, classe, adaptatif = true,
  tailles = '(max-width: 799px) calc(100vw - 48px), (max-width: 1360px) 92vw, 1248px',
} = Astro.props;
const src = `/images/league-of-database/${nom}.webp`;
const mobile = adaptatif && ['ahri', 'ahri-capacites', 'ahri-skins', 'ahri-skin-detail', 'objets', 'objet-recette', 'runes', 'versions-langues', 'historique-patchs', 'historique-anciens-patchs', 'histoire-champions', 'histoire-version', 'histoire-ahri', 'histoire-ahri-statistiques', 'histoire-ahri-capacites', 'histoire-skins', 'histoire-navigation'].includes(nom);
const originalMobile = mobile ? `/images/league-of-database/${nom}-mobile.webp` : undefined;
const apercus = new Set(['histoire-champions', 'historique-anciens-patchs', 'histoire-ahri-statistiques', 'histoire-skins', 'ahri', 'ahri-capacites', 'ahri-skins', 'ahri-skin-detail', 'objets', 'objet-recette', 'runes']);
function sources(capture: string): string {
  const estMobile = capture.endsWith('-mobile');
  const base = capture.replace(/-mobile$/, '');
  const largeurs = estMobile
    ? (capture === 'histoire-ahri-mobile' ? [320, 430] : apercus.has(base) ? [430] : [])
    : apercus.has(base) ? [720, 1440, 2160] : [];
  return [
    ...largeurs.map((taille) => `/images/league-of-database/apercus/${capture}-${taille}.webp ${taille}w`),
    `/images/league-of-database/${capture}.webp ${estMobile ? 860 : 2880}w`,
  ].join(', ');
}
---
<a class:list={['lod-capture', classe]} href={src} data-lod-capture data-lod-original-mobile={originalMobile} aria-label={`Agrandir : ${alt}`}>
  <picture>
    {mobile && <source media="(max-width: 799px)" srcset={sources(`${nom}-mobile`)} sizes={tailles} width="430" height="932" />}
    <img src={src} srcset={sources(nom)} sizes={tailles} alt={alt} width={largeur} height={hauteur} loading={prioritaire ? 'eager' : 'lazy'} fetchpriority={prioritaire ? 'high' : 'auto'} decoding="async" />
  </picture>
</a>
