---
interface Props { id?: string }
const { id = 'acces-compagnon' } = Astro.props;
const web = 'https://bloodborne-legendary-run.com/fr/sky';
const test = 'https://test.bb-legendary.charles-lindecker.com/fr/sky';
const android = 'https://test.bb-legendary.charles-lindecker.com/fr/download';
---

<section class="blr-section blr-acces" id={id} aria-labelledby={`${id}-titre`} data-blr-acces>
  <div class="blr-acces__entete">
    <h2 id={`${id}-titre`}>Essayez le compagnon.</h2>
    <p>Ouvrez votre ciel dans un navigateur ou gardez le compagnon sur votre téléphone Android.</p>
  </div>

  <div class="blr-acces__supports">
    <div class="blr-acces__support">
      <svg class="blr-acces__dessin" viewBox="0 0 112 104" aria-hidden="true">
        <rect class="blr-acces__surface" x="7" y="18" width="98" height="72" rx="4" />
        <path class="blr-acces__cadre" d="M7 33h98M17 25h1m7 0h1m7 0h1M37 98h38" />
        <path class="blr-acces__ciel" d="m23 72 24-22 22 17 19-22" />
        <circle class="blr-acces__etoile" cx="23" cy="72" r="3" /><circle class="blr-acces__etoile" cx="47" cy="50" r="4" /><circle class="blr-acces__etoile" cx="69" cy="67" r="3" /><circle class="blr-acces__etoile" cx="88" cy="45" r="3" />
      </svg>
      <div class="blr-acces__contenu">
        <h3>Application web</h3>
        <p>Sur ordinateur, tablette ou téléphone, depuis votre navigateur.</p>
        <div class="blr-acces__liens">
          <a class="blr-acces__lien blr-acces__lien--principal" href={web} data-umami-event="lien-sortant" data-umami-event-domaine={new URL(web).hostname} data-umami-event-emplacement="preuves">
            <span><span class="blr-acces__version">Version publique</span><strong>Ouvrir l’application</strong></span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
          </a>
          <a class="blr-acces__lien" href={test} data-umami-event="lien-sortant" data-umami-event-domaine={new URL(test).hostname} data-umami-event-emplacement="preuves">
            <span><span class="blr-acces__version">Version de test</span><strong>Essayer sur le web</strong></span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="blr-acces__support blr-acces__support--android">
      <svg class="blr-acces__dessin" viewBox="0 0 112 104" aria-hidden="true">
        <rect class="blr-acces__surface" x="30" y="3" width="52" height="98" rx="8" />
        <path class="blr-acces__cadre" d="M46 12h20M48 92h16" />
        <path class="blr-acces__ciel" d="m40 69 16-25 15 12" />
        <circle class="blr-acces__etoile" cx="40" cy="69" r="3" /><circle class="blr-acces__etoile" cx="56" cy="44" r="4" /><circle class="blr-acces__etoile" cx="71" cy="56" r="3" />
      </svg>
      <div class="blr-acces__contenu">
        <h3>Application Android</h3>
        <p>Une version de test à installer sur votre téléphone.</p>
        <div class="blr-acces__liens">
          <a class="blr-acces__lien blr-acces__lien--principal" href={android} data-umami-event="lien-sortant" data-umami-event-domaine={new URL(android).hostname} data-umami-event-emplacement="preuves">
            <span><span class="blr-acces__version">Version de test</span><strong>Télécharger l’APK</strong></span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 18v3h14v-3" /></svg>
          </a>
          <p class="blr-acces__store"><span>Google Play</span><span>À venir</span></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .blr-acces { min-width: 0; }
  .blr-acces__entete { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: end; gap: 24px 48px; }
  .blr-acces__entete > p { max-width: 43ch; color: var(--graphite); }
  .blr-acces__supports { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 32px; }
  .blr-acces__support { display: grid; grid-template-columns: 88px minmax(0, 1fr); align-items: start; gap: 24px; padding: clamp(20px, 3vw, 32px); border: 1px solid var(--filet); border-radius: var(--rayon); background: var(--blanc); }
  .blr-acces__dessin { width: 88px; height: 104px; }
  .blr-acces__surface { fill: var(--papier); stroke: var(--trait); stroke-width: 1.5; }
  .blr-acces__cadre { fill: none; stroke: var(--trait); stroke-width: 1.5; stroke-linecap: round; }
  .blr-acces__ciel { fill: none; stroke: var(--bleu); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .blr-acces__etoile { fill: var(--bleu); }
  .blr-acces__contenu { min-width: 0; }
  .blr-acces__contenu h3 { font-size: 1.375rem; line-height: 1.2; }
  .blr-acces__contenu > p { max-width: 35ch; margin-top: 12px; color: var(--graphite); font-size: .9375rem; line-height: 1.5; }
  .blr-acces__liens { display: grid; gap: 12px; margin-top: 24px; }
  .blr-acces__lien { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px; padding: 12px 16px; border: 1px solid var(--filet); border-radius: var(--rayon); color: var(--bleu); text-decoration: none; }
  .blr-acces__lien--principal { border-color: var(--bleu); background: color-mix(in srgb, var(--bleu) 6%, var(--blanc)); }
  .blr-acces__lien:hover { border-color: var(--bleu); text-decoration: underline; text-underline-offset: 4px; }
  .blr-acces__lien:focus-visible { outline: 3px solid var(--bleu); outline-offset: 4px; }
  .blr-acces__lien > span { display: grid; gap: 4px; }
  .blr-acces__version { color: var(--graphite); font-size: .75rem; line-height: 1.4; }
  .blr-acces__lien strong { font-size: .9375rem; line-height: 1.4; }
  .blr-acces__lien svg { flex-shrink: 0; width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .blr-acces__store { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; min-height: 72px; padding: 12px 16px; border-top: 1px solid var(--filet); font-size: .9375rem; }
  .blr-acces__store > span:last-child { color: var(--graphite); font: italic 1.125rem/1.4 var(--font-note); }
  @media (max-width: 960px) {
    .blr-acces__support { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  }
  @media (max-width: 620px) {
    .blr-acces__entete, .blr-acces__supports { grid-template-columns: minmax(0, 1fr); }
    .blr-acces__supports { gap: 16px; }
    .blr-acces__support { grid-template-columns: 64px minmax(0, 1fr); gap: 16px; padding: 20px 16px; }
    .blr-acces__dessin { grid-column: 1; grid-row: 1 / 3; width: 64px; height: 84px; }
    .blr-acces__contenu { display: contents; }
    .blr-acces__contenu h3, .blr-acces__contenu > p { grid-column: 2; }
    .blr-acces__contenu h3 { font-size: 1.1875rem; }
    .blr-acces__contenu > p { margin-top: 0; }
    .blr-acces__liens { grid-column: 1 / -1; margin-top: 4px; }
    .blr-acces__lien, .blr-acces__store { padding-inline: 12px; }
  }
</style>
