---
/**
 * « Comment je l’ai construit » (gabarit E5 · 4) : deux à quatre décisions,
 * chacune « contrainte, choix, effet », avec sa trace publique quand elle
 * existe. L’en-tête y mène en un clic (#construit).
 *
 *   <DecisionsProjet decisions={DECISIONS} />
 *   <DecisionsProjet decisions={…} chapeau="…">… (suite : logos, schéma)</DecisionsProjet>
 *
 * Bureau : les décisions côte à côte ; mobile : en pile (pas de carrousel).
 * Les liens de trace sont des sorties mesurées (emplacement `preuves`).
 */
import SectionProjet from './SectionProjet.astro';
import LienAction from '../../ui/LienAction.astro';
import type { Emplacement } from '../../../lib/liens';
import { typo } from '../../../lib/typo';
import type { Decision } from './types';

interface Props {
  decisions: readonly Decision[];
  id?: string;
  titre?: string;
  chapeau?: string;
  emplacement?: Emplacement;
}

const { decisions, id = 'construit', titre = 'Comment je l’ai construit', chapeau, emplacement = 'preuves' } = Astro.props;
if (decisions.length < 2 || decisions.length > 4) throw new Error(`<DecisionsProjet> : deux à quatre décisions (règle E5), ${decisions.length} reçues.`);
---

<SectionProjet id={id} titre={titre} chapeau={chapeau} class="decisions-projet">
  <ol class="decisions-projet__liste" aria-label={`${decisions.length === 2 ? 'Deux' : decisions.length === 3 ? 'Trois' : 'Quatre'} décisions`}>
    {
      decisions.map((decision, index) => (
        <li class="decision">
          <p class="decision__rang" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
          <dl>
            <dt>Contrainte</dt>
            <dd>{typo(decision.contrainte)}</dd>
            <dt>Choix</dt>
            <dd>{typo(decision.choix)}</dd>
            <dt class="decision__effet-titre">Effet</dt>
            <dd class="decision__effet">{typo(decision.effet)}</dd>
          </dl>
          {decision.lien && <LienAction class="decision__lien" href={decision.lien.href} emplacement={emplacement}>{typo(decision.lien.libelle)}</LienAction>}
        </li>
      ))
    }
  </ol>
  <slot />
</SectionProjet>

<style>
  .decisions-projet__liste {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--s4);
    margin: var(--s6) 0 0;
    padding: 0;
    list-style: none;
  }

  .decision {
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    padding: var(--s5);
    border: 1px solid var(--trait);
    border-radius: var(--r2);
    background: var(--surface);
  }

  .decision__rang {
    font-size: var(--t-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--ls-petit);
    color: var(--eteint);
  }

  dl {
    display: grid;
    gap: var(--s1);
    margin: 0;
  }

  dt {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-petit);
    color: var(--eteint);
  }

  dd {
    margin-bottom: var(--s3);
    font-size: var(--t-s);
    line-height: 1.5;
  }

  .decision__effet-titre {
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding-top: var(--s2);
  }

  .decision__effet-titre::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--filet);
  }

  /* L’effet en sérif, au corps du chapeau : la citation et « Ce que j’en
     retiens » gardent seuls le grand corps (hiérarchie de la page). */
  .decision__effet {
    margin-bottom: 0;
    font-family: var(--police-titre);
    font-size: var(--t-l);
    line-height: 1.2;
    color: var(--encre);
  }

  .decision :global(.decision__lien) {
    margin-top: auto;
    min-height: 44px;
  }
</style>
