---
/**
 * La fiche technique d’un projet, en tableau à filets (greffe de la
 * direction B sur la direction « Lanterne ») : Besoin · Ma part · Rôle ·
 * Période · Équipe · Statut · Liens publics. Posée par EnTeteProjet sous le
 * titre ; utilisable seule.
 *
 *   <FicheProjet fiche={FICHE} />
 *
 * Bureau : Besoin et Ma part sur une ligne, les cinq autres sur la suivante,
 * sur une grille de douze : Rôle et Période (3 + 3) se coupent sous la
 * coupure de Besoin et Ma part, à 50 % ; Équipe, Statut et Liens publics
 * (2 + 2 + 2) se partagent l’autre moitié, un lien par ligne. Tablette et
 * mobile : deux colonnes, les longues cases sur toute la largeur.
 * Les liens publics sont des sorties du site, mesurées en `lien-sortant`
 * (emplacement `preuves` par défaut). Le statut a une forme et un mot (C9).
 * Juste sous la case des liens, hors du tableau (qui ne porte que des
 * sorties), « Discutons de ce projet → » mène à /contact dès la fiche, sans
 * attendre la sortie de page (`contact-page`, emplacement `fiche-projet`).
 */
import AConfirmer from '../../ui/AConfirmer.astro';
import Statut from '../../ui/Statut.astro';
import { attributsMesure, FLECHES, sorteDeLien, type Emplacement } from '../../../lib/liens';
import { typo } from '../../../lib/typo';
import type { ChampFiche, DonneesFiche } from './types';

interface Props {
  fiche: DonneesFiche;
  emplacement?: Emplacement;
  class?: string;
}

const { fiche, emplacement = 'preuves', class: classe } = Astro.props;
const cases: { champ: ChampFiche; titre: string; large?: boolean }[] = [
  { champ: 'besoin', titre: 'Besoin', large: true },
  { champ: 'part', titre: 'Ma part', large: true },
  { champ: 'role', titre: 'Rôle' },
  { champ: 'periode', titre: 'Période' },
  { champ: 'equipe', titre: 'Équipe' },
];
---

<div class:list={['fiche-projet', classe]}>
  <div role="group" aria-label="Fiche du projet">
  <dl>
    {
      cases.map(({ champ, titre, large }) => (
        <div class:list={['fiche-projet__case', `fiche-projet__case--${champ}`, { 'fiche-projet__case--large': large }]}>
          <dt>{titre}</dt>
          <dd>
            {typo(fiche[champ])}
            {fiche.aConfirmer?.[champ] && <AConfirmer titre={fiche.aConfirmer[champ]} />}
          </dd>
        </div>
      ))
    }
    <div class="fiche-projet__case fiche-projet__case--statut">
      <dt>Statut</dt>
      <dd><Statut etat={fiche.statut.etat}>{typo(fiche.statut.texte)}</Statut></dd>
    </div>
    <div class="fiche-projet__case fiche-projet__case--liens">
      <dt>Liens publics</dt>
      <dd>
        <ul>
          {
            fiche.liens.map((lien) => {
              const sorte = sorteDeLien(lien.href);
              return (
                <li>
                  <a href={lien.href} rel={sorte === 'externe' ? 'external' : undefined} {...attributsMesure(lien.href, { emplacement })}>
                    {typo(lien.libelle)}<span class="fleche" aria-hidden="true">{` ${FLECHES[sorte]}`}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </dd>
    </div>
  </dl>
  </div>
  <p class="fiche-projet__discuter">
    <a href="/contact" {...attributsMesure('/contact', { evenement: 'contact-page', emplacement: 'fiche-projet' })}>Discutons de ce projet<span class="fleche" aria-hidden="true">&nbsp;→</span></a>
  </p>
</div>

<style>
  .fiche-projet dl {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    background: var(--trait);
    border-top: 1px solid var(--encre);
    border-bottom: 1px solid var(--trait);
    border-radius: var(--r1);
    overflow: hidden;
  }

  .fiche-projet__case {
    grid-column: span 2;
    min-width: 0;
    padding: var(--s3) var(--s4);
    background: var(--surface);
  }

  .fiche-projet__case--large {
    grid-column: span 6;
  }

  .fiche-projet__case--role,
  .fiche-projet__case--periode {
    grid-column: span 3;
  }

  dt {
    margin-bottom: var(--s1);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-petit);
    line-height: 1.4;
    color: var(--eteint);
  }

  dd {
    font-size: var(--t-s);
    line-height: 1.5;
    color: var(--encre);
  }

  .fiche-projet__case--large dd {
    font-size: var(--t-m);
    line-height: 1.45;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* En ligne : la flèche reste collée au dernier mot (espace insécable). */
  ul a {
    display: inline-block;
    padding-block: 2px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  /* L’appel, sous la colonne des liens : à droite sur ordinateur. */
  .fiche-projet__discuter {
    margin-top: var(--s1);
    text-align: right;
  }

  .fiche-projet__discuter a {
    display: inline-block;
    padding-block: var(--s1);
    font-size: var(--t-s);
    font-weight: 600;
    line-height: 1.5;
  }

  @media (min-width: 1101px) {
    .fiche-projet__case--liens ul {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 1100px) {
    .fiche-projet dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fiche-projet__case,
    .fiche-projet__case--role,
    .fiche-projet__case--periode {
      grid-column: span 1;
    }

    .fiche-projet__case--large,
    .fiche-projet__case--role {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 860px) {
    ul a,
    .fiche-projet__discuter a {
      padding-block: 10px;
    }

    .fiche-projet__discuter {
      text-align: left;
    }
  }

  /* L’adresse complète figure dans la note de sources : pas d’URL ajoutée. */
  @media print {
    .fiche-projet dl {
      background: transparent;
      gap: 0;
    }

    .fiche-projet__case {
      border: 1px solid var(--trait);
    }

    ul a::after {
      content: none !important;
    }
  }
</style>
