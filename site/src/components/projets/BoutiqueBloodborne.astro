---
import { Picture } from 'astro:assets';
import fonds from '../../assets/projets/bloodborne/boutique-fonds.webp';
import bannieres from '../../assets/projets/bloodborne/boutique-bannieres.webp';
import portraits from '../../assets/projets/bloodborne/boutique-portraits.webp';

const rayons = [
  { id: 'fonds', titre: 'Fonds', detail: 'Un autre ciel pour sa constellation.', image: fonds, alt: 'Le rayon des fonds de la boutique de Bloodborne Legendary Run, avec les décors de constellation et leurs prix en échos de sang.' },
  { id: 'bannieres', titre: 'Bannières', detail: 'Un décor pour son profil.', image: bannieres, alt: 'Le rayon des bannières de la boutique de Bloodborne Legendary Run, avec les décors de profil et leurs prix en échos de sang.' },
  { id: 'portraits', titre: 'Portraits', detail: 'Un visage pour son chasseur.', image: portraits, alt: 'Le rayon des portraits de la boutique de Bloodborne Legendary Run, avec les visages de chasseurs et leurs prix en échos de sang.' },
];
---

<div class="blr-boutique" data-blr-boutique role="region" aria-roledescription="carrousel" aria-labelledby="blr-boutique-titre">
  <div class="blr-boutique__texte">
    <h3 id="blr-boutique-titre">Des étoiles, des échos,<br />un ciel à votre goût.</h3>
    <p>Les réussites rapportent des échos de sang. La boutique permet de les dépenser en fonds de constellation, bannières de profil et portraits de chasseur.</p>
    <p class="blr-boutique__titres">Les titres récompensent les objectifs accomplis.</p>
    <div class="blr-boutique__navigation" data-blr-boutique-navigation hidden>
      <div class="blr-boutique__rayons" role="group" aria-label="Choisir un rayon de la boutique">
        {rayons.map((rayon, index) => <button type="button" data-blr-boutique-choix={index} aria-controls="blr-boutique-ecrans" aria-pressed={index === 0}>{rayon.titre}</button>)}
      </div>
      <div class="blr-boutique__commandes">
        <button type="button" data-blr-boutique-precedent aria-controls="blr-boutique-ecrans" aria-label="Voir le rayon précédent" aria-disabled="true"><span aria-hidden="true">←</span> Précédent</button>
        <span class="blr-boutique__position" data-blr-boutique-position aria-hidden="true">1 / 3</span>
        <button type="button" data-blr-boutique-suivant aria-controls="blr-boutique-ecrans" aria-label="Voir le rayon suivant">Suivant <span aria-hidden="true">→</span></button>
      </div>
    </div>
    <p class="blr-boutique__mode" id="blr-boutique-mode">Faites défiler les rayons.<br />Chaque écran peut être agrandi.</p>
    <p class="sr" data-blr-boutique-annonce aria-live="polite" aria-atomic="true"></p>
  </div>
  <div class="blr-boutique__galerie">
    <div class="blr-boutique__ecrans" id="blr-boutique-ecrans" data-blr-boutique-ecrans tabindex="0" role="group" aria-label="Les trois rayons de la boutique" aria-describedby="blr-boutique-mode">
      {rayons.map((rayon, index) => <figure class="blr-boutique__rayon" data-blr-boutique-rayon aria-roledescription="diapositive" aria-label={`${rayon.titre}, ${index + 1} sur ${rayons.length}`}>
        <a class="blr-boutique__capture" href={rayon.image.src} data-blr-capture={`boutique-${rayon.id}`} aria-label={`Agrandir le rayon ${rayon.titre.toLocaleLowerCase('fr')}`}>
          <Picture src={rayon.image} formats={['avif']} fallbackFormat="webp" widths={[390, 780]} sizes="(min-width: 390px) 308px, calc(100vw - 76px)" alt={rayon.alt} loading="lazy" />
        </a>
        <figcaption class="blr-boutique__legende"><strong>{rayon.titre}</strong><span>{rayon.detail}</span></figcaption>
      </figure>)}
    </div>
  </div>
</div>

<script>
  import '../../scripts/bloodborne-boutique';
</script>

<style>
  .blr-boutique { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .85fr); align-items: center; gap: 64px; margin-top: 56px; }
  .blr-boutique__texte { min-width: 0; }
  .blr-boutique__texte h3 { max-width: 22ch; font-size: clamp(1.7rem, 1.3rem + 1vw, 2.3rem); line-height: 1.1; letter-spacing: -.025em; }
  .blr-boutique__texte > p:not(.sr) { max-width: 43ch; color: var(--graphite); font-size: 1rem; margin-top: 20px; }
  .blr-boutique__texte .blr-boutique__titres { font-size: .875rem; margin-top: 12px; }
  .blr-boutique__navigation { margin-top: 32px; }
  .blr-boutique__navigation[hidden] { display: none; }
  .blr-boutique__rayons { display: flex; flex-wrap: wrap; gap: 8px; }
  .blr-boutique__rayons button { min-height: 44px; padding: 8px 14px; border: 1px solid var(--filet); border-radius: 4px; color: var(--encre); background: var(--blanc); cursor: pointer; font-size: .9375rem; font-weight: 700; }
  .blr-boutique__rayons button:hover { border-color: var(--bleu); }
  .blr-boutique__rayons button[aria-pressed='true'] { border-color: var(--bleu); color: var(--sur-bleu); background: var(--bleu); }
  .blr-boutique__commandes { display: flex; align-items: center; gap: 16px; margin-top: 12px; }
  .blr-boutique__commandes button { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 4px 0; border: 0; background: transparent; color: var(--encre); cursor: pointer; font-size: .875rem; }
  .blr-boutique__commandes button:hover:not([aria-disabled='true']) { color: var(--bleu); }
  .blr-boutique__commandes button[aria-disabled='true'] { color: var(--graphite); cursor: default; opacity: .65; }
  .blr-boutique__position { color: var(--graphite); font-size: .8125rem; white-space: nowrap; }
  .blr-boutique__texte .blr-boutique__mode { color: var(--graphite); font-size: .8125rem; margin-top: 16px; }
  .blr-boutique__galerie { min-width: 0; }
  .blr-boutique__ecrans { display: flex; gap: 24px; overflow-x: auto; padding: 8px 8px 16px; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-color: var(--trait-doux) transparent; scrollbar-width: thin; overscroll-behavior-x: contain; }
  .blr-boutique__rayon { flex: 0 0 100%; min-width: 0; display: flex; flex-direction: column; align-items: center; scroll-snap-align: center; scroll-snap-stop: always; }
  .blr-boutique__capture { display: block; position: relative; width: min(100%, 320px); padding: 6px; border: 1px solid #647070; border-radius: 16px; background: #080d0e; box-shadow: 0 16px 32px rgb(17 25 27 / .16); }
  .blr-boutique__capture :global(picture), .blr-boutique__capture :global(img) { display: block; width: 100%; height: auto; }
  .blr-boutique__capture :global(img) { border-radius: 10px; }
  .blr-boutique .blr-boutique__legende { margin-top: 16px; text-align: center; font-size: 1rem; }
  .blr-boutique__legende strong { font-weight: 700; }
  .blr-boutique .blr-boutique__legende span { display: block; margin-top: 4px; color: var(--graphite); font-size: .8125rem; font-weight: 400; }
  .blr-boutique__capture:focus-visible, .blr-boutique__ecrans:focus-visible, .blr-boutique__navigation button:focus-visible { outline: 3px solid var(--bleu); outline-offset: 4px; }
  @media (max-width: 800px) { .blr-boutique { gap: 32px; } }
  @media (max-width: 580px) {
    .blr-boutique { grid-template-columns: minmax(0, 1fr); gap: 24px; margin-top: 40px; }
    .blr-boutique__navigation { margin-top: 24px; }
    .blr-boutique__commandes { gap: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .blr-boutique__ecrans { scroll-behavior: auto; } }
  @media print {
    .blr-boutique { display: block; }
    .blr-boutique__navigation, .blr-boutique__mode { display: none; }
    .blr-boutique__ecrans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible; padding: 20px 0 0; gap: 20px; }
    .blr-boutique__capture { padding: 0; border: 0; box-shadow: none; }
  }
</style>
