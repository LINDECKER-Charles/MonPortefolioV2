---
import angular from '../../assets/projets/bloodborne/technos/angular.svg?url';
import ionic from '../../assets/projets/bloodborne/technos/ionic.svg?url';
import capacitor from '../../assets/projets/bloodborne/technos/capacitor.svg?url';
import dotnet from '../../assets/projets/bloodborne/technos/dotnet.svg?url';
import postgresql from '../../assets/projets/bloodborne/technos/postgresql.svg?url';
import docker from '../../assets/projets/bloodborne/technos/docker.svg?url';
import github from '../../assets/projets/bloodborne/technos/github.svg?url';

interface Props { id?: string }
const { id = 'blr-fabrication' } = Astro.props;
---

<section class="blr-section blr-fab" id="la-fabrication" aria-labelledby={`${id}-titre`} data-blr-fabrication>
  <div class="blr-fab__entete">
    <div><p class="blr-repere">05 · Sous le capot</p><h2 id={`${id}-titre`}>D’une étoile<br />à sa sauvegarde.</h2></div>
    <p>Un même compagnon sur le web et Android. Derrière chaque réussite, un chemin simple.</p>
  </div>

  <div class="blr-fab__plan">
    <div class="blr-fab__consigne">
      <p id={`${id}-aide`}>Sélectionnez une couche pour voir son rôle.</p>
      <span class="blr-fab__annotation">Le trajet d’un objectif accompli</span>
    </div>
    <fieldset class="blr-fab__explorateur" aria-describedby={`${id}-aide`}>
      <legend class="sr">Explorer les couches du compagnon</legend>
      <input class="sr blr-fab__choix" type="radio" name={`${id}-couche`} id={`${id}-interface`} value="interface" aria-controls={`${id}-detail-interface`} checked />
      <input class="sr blr-fab__choix" type="radio" name={`${id}-couche`} id={`${id}-api`} value="api" aria-controls={`${id}-detail-api`} />
      <input class="sr blr-fab__choix" type="radio" name={`${id}-couche`} id={`${id}-donnees`} value="donnees" aria-controls={`${id}-detail-donnees`} />

      <div class="blr-fab__couches">
        <label class="blr-fab__couche blr-fab__couche--interface" for={`${id}-interface`}>
          <svg class="blr-fab__dessin" viewBox="0 0 220 112" aria-hidden="true">
            <rect class="blr-fab__surface" x="21" y="19" width="136" height="76" rx="4" />
            <path class="blr-fab__trait" d="M21 33h136M30 26h2m5 0h2m5 0h2M34 101h112" />
            <path class="blr-fab__branche" d="m47 75 27-18 28 18 25-26" />
            <circle class="blr-fab__etoile" cx="47" cy="75" r="4" /><circle class="blr-fab__etoile" cx="74" cy="57" r="4" /><circle class="blr-fab__etoile" cx="102" cy="75" r="4" /><circle class="blr-fab__etoile" cx="127" cy="49" r="4" />
            <rect class="blr-fab__surface" x="150" y="5" width="48" height="99" rx="8" />
            <path class="blr-fab__trait" d="M164 13h20M169 96h11" />
            <path class="blr-fab__branche" d="m162 73 13-26 13 12" />
            <circle class="blr-fab__etoile" cx="162" cy="73" r="3" /><circle class="blr-fab__etoile" cx="175" cy="47" r="3" /><circle class="blr-fab__etoile" cx="188" cy="59" r="3" />
          </svg>
          <span class="blr-fab__nom">L’interface</span>
          <span class="blr-fab__fonction">Vous allumez l’étoile</span>
          <span class="blr-fab__logos blr-fab__logos--front">
            <span><img src={angular} alt="" width="24" height="24" loading="lazy" />Angular</span>
            <span><img src={ionic} alt="" width="24" height="24" loading="lazy" />Ionic</span>
            <span><img src={capacitor} alt="" width="24" height="24" loading="lazy" />Capacitor</span>
          </span>
          <span class="blr-fab__selection" aria-hidden="true">Voir cette couche <span></span></span>
        </label>

        <div class="blr-fab__liaison" aria-hidden="true"><span>HTTPS</span><svg viewBox="0 0 56 28"><path d="M2 14h48m-9-8 9 8-9 8" /></svg></div>

        <label class="blr-fab__couche blr-fab__couche--api" for={`${id}-api`}>
          <svg class="blr-fab__dessin" viewBox="0 0 220 112" aria-hidden="true">
            <rect class="blr-fab__surface" x="56" y="18" width="108" height="27" rx="4" />
            <rect class="blr-fab__surface" x="56" y="50" width="108" height="27" rx="4" />
            <rect class="blr-fab__surface" x="56" y="82" width="108" height="18" rx="4" />
            <path class="blr-fab__trait" d="M71 30h5m10 0h37M71 62h5m10 0h37M145 30h4m-4 32h4" />
            <path class="blr-fab__branche" d="M19 63h29m-8-6 8 6-8 6M172 63h29m-8-6 8 6-8 6" />
            <circle class="blr-fab__etoile" cx="19" cy="63" r="4" /><circle class="blr-fab__etoile" cx="201" cy="63" r="4" />
          </svg>
          <span class="blr-fab__nom">L’API</span>
          <span class="blr-fab__fonction">Elle traite votre progression</span>
          <span class="blr-fab__logos"><span><img src={dotnet} alt="" width="32" height="32" loading="lazy" />ASP.NET Core</span></span>
          <span class="blr-fab__selection" aria-hidden="true">Voir cette couche <span></span></span>
        </label>

        <div class="blr-fab__liaison" aria-hidden="true"><span>Écriture</span><svg viewBox="0 0 56 28"><path d="M2 14h48m-9-8 9 8-9 8" /></svg></div>

        <label class="blr-fab__couche blr-fab__couche--donnees" for={`${id}-donnees`}>
          <svg class="blr-fab__dessin" viewBox="0 0 220 112" aria-hidden="true">
            <path class="blr-fab__surface" d="M60 29v57c0 10 22 18 50 18s50-8 50-18V29Z" />
            <ellipse class="blr-fab__surface" cx="110" cy="29" rx="50" ry="18" />
            <path class="blr-fab__trait" d="M60 57c0 10 22 18 50 18s50-8 50-18M60 77c0 10 22 18 50 18s50-8 50-18" />
            <path class="blr-fab__branche" d="m101 30 6 6 12-13" />
          </svg>
          <span class="blr-fab__nom">La sauvegarde</span>
          <span class="blr-fab__fonction">Vous retrouvez votre parcours</span>
          <span class="blr-fab__logos"><span><img src={postgresql} alt="" width="32" height="32" loading="lazy" />PostgreSQL</span></span>
          <span class="blr-fab__selection" aria-hidden="true">Voir cette couche <span></span></span>
        </label>
      </div>

      <div class="blr-fab__details">
        <div class="blr-fab__detail blr-fab__detail--interface" id={`${id}-detail-interface`}>
          <div class="blr-fab__detail-texte"><h3>Le même ciel, deux formats.</h3><p>La navigation et les gestes sont partagés entre le navigateur et l’application Android.</p></div>
          <dl class="blr-fab__responsabilites"><div><dt>Angular</dt><dd>Le ciel et ses gestes</dd></div><div><dt>Ionic</dt><dd>Les écrans sur mobile</dd></div><div><dt>Capacitor</dt><dd>L’enveloppe Android</dd></div></dl>
        </div>
        <div class="blr-fab__detail blr-fab__detail--api" id={`${id}-detail-api`}>
          <div class="blr-fab__detail-texte"><h3>Une réussite pour le bon personnage.</h3><p>L’API associe votre objectif au personnage actif et enregistre les souvenirs que vous lui ajoutez.</p></div>
          <dl class="blr-fab__responsabilites"><div><dt>Compte</dt><dd>Identifier le joueur</dd></div><div><dt>Personnage</dt><dd>Associer l’avancement</dd></div><div><dt>Objectif</dt><dd>Garder la réussite</dd></div></dl>
        </div>
        <div class="blr-fab__detail blr-fab__detail--donnees" id={`${id}-detail-donnees`}>
          <div class="blr-fab__detail-texte"><h3>La partie attend votre retour.</h3><p>PostgreSQL conserve les comptes, les personnages et leur progression, au-delà de la session en cours.</p></div>
          <dl class="blr-fab__responsabilites"><div><dt>Personnages</dt><dd>Chaque partie à part</dd></div><div><dt>Progression</dt><dd>Les étoiles accomplies</dd></div><div><dt>Souvenirs</dt><dd>Les notes et les morts</dd></div></dl>
        </div>
      </div>
    </fieldset>
  </div>

  <div class="blr-fab__livraison" aria-labelledby={`${id}-livraison-titre`}>
    <div class="blr-fab__livraison-tete">
      <div><h3 id={`${id}-livraison-titre`}>Construire une fois. Livrer la même version.</h3><p>Les images validées en test passent en production sans être reconstruites.</p></div>
      <div class="blr-fab__outils"><span><img src={docker} alt="" width="40" height="32" loading="lazy" />Docker</span><span><img src={github} alt="" width="28" height="28" loading="lazy" />GitHub Actions</span></div>
    </div>
    <ol class="blr-fab__pipeline">
      <li><span class="blr-fab__numero" aria-hidden="true">1</span><div><strong>Construire</strong><span>Les images du compagnon</span></div><svg class="blr-fab__colis" viewBox="0 0 42 48" aria-hidden="true"><path d="m21 4 16 9v21l-16 9-16-9V13Zm0 0v18m16-9-16 9-16-9m16 9v21" /></svg></li>
      <li><span class="blr-fab__numero" aria-hidden="true">2</span><div><strong>Valider en test</strong><span>La version à livrer</span></div><svg class="blr-fab__colis" viewBox="0 0 42 48" aria-hidden="true"><path d="m21 4 16 9v21l-16 9-16-9V13Zm0 0v18m16-9-16 9-16-9m16 9v21" /><path class="blr-fab__valide" d="m12 29 4 4 7-8" /></svg></li>
      <li><span class="blr-fab__numero" aria-hidden="true">3</span><div><strong>Promouvoir</strong><span>Les mêmes images en production</span></div><svg class="blr-fab__colis" viewBox="0 0 42 48" aria-hidden="true"><path d="m21 4 16 9v21l-16 9-16-9V13Zm0 0v18m16-9-16 9-16-9m16 9v21" /><path class="blr-fab__valide" d="m12 29 4 4 7-8" /></svg></li>
    </ol>
  </div>
</section>

<style>
  .blr-fab { min-width: 0; }
  .blr-fab__entete { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: end; gap: 32px; margin-bottom: 32px; }
  .blr-fab__entete > p { max-width: 39ch; color: var(--graphite); }
  .blr-fab__plan { padding: clamp(16px, 2.4vw, 32px); border: 1px solid var(--filet); border-radius: var(--rayon); background: var(--blanc); }
  .blr-fab__consigne { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-bottom: 24px; }
  .blr-fab__consigne p { font-size: 1rem; font-weight: 700; }
  .blr-fab__annotation { color: var(--bleu); font: italic 1.0625rem/1.5 var(--font-note); }
  .blr-fab__explorateur { position: relative; min-width: 0; margin: 0; padding: 0; border: 0; }
  .blr-fab__couches { display: grid; grid-template-columns: minmax(0, 1fr) 56px minmax(0, 1fr) 56px minmax(0, 1fr); align-items: stretch; }
  .blr-fab__couche { display: flex; flex-direction: column; min-width: 0; padding: 16px; border: 1px solid var(--filet); border-radius: var(--rayon); background: var(--papier); cursor: pointer; transition: border-color 160ms, background-color 160ms; }
  .blr-fab__couche:hover { border-color: var(--bleu); }
  .blr-fab__dessin { width: 100%; max-width: 220px; height: 112px; align-self: center; margin-bottom: 16px; }
  .blr-fab__surface { fill: var(--blanc); stroke: var(--trait); stroke-width: 1.5; }
  .blr-fab__trait { fill: none; stroke: var(--trait); stroke-width: 1.5; stroke-linecap: round; }
  .blr-fab__branche { fill: none; stroke: var(--bleu); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .blr-fab__etoile { fill: var(--bleu); }
  .blr-fab__nom { font-size: 1.375rem; font-weight: 800; line-height: 1.2; }
  .blr-fab__fonction { margin-top: 8px; min-height: 2.8em; color: var(--graphite); font-size: 0.9375rem; line-height: 1.4; }
  .blr-fab__logos { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 10px; min-height: 56px; margin-top: 16px; font-size: 0.9375rem; font-weight: 700; }
  .blr-fab__logos > span { display: inline-flex; align-items: center; gap: 8px; }
  .blr-fab__logos img { flex-shrink: 0; object-fit: contain; }
  .blr-fab__logos--front { justify-content: space-between; gap: 8px; }
  .blr-fab__logos--front > span { flex-direction: column; gap: 5px; font-size: 0.75rem; }
  .blr-fab__logos--front > span:nth-child(n + 2) img { padding: 3px; background: #fff; border-radius: 4px; }
  .blr-fab__selection { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 20px; padding-top: 12px; border-top: 1px solid var(--filet); color: var(--bleu); font-size: 0.875rem; font-weight: 700; }
  .blr-fab__selection > span { position: relative; flex-shrink: 0; width: 16px; height: 16px; border: 1.5px solid currentColor; border-radius: 50%; }
  .blr-fab__liaison { display: flex; flex-direction: column; align-self: center; align-items: center; gap: 4px; padding: 4px; color: var(--graphite); font-size: 0.75rem; }
  .blr-fab__liaison svg { width: 48px; height: 24px; fill: none; stroke: var(--bleu); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .blr-fab__details { margin-top: 24px; }
  .blr-fab__detail { display: none; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); align-items: start; gap: 24px 32px; min-height: 154px; padding: 24px 0 0; border-top: 1px solid var(--filet); }
  .blr-fab__detail h3 { font-size: 1.3125rem; line-height: 1.2; }
  .blr-fab__detail p { max-width: 48ch; margin-top: 10px; color: var(--graphite); font-size: 0.9375rem; line-height: 1.5; }
  .blr-fab__responsabilites { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .blr-fab__responsabilites > div { padding-left: 12px; border-left: 2px solid var(--bleu); }
  .blr-fab__responsabilites dt { color: var(--bleu); font-size: 0.9375rem; font-weight: 700; }
  .blr-fab__responsabilites dd { margin-top: 6px; font-size: 0.9375rem; line-height: 1.4; }
  .blr-fab__choix[value='interface']:checked ~ .blr-fab__couches .blr-fab__couche--interface,
  .blr-fab__choix[value='api']:checked ~ .blr-fab__couches .blr-fab__couche--api,
  .blr-fab__choix[value='donnees']:checked ~ .blr-fab__couches .blr-fab__couche--donnees { border-color: var(--bleu); background: color-mix(in srgb, var(--bleu) 7%, var(--blanc)); box-shadow: inset 0 0 0 1px var(--bleu); }
  .blr-fab__choix[value='interface']:checked ~ .blr-fab__couches .blr-fab__couche--interface .blr-fab__selection > span::after,
  .blr-fab__choix[value='api']:checked ~ .blr-fab__couches .blr-fab__couche--api .blr-fab__selection > span::after,
  .blr-fab__choix[value='donnees']:checked ~ .blr-fab__couches .blr-fab__couche--donnees .blr-fab__selection > span::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: currentColor; }
  .blr-fab__choix[value='interface']:focus-visible ~ .blr-fab__couches .blr-fab__couche--interface,
  .blr-fab__choix[value='api']:focus-visible ~ .blr-fab__couches .blr-fab__couche--api,
  .blr-fab__choix[value='donnees']:focus-visible ~ .blr-fab__couches .blr-fab__couche--donnees { outline: 3px solid var(--bleu); outline-offset: 5px; }
  .blr-fab__choix[value='interface']:checked ~ .blr-fab__details .blr-fab__detail--interface,
  .blr-fab__choix[value='api']:checked ~ .blr-fab__details .blr-fab__detail--api,
  .blr-fab__choix[value='donnees']:checked ~ .blr-fab__details .blr-fab__detail--donnees { display: grid; }
  .blr-fab__livraison { margin-top: 24px; padding: 28px 0 0; border-top: 1px solid var(--filet); }
  .blr-fab__livraison-tete { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px 32px; }
  .blr-fab__livraison-tete h3 { max-width: 38ch; font-size: 1.375rem; }
  .blr-fab__livraison-tete p { margin-top: 8px; color: var(--graphite); font-size: 0.9375rem; }
  .blr-fab__outils { display: flex; flex-wrap: wrap; gap: 20px; font-size: 0.9375rem; font-weight: 700; }
  .blr-fab__outils > span { display: flex; align-items: center; gap: 8px; }
  .blr-fab__outils img { padding: 3px; object-fit: contain; background: #fff; border-radius: 4px; }
  .blr-fab__pipeline { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin: 24px 0 0; padding: 0; list-style: none; border: 1px solid var(--filet); border-radius: var(--rayon); background: var(--blanc); }
  .blr-fab__pipeline li { position: relative; display: flex; align-items: center; gap: 12px; padding: 18px; }
  .blr-fab__pipeline li + li { border-left: 1px solid var(--filet); }
  .blr-fab__pipeline li + li::before { content: ''; position: absolute; left: -6px; top: calc(50% - 5px); width: 10px; height: 10px; border-top: 1px solid var(--bleu); border-right: 1px solid var(--bleu); background: var(--blanc); transform: rotate(45deg); }
  .blr-fab__numero { color: var(--bleu); font: italic 1.375rem/1 var(--font-note); }
  .blr-fab__pipeline strong { display: block; font-size: 1rem; line-height: 1.3; }
  .blr-fab__pipeline div > span { display: block; margin-top: 4px; color: var(--graphite); font-size: 0.8125rem; line-height: 1.4; }
  .blr-fab__colis { flex-shrink: 0; width: 36px; height: 42px; margin-left: auto; fill: none; stroke: var(--bleu); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .blr-fab__valide { stroke-width: 2.25; }
  @media (max-width: 960px) {
    .blr-fab__couches { grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1fr) 40px minmax(0, 1fr); }
    .blr-fab__couche { padding: 12px; }
    .blr-fab__nom { font-size: 1.25rem; }
    .blr-fab__liaison { font-size: 0.625rem; }
    .blr-fab__dessin { height: 92px; }
    .blr-fab__detail { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .blr-fab__pipeline li { padding: 16px 12px; }
    .blr-fab__colis { width: 28px; }
  }
  @media (max-width: 680px) {
    .blr-fab__entete { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .blr-fab__couches { grid-template-columns: minmax(0, 1fr); }
    .blr-fab__couche { display: grid; grid-template-columns: 76px minmax(0, 1fr); column-gap: 12px; padding: 14px; }
    .blr-fab__dessin { grid-column: 1; grid-row: 1 / 4; width: 76px; height: 68px; margin-bottom: 0; align-self: center; }
    .blr-fab__nom { grid-column: 2; font-size: 1.125rem; }
    .blr-fab__fonction { grid-column: 2; min-height: 0; margin-top: 4px; font-size: 0.8125rem; }
    .blr-fab__logos { grid-column: 2; min-height: 0; gap: 10px; margin-top: 12px; font-size: 0.8125rem; }
    .blr-fab__logos img { width: 22px; height: 22px; }
    .blr-fab__logos--front { grid-column: 1 / 3; justify-content: flex-start; margin-top: 10px; padding-left: 88px; gap: 8px; }
    .blr-fab__logos--front > span { flex-direction: row; gap: 4px; font-size: 0.6875rem; }
    .blr-fab__logos--front img { width: 16px; height: 16px; }
    .blr-fab__selection { grid-column: 1 / 3; margin-top: 12px; padding-top: 9px; font-size: 0.8125rem; }
    .blr-fab__liaison { flex-direction: row; justify-content: flex-start; gap: 10px; height: 38px; padding-left: 45px; font-size: 0.8125rem; }
    .blr-fab__liaison svg { order: -1; width: 28px; height: 32px; transform: rotate(90deg); }
    .blr-fab__responsabilites { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .blr-fab__responsabilites > div { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 8px; }
    .blr-fab__responsabilites dt, .blr-fab__responsabilites dd { font-size: 0.875rem; }
    .blr-fab__responsabilites dd { margin-top: 0; }
    .blr-fab__livraison-tete h3 { font-size: 1.25rem; line-height: 1.2; }
    .blr-fab__pipeline { grid-template-columns: minmax(0, 1fr); }
    .blr-fab__pipeline li { padding: 18px; }
    .blr-fab__pipeline li + li { border-left: 0; border-top: 1px solid var(--filet); }
    .blr-fab__pipeline li + li::before { left: 26px; top: -6px; transform: rotate(135deg); }
    .blr-fab__colis { width: 36px; }
  }
  @media (max-width: 360px) {
    .blr-fab__couche { grid-template-columns: 58px minmax(0, 1fr); gap: 0 10px; padding: 12px; }
    .blr-fab__dessin { width: 58px; }
    .blr-fab__logos--front { padding-left: 0; justify-content: space-between; }
    .blr-fab__logos--front > span { font-size: 0.75rem; }
    .blr-fab__responsabilites > div { grid-template-columns: 78px minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) { .blr-fab__couche { transition: none; } }
  @media print {
    .blr-fab__choix, .blr-fab__selection, .blr-fab__consigne { display: none; }
    .blr-fab__couches { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .blr-fab__liaison { display: none; }
    .blr-fab__detail { display: grid !important; min-height: 0; break-inside: avoid; }
    .blr-fab__plan, .blr-fab__livraison { break-inside: avoid; }
  }
</style>
