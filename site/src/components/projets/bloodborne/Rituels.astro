---
/**
 * Quatre allumages enregistrés dans l’application (public/demos/bloodborne),
 * dans un acte de veille : la nuit dans le jour, là où les captures
 * attendent. Un choix natif (boutons radio) montre l’un des quatre lecteurs,
 * même sans JavaScript (:has) ; les vidéos se lancent à la demande, une
 * seule à la fois, et s’arrêtent hors de l’écran (scripts/bloodborne-rituels.ts).
 * Choisir un rituel ne fait pas remonter la page.
 */
import CadreCapture from '../../ui/CadreCapture.astro';
import { RITUELS } from '../../../config/bloodborne';
---

<fieldset class="blr-rituels acte-veille" data-blr-rituels>
  <legend class="sr">Choisir un allumage à regarder</legend>
  <div class="blr-rituels__choix">
    <div class="blr-rituels__options">
      {
        RITUELS.map((rituel, index) => (
          <label for={`rituel-${rituel.id}`}>
            <input class="sr" type="radio" name="rituel-bloodborne" id={`rituel-${rituel.id}`} value={rituel.id} checked={index === 0} aria-controls={`video-${rituel.id}`} />
            <img src={`/demos/bloodborne/${rituel.id}-poster.webp`} width="390" height="844" alt="" loading="lazy" decoding="async" />
            <span class="blr-rituels__texte">
              <span class="blr-rituels__numero" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <strong>{rituel.titre}</strong>
              <span class="blr-rituels__detail">{rituel.detail}</span>
            </span>
          </label>
        ))
      }
    </div>
    <p class="blr-rituels__meta">Enregistrés sur téléphone · 10&nbsp;secondes · sans son</p>
  </div>
  <div class="blr-rituels__lecteurs">
    {
      RITUELS.map((rituel) => (
        <div class="blr-rituels__lecteur" data-blr-rituel={rituel.id} id={`video-${rituel.id}`}>
          <CadreCapture type="telephone">
            <video slot="media" controls playsinline preload="none" poster={`/demos/bloodborne/${rituel.id}-poster.webp`} width="390" height="844" aria-label={`Voir l’allumage : ${rituel.titre.toLocaleLowerCase('fr')}`} aria-describedby={`rituel-description-${rituel.id}`}>
              <source src={`/demos/bloodborne/${rituel.id}.webm`} type="video/webm" />
              <source src={`/demos/bloodborne/${rituel.id}.mp4`} type="video/mp4" />
              <p><a href={`/demos/bloodborne/${rituel.id}.mp4`}>Regarder la vidéo de l’allumage.</a></p>
            </video>
            <Fragment slot="legende"><span><b>{rituel.nom}</b> · enregistré dans l’application</span></Fragment>
          </CadreCapture>
          <p class="sr" id={`rituel-description-${rituel.id}`}>{rituel.equivalent}</p>
        </div>
      ))
    }
  </div>
</fieldset>

<script>
  import '../../../scripts/bloodborne-rituels';
</script>

<style>
  .blr-rituels {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 260px);
    gap: var(--s6) var(--s7);
    align-items: center;
    min-width: 0;
    margin: var(--s6) 0 0;
    padding: clamp(20px, 3.4vw, 48px);
    border: 0;
    border-radius: var(--r2);
  }

  .blr-rituels__options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s3);
  }

  .blr-rituels__options label {
    position: relative;
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    align-items: center;
    gap: var(--s4);
    padding: var(--s2) var(--s4) var(--s2) var(--s2);
    border: 1px solid var(--filet);
    border-radius: var(--r2);
    background: var(--surface);
    cursor: pointer;
    transition: border-color var(--d-ui) var(--courbe);
  }

  .blr-rituels__options label:hover {
    border-color: var(--trait);
  }

  .blr-rituels__options label:has(input:checked) {
    border-color: var(--accent);
    box-shadow: inset 3px 0 var(--accent);
  }

  .blr-rituels__options label:has(input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .blr-rituels__options img {
    width: 80px;
    height: 150px;
    border-radius: var(--r1);
    object-fit: cover;
    object-position: 50% 42%;
  }

  .blr-rituels__texte {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .blr-rituels__numero {
    font-size: var(--t-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--eteint);
  }

  .blr-rituels__texte strong {
    font-size: var(--t-s);
    font-weight: 600;
    line-height: 1.3;
  }

  .blr-rituels__detail {
    font-size: var(--t-xs);
    line-height: 1.45;
    color: var(--eteint);
  }

  .blr-rituels__meta {
    margin-top: var(--s4);
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .blr-rituels__lecteurs {
    min-width: 0;
  }

  .blr-rituels__lecteur {
    display: none;
    width: min(100%, 250px);
    margin-inline: auto;
  }

  .blr-rituels:has(#rituel-boss:checked) [data-blr-rituel='boss'],
  .blr-rituels:has(#rituel-decouverte:checked) [data-blr-rituel='decouverte'],
  .blr-rituels:has(#rituel-rune:checked) [data-blr-rituel='rune'],
  .blr-rituels:has(#rituel-gemme:checked) [data-blr-rituel='gemme'] {
    display: block;
  }

  .blr-rituels__lecteur :global(video) {
    aspect-ratio: 390 / 844;
    background: var(--cadre);
  }

  /* Le cadre du téléphone rogne tout ce qui dépasse (overflow: hidden) :
     l’anneau de focus de la vidéo se porte sur le cadre (critère 2.4.7). */
  .blr-rituels__lecteur :global(.capture__cadre:has(video:focus-visible)) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .blr-rituels__lecteur :global(.capture__legende b) {
    font-weight: 600;
    color: var(--encre);
  }

  @media (max-width: 860px) {
    .blr-rituels {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s5);
    }

    .blr-rituels__options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--s2);
    }

    .blr-rituels__options label {
      grid-template-columns: minmax(0, 1fr);
      align-items: stretch;
      gap: var(--s2);
      padding: var(--s2);
    }

    .blr-rituels__options img {
      width: 100%;
      height: 64px;
    }

    .blr-rituels__detail {
      display: none;
    }

    .blr-rituels__lecteur {
      width: min(100%, 260px);
    }
  }

  @media print {
    .blr-rituels__lecteurs {
      display: none;
    }
  }
</style>
