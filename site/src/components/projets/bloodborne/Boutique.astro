---
/**
 * La boutique en carrousel : trois rayons (fonds, bannières, portraits) qui
 * défilent dans leur galerie sans déplacer la page. Galerie à crans
 * (scroll-snap) et compteur « 1 / 3 » ; avec JavaScript, les rayons se
 * choisissent par leur nom, par Précédent et Suivant, ou aux flèches dans la
 * galerie (scripts/bloodborne-boutique.ts). Sans JavaScript, la galerie
 * défile seule et chaque capture reste un lien vers l’image.
 *
 * Chaque capture montre le premier écran du rayon ; elle s’agrandit en
 * entier dans la visionneuse de la page.
 */
import CadreCapture from '../../ui/CadreCapture.astro';
import fonds from '../../../assets/projets/bloodborne/boutique-fonds.webp';
import bannieres from '../../../assets/projets/bloodborne/boutique-bannieres.webp';
import portraits from '../../../assets/projets/bloodborne/boutique-portraits.webp';

const rayons = [
  { id: 'fonds', titre: 'Fonds', detail: 'Un autre ciel derrière sa constellation.', image: fonds, alt: 'Le rayon des fonds de constellation dans la boutique, avec ses paysages et leurs prix en échos de sang.' },
  { id: 'bannieres', titre: 'Bannières', detail: 'Un décor pour son profil, que les amis voient aussi.', image: bannieres, alt: 'Le rayon des bannières de profil dans la boutique, avec leurs décors et leurs prix en échos de sang.' },
  { id: 'portraits', titre: 'Portraits', detail: 'Un visage pour son personnage.', image: portraits, alt: 'Le rayon des portraits de chasseur dans la boutique, avec leurs visages et leurs prix en échos de sang.' },
];
---

<div class="blr-boutique" data-blr-boutique role="region" aria-roledescription="carrousel" aria-label="Les trois rayons de la boutique">
  <div class="blr-boutique__commandes" data-blr-boutique-navigation hidden>
    <div class="blr-boutique__rayons" role="group" aria-label="Choisir un rayon de la boutique">
      {rayons.map((rayon, index) => <button type="button" data-blr-boutique-choix={index} aria-controls="blr-boutique-ecrans" aria-pressed={index === 0 ? 'true' : 'false'}>{rayon.titre}</button>)}
    </div>
    <div class="blr-boutique__pas">
      <button type="button" data-blr-boutique-precedent aria-controls="blr-boutique-ecrans" aria-label="Voir le rayon précédent" aria-disabled="true"><span aria-hidden="true">←</span></button>
      <span class="blr-boutique__position chiffres" data-blr-boutique-position aria-hidden="true">1 / {rayons.length}</span>
      <button type="button" data-blr-boutique-suivant aria-controls="blr-boutique-ecrans" aria-label="Voir le rayon suivant"><span aria-hidden="true">→</span></button>
    </div>
  </div>
  <div class="blr-boutique__ecrans" id="blr-boutique-ecrans" data-blr-boutique-ecrans tabindex="0" role="group" aria-label="Rayons de la boutique">
    {
      rayons.map((rayon, index) => (
        <div class="blr-boutique__rayon" data-blr-boutique-rayon data-rayon={rayon.id} role="group" aria-roledescription="diapositive" aria-label={`${rayon.titre}, ${index + 1} sur ${rayons.length}`}>
          <CadreCapture class="blr-boutique__capture" type="telephone" src={rayon.image} alt={rayon.alt} ratio="390 / 844" widths={[390, 780]} sizes="(max-width: 860px) 52vw, 220px" agrandir />
          <div class="blr-boutique__legende">
            <p class="blr-boutique__numero chiffres" aria-hidden="true">{index + 1} / {rayons.length}</p>
            <p class="blr-boutique__titre">{rayon.titre}</p>
            <p class="blr-boutique__detail">{rayon.detail}</p>
          </div>
        </div>
      ))
    }
  </div>
  <p class="sr" data-blr-boutique-annonce aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  import '../../../scripts/bloodborne-boutique';
</script>

<style>
  .blr-boutique {
    min-width: 0;
  }

  .blr-boutique__commandes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3) var(--s5);
    margin-bottom: var(--s4);
  }

  .blr-boutique__commandes[hidden] {
    display: none;
  }

  .blr-boutique__rayons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }

  .blr-boutique button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid var(--trait);
    border-radius: var(--r3);
    background: transparent;
    color: var(--encre);
    font-size: var(--t-s);
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--d-ui) var(--courbe), background-color var(--d-ui) var(--courbe);
  }

  .blr-boutique__rayons button {
    padding: 0 var(--s4);
  }

  .blr-boutique__rayons button:hover,
  .blr-boutique__pas button:hover:not([aria-disabled='true']) {
    border-color: var(--accent);
  }

  .blr-boutique__rayons button[aria-pressed='true'] {
    border-color: var(--bouton);
    background: var(--bouton);
    color: var(--bouton-texte);
  }

  .blr-boutique__pas {
    display: flex;
    align-items: center;
    gap: var(--s3);
  }

  .blr-boutique__pas button {
    width: 44px;
    padding: 0;
  }

  .blr-boutique__pas button[aria-disabled='true'] {
    border-color: var(--filet);
    color: var(--eteint);
    cursor: default;
  }

  .blr-boutique__position {
    min-width: 3.2em;
    text-align: center;
    font-size: var(--t-xs);
    font-variant-numeric: tabular-nums;
    color: var(--eteint);
  }

  .blr-boutique__ecrans {
    display: flex;
    gap: var(--s5);
    overflow-x: auto;
    padding: var(--s2) var(--s2) var(--s4);
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--trait) transparent;
  }

  .blr-boutique__ecrans:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--r2);
  }

  .blr-boutique__rayon {
    flex: 0 0 100%;
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: var(--s5);
    align-items: end;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .blr-boutique__legende {
    padding-bottom: var(--s5);
  }

  .blr-boutique__numero {
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .blr-boutique__titre {
    margin-top: var(--s1);
    font-family: var(--police-titre);
    font-size: var(--t-xl);
    line-height: 1.1;
  }

  .blr-boutique__detail {
    margin-top: var(--s2);
    max-width: 18rem;
    font-size: var(--t-s);
    color: var(--eteint);
  }

  @media (max-width: 860px) {
    .blr-boutique__rayon {
      grid-template-columns: minmax(0, 52%) minmax(0, 1fr);
      gap: var(--s4);
    }

    .blr-boutique__titre {
      font-size: var(--t-l);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blr-boutique__ecrans {
      scroll-behavior: auto;
    }
  }

  @media print {
    .blr-boutique__commandes {
      display: none;
    }

    .blr-boutique__ecrans {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
    }

    .blr-boutique__rayon {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
