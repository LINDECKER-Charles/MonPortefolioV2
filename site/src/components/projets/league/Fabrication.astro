---
/**
 * « En production » : les quatre schémas de l’exploitation de League Of Data
 * Base, gardés et redessinés dans le système (figures codées LOD-F2 à LOD-F5,
 * config/visuels.ts). Le trafic et ses deux caches, la mesure d’audience, la
 * copie hors du serveur et sa restauration, la livraison des mêmes images.
 *
 * Chaque bloc porte l’identifiant de l’ancienne page (#trafic, #audience,
 * #sauvegardes, #livraison) et sa trace publique, en permalien figé
 * (config/league-of-database.ts, LIENS). Le dispositif des sauvegardes est
 * celui du dépôt public : son activation en production reste à confirmer, et
 * la page ne lui attribue aucune exécution.
 *
 * Les dessins sont des glyphes de schéma au trait (encre), la marque en
 * laiton (la lanterne, la nuit) ; les logos viennent de src/assets/stacks/.
 * Aucune animation : les schémas se lisent d’un regard, imprimés compris.
 */
import angular from '../../../assets/stacks/angular.svg?url';
import docker from '../../../assets/stacks/docker.svg?url';
import dotnet from '../../../assets/stacks/dotnet.svg?url';
import actions from '../../../assets/stacks/github-actions.svg?url';
import nginx from '../../../assets/stacks/nginx.svg?url';
import postgres from '../../../assets/stacks/postgresql.svg?url';
import AConfirmer from '../../ui/AConfirmer.astro';
import LienAction from '../../ui/LienAction.astro';
import { LIENS } from '../../../config/league-of-database';
---

<div class="fabrication">
  <section class="bloc" id="trafic" aria-labelledby="trafic-titre">
    <div class="bloc__tete">
      <h3 id="trafic-titre">La bonne réponse, sans tout recalculer</h3>
      <p>Le cache répond aux demandes répétées. Les rendus et les téléchargements ont chacun leur budget.</p>
    </div>
    <figure class="schema trafic" aria-labelledby="trafic-titre" aria-describedby="trafic-legende">
      <ol class="trafic__chaud" aria-label="Une page déjà en cache">
        <li class="noeud">
          <svg class="glyphe" viewBox="0 0 160 100" aria-hidden="true">
            <rect class="surface" x="17" y="15" width="112" height="68" rx="4" />
            <path d="M17 29h112M25 22h2m5 0h2m5 0h2M51 90h46M73 83v7" />
            <rect class="surface" x="109" y="41" width="34" height="52" rx="5" />
            <path d="M119 47h14m-10 39h7M29 42h31m-31 9h43m-43 9h36" />
          </svg>
          <strong>Une page demandée</strong>
          <span>Navigateur ou robot</span>
        </li>
        <li class="route" aria-hidden="true"><span>HTTPS</span></li>
        <li class="noeud noeud--foyer">
          <svg class="glyphe" viewBox="0 0 160 100" aria-hidden="true">
            <path class="surface" d="M43 28v46c0 9 16 16 37 16s37-7 37-16V28Z" />
            <ellipse class="surface" cx="80" cy="28" rx="37" ry="16" />
            <path d="M43 45c0 9 16 16 37 16s37-7 37-16M43 61c0 9 16 16 37 16s37-7 37-16" />
            <path class="marque" d="m69 28 8 7 15-17" />
          </svg>
          <strong>Cache de pages</strong>
          <span class="logo"><img src={nginx} width="22" height="22" alt="" loading="lazy" />nginx</span>
          <span class="etiquettes"><span>Patch actuel</span><span>Archives</span></span>
        </li>
        <li class="route route--marque" aria-hidden="true"><span>Déjà en cache</span></li>
        <li class="noeud">
          <svg class="glyphe" viewBox="0 0 160 100" aria-hidden="true">
            <rect class="surface" x="37" y="12" width="86" height="77" rx="4" />
            <path d="M37 26h86M47 19h2m5 0h2m5 0h2M49 64h47m-47 9h36" />
            <path class="marque" d="m84 44 8 8 16-19" />
          </svg>
          <strong>La page est servie</strong>
          <span>Sans nouveau rendu</span>
        </li>
      </ol>
      <div class="trafic__froid">
        <p class="trafic__branche"><span class="fleche-bas" aria-hidden="true"></span>Absente du cache</p>
        <ol class="trafic__etapes" aria-label="Une page absente du cache">
          <li>
            <span class="creneaux" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span>
            <span>
              <strong>Rendre la page</strong>
              <span class="logo"><img src={angular} width="22" height="22" alt="" loading="lazy" />Angular SSR</span>
              <span class="detail">Rendus simultanés limités</span>
            </span>
          </li>
          <li class="trafic__lire">Lire le catalogue</li>
          <li>
            <span>
              <span class="logo"><img src={dotnet} width="26" height="26" alt="" loading="lazy" /><strong>API .NET</strong></span>
              <span class="logo"><img src={postgres} width="26" height="26" alt="" loading="lazy" />Catalogue conservé</span>
            </span>
          </li>
        </ol>
        <p class="trafic__retour"><span class="fleche-retour" aria-hidden="true"></span>Une copie rejoint le cache</p>
      </div>
      <div class="trafic__patchs">
        <p class="trafic__patchs-titre"><strong>Préparer les nouveaux patchs</strong><span>En arrière-plan, avant la première visite</span></p>
        <ol class="trafic__chaine" aria-label="Préparer un nouveau patch">
          <li>
            <svg class="glyphe glyphe--petit" viewBox="0 0 72 54" aria-hidden="true"><path class="surface" d="M14 39a12 12 0 0 1-1-24 18 18 0 0 1 34-3 13 13 0 0 1 9 25H14Z" /><path class="marque" d="M36 22v22m-7-7 7 7 7-7" /></svg>
            <strong>Riot</strong><span>Data Dragon</span>
          </li>
          <li>
            <svg class="glyphe glyphe--petit" viewBox="0 0 72 54" aria-hidden="true"><rect class="surface" x="17" y="5" width="38" height="44" rx="3" /><path d="M24 17h24m-24 10h24m-24 10h24" /><circle class="plein" cx="29" cy="17" r="3" /><circle class="plein" cx="42" cy="27" r="3" /><circle class="plein" cx="34" cy="37" r="3" /></svg>
            <strong>Ingestion</strong><span>Données puis images</span>
          </li>
          <li>
            <svg class="glyphe glyphe--petit" viewBox="0 0 72 54" aria-hidden="true"><path class="surface" d="M10 14h22l6 7h24v26H10Z" /><path d="M10 27h52" /><path class="marque" d="m27 36 6 6 12-13" /></svg>
            <strong>Prêt à consulter</strong><span>Promu une fois complet</span>
          </li>
        </ol>
      </div>
      <figcaption id="trafic-legende">Les anciens patchs ont leur propre cache&nbsp;: une visite des archives laisse sa place au patch actuel.</figcaption>
    </figure>
    <div class="actions bloc__liens">
      <LienAction href={LIENS.routage} emplacement="preuves">Le routage des deux caches</LienAction>
      <LienAction href={LIENS.ingestion} emplacement="preuves">L’ingestion des patchs</LienAction>
    </div>
  </section>

  <div class="fabrication__trio">
    <section class="bloc" id="sauvegardes" aria-labelledby="sauvegardes-titre">
      <div class="bloc__tete">
        <h3 id="sauvegardes-titre">Une copie ailleurs, un retour vérifiable</h3>
        <p>La chaîne prévoit une sauvegarde chaque nuit et une restauration réelle chaque mois.<AConfirmer titre="Activation en production à confirmer par Charles (questions, Q8)">activation à confirmer</AConfirmer></p>
      </div>
      <figure class="schema sauvegarde" aria-labelledby="sauvegardes-titre" aria-describedby="sauvegardes-legende">
        <p class="sauvegarde__frontiere" aria-hidden="true"><span>Sur le serveur</span><span>Hors du serveur</span></p>
        <ol class="sauvegarde__chaine" aria-label="De la base à la copie hors du serveur">
          <li>
            <svg class="glyphe" viewBox="0 0 120 100" aria-hidden="true"><path class="surface" d="M27 25v52c0 9 15 16 33 16s33-7 33-16V25Z" /><ellipse class="surface" cx="60" cy="25" rx="33" ry="16" /><path d="M27 43c0 9 15 16 33 16s33-7 33-16M27 61c0 9 15 16 33 16s33-7 33-16" /></svg>
            <strong>PostgreSQL</strong><span>Les données du projet</span><span class="etiquette">Accès en lecture</span>
          </li>
          <li>
            <svg class="glyphe" viewBox="0 0 120 100" aria-hidden="true"><path class="surface" d="M35 10h34l20 20v59H35Z" /><path d="M69 10v20h20M46 43h30m-30 10h30m-30 10h21" /><path class="marque" d="M59 69v17m-7-7 7 7 7-7" /></svg>
            <strong>pg_dump</strong><span>Une copie de la base</span>
          </li>
          <li>
            <svg class="glyphe" viewBox="0 0 120 100" aria-hidden="true"><path class="surface" d="m23 31 37-20 37 20v42L60 93 23 73Z" /><path d="m23 31 37 20 37-20M60 51v42" /><rect class="surface" x="42" y="40" width="36" height="29" rx="4" /><path class="marque" d="M49 40V29a11 11 0 0 1 22 0v11" /><circle class="plein" cx="60" cy="53" r="3" /></svg>
            <strong>restic</strong><span>Chiffrer et dédupliquer</span>
          </li>
          <li class="sauvegarde__ailleurs">
            <svg class="glyphe" viewBox="0 0 120 100" aria-hidden="true"><path class="surface" d="M25 68a18 18 0 0 1-2-36 28 28 0 0 1 53-5 20 20 0 0 1 15 39H25Z" /><path class="surface" d="m60 44 17 7v14c0 11-17 20-17 20S43 76 43 65V51Z" /><path class="marque" d="m52 64 6 6 11-14" /></svg>
            <strong>Stockage S3</strong><span>Objets verrouillés</span><span class="etiquette">Copie hors du serveur</span>
          </li>
        </ol>
        <div class="sauvegarde__retour">
          <p class="sauvegarde__rejouer"><span class="fleche-retour" aria-hidden="true"></span>Rejouer la sauvegarde</p>
          <ul aria-label="Le retour">
            <li>
              <svg class="glyphe glyphe--petit" viewBox="0 0 84 72" aria-hidden="true"><path class="surface" d="M17 18v35c0 7 12 12 27 12s27-5 27-12V18Z" /><ellipse class="surface" cx="44" cy="18" rx="27" ry="12" /><path d="M17 36c0 7 12 12 27 12s27-5 27-12" /><circle class="surface" cx="20" cy="52" r="15" /><path class="marque" d="m12 52 6 6 11-13" /></svg>
              <span><strong>Restaurer pour de vrai</strong><span>Dans un PostgreSQL temporaire</span></span>
            </li>
            <li>
              <svg class="glyphe glyphe--petit" viewBox="0 0 58 56" aria-hidden="true"><path class="surface" d="M11 4h36v47H11Z" /><path d="M21 15h17m-17 10h17m-17 10h11" /><path class="marque" d="m33 42 5 5 12-13" /></svg>
              <span><strong>Garder une trace</strong><span>Journal des passes et alertes</span></span>
            </li>
          </ul>
        </div>
        <figcaption id="sauvegardes-legende">Avant une migration, une copie supplémentaire permet aussi le retour à la version précédente.</figcaption>
      </figure>
      <div class="actions bloc__liens">
        <LienAction href={LIENS.sauvegardes} emplacement="preuves">Le dispositif, dans le dépôt</LienAction>
        <LienAction href={LIENS.migration} emplacement="preuves">La copie avant migration</LienAction>
      </div>
    </section>

    <section class="bloc" id="livraison" aria-labelledby="livraison-titre">
      <div class="bloc__tete">
        <h3 id="livraison-titre">Construire une fois, livrer la même version</h3>
        <p>Les images validées en test passent en production avec la même empreinte, après une promotion manuelle.</p>
      </div>
      <figure class="schema livraison" aria-labelledby="livraison-titre" aria-describedby="livraison-legende">
        <p class="livraison__outils"><span class="logo"><img src={actions} width="26" height="26" alt="" loading="lazy" />GitHub Actions</span><span class="logo"><img src={docker} width="30" height="26" alt="" loading="lazy" />Docker</span></p>
        <ol class="livraison__etapes">
          {
            [
              { titre: 'Construire', detail: 'API, web, nginx', valide: false },
              { titre: 'Valider en test', detail: 'Contrôles et déploiement', valide: true },
              { titre: 'Promouvoir en production', detail: 'Les mêmes images', valide: true },
            ].map((etape, index) => (
              <li>
                <span class="livraison__rang" aria-hidden="true">{index + 1}</span>
                <span class:list={['colis', { 'colis--valide': etape.valide }]} aria-hidden="true">
                  <img src={dotnet} width="20" height="20" alt="" loading="lazy" />
                  <img src={angular} width="20" height="20" alt="" loading="lazy" />
                  <img src={nginx} width="20" height="20" alt="" loading="lazy" />
                </span>
                <strong>{etape.titre}</strong>
                <span>{etape.detail}</span>
              </li>
            ))
          }
        </ol>
        <figcaption id="livraison-legende">Même empreinte d’un environnement à l’autre.</figcaption>
      </figure>
      <div class="actions bloc__liens">
        <LienAction href={LIENS.ci} emplacement="preuves">La chaîne de livraison</LienAction>
      </div>
    </section>

    <section class="bloc" id="audience" aria-labelledby="audience-titre">
      <div class="bloc__tete">
        <h3 id="audience-titre">Voir ce qui est consulté</h3>
        <p>Umami suit les pages et les usages du catalogue, sans cookie&nbsp;; la recherche libre n’est pas transmise.</p>
      </div>
      <figure class="schema mesure" aria-labelledby="audience-titre" aria-describedby="audience-legende">
        <ol class="mesure__etapes">
          <li>
            <svg class="glyphe glyphe--petit" viewBox="0 0 80 64" aria-hidden="true"><rect class="surface" x="7" y="6" width="66" height="50" rx="4" /><path d="M7 17h66M17 28h18v18H17m28-18h16m-16 9h16m-16 9h9" /></svg>
            <strong>Une fiche ouverte</strong><span>Page, langue, patch</span>
          </li>
          <li>
            <svg class="glyphe glyphe--petit" viewBox="0 0 80 64" aria-hidden="true"><path class="marque" d="M8 33h13l8-19 14 38 9-25h20" /><circle class="plein" cx="8" cy="33" r="3" /><circle class="plein" cx="72" cy="27" r="3" /></svg>
            <strong>Un usage mesuré</strong><span>Recherche, partage</span>
          </li>
          <li>
            <svg class="glyphe glyphe--petit" viewBox="0 0 80 64" aria-hidden="true"><path d="M10 52V10m0 42h62" /><path class="surface" d="M21 43V33h8v10m9 0V24h8v19m9 0V15h8v28" /></svg>
            <strong>Umami</strong><span>Un tableau privé</span>
          </li>
        </ol>
        <figcaption id="audience-legende">La mesure d’audience complète les métriques du serveur&nbsp;: les visites et la charge technique se lisent séparément.</figcaption>
      </figure>
      <div class="actions bloc__liens">
        <LienAction href={LIENS.mesure} emplacement="preuves">La mesure, dans le dépôt</LienAction>
      </div>
    </section>
  </div>
</div>

<style>
  .fabrication {
    display: grid;
    gap: var(--s7);
    margin-top: var(--s6);
  }

  /* Les trois schémas secondaires côte à côte ; chacun se lit de haut en
     bas dès que sa colonne est étroite (requêtes de conteneur). */
  .fabrication__trio {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--s6) var(--s5);
    align-items: start;
  }

  .fabrication__trio .bloc__tete p {
    font-size: var(--t-s);
  }

  .bloc {
    min-width: 0;
    scroll-margin-top: calc(var(--entete) + var(--s5));
  }

  .bloc__tete h3 {
    font-size: var(--t-xl);
    line-height: 1.1;
  }

  .bloc__tete p {
    margin-top: var(--s2);
    max-width: var(--mesure);
    color: var(--eteint);
  }

  .bloc__liens {
    margin-top: var(--s1);
  }

  .schema {
    container: schema / inline-size;
    margin: var(--s4) 0 0;
    border: 1px solid var(--filet);
    border-radius: var(--r2);
    background: var(--surface);
    box-shadow: var(--ombre-1);
    overflow: hidden;
  }

  .schema ol,
  .schema ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .schema strong {
    font-weight: 600;
    color: var(--encre);
  }

  .schema figcaption {
    padding: var(--s3) var(--s5);
    border-top: 1px solid var(--filet);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--eteint);
  }

  /* Les glyphes : trait d’encre, surfaces en papier, marque en laiton. */
  .glyphe {
    display: block;
    width: 96px;
    height: auto;
    fill: none;
    stroke: var(--encre);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .glyphe--petit {
    width: 56px;
  }

  .glyphe .surface {
    fill: var(--fond);
  }

  .glyphe .marque {
    stroke: var(--laiton);
    stroke-width: 2.4;
  }

  .glyphe .plein {
    fill: var(--laiton);
    stroke: var(--laiton);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    font-size: var(--t-xs);
    line-height: 1.3;
    color: var(--encre);
  }

  .logo img {
    flex: none;
    object-fit: contain;
  }

  .etiquettes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s1);
  }

  .etiquettes span,
  .etiquette {
    padding: 0 var(--s2);
    border: 1px solid var(--trait);
    border-radius: var(--r1);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--encre);
  }

  .detail {
    display: block;
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  /* Flèches dessinées en CSS : un trait, une pointe. */
  .route {
    position: relative;
    display: grid;
    place-items: center;
    padding-bottom: var(--s4);
    font-size: var(--t-xs);
    line-height: 1.3;
    text-align: center;
    color: var(--eteint);
  }

  .route::after {
    content: '';
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 6px;
    height: 0;
    border-top: 1.5px solid currentColor;
  }

  .route::before {
    content: '';
    position: absolute;
    right: 8px;
    bottom: 2px;
    width: 8px;
    height: 8px;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    rotate: 45deg;
  }

  .route--marque {
    font-weight: 600;
    color: var(--laiton);
  }

  .fleche-bas,
  .fleche-retour {
    display: inline-block;
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
  }

  .fleche-bas {
    rotate: 45deg;
    margin-top: -4px;
  }

  .fleche-retour {
    rotate: -135deg;
    margin-top: 4px;
  }

  /* --- Le trafic (LOD-F2) --- */
  .trafic__chaud {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 84px minmax(0, 1.2fr) 104px minmax(0, 1fr);
    align-items: center;
    gap: var(--s2);
    padding: var(--s5) var(--s5) var(--s4);
  }

  .noeud {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s1);
    text-align: center;
  }

  .noeud > span:not(.logo, .etiquettes) {
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .noeud--foyer {
    padding: var(--s3) var(--s2);
    border: 1px solid var(--laiton);
    border-radius: var(--r2);
    background: var(--fond);
  }

  .trafic__froid {
    display: grid;
    gap: var(--s3);
    margin: 0 var(--s5) var(--s5) 30%;
    padding: var(--s4);
    border: 1px dashed var(--trait);
    border-radius: var(--r2);
  }

  .trafic__branche,
  .trafic__retour {
    display: flex;
    align-items: center;
    gap: var(--s3);
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .trafic__retour {
    color: var(--laiton);
    font-weight: 600;
  }

  .trafic__etapes {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--s4);
  }

  .trafic__etapes > li {
    display: flex;
    align-items: center;
    gap: var(--s3);
    min-width: 0;
  }

  .trafic__etapes > li > span:not(.creneaux) {
    display: grid;
    gap: var(--s1);
  }

  .trafic__lire {
    position: relative;
    padding-bottom: var(--s4);
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .trafic__lire::after {
    content: '';
    position: absolute;
    left: 0;
    right: 4px;
    bottom: 6px;
    border-top: 1.5px solid currentColor;
  }

  .trafic__lire::before {
    content: '';
    position: absolute;
    right: 4px;
    bottom: 2px;
    width: 8px;
    height: 8px;
    border-top: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    rotate: 45deg;
  }

  .creneaux {
    display: grid;
    flex: none;
    grid-template-columns: repeat(4, 12px);
    gap: 4px;
  }

  .creneaux span {
    height: 16px;
    border: 1.5px solid var(--laiton);
    border-radius: 2px;
  }

  .creneaux span:nth-child(n + 4) {
    border-color: var(--trait);
    border-style: dashed;
  }

  .trafic__patchs {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    align-items: center;
    gap: var(--s5);
    padding: var(--s5);
    border-top: 1px solid var(--filet);
    background: var(--fond);
  }

  .trafic__patchs-titre {
    display: grid;
    gap: var(--s1);
  }

  .trafic__patchs-titre strong {
    font-size: var(--t-m);
  }

  .trafic__patchs-titre span {
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .trafic__chaine {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s4);
  }

