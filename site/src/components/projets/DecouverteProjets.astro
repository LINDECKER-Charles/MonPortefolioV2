---
import { Picture } from 'astro:assets';
import DemoGup from './DemoGup.astro';
import VisuelBloodborne from './VisuelBloodborne.astro';
import selectionGup from '../../assets/projets/gup-selection.webp';
import jardin from '../../assets/captures/pvz-fusion.webp';

// Extraits présents dans la traduction française du projet PVZF Translation.
const commandes = [
  { origine: '选择你的植物', francais: 'Choisissez Vos Plantes' },
  { origine: '查看图鉴', francais: 'Voir l’Almanach' },
  { origine: '返回游戏', francais: 'Reprendre' },
];
---

<dialog class="decouverte-projet" id="decouvrir-bloodborne" data-project-dialog="bloodborne" aria-labelledby="decouverte-bloodborne-titre" aria-describedby="decouverte-bloodborne-besoin">
  <header class="decouverte-projet__entete">
    <h2 id="decouverte-bloodborne-titre">Bloodborne Legendary Run</h2>
    <button type="button" class="decouverte-projet__fermer" data-close-project aria-label="Fermer l’aperçu">
      <span>Fermer l’aperçu</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
    </button>
  </header>

  <div class="decouverte-projet__corps" tabindex="0" role="region" aria-label="Présentation de Bloodborne Legendary Run">
    <div class="decouverte-bloodborne__ouverture">
      <div class="decouverte-contexte">
        <p class="decouverte-intro" id="decouverte-bloodborne-besoin">Bloodborne est un jeu d’action sur console. J’ai créé un compagnon pour suivre ses objectifs, garder la trace de sa partie et préparer ses combats.</p>
        <p>Le joueur y renseigne lui-même son avancée. La carte permet ensuite de retrouver ce qu’il a accompli et ce qu’il lui reste à explorer.</p>
      </div>
      <figure data-modal-bloodborne-presentation>
        <div class="decouverte-bloodborne__visuel"><VisuelBloodborne /></div>
        <figcaption>Le parcours sur grand écran, le guide à portée de main. Captures de l’application sur un parcours d’exemple.</figcaption>
      </figure>
    </div>

    <ul class="decouverte-usages" data-modal-bloodborne-uses>
      <li>
        <h3>Retrouver où reprendre</h3>
        <p>Revenir après une pause et voir les objectifs qui restent à accomplir.</p>
      </li>
      <li>
        <h3>Compléter sa collection</h3>
        <p>Retrouver les armes et les objets à collecter, puis marquer ceux que l’on a récupérés.</p>
      </li>
      <li>
        <h3>Préparer le prochain combat</h3>
        <p>Consulter les faiblesses d’un boss et les conseils pour l’affronter.</p>
      </li>
    </ul>
  </div>

  <footer class="decouverte-projet__suite">
    <a class="btn btn--plein" href="/projets/bloodborne-legendary-run">Voir la page du projet</a>
  </footer>
</dialog>

<dialog class="decouverte-projet" id="decouvrir-gup" data-project-dialog="gup" aria-labelledby="decouverte-gup-titre" aria-describedby="decouverte-gup-besoin">
  <header class="decouverte-projet__entete">
    <h2 id="decouverte-gup-titre">GUP</h2>
    <button type="button" class="decouverte-projet__fermer" data-close-project aria-label="Fermer l’aperçu">
      <span>Fermer l’aperçu</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
    </button>
  </header>

  <div class="decouverte-projet__corps" tabindex="0" role="region" aria-label="Présentation de GUP">
    <div class="decouverte-gup__ouverture">
      <div class="decouverte-contexte">
        <p class="decouverte-intro" id="decouverte-gup-besoin">Pour un développeur, mettre à jour ses outils peut demander plusieurs commandes différentes. GUP réunit les mises à jour disponibles dans une seule interface : on choisit celles que l’on veut lancer.</p>
        <p>Une interface dans le terminal, que l’on pilote au clavier.</p>
      </div>
      <figure class="decouverte-gup__capture" data-modal-gup-capture>
        <Picture src={selectionGup} formats={['avif']} fallbackFormat="webp" widths={[480, 768, 1100, 1624]} sizes="(min-width: 900px) 620px, calc(100vw - 48px)" alt="L’interface de GUP rassemble les logiciels de plusieurs gestionnaires, indique leurs versions et propose des cases pour sélectionner les mises à jour." loading="lazy" />
        <figcaption>L’interface réelle de GUP, rendue sur des données d’exemple.</figcaption>
      </figure>
    </div>
    <ul class="decouverte-usages decouverte-usages--gup">
      <li>
        <h3>Choisir ce qui change</h3>
        <p>Cocher un logiciel, plusieurs ou l’ensemble, après avoir vu les versions disponibles.</p>
      </li>
      <li>
        <h3>Suivre la mise à jour</h3>
        <p>Retrouver l’avancement et le résultat des installations dans la même interface.</p>
      </li>
    </ul>
    <details class="decouverte-gup__exemple" data-modal-gup-example>
      <summary>Essayer un exemple</summary>
      <div class="decouverte-gup__demo"><DemoGup /></div>
    </details>
  </div>

  <footer class="decouverte-projet__suite">
    <a class="btn btn--plein" href="/projets/gup">Voir la page du projet</a>
  </footer>
</dialog>

<dialog class="decouverte-projet" id="decouvrir-pvz" data-project-dialog="pvz" aria-labelledby="decouverte-pvz-titre" aria-describedby="decouverte-pvz-besoin">
  <header class="decouverte-projet__entete">
    <h2 id="decouverte-pvz-titre">PVZF Translation</h2>
    <button type="button" class="decouverte-projet__fermer" data-close-project aria-label="Fermer l’aperçu">
      <span>Fermer l’aperçu</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
    </button>
  </header>

  <div class="decouverte-projet__corps" tabindex="0" role="region" aria-label="Présentation de PVZF Translation">
    <div class="decouverte-pvz__ouverture">
      <div class="decouverte-contexte">
        <p class="decouverte-intro" id="decouverte-pvz-besoin">Dans PvZ Fusion, on combine des plantes pour défendre son jardin contre les zombies. Ce projet communautaire traduit les menus et les descriptions du jeu en français.</p>
        <p>Je coordonne le pôle francophone. L’équipe traduit et relit les textes pour que les joueurs puissent comprendre les plantes, leurs fusions et les commandes.</p>
      </div>
      <figure>
        <Picture src={jardin} formats={['avif']} fallbackFormat="webp" widths={[480, 768, 1080]} sizes="(min-width: 900px) 620px, calc(100vw - 48px)" alt="Une partie de Plants vs. Zombies Fusion, où des plantes fusionnées défendent le jardin contre les zombies." loading="lazy" />
        <figcaption>Une partie du jeu que l’équipe francophone traduit.</figcaption>
      </figure>
    </div>

    <table class="decouverte-pvz__comparaison" data-modal-pvz-comparison>
      <caption>Quelques commandes, avant et après.</caption>
      <thead><tr><th scope="col">Texte chinois</th><th scope="col">Français</th></tr></thead>
      <tbody>
        {commandes.map((commande) => <tr>
          <td lang="zh-CN" data-modal-pvz-original>{commande.origine}</td>
          <td lang="fr" data-modal-pvz-french>{commande.francais}</td>
        </tr>)}
      </tbody>
    </table>
    <p class="decouverte-pvz__source">Extraits réels de la traduction des menus.</p>
  </div>

  <footer class="decouverte-projet__suite">
    <a class="btn btn--plein" href="/projets/pvz-fusion">Voir la page du projet</a>
  </footer>
</dialog>

<script>
  const fenetres = [...document.querySelectorAll<HTMLDialogElement>('[data-project-dialog]')];
  const declencheurs = new Map<HTMLDialogElement, HTMLElement>();
  let defilement: { racine: string; corps: string } | undefined;

  const verrouillerDefilement = () => {
    if (defilement) return;
    defilement = { racine: document.documentElement.style.overflow, corps: document.body.style.overflow };
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
  };

  const libererDefilement = () => {
    if (!defilement || fenetres.some((fenetre) => fenetre.open)) return;
    document.documentElement.style.overflow = defilement.racine;
    document.body.style.overflow = defilement.corps;
    defilement = undefined;
  };

  const estVisible = (element: HTMLElement) => element.isConnected
    && element.getClientRects().length > 0
    && getComputedStyle(element).visibility === 'visible'
    && !element.closest('[hidden], [inert], [aria-hidden="true"]');

  const memeGroupeRadio = (premier: HTMLInputElement, second: HTMLElement) => second instanceof HTMLInputElement
    && second.type === 'radio' && second.name === premier.name && second.form === premier.form;

  const controlesAccessibles = (fenetre: HTMLDialogElement) => {
    const controles = [...fenetre.querySelectorAll<HTMLElement>(
      'a[href], button, input:not([type="hidden"]), select, textarea, summary, [tabindex]',
    )].filter((controle) => controle.tabIndex >= 0 && estVisible(controle)
      && !controle.matches(':disabled, [aria-disabled="true"]'));

    // Un groupe de radios constitue une seule étape de tabulation. Les flèches
    // conservent leur comportement natif pour choisir une autre option.
    return controles.filter((controle) => {
      if (!(controle instanceof HTMLInputElement) || controle.type !== 'radio' || !controle.name) return true;
      const groupe = controles.filter((autre) => memeGroupeRadio(controle, autre));
      return controle === (groupe.find((radio) => (radio as HTMLInputElement).checked) ?? groupe[0]);
    }).sort((premier, second) => (premier.tabIndex || Number.MAX_SAFE_INTEGER)
      - (second.tabIndex || Number.MAX_SAFE_INTEGER));
  };

  document.addEventListener('keydown', (evenement) => {
    if (evenement.key !== 'Tab' || evenement.defaultPrevented) return;
    const fenetre = fenetres.findLast((fenetre) => fenetre.open);
    if (!fenetre) return;
    const controles = controlesAccessibles(fenetre);
    if (controles.length === 0) return;

    // Recalculer à chaque Tab tient compte des contrôles que la démonstration
    // vient de masquer ou désactiver, sans mémoriser une liste périmée.
    const actif = document.activeElement;
    let position = controles.indexOf(actif as HTMLElement);
    if (position < 0 && actif instanceof HTMLInputElement && actif.type === 'radio' && actif.name) {
      position = controles.findIndex((controle) => memeGroupeRadio(actif, controle));
    }
    const suivante = position < 0
      ? (evenement.shiftKey ? controles.length - 1 : 0)
      : (position + (evenement.shiftKey ? -1 : 1) + controles.length) % controles.length;
    evenement.preventDefault();
    controles[suivante]?.focus();
  });

  document.addEventListener('click', (evenement) => {
    if (!(evenement.target instanceof Element)) return;
    const declencheur = evenement.target.closest<HTMLElement>('[data-open-project]');
    if (!declencheur || evenement.defaultPrevented || evenement.button !== 0
      || evenement.metaKey || evenement.ctrlKey || evenement.shiftKey || evenement.altKey) return;
    const identifiant = declencheur.dataset.openProject;
    const fenetre = fenetres.find((fenetre) => fenetre.id === identifiant || fenetre.dataset.projectDialog === identifiant);
    if (!fenetre || typeof fenetre.showModal !== 'function' || fenetre.open) return;

    try {
      fenetre.showModal();
    } catch {
      return;
    }
    evenement.preventDefault();
    declencheurs.set(fenetre, declencheur);
    verrouillerDefilement();
  });

  fenetres.forEach((fenetre) => {
    fenetre.querySelector<HTMLButtonElement>('[data-close-project]')?.addEventListener('click', () => fenetre.close());

    fenetre.addEventListener('click', (evenement) => {
      if (evenement.target !== fenetre) return;
      const cadre = fenetre.getBoundingClientRect();
      if (evenement.clientX < cadre.left || evenement.clientX > cadre.right
        || evenement.clientY < cadre.top || evenement.clientY > cadre.bottom) fenetre.close();
    });

    fenetre.addEventListener('close', () => {
      libererDefilement();
      const declencheur = declencheurs.get(fenetre);
      declencheurs.delete(fenetre);
      if (fenetres.some((autre) => autre.open)) return;
      if (declencheur && estVisible(declencheur)) {
        declencheur.focus({ preventScroll: true });
      } else {
        document.getElementById('contenu')?.focus({ preventScroll: true });
      }
    });
  });
</script>

<style>
  :global(html) { scrollbar-gutter: stable; }
  .decouverte-projet {
    width: min(1120px, calc(100vw - 48px));
    max-width: none;
    max-height: 90dvh;
    padding: 0;
    margin: auto;
    overflow: hidden;
    border: 1px solid var(--filet);
    border-radius: 8px;
    background: var(--papier);
    color: var(--encre);
    box-shadow: 0 32px 100px rgb(0 0 0 / 0.3);
  }
  .decouverte-projet[open] { display: flex; flex-direction: column; }
  .decouverte-projet::backdrop { background: rgb(14 20 36 / 0.7); backdrop-filter: blur(4px); }
  .decouverte-projet__entete { display: flex; align-items: center; justify-content: space-between; gap: var(--s5); padding: var(--s4) var(--s6); border-bottom: 1px solid var(--filet); flex-shrink: 0; }
  .decouverte-projet__entete h2 { font-size: clamp(1.25rem, 0.9rem + 0.9vw, 1.75rem); line-height: 1.2; letter-spacing: -0.025em; }
  .decouverte-projet__fermer { display: inline-flex; align-items: center; justify-content: center; gap: var(--s2); min-width: 44px; min-height: 44px; padding: var(--s2); flex-shrink: 0; border: 0; border-radius: var(--rayon); background: transparent; color: var(--graphite); font-size: 0.9375rem; cursor: pointer; }
  .decouverte-projet__fermer:hover { color: var(--bleu); background: var(--blanc); }
  .decouverte-projet__fermer svg { width: 20px; height: 20px; flex-shrink: 0; }
  .decouverte-projet__corps { min-height: 0; padding: clamp(24px, 3vw, 40px); overflow-y: auto; overscroll-behavior: contain; }
  .decouverte-projet__corps:focus-visible { outline: 2px solid var(--bleu); outline-offset: -4px; }
  .decouverte-projet__corps figure { min-width: 0; }
  .decouverte-projet__corps figcaption { margin-top: var(--s3); max-width: 75ch; color: var(--graphite); font-size: 0.875rem; line-height: 1.45; }
  .decouverte-projet__suite { display: flex; justify-content: flex-end; padding: var(--s4) var(--s6); border-top: 1px solid var(--filet); flex-shrink: 0; }
  .decouverte-contexte { align-self: center; max-width: 42ch; }
  .decouverte-intro { font-size: 1.1875rem; line-height: 1.55; }
  .decouverte-contexte > p + p { margin-top: var(--s5); color: var(--graphite); font-size: 1rem; line-height: 1.55; }
  .decouverte-bloodborne__ouverture, .decouverte-gup__ouverture, .decouverte-pvz__ouverture { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--s6); align-items: center; }
  .decouverte-bloodborne__visuel { height: 380px; overflow: hidden; border-radius: var(--rayon); }
  .decouverte-bloodborne__visuel :global(.presentation-bloodborne) { height: 100%; min-height: 0; }
  .decouverte-bloodborne__visuel :global(.presentation-bloodborne__guide) { bottom: 4%; }
  .decouverte-usages { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s5); margin: var(--s6) 0 0; padding: var(--s5) 0 0; border-top: 1px solid var(--filet); list-style: none; }
  .decouverte-usages h3 { max-width: 24ch; font-size: 1.1875rem; font-weight: 700; line-height: 1.25; letter-spacing: -0.015em; }
  .decouverte-usages p { margin-top: var(--s3); max-width: 40ch; color: var(--graphite); font-size: 1rem; line-height: 1.5; }
  .decouverte-usages--gup { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .decouverte-gup__capture :global(img) { display: block; width: 100%; height: auto; border: 1px solid #30363d; border-radius: var(--rayon); background: #0d1117; }
  .decouverte-gup__exemple { margin-top: var(--s6); padding-top: var(--s4); border-top: 1px solid var(--filet); }
  .decouverte-gup__exemple summary { width: fit-content; min-height: 44px; padding-block: var(--s2); color: var(--bleu); font-weight: 700; font-size: 1rem; cursor: pointer; }
  .decouverte-gup__demo { max-width: 620px; padding-top: var(--s4); }
  .decouverte-gup__demo :global(.demo-gup) { max-width: none; padding: var(--s5); box-shadow: none; }
  .decouverte-pvz__ouverture :global(img) { display: block; width: 100%; height: auto; border-radius: var(--rayon); }
  .decouverte-pvz__comparaison { width: 100%; margin-top: var(--s6); border-collapse: collapse; table-layout: fixed; text-align: left; }
  .decouverte-pvz__comparaison caption { text-align: left; margin-bottom: var(--s4); font-size: 1.1875rem; font-weight: 700; line-height: 1.3; }
  .decouverte-pvz__comparaison th { padding: var(--s3) var(--s4); border-bottom: 1px solid var(--filet); color: var(--graphite); font-size: 0.9375rem; font-weight: 400; }
  .decouverte-pvz__comparaison td { padding: var(--s4); border-bottom: 1px solid var(--filet); font-size: 1.125rem; line-height: 1.4; overflow-wrap: anywhere; }
  .decouverte-pvz__comparaison td[lang='fr'] { color: var(--bleu); background: var(--blanc); font-weight: 700; }
  .decouverte-pvz__source { margin-top: var(--s3); color: var(--graphite); font-size: 0.875rem; }
  @media (max-width: 850px) {
    .decouverte-bloodborne__ouverture, .decouverte-gup__ouverture, .decouverte-pvz__ouverture { grid-template-columns: minmax(0, 1fr); gap: var(--s5); }
    .decouverte-contexte { max-width: 65ch; }
    .decouverte-bloodborne__visuel { height: 320px; }
    .decouverte-usages { grid-template-columns: minmax(0, 1fr); gap: var(--s5); }
    .decouverte-usages h3, .decouverte-usages p { max-width: 65ch; }
  }
  @media (max-width: 640px) {
    .decouverte-projet { width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; border: 0; border-radius: 0; }
    .decouverte-projet__entete { padding: var(--s3) var(--s5); gap: var(--s3); }
    .decouverte-projet__fermer span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .decouverte-projet__corps { padding: var(--s5); flex: 1; }
    .decouverte-projet__suite { padding: var(--s3) var(--s5); }
    .decouverte-projet__suite .btn { width: 100%; }
    .decouverte-intro { font-size: 1.125rem; }
    .decouverte-contexte > p + p { margin-top: var(--s4); }
    .decouverte-bloodborne__visuel { height: 280px; }
    .decouverte-pvz__comparaison th, .decouverte-pvz__comparaison td { padding-inline: var(--s3); }
    .decouverte-pvz__comparaison td { font-size: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .decouverte-projet, .decouverte-projet::backdrop { animation: none; transition: none; }
  }
</style>
