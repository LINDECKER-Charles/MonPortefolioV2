---
/**
 * OMN-03 · Le plateau, en schéma : une figure codée en HTML et CSS depuis la
 * version joueur des règles du moteur (docs/rules.md du dépôt de
 * présentation), présentée comme un schéma, jamais comme une capture. Quatre
 * cibles numérotées renvoient aux repères de ReperesPartie, qui portent le
 * texte et les chiffres.
 *
 *   <PlateauPartie />
 *
 * Le dessin est décoratif (aria-hidden) : chaque chiffre est dit dans les
 * repères. Cibles : `.oc-cible` (styles/omnicard.css).
 */

/** Deux lignes de 10 places par joueur (docs/rules.md). */
const PLACES = 10;
/** Les unités posées, par ligne (avant, arrière), pour donner une partie en cours. */
const POSEES = { joueur: [[2, 4, 5, 7], [4]], adverse: [[1, 4, 6], [3, 7]] } as const;
const MAIN = 6;
const MANA = { max: 10, pleine: 6 };
const CRISTAUX = { max: 5, pleins: 2 };
---

<figure class="plateau" data-figure="OMN-03">
  <div class="plateau__dessin" aria-hidden="true">
    <div class="camp camp--adverse">
      <span class="camp__main">{Array.from({ length: MAIN }, () => <span class="carte carte--dos" />)}</span>
      <span class="camp__heros"><span class="heros">30</span></span>
      <span class="camp__lignes">
        {[1, 0].map((ligne) => (
          <span class="ligne">{Array.from({ length: PLACES }, (_, i) => <span class:list={['place', { 'place--prise': (POSEES.adverse[ligne] as readonly number[]).includes(i) }]} />)}</span>
        ))}
      </span>
    </div>
    <span class="plateau__milieu" />
    <div class="camp camp--joueur">
      <span class="camp__lignes">
        <span class="oc-cible cible--lignes">4</span>
        {[0, 1].map((ligne) => (
          <span class="ligne">{Array.from({ length: PLACES }, (_, i) => <span class:list={['place', { 'place--prise': (POSEES.joueur[ligne] as readonly number[]).includes(i) }]} />)}</span>
        ))}
      </span>
      <span class="camp__heros">
        <span class="heros heros--joueur">30<span class="oc-cible cible--heros">1</span></span>
      </span>
      <span class="camp__ressources">
        <span class="jauge">{Array.from({ length: MANA.max }, (_, i) => <span class:list={['mana', { 'mana--pleine': i < MANA.pleine }]} />)}</span>
        <span class="jauge jauge--cristaux">{Array.from({ length: CRISTAUX.max }, (_, i) => <span class:list={['cristal', { 'cristal--plein': i < CRISTAUX.pleins }]} />)}</span>
        <span class="oc-cible cible--ressources">3</span>
      </span>
      <span class="camp__deck"><span class="pile">40</span><span class="oc-cible cible--deck">2</span></span>
      <span class="camp__main camp__main--joueur">{Array.from({ length: MAIN }, () => <span class="carte" />)}</span>
    </div>
  </div>
  <figcaption class="plateau__legende">Le plateau, en schéma&nbsp;: les numéros renvoient aux repères de la partie.</figcaption>
</figure>

<style>
  .plateau {
    max-width: 30rem;
    margin: 0;
  }

  /* Le plateau : deux camps face à face sur une surface à filets. */
  .plateau__dessin {
    display: grid;
    gap: var(--s3);
    padding: var(--s4);
    border: 1px solid var(--trait);
    border-radius: var(--r2);
    background: var(--surface);
    box-shadow: var(--ombre-1);
  }

  .camp {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 4.6fr);
    gap: var(--s2) var(--s4);
    align-items: center;
  }

  .camp--adverse {
    grid-template-areas:
      'main main'
      'heros lignes';
    opacity: 0.78;
  }

  .camp--joueur {
    grid-template-areas:
      'heros lignes'
      'deck ressources'
      'main main';
  }

  .camp__main {
    grid-area: main;
    display: flex;
    justify-content: center;
    gap: 3%;
  }

  .camp__heros {
    grid-area: heros;
    display: grid;
    place-items: center;
  }

  .camp__lignes {
    grid-area: lignes;
    position: relative;
    display: grid;
    gap: var(--s2);
  }

  .camp__ressources {
    grid-area: ressources;
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s2) var(--s4);
  }

  .camp__deck {
    grid-area: deck;
    position: relative;
    display: grid;
    place-items: center;
  }

  .plateau__milieu {
    height: 1px;
    margin-inline: 8%;
    background: repeating-linear-gradient(90deg, var(--trait) 0 6px, transparent 6px 12px);
  }

  .ligne {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 3px;
  }

  .place,
  .carte {
    aspect-ratio: 5 / 7;
    border-radius: var(--r1);
  }

  .carte {
    aspect-ratio: 5 / 7;
  }

  .place {
    border: 1px dashed var(--trait);
  }

  .place--prise {
    border: 1.5px solid var(--encre);
    background: linear-gradient(var(--filet), var(--filet)) center 30% / 70% 34% no-repeat, var(--surface);
  }

  .carte {
    width: 9%;
    border: 1.5px solid var(--encre);
    background: var(--surface);
  }

  .camp__main--joueur .carte:nth-child(odd) {
    translate: 0 6%;
  }

  .carte--dos {
    border-color: var(--trait);
    background: repeating-linear-gradient(-45deg, var(--filet) 0 2px, transparent 2px 6px), var(--acte);
  }

  .heros {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(44px, 70%, 72px);
    aspect-ratio: 1;
    border: 2px solid var(--encre);
    border-radius: 50%;
    background: var(--fond);
    font-size: var(--t-l);
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--encre);
  }

  .pile {
    display: grid;
    place-items: center;
    width: clamp(38px, 56%, 58px);
    aspect-ratio: 5 / 7;
    border: 1.5px solid var(--encre);
    border-radius: var(--r1);
    background: var(--surface);
    box-shadow: 3px 3px 0 -1px var(--surface), 3px 3px 0 0 var(--trait), 6px 6px 0 -1px var(--surface), 6px 6px 0 0 var(--trait);
    font-size: var(--t-s);
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .jauge {
    display: flex;
    gap: 4px;
  }

  .mana {
    width: 12px;
    height: 12px;
    border: 1.5px solid var(--encre);
    border-radius: 50%;
  }

  .mana--pleine {
    background: var(--encre);
  }

  .cristal {
    width: 11px;
    height: 11px;
    margin-inline: 1px;
    border: 1.5px solid var(--laiton);
    rotate: 45deg;
  }

  .cristal--plein {
    background: var(--laiton);
  }

  .plateau__dessin .oc-cible {
    box-shadow: 0 0 0 3px var(--surface);
  }

  .plateau__dessin .oc-cible:not(.cible--ressources) {
    position: absolute;
    z-index: 1;
  }

  .cible--heros {
    right: -10px;
    top: -8px;
  }

  .cible--lignes {
    left: -11px;
    top: -11px;
  }

  .cible--deck {
    right: 8%;
    top: -10px;
  }

  .plateau__legende {
    margin-top: var(--s3);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--eteint);
  }

  @media (max-width: 480px) {
    .plateau__dessin {
      padding: var(--s3);
    }

    .camp {
      gap: var(--s2) var(--s3);
    }

    .mana {
      width: 10px;
      height: 10px;
    }

    .cristal {
      width: 9px;
      height: 9px;
    }
  }
</style>
