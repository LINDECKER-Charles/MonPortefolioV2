---
/**
 * Trois univers dans un même deck : l’éventail de trois vraies cartes du jeu
 * (exports de l’outil du projet), une par univers. Choisir une carte ou son
 * univers la fait monter dans l’éventail et dit ce qu’elle change à la partie.
 *
 *   <EventailCartes />
 *
 * Chaque carte est l’étiquette de son bouton radio : son image a un alt vide,
 * pour que le nom accessible du bouton reste l’univers seul (le nom de la
 * carte est dit dans son effet).
 *
 * Boutons radio natifs, sans JavaScript : clic sur la carte ou sur l’univers,
 * flèches au clavier. L’état se lit par position (`:has` et `nth-child`),
 * jamais par identifiant. Données : CARTES_UNIVERS (config/omnicard.ts).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import gehrman from '../../../assets/projets/omnicard/carte-gehrman.webp';
import jonathan from '../../../assets/projets/omnicard/carte-jonathan.webp';
import floppa from '../../../assets/projets/omnicard/carte-floppa.webp';
import { CARTES_UNIVERS, type CarteUnivers } from '../../../config/omnicard';
import { typo } from '../../../lib/typo';

const IMAGES: Record<CarteUnivers['id'], ImageMetadata> = { gehrman, jonathan, floppa };
/** La carte du milieu est choisie au départ : l’éventail est symétrique. */
const DEPART = 1;
---

<fieldset class="eventail">
  <legend class="sr">Choisir une carte et son univers</legend>
  <div class="eventail__cartes">
    {
      CARTES_UNIVERS.map((carte) => (
        <label class="eventail__carte" for={`univers-${carte.id}`}>
          <Picture
            src={IMAGES[carte.id]}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[240, 400, 600]}
            sizes="(max-width: 860px) 42vw, 230px"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </label>
      ))
    }
  </div>
  <div class="eventail__panneau">
    <h3 class="eventail__titre">Trois univers dans un même deck</h3>
    <p class="eventail__texte">Les cartes viennent de trois univers&nbsp;; chacune apporte sa mécanique.</p>
    <div class="eventail__pastilles">
      {
        CARTES_UNIVERS.map((carte, index) => (
          <label class="oc-pastille">
            <input class="oc-pastille__radio" type="radio" name="univers" id={`univers-${carte.id}`} value={carte.id} checked={index === DEPART} />
            {carte.univers}
          </label>
        ))
      }
    </div>
    <div class="eventail__effets" aria-live="polite">
      {
        CARTES_UNIVERS.map((carte) => (
          <div class="effet">
            <p class="effet__mecanique">{carte.mecanique}</p>
            <p class="effet__detail">{typo(carte.detail)}</p>
            <p class="effet__carte">{typo(carte.nom)}</p>
          </div>
        ))
      }
    </div>
    <p class="eventail__droits">Projet de fan, non commercial&nbsp;: les univers et leurs illustrations appartiennent à leurs ayants droit.</p>
  </div>
</fieldset>

<style>
  .eventail {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s5) var(--s7);
    align-items: center;
    min-width: 0;
    margin: var(--s7) 0 0;
    padding: 0;
    border: 0;
  }

  /* L’éventail : trois cartes inclinées, la carte choisie se redresse. */
  .eventail__cartes {
    position: relative;
    isolation: isolate;
    aspect-ratio: 10 / 7.6;
  }

  .eventail__carte {
    position: absolute;
    top: 7%;
    width: 38%;
    cursor: pointer;
    transform-origin: 50% 100%;
    transition: transform var(--d-scene) var(--courbe), filter var(--d-ui) var(--courbe);
  }

  .eventail__carte :global(picture) {
    display: block;
  }

  .eventail__carte :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4.5% / 2.9%;
    box-shadow: var(--ombre-2);
  }

  .eventail__carte:nth-child(1) {
    left: 4%;
    transform: rotate(-11deg) translateY(4%);
  }

  .eventail__carte:nth-child(2) {
    left: 31%;
    transform: translateY(-1%);
  }

  .eventail__carte:nth-child(3) {
    left: 58%;
    transform: rotate(11deg) translateY(4%);
  }

  /* La carte choisie passe devant, redressée, dans la lumière. */
  .eventail:has(.oc-pastille:nth-child(1) :checked) .eventail__carte:nth-child(1),
  .eventail:has(.oc-pastille:nth-child(2) :checked) .eventail__carte:nth-child(2),
  .eventail:has(.oc-pastille:nth-child(3) :checked) .eventail__carte:nth-child(3) {
    z-index: 2;
    transform: translateY(-5%) scale(1.06);
  }

  .eventail__cartes::before {
    content: '';
    position: absolute;
    inset: -6% 4% -2%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(closest-side, var(--lumiere), transparent);
  }

  :global(:root[data-theme='nuit']) .eventail__cartes::before {
    background: radial-gradient(closest-side, var(--lanterne-halo), transparent);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .eventail__cartes::before {
      background: radial-gradient(closest-side, var(--lanterne-halo), transparent);
    }
  }

  .eventail__titre {
    font-size: var(--t-xl);
    line-height: 1.1;
  }

  .eventail__texte {
    margin-top: var(--s3);
    color: var(--eteint);
  }

  /* Les univers : des commandes en pilule, l’univers choisi plein. */
  .eventail__pastilles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s5);
  }

  .eventail__effets {
    margin-top: var(--s5);
    min-height: 9.5rem;
    padding-top: var(--s4);
    border-top: 1px solid var(--trait);
  }

  .effet {
    display: none;
  }

  .eventail:has(.oc-pastille:nth-child(1) :checked) .effet:nth-child(1),
  .eventail:has(.oc-pastille:nth-child(2) :checked) .effet:nth-child(2),
  .eventail:has(.oc-pastille:nth-child(3) :checked) .effet:nth-child(3) {
    display: block;
  }

  .effet__mecanique {
    font-family: var(--police-titre);
    font-style: italic;
    font-size: var(--t-xl);
    line-height: 1.1;
    color: var(--encre);
  }

  .effet__detail {
    margin-top: var(--s2);
  }

  .effet__carte,
  .eventail__droits {
    margin-top: var(--s3);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--eteint);
  }

  .eventail__droits {
    margin-top: var(--s5);
  }

  @media (hover: hover) {
    .eventail__carte:hover {
      filter: brightness(1.05);
    }
  }

  @media (max-width: 1100px) {
    .eventail {
      grid-template-columns: minmax(0, 1fr);
      max-width: 40rem;
    }

    /* Les univers au-dessus de l’éventail : la commande reste à portée de la carte. */
    .eventail__panneau {
      display: contents;
    }

    .eventail__titre {
      order: -3;
    }

    .eventail__texte {
      order: -2;
      margin-top: calc(-1 * var(--s3));
    }

    .eventail__pastilles {
      order: -1;
      margin-top: 0;
    }

    .eventail__effets {
      margin-top: 0;
      min-height: 8.5rem;
    }

    .eventail__droits {
      margin-top: calc(-1 * var(--s3));
    }
  }

  /* Sur téléphone, l’éventail se resserre : aucune carte ne sort de la colonne. */
  @media (max-width: 560px) {
    .eventail__cartes {
      aspect-ratio: 10 / 7.2;
    }

    .eventail__carte {
      width: 36%;
    }

    .eventail__carte:nth-child(1) {
      left: 5%;
      transform: rotate(-9deg) translateY(4%);
    }

    .eventail__carte:nth-child(2) {
      left: 32%;
    }

    .eventail__carte:nth-child(3) {
      left: 59%;
      transform: rotate(9deg) translateY(4%);
    }
  }

  @media print {
    .eventail__pastilles,
    .eventail__cartes::before {
      display: none;
    }

    .effet {
      display: block;
      margin-bottom: var(--s3);
    }
  }
</style>
