---
// Versions et sources de la machine d’exemple du projet gup.
// Source : scripts/screenshots/fixtures/scan.ts dans son dépôt public.
const logiciels = [
  { nom: 'Git', source: 'Winget', version: '2.51.0', prochaine: '2.52.0' },
  { nom: 'TypeScript', source: 'npm', version: '6.0.2', prochaine: '6.0.3' },
  { nom: 'Ruff', source: 'pipx', version: '0.13.0', prochaine: '0.13.2' },
];
---

<section class="demo-gup" aria-labelledby="demo-gup-titre" data-gup-demo>
  <div class="demo-gup__entete">
    <p class="demo-gup__mention">Démonstration sur des données d’exemple</p>
    <h2 id="demo-gup-titre">À vous de choisir.</h2>
    <p>Cochez les logiciels, puis simulez leur mise à jour.</p>
  </div>
  <fieldset class="demo-gup__logiciels">
    <legend class="sr">Les logiciels à mettre à jour</legend>
    {logiciels.map((logiciel) => <label class="demo-gup__logiciel" data-gup-package>
      <input type="checkbox" value={logiciel.nom} data-version={logiciel.version} data-prochaine={logiciel.prochaine} />
      <span class="demo-gup__identite"><strong>{logiciel.nom}</strong><span>{logiciel.source}</span></span>
      <span class="demo-gup__versions">
        <span class="sr">Version installée&nbsp;: </span><span data-gup-version>{logiciel.version}</span>
        <span class="demo-gup__prochaine" data-gup-next><span aria-hidden="true"> → </span><span class="sr">Version disponible&nbsp;: </span>{logiciel.prochaine}</span>
      </span>
      <span class="demo-gup__etat" data-gup-state>Mise à jour disponible</span>
    </label>)}
  </fieldset>
  <div class="demo-gup__actions">
    <p class="demo-gup__resultat" role="status" aria-live="polite" aria-atomic="true" data-gup-status>Sélectionnez au moins un logiciel.</p>
    <button type="button" class="btn btn--plein" data-gup-update disabled>Simuler la mise à jour</button>
    <button type="button" class="demo-gup__recommencer" data-gup-reset hidden>Recommencer</button>
  </div>
  <noscript><p class="demo-gup__sans-script">Activez JavaScript pour essayer cette démonstration.</p></noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gup-demo]').forEach((demo) => {
    const choix = [...demo.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const liste = demo.querySelector<HTMLFieldSetElement>('fieldset');
    const lancer = demo.querySelector<HTMLButtonElement>('[data-gup-update]');
    const recommencer = demo.querySelector<HTMLButtonElement>('[data-gup-reset]');
    const resultat = demo.querySelector<HTMLElement>('[data-gup-status]');
    if (!liste || !lancer || !recommencer || !resultat) return;

    const afficherSelection = () => {
      const nombre = choix.filter((choix) => choix.checked).length;
      lancer.disabled = nombre === 0;
      resultat.textContent = nombre === 0
        ? 'Sélectionnez au moins un logiciel.'
        : `${nombre} logiciel${nombre > 1 ? 's' : ''} sélectionné${nombre > 1 ? 's' : ''}.`;
    };
    choix.forEach((choix) => choix.addEventListener('change', afficherSelection));

    lancer.addEventListener('click', () => {
      const selection = choix.filter((choix) => choix.checked);
      if (selection.length === 0) return;
      selection.forEach((choix) => {
        const ligne = choix.closest<HTMLElement>('[data-gup-package]');
        if (!ligne) return;
        const version = ligne.querySelector<HTMLElement>('[data-gup-version]');
        const prochaine = ligne.querySelector<HTMLElement>('[data-gup-next]');
        const etat = ligne.querySelector<HTMLElement>('[data-gup-state]');
        if (version) version.textContent = choix.dataset.prochaine ?? '';
        if (prochaine) prochaine.hidden = true;
        if (etat) etat.textContent = 'À jour';
        ligne.dataset.updated = 'true';
      });
      liste.disabled = true;
      lancer.hidden = true;
      recommencer.hidden = false;
      const nombre = selection.length;
      resultat.textContent = `${nombre} logiciel${nombre > 1 ? 's' : ''} mis à jour dans cette démonstration.`;
      recommencer.focus();
    });

    recommencer.addEventListener('click', () => {
      choix.forEach((choix) => {
        choix.checked = false;
        const ligne = choix.closest<HTMLElement>('[data-gup-package]');
        if (!ligne) return;
        const version = ligne.querySelector<HTMLElement>('[data-gup-version]');
        const prochaine = ligne.querySelector<HTMLElement>('[data-gup-next]');
        const etat = ligne.querySelector<HTMLElement>('[data-gup-state]');
        if (version) version.textContent = choix.dataset.version ?? '';
        if (prochaine) prochaine.hidden = false;
        if (etat) etat.textContent = 'Mise à jour disponible';
        delete ligne.dataset.updated;
      });
      liste.disabled = false;
      lancer.hidden = false;
      recommencer.hidden = true;
      afficherSelection();
      choix[0]?.focus();
    });
    afficherSelection();
  });
</script>

<style>
  .demo-gup { padding: clamp(24px, 3vw, 40px); border: 1px solid var(--filet); border-radius: var(--rayon); background: var(--blanc); box-shadow: 0 16px 40px color-mix(in srgb, var(--encre) 5%, transparent); }
  .demo-gup__mention { margin-bottom: var(--s5); color: var(--graphite); font-size: 0.875rem; }
  .demo-gup__entete h2 { font-size: 2rem; letter-spacing: -0.035em; }
  .demo-gup__entete h2 + p { margin-top: var(--s3); max-width: 32ch; color: var(--graphite); font-size: 1rem; }
  .demo-gup__logiciels { margin: var(--s6) 0 0; padding: 0; border: 0; min-width: 0; }
  .demo-gup__logiciel { display: grid; grid-template-columns: 24px minmax(0, 1fr) auto; align-items: center; gap: var(--s2) var(--s3); min-height: 100px; padding-block: var(--s4); border-top: 1px solid var(--filet); cursor: pointer; }
  .demo-gup__logiciel input { width: 20px; height: 20px; margin: 0; accent-color: var(--bleu); cursor: pointer; }
  .demo-gup__identite { display: grid; line-height: 1.35; }
  .demo-gup__identite strong { font-size: 1.125rem; }
  .demo-gup__identite > span { color: var(--graphite); font-size: 0.875rem; }
  .demo-gup__versions { font-variant-numeric: tabular-nums; font-size: 1rem; white-space: nowrap; }
  .demo-gup__prochaine { color: var(--bleu); }
  .demo-gup__etat { grid-column: 2 / -1; color: var(--graphite); font-size: 0.875rem; line-height: 1.3; }
  .demo-gup__logiciel[data-updated='true'] .demo-gup__etat { color: var(--bleu); font-weight: 700; }
  .demo-gup__logiciels:disabled .demo-gup__logiciel { cursor: default; }
  .demo-gup__actions { display: grid; justify-items: start; gap: var(--s5); padding-top: var(--s5); border-top: 1px solid var(--filet); }
  .demo-gup__resultat { min-height: 2.75em; max-width: 33ch; line-height: 1.4; color: var(--bleu); font-size: 1rem; }
  .demo-gup__actions .btn { width: 100%; }
  .demo-gup__actions .btn:disabled { color: var(--graphite); border-color: var(--filet); background: var(--papier); cursor: default; }
  .demo-gup__recommencer { min-height: 48px; padding: var(--s3) 0; border: 0; background: transparent; color: var(--bleu); font-weight: 700; text-decoration: underline; text-underline-offset: 0.22em; cursor: pointer; }
  .demo-gup__sans-script { margin-top: var(--s5); color: var(--graphite); font-size: 1rem; }
  [hidden] { display: none !important; }
  @media (max-width: 1000px) { .demo-gup { max-width: 680px; } }
  @media (max-width: 460px) {
    .demo-gup { padding: var(--s5); }
    .demo-gup__logiciel { grid-template-columns: 24px minmax(0, 1fr); }
    .demo-gup__versions { grid-column: 2; }
    .demo-gup__etat { grid-column: 2; }
  }
</style>
