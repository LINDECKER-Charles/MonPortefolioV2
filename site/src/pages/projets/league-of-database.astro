---
import Base from '../../layouts/Base.astro';
import FilAriane from '../../components/pages/FilAriane.astro';
import ContinuerLecture from '../../components/pages/ContinuerLecture.astro';
import CaptureLeague from '../../components/projets/CaptureLeague.astro';
import FabricationLeague from '../../components/projets/FabricationLeague.astro';
import { SITE } from '../../config/site';
import '../../styles/profondeur.css';
import '../../styles/league-of-database.css';

const titre = `League Of Database — ${SITE.nom}`;
const description = 'Retrouver les données des anciens patchs de League of Legends, sur ordinateur et mobile, puis découvrir les caches et sauvegardes de League Of Database.';
const taillesColonnes = '(max-width: 799px) calc(100vw - 48px), (max-width: 1360px) calc((100vw - 144px) / 2), 610px';
const taillesSecondaires = '(max-width: 799px) calc(100vw - 80px), (max-width: 1360px) 55vw, 790px';
const taillesFiches = '(max-width: 799px) 260px, (max-height: 700px) 500px, 950px';
const fiches = [
  { nom: 'ahri', titre: 'Le champion', alt: 'La fiche d’Ahri dans League Of Database, avec son portrait et ses informations.' },
  { nom: 'ahri-capacites', titre: 'Ses capacités', alt: 'Les capacités d’Ahri, leurs descriptions et leurs valeurs dans la version choisie.' },
  { nom: 'ahri-skins', titre: 'Ses apparences', alt: 'La galerie des apparences d’Ahri dans League Of Database.' },
  { nom: 'ahri-skin-detail', titre: 'En grand', alt: 'L’apparence Ahri dynastique ouverte en grand dans la visionneuse de League Of Database.' },
];
---
<Base titre={titre} description={description} chemin="/projets/league-of-database">
  <article class="profondeur cas-league" data-lod-page>
    <div class="wrap"><FilAriane courant="League Of Database" projet /></div>
    <header class="lod-hero wrap" id="explorer">
      <div class="lod-hero__texte">
        <p class="lod-nom">League Of Database</p>
        <h1>Les données de League,<br />patch après patch.</h1>
        <p class="lod-intro">Une application pour retrouver les champions, objets, runes et sorts de League of Legends dans les anciennes versions du jeu.</p>
        <a class="btn btn--plein" href="https://www.league-of-data-base.com" data-umami-event="lien-sortant" data-umami-event-domaine="www.league-of-data-base.com" data-umami-event-emplacement="hero">Découvrir l’application <span aria-hidden="true">↗</span></a>
        <p class="lod-role">Application web · ordinateur et mobile</p>
      </div>
      <figure class="lod-hero__visuel">
        <div class="lod-bureau"><CaptureLeague nom="histoire-champions" alt="Les champions de League of Legends au patch 3.6.14, dans le catalogue de League Of Database." prioritaire adaptatif={false} tailles="(max-width: 799px) calc(100vw - 90px), (max-width: 1050px) 48vw, 650px" /></div>
        <div class="lod-mobile"><CaptureLeague nom="histoire-ahri-mobile" alt="La fiche d’Ahri au patch 3.6.14, sur téléphone." largeur={430} hauteur={932} tailles="(max-width: 799px) min(144px, 22vw), (max-width: 1050px) 110px, 140px" /></div>
        <figcaption>Un ancien patch, sur ordinateur comme sur mobile.</figcaption>
      </figure>
    </header>
    <nav class="lod-sommaire" aria-label="Dans cette page"><div class="wrap">
      <a href="#versions">L’historique</a><a href="#anciennes-fiches">Un ancien patch</a><a href="#champions">Les fiches</a><a href="#objets">Les objets</a><a href="#trafic">Le trafic</a><a href="#audience">L’audience</a><a href="#sauvegardes">Les sauvegardes</a>
    </div></nav>
    <div class="wrap">
      <section class="lod-section lod-historique" id="versions" aria-labelledby="versions-titre">
        <div class="lod-tete"><h2 id="versions-titre">Choisir un ancien patch.<br />Ouvrir ses données.</h2><p>Chaque version ouvre ses champions, ses objets, ses runes et ses sorts.</p></div>
        <ol class="lod-historique__etapes">
          <li><div class="lod-historique__legende"><span aria-hidden="true">01</span><h3>Parcourir l’historique</h3></div><CaptureLeague nom="historique-anciens-patchs" tailles={taillesColonnes} alt="La partie 3.x de l’historique des patchs dans League Of Database, avec les liens vers les quatre catalogues de chaque ancienne version." /></li>
          <li><div class="lod-historique__legende"><span aria-hidden="true">02</span><h3>Retrouver le catalogue de l’époque</h3></div><CaptureLeague nom="histoire-champions" tailles={taillesColonnes} alt="Le catalogue des 113 champions disponibles au patch 3.6.14 de League of Legends." /><p class="lod-historique__patch">Exemple : patch <strong>3.6.14</strong></p></li>
        </ol>
      </section>
      <section class="lod-section lod-archives" id="anciennes-fiches" aria-labelledby="archives-titre">
        <div class="lod-tete"><h2 id="archives-titre">Ahri, au patch 3.6.14.</h2><p>Les caractéristiques et les capacités de cette version, dans sa fiche.</p></div>
        <figure class="lod-archives__donnees"><CaptureLeague nom="histoire-ahri-statistiques" alt="Les statistiques d’Ahri au patch 3.6.14, avec 380 points de vie de base et 50 points d’attaque de base." /><figcaption>Les valeurs suivent le patch consulté.</figcaption></figure>
        <div class="lod-archives__suite"><div><h3>Les apparences disponibles dans ce patch.</h3><p>Trois apparences dans le catalogue d’Ahri au patch 3.6.14.</p></div><CaptureLeague nom="histoire-skins" tailles={taillesSecondaires} alt="Les trois apparences d’Ahri présentes dans le catalogue du patch 3.6.14, avec leurs illustrations." /></div>
      </section>
      <section class="lod-section lod-champions" id="champions" aria-labelledby="champions-titre">
        <div class="lod-tete"><h2 id="champions-titre">Les fiches à explorer.</h2><p>Exemple : Ahri dans le patch 16.20.1.</p></div>
        <fieldset class="lod-fiches">
          <legend class="sr">Explorer la fiche d’Ahri</legend>
          {fiches.map((fiche, index) => <input class="sr" type="radio" name="fiche-ahri" id={`fiche-${fiche.nom}`} checked={index === 0} />)}
          <div class="lod-fiches__choix">{fiches.map((fiche) => <label for={`fiche-${fiche.nom}`}>{fiche.titre}</label>)}</div>
          <div class="lod-fiches__ecrans">{fiches.map((fiche) => <figure class={`lod-fiche lod-fiche--${fiche.nom}`}><CaptureLeague nom={fiche.nom} tailles={taillesFiches} alt={fiche.alt} /><figcaption>{fiche.titre === 'Ses capacités' ? 'Les effets, les valeurs et les temps de récupération.' : fiche.titre === 'Ses apparences' ? 'Les illustrations du jeu, réunies dans une galerie.' : fiche.titre === 'En grand' ? 'Une apparence ouverte dans la visionneuse de l’application.' : 'Ahri, ses rôles et ses caractéristiques.'}</figcaption></figure>)}</div>
        </fieldset>
      </section>
      <section class="lod-section" id="objets" aria-labelledby="objets-titre">
        <div class="lod-tete"><h2 id="objets-titre">Les objets, leurs effets,<br />leurs recettes.</h2><p>Prix, caractéristiques et composants du patch consulté.</p></div>
        <div class="lod-objets">
          <figure><CaptureLeague nom="objets" tailles={taillesColonnes} alt="Le catalogue des objets de League of Legends dans League Of Database." /><figcaption><span>01</span><strong>Parcourir les objets</strong></figcaption></figure>
          <figure><CaptureLeague nom="objet-recette" tailles={taillesColonnes} alt="La fiche de la Coiffe de Rabadon avec son prix, ses effets et les composants de sa recette." /><figcaption><span>02</span><strong>Comprendre la recette</strong></figcaption></figure>
        </div>
        <div class="lod-runes"><div><h3>Une rune, dans son arbre.</h3><p>Les runes et les sorts d’invocateur complètent le catalogue.</p></div><CaptureLeague nom="runes" tailles={taillesSecondaires} alt="L’arbre de runes Précision et les effets de la rune Attaque soutenue dans League Of Database." /></div>
      </section>
    </div>
    <div class="lod-fabrication"><div class="wrap">
      <header class="lod-tech-intro"><p>Dans les coulisses</p><h2>Conserver les versions.<br />Servir les fiches.</h2><a href="https://github.com/LINDECKER-Charles/LeagueOfDataBaseFinal/tree/dev" data-umami-event="lien-sortant" data-umami-event-domaine="github.com" data-umami-event-emplacement="preuves">Voir le code source <span aria-hidden="true">↗</span></a></header>
      <FabricationLeague>
      <section class="lod-section lod-audience" id="audience" aria-labelledby="audience-titre">
        <div class="lod-tete"><h2 id="audience-titre">Voir ce qui est consulté.</h2><p>Umami suit les pages et les usages du catalogue.</p></div>
        <div class="lod-mesure" aria-label="Le trajet d’un événement de mesure d’audience">
          <div class="lod-mesure__page"><svg viewBox="0 0 80 64" aria-hidden="true"><rect x="7" y="6" width="66" height="50" rx="4"/><path d="M7 17h66M17 28h18v18H17m28-18h16m-16 9h16m-16 9h9"/></svg><h3>Une fiche ouverte</h3><p>Page · langue · patch</p></div>
          <div class="lod-mesure__fleche" aria-hidden="true">→</div>
          <div class="lod-mesure__evenement"><svg viewBox="0 0 80 64" aria-hidden="true"><path d="M8 33h13l8-19 14 38 9-25h20"/><circle cx="8" cy="33" r="3"/><circle cx="72" cy="27" r="3"/></svg><h3>Un usage mesuré</h3><p>Recherche · partage</p></div>
          <div class="lod-mesure__fleche" aria-hidden="true">→</div>
          <div class="lod-mesure__umami"><svg viewBox="0 0 80 64" aria-hidden="true"><path d="M10 52V10m0 42h62M21 43V33h8v10m9 0V24h8v19m9 0V15h8v28"/></svg><h3>Umami</h3><p>Audience et événements</p></div>
        </div>
        <p class="lod-note">La mesure d’audience complète les métriques du serveur : les visites et la charge technique se lisent séparément.</p>
      </section>
      </FabricationLeague>
    </div></div>
    <div class="wrap">
      <aside class="lod-credits" aria-label="À propos des captures"><p>Captures de la véritable application, le 12 octobre 2026. Les données et illustrations du jeu proviennent de Riot Games. Projet indépendant, sans affiliation à Riot Games.</p></aside>
      <ContinuerLecture liens={[
        { href: '/projets/bloodborne-legendary-run', titre: 'Bloodborne Legendary Run', detail: 'Un compagnon pour retrouver sa progression.' },
        { href: '/projets', titre: 'Les projets', detail: 'Revenir à la sélection.' },
        { href: '/contact', titre: 'Discutons', detail: 'Parlons de ce que nous pourrions construire.' },
      ]} />
    </div>
    <dialog class="lod-visionneuse" data-lod-dialog aria-labelledby="lod-capture-titre" aria-describedby="lod-capture-aide">
      <h2 class="sr" id="lod-capture-titre" data-lod-caption>Capture de League Of Database</h2>
      <button class="lod-visionneuse__image" type="button" aria-label="Fermer la capture"><img data-lod-full alt="" /><span class="lod-capture__statut" data-lod-status role="status" hidden></span></button>
      <p id="lod-capture-aide">Cliquez sur l’image ou appuyez sur Échap pour revenir.</p>
    </dialog>
  </article>
</Base>
<script>
  import '../../scripts/league-captures';
</script>
