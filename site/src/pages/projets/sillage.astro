---
/**
 * Sillage : la preuve d’« orchestrer des agents IA ». Page bâtie sur le
 * gabarit commun des pages de projet (components/projets/gabarit, règle E5) :
 * en-tête et fiche, corps libre (le principe, composer une tâche, reprendre
 * après une coupure, le résultat), « Comment je l’ai construit », sortie et
 * note de sources. Données et sources : config/sillage.ts, que cette page
 * tient seule (sa carte de la vitrine comprise).
 *
 * Dépôt privé (décision de Charles du 14/10/2026) : aucun lien vers le code,
 * aucun nom de dépôt, aucune tâche réelle. Les écrans sont de vraies vues de
 * l’application lancée en local sur des projets de démonstration
 * (src/assets/projets/sillage/README.md, registre SIL-C1).
 */
import Base from '../../layouts/Base.astro';
import CorpsProjet from '../../components/projets/gabarit/CorpsProjet.astro';
import DecisionsProjet from '../../components/projets/gabarit/DecisionsProjet.astro';
import EnTeteProjet from '../../components/projets/gabarit/EnTeteProjet.astro';
import SectionProjet from '../../components/projets/gabarit/SectionProjet.astro';
import SortieProjet from '../../components/projets/gabarit/SortieProjet.astro';
import SourcesProjet from '../../components/projets/gabarit/SourcesProjet.astro';
import CadreCapture from '../../components/ui/CadreCapture.astro';
import CaptureAnnotee from '../../components/ui/CaptureAnnotee.astro';
import Visionneuse from '../../components/ui/Visionneuse.astro';
import composer from '../../assets/projets/sillage/creer-avec-un-agent.webp';
import graphe from '../../assets/projets/sillage/graphe-en-direct.webp';
import projet from '../../assets/projets/sillage/page-projet.webp';
import projetMobile from '../../assets/projets/sillage/page-projet-mobile.webp';
import recapitulatif from '../../assets/projets/sillage/recapitulatif.webp';
import reprendre from '../../assets/projets/sillage/reprendre-execution.webp';
import { SITE } from '../../config/site';
import { DECISIONS, ECRANS, EN_TETE, FICHE, LIENS_SORTIE, PREUVES, SECTIONS } from '../../config/sillage';
import { typo } from '../../lib/typo';

// ≤ 45 caractères avant « — Charles Lindecker » (titre ≤ 65 au total).
const titre = `Sillage, orchestrer des agents IA — ${SITE.nom}`;
// 110 à 165 caractères.
const description = 'Sillage lance sur ma machine un graphe d’agents IA, les suit, leur fait corriger une réponse mal formée et reprend après une coupure. Conçu et développé seul.';

/**
 * La page projet suit la largeur de l’écran, comme l’application : la vue de
 * bureau au-delà de 860 px, la vue de téléphone en dessous. Sans JavaScript,
 * la vue masquée prend une source neutre et ne télécharge rien.
 */
const neutreBureau = 'screen and (scripting: none) and (max-width: 860px)';
const neutreMobile = 'screen and (scripting: none) and (min-width: 861px)';
// Les alts suivent la typographie du texte visible (insécables avant « : ; ! ? »).
const alt = (ecran: keyof typeof ECRANS) => typo(ECRANS[ecran].alt);
---

<Base titre={titre} description={description} chemin="/projets/sillage" sommaire={SECTIONS}>
  <EnTeteProjet projet="sillage" titre={EN_TETE.titre} chapeau={EN_TETE.chapeau} liens={EN_TETE.liens} preuves={PREUVES} fiche={FICHE}>
    <CadreCapture
      slot="visuel"
      type="navigateur"
      src={graphe}
      alt={alt('graphe')}
      legende={ECRANS.graphe.legende}
      class="sil-entete-capture"
      sizes="(max-width: 860px) 100vw, (max-width: 1100px) 640px, 560px"
      widths={[640, 1200, 1600, 2400]}
      loading="eager"
      agrandir
    />
  </EnTeteProjet>

  <CorpsProjet sections={SECTIONS}>
    <SectionProjet id="principe" etiquette="Le principe" titre="Une tâche, c’est un graphe d’agents" alignement="centre">
      <Fragment slot="texte">
        <p>Dans Sillage, je décris une tâche comme un graphe. Certains agents ont une place fixe&nbsp;; d’autres coordonnent et créent leurs sous-agents en cours de route. Chacun reçoit sa mission, ses dossiers et le livrable qu’il doit rendre.</p>
        <p>Sillage ne lance pas les agents lui-même&nbsp;: il confie chaque session à <a href="/projets/relais">Relais</a>, mon fournisseur d’agents, par son API. <a href="/projets/karl-scraper">Karl Scraper</a> y pousse aussi ses plans, pour qu’un agent en compose les tâches.</p>
        <p>La page d’un projet montre ce qui tourne. En haut de cette page, l’une de ces exécutions en direct&nbsp;: un coordinateur a créé trois sous-agents, au travail en même temps.</p>
      </Fragment>
      <div slot="figure" class="sil-projet">
        <CadreCapture
          class="sil-projet__bureau"
          type="navigateur"
          src={projet}
          alt={alt('projet')}
          legende={ECRANS.projet.legende}
          sizes="(max-width: 860px) 1px, (max-width: 1100px) 100vw, 560px"
          widths={[640, 1200, 1600]}
          neutre={neutreBureau}
          agrandir
        />
        <CadreCapture
          class="sil-projet__mobile"
          type="telephone"
          src={projetMobile}
          alt={alt('projet')}
          legende={ECRANS.projet.legende}
          sizes="(max-width: 860px) 300px, 1px"
          widths={[390, 780]}
          neutre={neutreMobile}
          agrandir
        />
      </div>
    </SectionProjet>

    <SectionProjet id="composer" etiquette="Composer une tâche" titre="Un agent compose la tâche, Sillage la vérifie">
      <Fragment slot="texte">
        <p>Je peux dessiner le graphe à la main, ou décrire ce que je veux à un assistant. Il compose alors la tâche par les outils MCP de Sillage, un agent par appel, dans un brouillon que je vois se remplir.</p>
        <p>Chaque ajout passe par les validations de Sillage. Ici, la relecture arrive avant l’équipe dont elle dépend&nbsp;: elle est refusée. L’assistant ajoute l’équipe, puis la relecture. Pour cette demande, il ne lit que le projet et ne lance rien sans moi.</p>
      </Fragment>
      <CaptureAnnotee
        class="sil-composer"
        type="navigateur"
        src={composer}
        alt={alt('composer')}
        legende={ECRANS.composer.legende}
        ratio="2880 / 2080"
        cible={{ x: 59.8, y: 45.9 }}
        loupe={{ x: 77.3, y: 49.2, zoom: 2.73, largeur: 48, ratio: '11 / 2', coin: 'bas-gauche', dessous: true }}
        sizes="(max-width: 860px) 100vw, (max-width: 1100px) 90vw, 1040px"
        widths={[640, 1200, 1600, 2400]}
        agrandir
      />
    </SectionProjet>

    <SectionProjet id="reprendre" etiquette="Reprendre après une coupure" titre="Une coupure ne fait pas tout recommencer" alignement="centre">
      <Fragment slot="texte">
        <p>Une exécution peut s’arrêter en route&nbsp;: un redémarrage du serveur, une coupure. Sillage propose alors de la reprendre là où elle en était.</p>
        <p>Les agents qui avaient fini gardent leur résultat. Celui qui travaillait reprend sa session, encore ouverte chez Relais, sans en ouvrir une nouvelle&nbsp;; les étapes suivantes repartent ensuite. Je peux ajouter des consignes avant de relancer.</p>
      </Fragment>
      <CadreCapture
        slot="figure"
        class="sil-panneau sil-reprendre"
        type="terminal"
        src={reprendre}
        alt={alt('reprendre')}
        legende={ECRANS.reprendre.legende}
        sizes="(max-width: 860px) 100vw, (max-width: 1100px) 640px, 480px"
        widths={[640, 960, 1240]}
        agrandir
      />
    </SectionProjet>

    <SectionProjet id="resultat" etiquette="Le résultat" titre="À la fin, je sais où est le résultat">
      <Fragment slot="texte">
        <p>Quand l’exécution se termine, le récapitulatif dit où se trouve le résultat final&nbsp;: le dossier, la branche, le commit. Il dit aussi ce que sont devenus les worktrees, les copies de travail Git où chaque agent a écrit&nbsp;: ceux qui restent à fusionner, ceux qui ont été supprimés.</p>
        <p>Puis, agent par agent, ce qu’il a rendu&nbsp;: un résumé, ses décisions, ses contrôles et la suite qu’il propose. C’est le résultat court que chaque agent doit tenir, et ce que reçoivent les agents qui le suivent.</p>
      </Fragment>
      <CadreCapture
        slot="figure"
        class="sil-panneau sil-resultat"
        type="terminal"
        src={recapitulatif}
        alt={alt('resultat')}
        legende={ECRANS.resultat.legende}
        ratio="4 / 5"
        position="50% 0"
        sizes="(max-width: 860px) 100vw, (max-width: 1100px) 640px, 520px"
        widths={[640, 1040, 1588]}
        agrandir
      />
    </SectionProjet>

    <DecisionsProjet decisions={DECISIONS} chapeau="Quatre choix qui ne se voient pas à l’écran, chacun né d’un problème mesuré." />

    <SortieProjet projet="sillage" titre="Aujourd’hui" liens={LIENS_SORTIE}>
      <p>Neuf exécutions réelles en huit jours, 579&nbsp;agents lancés, sept blocages durs relevés puis traités&nbsp;: Sillage tourne aujourd’hui sur mon poste, avec Relais.</p>
    </SortieProjet>

    <SourcesProjet>
      <p><b>Le projet.</b> Dépôt privé, présenté sans lien, relu le 14/10/2026 à la révision c256e76 du 13/10/2026&nbsp;: un serveur en Rust (Axum, Tokio, SQLite embarqué) et une interface Angular&nbsp;22, testés en intégration continue sous Windows et macOS, sur processeurs Apple et Intel. 783&nbsp;commits d’un seul auteur, du 19/09 au 13/10/2026.</p>
      <p><b>Chiffres.</b> Les 579&nbsp;agents et les 63&nbsp;500 appels d’outils, dont 1&nbsp;004 en échec à l’origine de sept blocages durs, viennent du registre des blocages du dépôt (révision 9b4533a du 05/10/2026)&nbsp;; il couvre neuf exécutions réelles, du 26/09 au 03/10/2026. Les 643&nbsp;tests du serveur sont comptés dans son code à la révision c256e76&nbsp;; avec 206&nbsp;tests Node, 22&nbsp;parcours d’interface et 14&nbsp;scénarios de bout en bout, ils se jouent contre un fournisseur simulé, sans abonnement.</p>
      <p><b>Décisions.</b> Les 10&nbsp;000 à 27&nbsp;000 caractères par réponse viennent des contrats de contexte (révision 480e358)&nbsp;; les 26&nbsp;commandes Git bloquées et les 39&nbsp;blocages de commit, du registre des blocages&nbsp;; les 2,19&nbsp;milliards de tokens relus sur 79&nbsp;sessions, de la mesure qui a motivé la fenêtre de compaction (révision ae2efd8 du 12/10/2026)&nbsp;; le découplage de Relais, du rapport d’architecture (révision ed4080b). Les deux corrections au plus et la fenêtre de 300&nbsp;000 tokens sont lues dans le code.</p>
      <p><b>Écrans.</b> L’application lancée en local à la révision c256e76, contre le faux fournisseur des tests du dépôt, sur des projets, des tâches et des résultats de démonstration&nbsp;: aucun abonnement, aucune donnée ni tâche réelle. Leurs durées et leurs commits ne mesurent rien.</p>
    </SourcesProjet>
  </CorpsProjet>

  <Visionneuse />
</Base>

<style>
  /* La page projet : la vue de bureau, ou la vue de téléphone sous 861 px. */
  .sil-projet {
    min-width: 0;
  }

  .sil-projet :global(.sil-projet__mobile) {
    display: none;
  }

  /* L’assistant de création, en pleine largeur sous son texte. */
  :global(.sil-composer) {
    margin-top: var(--s6);
  }

  /* Le dialogue et le panneau : capturés seuls, sans fenêtre autour ; un
     filet et les coins des cadres les posent sur la page. */
  :global(figure.sil-panneau.capture--terminal .capture__cadre) {
    border: 1px solid var(--trait);
    border-radius: var(--r2);
    background: var(--cadre);
    box-shadow: var(--ombre-1);
  }

  :global(.sil-reprendre),
  :global(.sil-resultat) {
    max-width: 30rem;
    margin-inline: auto;
  }

  @media (max-width: 860px) {
    .sil-projet :global(.sil-projet__bureau) {
      display: none;
    }

    .sil-projet :global(.sil-projet__mobile) {
      display: block;
      width: min(100%, 300px);
      margin-inline: auto;
    }
  }
</style>
