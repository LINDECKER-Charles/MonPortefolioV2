---
/**
 * ÉBAUCHE du socle : remplacée par la page du projet.
 *
 * Sillage : la preuve de « Orchestrer des agents IA ». Page bâtie sur le gabarit
 * commun des pages de projet (components/projets/gabarit, règle E5) : en-tête
 * et fiche, une section, « Comment je l’ai construit », sortie et note de
 * sources. Données et sources : config/sillage.ts, que cette page tient
 * seule (sa carte de la vitrine comprise).
 */
import Base from '../../layouts/Base.astro';
import CorpsProjet from '../../components/projets/gabarit/CorpsProjet.astro';
import DecisionsProjet from '../../components/projets/gabarit/DecisionsProjet.astro';
import EnTeteProjet from '../../components/projets/gabarit/EnTeteProjet.astro';
import SectionProjet from '../../components/projets/gabarit/SectionProjet.astro';
import SortieProjet from '../../components/projets/gabarit/SortieProjet.astro';
import SourcesProjet from '../../components/projets/gabarit/SourcesProjet.astro';
import { SITE } from '../../config/site';
import { DECISIONS, EN_TETE, FICHE, LIENS_SORTIE, PREUVES, SECTIONS } from '../../config/sillage';

// ≤ 45 caractères avant « — Charles Lindecker » (titre ≤ 65 au total).
const titre = `Sillage, orchestrer des agents IA — ${SITE.nom}`;
// 110 à 165 caractères.
const description = 'Sillage : un orchestrateur local qui lance un graphe d’agents IA, les suit, corrige leurs réponses et reprend après une coupure, sans perdre la main.';
---

<Base titre={titre} description={description} chemin="/projets/sillage" sommaire={SECTIONS}>
  <EnTeteProjet projet="sillage" titre={EN_TETE.titre} chapeau={EN_TETE.chapeau} liens={EN_TETE.liens} preuves={PREUVES} fiche={FICHE} />

  <CorpsProjet sections={SECTIONS}>
    <SectionProjet id="apercu" titre="En bref">
      <Fragment slot="texte">
        <p>On dessine le graphe&nbsp;: des agents fixes, et des coordinateurs qui créent leurs sous-agents en cours de route. Sillage confie chaque session à <a href="/projets/relais">Relais</a>, suit les échanges et dit, à la fin, où se trouve le résultat&nbsp;: le worktree, la branche, le commit.</p>
        <p>Une exécution coupée se reprend&nbsp;: Sillage relance les étapes à refaire et réutilise les agents qu’il peut garder.</p>
      </Fragment>
    </SectionProjet>

    <DecisionsProjet decisions={DECISIONS} />

    <SortieProjet projet="sillage" liens={LIENS_SORTIE}>
      <p>Plusieurs agents, une seule chaîne&nbsp;: on la suit, on la reprend, on la relit.</p>
    </SortieProjet>

    <SourcesProjet>
      <p><b>Le projet.</b> Dépôt privé, présenté sans lien, relu le 14/10/2026 à la révision c256e76 du 13/10/2026. Les 579&nbsp;agents viennent de son registre des blocages (révision du 05/10/2026), qui couvre neuf exécutions réelles du 26/09 au 03/10/2026&nbsp;; les 2,19&nbsp;milliards de tokens relus, de la mesure qui a motivé la fenêtre de compaction (révision du 12/10/2026).</p>
      <p><b>Données.</b> Aucune exécution ni tâche réelle n’est nommée sur cette page.</p>
    </SourcesProjet>
  </CorpsProjet>
</Base>
