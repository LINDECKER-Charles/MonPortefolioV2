---
/**
 * Sillage : la preuve d’« orchestrer des agents IA ». Page bâtie sur le
 * gabarit commun des pages de projet (components/projets/gabarit, règle E5) :
 * en-tête et fiche, corps libre (le principe, composer une tâche, reprendre
 * après une coupure, le résultat), « Sous le capot », sortie et
 * note de sources. Données et sources : config/sillage.ts, que cette page
 * tient seule (sa carte de la vitrine comprise).
 *
 * Dépôt privé (décision de Charles du 14/10/2026) : aucun lien vers le code,
 * aucun nom de dépôt, aucune tâche réelle. Les écrans sont de vraies vues de
 * l’application lancée en local sur des projets de démonstration
 * (src/assets/projets/sillage/README.md, registre SIL-C1).
 */
import Base from '../../layouts/Base.astro';
import CorpsProjet from '../../components/projets/gabarit/CorpsProjet.astro';
import EnTeteProjet from '../../components/projets/gabarit/EnTeteProjet.astro';
import SectionProjet from '../../components/projets/gabarit/SectionProjet.astro';
import SortieProjet from '../../components/projets/gabarit/SortieProjet.astro';
import SourcesProjet from '../../components/projets/gabarit/SourcesProjet.astro';
import SousLeCapot from '../../components/projets/gabarit/SousLeCapot.astro';
import CadreCapture from '../../components/ui/CadreCapture.astro';
import CaptureAnnotee from '../../components/ui/CaptureAnnotee.astro';
import Visionneuse from '../../components/ui/Visionneuse.astro';
import composer from '../../assets/projets/sillage/creer-avec-un-agent.webp';
import graphe from '../../assets/projets/sillage/graphe-en-direct.webp';
import projet from '../../assets/projets/sillage/page-projet.webp';
import projetMobile from '../../assets/projets/sillage/page-projet-mobile.webp';
import recapitulatif from '../../assets/projets/sillage/recapitulatif.webp';
import recapitulatifMobile from '../../assets/projets/sillage/recapitulatif-mobile.webp';
import reprendre from '../../assets/projets/sillage/reprendre-execution.webp';
import reprendreMobile from '../../assets/projets/sillage/reprendre-execution-mobile.webp';
import { SITE } from '../../config/site';
import { CAPOT, ECRANS, EN_TETE, FICHE, FONCTIONS, LIENS_SORTIE, PREUVES, SECTIONS } from '../../config/sillage';
import { typo } from '../../lib/typo';

// ≤ 45 caractères avant « — Charles Lindecker » (titre ≤ 65 au total).
const titre = `Sillage, orchestrer des agents IA — ${SITE.nom}`;
// 110 à 165 caractères.
const description = 'Sillage orchestre sur ma machine des agents IA qui écrivent du code, les suit, leur fait corriger une réponse mal formée et reprend après une coupure.';

/**
 * La page projet, le dialogue de reprise et le récapitulatif suivent la
 * largeur de l’écran, comme l’application : la vue de bureau au-delà de
 * 860 px, la vue de téléphone (capturée à 390 px) en dessous, où la vue de
 * bureau deviendrait illisible. Sans JavaScript, la vue masquée prend une
 * source neutre et ne télécharge rien.
 */
const neutreBureau = 'screen and (scripting: none) and (max-width: 860px)';
const neutreMobile = 'screen and (scripting: none) and (min-width: 861px)';
// Les alts suivent la typographie du texte visible (insécables avant « : ; ! ? »).
const alt = (ecran: keyof typeof ECRANS) => typo(ECRANS[ecran].alt);
---

<Base titre={titre} description={description} chemin="/projets/sillage" sommaire={SECTIONS}>
  <EnTeteProjet projet="sillage" titre={EN_TETE.titre} chapeau={EN_TETE.chapeau} liens={EN_TETE.liens} preuves={PREUVES} fiche={FICHE}>
    <CadreCapture
      slot="visuel"
      type="navigateur"
      src={graphe}
      alt={alt('graphe')}
      legende={ECRANS.graphe.legende}
      class="sil-entete-capture"
      region={{ x: 42.5, y: 23.2, l: 49, h: 67.6 }}
      regionMobile={{ x: 42.5, y: 26.8, l: 32, h: 63.6 }}
      sizes="(max-width: 860px) 313vw, (max-width: 1100px) 1310px, 1150px"
      widths={[1200, 1600, 2400]}
      loading="eager"
      agrandir
    />
  </EnTeteProjet>

  <CorpsProjet sections={SECTIONS}>
    <SectionProjet id="principe" etiquette="Le principe" titre="Une tâche, c’est un graphe d’agents">
      <Fragment slot="texte">
        <p>Dans Sillage, je décris une tâche comme un graphe. Certains agents ont une place fixe&nbsp;; d’autres coordonnent et créent leurs sous-agents en cours de route. Chacun reçoit sa mission, ses dossiers et le livrable qu’il doit rendre.</p>
        <p>Sillage ne démarre pas lui-même les sessions des agents&nbsp;: il les confie à <a href="/projets/relais">Relais</a>, mon point d’accès local aux agents, par son API. <a href="/projets/karl-scraper">Karl Scraper</a> y pousse aussi ses plans, pour qu’un agent en compose les tâches.</p>
        <p>La page d’un projet rassemble ses tâches et ce qui tourne&nbsp;: ici, un assistant compose une tâche pendant qu’une autre s’exécute.</p>
      </Fragment>
      <div class="sil-projet">
        <CadreCapture
          class="sil-projet__bureau"
          type="navigateur"
          src={projet}
          alt={alt('projet')}
          legende={ECRANS.projet.legende}
          region={{ x: 18.75, y: 8, l: 79.25, h: 78 }}
          sizes="(max-width: 860px) 1px, (max-width: 1100px) 115vw, 1320px"
          widths={[1200, 1600, 2400]}
          neutre={neutreBureau}
          agrandir
        />
        <CadreCapture
          class="sil-projet__mobile"
          type="telephone"
          src={projetMobile}
          alt={alt('projet')}
          legende={ECRANS.projet.legende}
          sizes="(max-width: 860px) 300px, 1px"
          widths={[390, 780]}
          neutre={neutreMobile}
          agrandir
        />
      </div>
    </SectionProjet>

    <SectionProjet id="composer" etiquette="Composer une tâche" titre="Un agent compose la tâche, Sillage la vérifie">
      <Fragment slot="texte">
        <p>Je peux dessiner le graphe à la main, ou décrire ce que je veux à un assistant. Il compose alors la tâche par les outils que Sillage lui ouvre (MCP), un agent par appel, dans un brouillon que je vois se remplir.</p>
        <p>Chaque ajout passe par les validations de Sillage. Ici, la relecture arrive avant l’équipe dont elle dépend&nbsp;: elle est refusée. L’assistant ajoute l’équipe, puis la relecture. Pour cette demande, il ne lit que le projet et ne lance rien sans moi.</p>
      </Fragment>
      <CaptureAnnotee
        class="sil-composer"
        type="navigateur"
        src={composer}
        alt={alt('composer')}
        legende={ECRANS.composer.legende}
        ratio="2880 / 2080"
        cible={{ x: 59.8, y: 45.9 }}
        loupe={{ x: 77.3, y: 49.2, zoom: 2.73, largeur: 48, ratio: '11 / 2', coin: 'bas-gauche', dessous: true }}
        sizes="(max-width: 860px) 100vw, (max-width: 1100px) 90vw, 1040px"
        widths={[640, 1200, 1600, 2400]}
        agrandir
      />
    </SectionProjet>

    <div class="sil-acte acte-teinte">
      <SectionProjet id="reprendre" etiquette="Reprendre après une coupure" titre="Une coupure ne fait pas tout recommencer" alignement="centre">
        <Fragment slot="texte">
          <p>Une exécution peut s’arrêter en route&nbsp;: un redémarrage du serveur, une coupure. Sillage propose alors de la reprendre là où elle en était.</p>
          <p>Les agents qui avaient fini gardent leur résultat. Celui qui travaillait reprend sa session, encore ouverte chez Relais, sans en ouvrir une nouvelle&nbsp;; les étapes suivantes repartent ensuite. Si j’ajoute des consignes de reprise, il repart dans une nouvelle session qui les reçoit.</p>
        </Fragment>
        <div slot="figure" class="sil-paire sil-reprendre">
          <CadreCapture
            class="sil-paire__bureau"
            type="panneau"
            src={reprendre}
            alt={alt('reprendre')}
            legende={ECRANS.reprendre.legende}
            sizes="(max-width: 860px) 1px, (max-width: 1100px) 640px, 480px"
            widths={[640, 960, 1240]}
            neutre={neutreBureau}
            agrandir
          />
          <CadreCapture
            class="sil-paire__mobile"
            type="panneau"
            src={reprendreMobile}
            alt={alt('reprendre')}
            legende={ECRANS.reprendre.legende}
            sizes="(max-width: 860px) min(100vw, 416px), 1px"
            widths={[390, 740]}
            neutre={neutreMobile}
            agrandir
          />
        </div>
      </SectionProjet>

      <SectionProjet id="resultat" etiquette="Le résultat" titre="À la fin, je sais où est le résultat">
        <Fragment slot="texte">
          <p>Quand l’exécution se termine, le récapitulatif dit où se trouve le résultat final&nbsp;: le dossier, la branche, le commit. Il dit aussi ce que sont devenus les worktrees, les copies de travail Git où chaque agent a écrit&nbsp;: ceux qui restent à fusionner, ceux qui ont été supprimés.</p>
          <p>Puis, agent par agent, ce qu’il a rendu&nbsp;: un résumé, ses décisions, ses contrôles et la suite qu’il propose. C’est le résultat court que chaque agent doit tenir, et ce que reçoivent les agents qui le suivent.</p>
        </Fragment>
        <div class="sil-paire sil-resultat">
          <CadreCapture
            class="sil-paire__bureau"
            type="panneau"
            src={recapitulatif}
            alt={alt('resultat')}
            legende={ECRANS.resultat.legende}
            ratio="1588 / 1420"
            position="50% 0"
            sizes="(max-width: 860px) 1px, 800px"
            widths={[1040, 1588]}
            neutre={neutreBureau}
            agrandir
          />
          <CadreCapture
            class="sil-paire__mobile"
            type="panneau"
            src={recapitulatifMobile}
            alt={alt('resultatMobile')}
            legende={ECRANS.resultatMobile.legende}
            sizes="(max-width: 860px) min(100vw, 416px), 1px"
            widths={[390, 664]}
            neutre={neutreMobile}
            agrandir
          />
        </div>
      </SectionProjet>
    </div>

    <SousLeCapot id="fonctions" titre="Toutes ses fonctions, une ligne chacune" points={FONCTIONS} chapeau="Du projet au résultat : un clic déplie chaque fonction." />

    <SousLeCapot points={CAPOT} chapeau="L’architecture, puis quatre choix nés d’un problème relevé, et ce qui les tient. Le code est privé : les extraits sont des formes simplifiées, écrites pour cette page." />

    <SortieProjet projet="sillage" titre="Aujourd’hui" liens={LIENS_SORTIE}>
      <p>Neuf exécutions réelles en huit jours, 579&nbsp;agents lancés, 63&nbsp;500 appels d’outils, sept blocages durs relevés puis traités&nbsp;: Sillage tourne sur ma machine, avec Relais.</p>
    </SortieProjet>

    <SourcesProjet>
      <p><b>Le projet.</b> Dépôt privé, présenté sans lien, relu le 14/10/2026 à la révision c256e76 du 13/10/2026&nbsp;: un serveur en Rust (Axum, Tokio, SQLite embarqué) et une interface Angular&nbsp;22, testés en intégration continue sous Windows et macOS, sur processeurs Apple et Intel. 783&nbsp;commits d’un seul auteur, du 19/09 au 13/10/2026.</p>
      <p><b>Chiffres.</b> Les 579&nbsp;agents et les 63&nbsp;500 appels d’outils, dont 1&nbsp;004 en échec, viennent du registre des blocages du dépôt (révision 9b4533a du 05/10/2026), qui en tire sept blocages durs&nbsp;; il couvre neuf exécutions réelles, du 26/09 au 03/10/2026. Les 643&nbsp;tests du serveur sont comptés dans son code à la révision c256e76&nbsp;; avec 206&nbsp;tests Node, 22&nbsp;parcours d’interface et 14&nbsp;scénarios de bout en bout, aucun ne consomme d’abonnement&nbsp;: ceux qui parlent à un fournisseur passent par un fournisseur simulé.</p>
      <p><b>Décisions.</b> Les 10&nbsp;000 à 27&nbsp;000 caractères que rendent les agents, quelle que soit la cible annoncée, viennent des contrats de contexte (révision 480e358)&nbsp;; les 26&nbsp;commandes Git bloquées et les 39&nbsp;blocages dus au bac à sable des agents, du registre des blocages&nbsp;; les 2,19&nbsp;milliards de tokens relus sur 79&nbsp;sessions, de la mesure qui a motivé la fenêtre de compaction (révision ae2efd8 du 12/10/2026)&nbsp;; le découplage de Relais et ses trois lectures du dossier voisin, du rapport d’architecture (révision ed4080b). Les deux corrections au plus, la fenêtre de 300&nbsp;000 tokens et les cas où Sillage crée le worktree d’un agent sont lus dans le code.</p>
      <p><b>Écrans.</b> L’application lancée en local à la révision c256e76, contre le faux fournisseur des tests du dépôt, sur des projets, des tâches et des résultats de démonstration&nbsp;: aucun abonnement, aucune donnée ni tâche réelle. Les vues de téléphone sont capturées à 390&nbsp;px de large. Leurs durées et leurs commits ne mesurent rien.</p>
      <p><b>Fonctions et sous le capot.</b> Relus le 15/10/2026 à la même révision&nbsp;: la documentation, le contrat de l’API, les contrats des agents et le code. Les extraits sont des formes simplifiées, écrites pour cette page. Tests comptés dans le code&nbsp;: 643 en Rust, 206 pour les scripts, 22 parcours d’interface et 14 scénarios de bout en bout.</p>
    </SourcesProjet>
  </CorpsProjet>

  <Visionneuse />
</Base>

<style>
  /* La page projet, en pleine largeur sous son texte : la vue de bureau, ou
     la vue de téléphone sous 861 px. */
  .sil-projet {
    min-width: 0;
    margin-top: var(--s6);
  }

  .sil-projet :global(.sil-projet__mobile) {
    display: none;
  }

  /* L’assistant de création, en pleine largeur sous son texte. */
  :global(.sil-composer) {
    margin-top: var(--s6);
  }

  /* « Reprendre » et « Le résultat » : un changement d’acte, la lumière
     teintée (règle B6), sans toucher au gabarit. */
  .sil-acte {
    margin-top: var(--s8);
    padding: 0 clamp(16px, 3.4vw, 40px) clamp(24px, 3.4vw, 40px);
    border-radius: var(--r2);
  }

  .sil-acte :global(.section-projet) {
    padding-top: clamp(24px, 3.4vw, 40px);
  }

  /* Le dialogue et le récapitulatif : la vue de bureau, ou celle capturée à
     390 px sous 861 px. */
  .sil-paire {
    min-width: 0;
  }

  .sil-paire :global(.sil-paire__mobile) {
    display: none;
  }

  .sil-reprendre :global(.sil-paire__bureau) {
    max-width: 30rem;
    margin-inline: auto;
  }

  .sil-resultat {
    margin-top: var(--s6);
  }

  .sil-resultat :global(.sil-paire__bureau) {
    max-width: 50rem;
    margin-inline: auto;
  }

  @media (max-width: 860px) {
    .sil-projet :global(.sil-projet__bureau),
    .sil-paire :global(.sil-paire__bureau) {
      display: none;
    }

    .sil-projet :global(.sil-projet__mobile) {
      display: block;
      width: min(100%, 300px);
      margin-inline: auto;
    }

    .sil-paire :global(.sil-paire__mobile) {
      display: block;
      max-width: 26rem;
      margin-inline: auto;
    }
  }
</style>
