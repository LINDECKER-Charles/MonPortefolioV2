---
import Base from '../../layouts/Base.astro';
import FilAriane from '../../components/pages/FilAriane.astro';
import ContinuerLecture from '../../components/pages/ContinuerLecture.astro';
import DemoGup from '../../components/projets/DemoGup.astro';
import { SITE } from '../../config/site';
import capture from '../../assets/projets/gup-selection.webp';
import '../../styles/profondeur.css';

const titre = `gup, les mises à jour au même endroit — ${SITE.nom}`;
const description = 'Voir les mises à jour, choisir ses logiciels et les lancer au même endroit. Découvrez gup à travers une démonstration, sans rien installer.';
---

<Base titre={titre} description={description} chemin="/projets/gup">
  <article class="wrap profondeur cas-gup">
    <FilAriane courant="gup" projet />
    <header class="page-hero gup-hero">
      <div class="gup-introduction">
        <p class="gup-nom">gup</p>
        <h1>Les mises à jour, au même endroit.</h1>
        <p class="page-hero__intro">Sur l’ordinateur d’un développeur, les logiciels et les outils de développement demandent souvent des commandes de mise à jour différentes. GUP rassemble les mises à jour disponibles dans une liste&nbsp;: on choisit celles que l’on veut lancer.</p>
        <p class="gup-note note">Voir ce qui attend. Choisir. Mettre à jour.</p>
      </div>
      <DemoGup />
    </header>

    <section class="page-section gup-usage" aria-labelledby="besoin-titre">
      <div class="gup-recit prose">
        <h2 id="besoin-titre">Faire le tour de sa machine, en un passage.</h2>
        <p>Sur une machine de développement, les logiciels viennent de plusieurs sources. Chacune propose sa propre façon de vérifier les mises à jour. C’est une tâche répétitive, et il est facile d’en oublier une.</p>
        <p>gup rassemble ce qui est disponible dans une même liste. Je peux cocher un logiciel, plusieurs ou l’ensemble, puis suivre leurs mises à jour depuis l’interface.</p>
        <p>Pour les outils que je mets à jour régulièrement, je peux aussi choisir les logiciels et leur programmer un rendez-vous.</p>
        <p class="page-repere">Disponible sur Windows, macOS et Linux.</p>
      </div>
      <figure class="page-capture gup-capture">
        <img src={capture.src} width={capture.width} height={capture.height} alt="L’interface de gup affiche les logiciels par source, leurs versions et une case pour choisir chacun d’eux." loading="lazy" />
        <figcaption class="legende">La vraie interface de gup. Cette capture utilise des données d’exemple, comme la démonstration ci-dessus.</figcaption>
      </figure>
    </section>

    <details class="gup-details">
      <summary>Le code et les détails techniques</summary>
      <div class="prose">
        <p>gup est un projet open source écrit en TypeScript et Node.js. Il utilise les gestionnaires déjà présents sur la machine pour mettre à jour les logiciels installés globalement. Le code, la documentation et le paquet sont publics.</p>
        <div class="page-liens">
          <a href="https://github.com/LINDECKER-Charles/gup" data-umami-event="lien-sortant" data-umami-event-domaine="github.com" data-umami-event-emplacement="preuves">Le code et la documentation</a>
          <a href="https://www.npmjs.com/package/@charles_lindecker/gup" data-umami-event="lien-sortant" data-umami-event-domaine="www.npmjs.com" data-umami-event-emplacement="preuves">Le paquet sur npm</a>
        </div>
      </div>
    </details>

    <ContinuerLecture liens={[
      { href: '/projets/bloodborne-legendary-run', titre: 'Bloodborne Legendary Run', detail: 'Se donner une nouvelle façon de parcourir un jeu.' },
      { href: '/projets/pvz-fusion', titre: 'PVZF Translation', detail: 'Comprendre le jeu dans sa langue.' },
      { href: '/projets/omnicard', titre: 'Omnicard', detail: 'D’un jeu papier à un jeu dans le navigateur.' },
      { href: '/projets', titre: 'Tous les projets', detail: 'Revenir aux réalisations.' },
    ]} />
  </article>
</Base>

<style>
  .gup-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 88px); align-items: center; }
  .gup-nom { margin-bottom: var(--s4); color: var(--bleu); font-size: 1.5rem; font-weight: 800; line-height: 1; }
  .gup-introduction h1 { max-width: 15ch; }
  .gup-introduction .page-hero__intro { max-width: 41ch; }
  .gup-note { margin-top: var(--s5); font-size: 1.25rem; }
  .gup-usage { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .gup-recit h2 { max-width: 20ch; }
  .gup-recit .page-repere { margin-top: var(--s5); }
  .gup-capture { margin-top: var(--s1); }
  .gup-capture img { border: 1px solid #30363d; background: #0d1117; }
  .gup-capture .legende { max-width: 64ch; }
  .gup-details { border-top: 1px solid var(--filet); border-bottom: 1px solid var(--filet); padding-block: var(--s5); }
  .gup-details summary { width: fit-content; min-height: 44px; padding-block: var(--s2); color: var(--bleu); font-weight: 700; cursor: pointer; }
  .gup-details .prose { padding-top: var(--s5); max-width: 70ch; }
  @media (max-width: 1000px) {
    .gup-hero { grid-template-columns: minmax(0, 1fr); gap: var(--s7); }
    .gup-introduction h1 { max-width: 19ch; }
    .gup-introduction .page-hero__intro { max-width: 56ch; }
    .gup-usage { grid-template-columns: minmax(0, 1fr); gap: var(--s6); }
    .gup-recit h2 { max-width: 24ch; }
    .gup-capture { max-width: 860px; }
  }
</style>
