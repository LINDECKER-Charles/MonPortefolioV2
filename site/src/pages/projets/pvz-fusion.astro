---
/**
 * PvZ Fusion, pôle francophone : la preuve d’« emmener ». Première page bâtie
 * sur le gabarit commun des pages de projet (components/projets/gabarit,
 * règle E5) : en-tête et fiche, corps libre (le point de départ, l’équipe, la
 * semaine type, le résultat), « Comment je l’ai construit », sortie et note
 * de sources. Données et relevés : config/pvz-fusion.ts.
 */
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CorpsProjet from '../../components/projets/gabarit/CorpsProjet.astro';
import DecisionsProjet from '../../components/projets/gabarit/DecisionsProjet.astro';
import EnTeteProjet from '../../components/projets/gabarit/EnTeteProjet.astro';
import SectionProjet from '../../components/projets/gabarit/SectionProjet.astro';
import SortieProjet from '../../components/projets/gabarit/SortieProjet.astro';
import SourcesProjet from '../../components/projets/gabarit/SourcesProjet.astro';
import BoucleSemaine from '../../components/projets/pvz/BoucleSemaine.astro';
import DemoTraduction from '../../components/projets/pvz/DemoTraduction.astro';
import FigureDepart from '../../components/projets/pvz/FigureDepart.astro';
import FigureEquipe from '../../components/projets/pvz/FigureEquipe.astro';
import FigureQuatreZero from '../../components/projets/pvz/FigureQuatreZero.astro';
import FigureRattrapage from '../../components/projets/pvz/FigureRattrapage.astro';
import LienAction from '../../components/ui/LienAction.astro';
import PreuveChiffree from '../../components/ui/PreuveChiffree.astro';
import PreuvesChiffrees from '../../components/ui/PreuvesChiffrees.astro';
import Visuel from '../../components/ui/Visuel.astro';
import capture from '../../assets/captures/pvz-fusion.webp';
import { SITE } from '../../config/site';
import { CORRECTIONS, DECISIONS, EN_TETE, FICHE, LIENS, LIENS_SORTIE, PARCOURS_EQUIPE, PREUVES, SECTIONS, VOLUMES } from '../../config/pvz-fusion';
import { attributsMesure } from '../../lib/liens';
import { typo } from '../../lib/typo';

const titre = `PvZ Fusion, pôle francophone — ${SITE.nom}`;
const description = 'Lead du pôle francophone de PvZ Fusion : rattraper la traduction d’un jeu qui change sans cesse, avec une équipe de bénévoles recrutée et formée.';
const sortant = (href: string) => ({ href, rel: 'external', ...attributsMesure(href, { emplacement: 'preuves' }) });
/** L’intitulé du sommaire, en sur-titre au-dessus d’un titre qui raconte autre chose. */
const etiquette = (id: string) => SECTIONS.find((section) => section.id === id)?.titre;
---

<Base titre={titre} description={description} chemin="/projets/pvz-fusion" sommaire={SECTIONS}>
  <EnTeteProjet projet="pvz" titre={EN_TETE.titre} chapeau={EN_TETE.chapeau} liens={EN_TETE.liens} preuves={PREUVES} fiche={FICHE}>
    <Visuel slot="visuel" id="PVZ-01" loading="eager" sizes="(max-width: 1100px) 100vw, 520px" />
  </EnTeteProjet>

  <CorpsProjet sections={SECTIONS}>
    <SectionProjet id="depart" etiquette={etiquette('depart')} titre="Un jeu qui ne s’arrête jamais">
      <Fragment slot="texte">
        <p>PvZ Fusion est un jeu amateur dérivé de Plants vs. Zombies&nbsp;: on y combine des plantes pour défendre son jardin. Des bénévoles du monde entier le traduisent. Chaque mise à jour ajoute des plantes et réécrit des règles, et le projet multilingue a publié 25&nbsp;versions entre août 2025 et octobre 2026.</p>
        <p>En octobre 2025, la traduction française en était à la version 2.3.1&nbsp;; le jeu, à la 3.0.1.</p>
        <figure class="pvz-jeu">
          <Picture src={capture} formats={['avif']} fallbackFormat="webp" widths={[480, 768, 1024]} sizes="(max-width: 860px) 100vw, 320px" alt="Une partie de PvZ Fusion : des plantes fusionnées défendent le jardin contre une vague de zombies." loading="lazy" />
          <figcaption>Le jeu qui nous a réunis&nbsp;: combiner des plantes pour défendre son jardin. Capture de l’interface d’origine, en chinois.</figcaption>
        </figure>
      </Fragment>
      <FigureDepart slot="figure" />
    </SectionProjet>

    <SectionProjet id="equipe" etiquette={etiquette('equipe')} titre="Accueillir, former, faire confiance">
      <Fragment slot="texte">
        <p>Je suis arrivé pour traduire, le 21&nbsp;octobre 2025. Le 5&nbsp;décembre, on m’a confié le pôle&nbsp;; je m’occupais déjà de l’organisation, de l’accueil et de la formation des nouveaux.</p>
        <blockquote class="citation foyer pvz-citation"><p>«&nbsp;La seule chose qui a changé, c’est le titre.&nbsp;»</p></blockquote>
        <p>Le 8&nbsp;décembre, deux nouvelles arrivées étaient consignées dans les journaux du pôle. En tout, j’ai formé 20&nbsp;personnes.</p>
      </Fragment>
      <figure slot="figure" class="pvz-equipe">
        <figcaption class="pvz-legende-titre">Traducteur, lead, mainteneur&nbsp;: mes rôles et les arrivées dans le pôle</figcaption>
        <FigureEquipe />
        <p class="petit">Neuf arrivées sont consignées dans les journaux publics du pôle, sur les vingt personnes que j’ai formées. Silhouettes anonymes, sans pseudonyme.</p>
      </figure>
      <ol class="pvz-temps" aria-label="Les trois temps de la formation">
        {
          PARCOURS_EQUIPE.map((temps, index) => (
            <li class="pvz-temps__temps">
              <Visuel id={temps.visuel} class="pvz-temps__visuel" sizes="(max-width: 860px) 100vw, 380px" />
              <div class="pvz-temps__texte">
                <span class="pvz-temps__rang" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <h3>{temps.titre}</h3>
                <p>{typo(temps.texte)}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </SectionProjet>

    <SectionProjet id="semaine" etiquette={etiquette('semaine')} titre="Une semaine que tout le monde peut suivre" chapeau="Chaque version relançait le travail. J’ai donné au pôle une semaine type, la même pour tous, et un outil pour la faire tourner.">
      <BoucleSemaine />
      <div class="pvz-outil acte-veille">
        <div class="pvz-outil__texte">
          <h3>L’outil du pôle&nbsp;: le Console Manager</h3>
          <p>Une version sort&nbsp;: l’outil compare le français à l’anglais et écrit, pour chaque entrée manquante, le bloc exact à traduire. Il exporte ce reliquat en cartes prêtes pour le tableau commun, puis tire de chaque pull request le bilan de chacun.</p>
          <p>Je l’ai construit pour le pôle français&nbsp;; il couvre aujourd’hui les 19&nbsp;langues du projet, intégré au dépôt officiel depuis octobre 2025.</p>
          <div class="actions pvz-outil__liens">
            <LienAction href={LIENS.outilSite} emplacement="preuves">Son site</LienAction>
            <LienAction href={LIENS.outilCode} emplacement="preuves">Le code</LienAction>
            <LienAction href={LIENS.outilNpm} emplacement="preuves">Le paquet npm</LienAction>
          </div>
        </div>
        <Visuel id="PVZ-04" alt="" class="pvz-outil__visuel" sizes="(max-width: 860px) 100vw, 360px" />
      </div>
    </SectionProjet>

    <SectionProjet id="resultat" etiquette={etiquette('resultat')} titre="Rattraper, puis ne plus décrocher" alignement="bas">
      <p slot="texte">En dix mois, le retard a disparu, alors que le jeu avait gagné 185&nbsp;plantes. Depuis, une version majeure est traduite avant même sa sortie multilingue.</p>
      <FigureQuatreZero slot="figure" />
      <FigureRattrapage class="foyer pvz-rattrapage" />
      <PreuvesChiffrees label="Le bilan public du pôle, au 26/09/2026" class="pvz-volumes">
        {VOLUMES.map((volume) => <PreuveChiffree {...volume} />)}
      </PreuvesChiffrees>
      <div class="pvz-metier">
        <div class="pvz-metier__tete">
          <Visuel id="PVZ-06" alt="" class="pvz-metier__visuel" sizes="96px" />
          <h3>Traduire, c’est suivre des règles qui changent</h3>
        </div>
        <div class="pvz-metier__grille">
          <div class="pvz-corrections">
            <table role="table">
              <caption>Trois corrections de mon journal public, semaine du 21/09/2026</caption>
              <thead role="rowgroup">
                <tr role="row"><th scope="col" role="columnheader">Entrée</th><th scope="col" role="columnheader">Avant</th><th scope="col" role="columnheader">Après</th></tr>
              </thead>
              <tbody role="rowgroup">
                {
                  CORRECTIONS.map((correction) => (
                    <tr role="row">
                      <th scope="row" role="rowheader">{correction.entree}</th>
                      <td role="cell"><del>{typo(correction.avant)}</del></td>
                      <td role="cell"><ins>{typo(correction.apres)}</ins></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="petit">Réaligner une fiche sur la version anglaise, c’est reprendre ses chiffres et corriger ses contresens.</p>
          </div>
          <DemoTraduction />
        </div>
      </div>
    </SectionProjet>

    <DecisionsProjet decisions={DECISIONS} />

    <SortieProjet projet="pvz" liens={LIENS_SORTIE}>
      <p>Ce dont je suis le plus fier&nbsp;: des personnes arrivées sans compétences, parfois avec du mal à travailler en groupe, et qui ont fini ancrées dans la communauté et brillantes sur la technique.</p>
    </SortieProjet>

    <SourcesProjet>
      <p><b>Le jeu et l’outil.</b> Les 25&nbsp;versions sont celles que le projet multilingue a publiées (PC, Android et préversions) du 12/08/2025 au 01/10/2026, d’après <a {...sortant(LIENS.versions)}>sa liste des versions<span class="fleche" aria-hidden="true">&nbsp;↗</span></a>, relevée le 13/10/2026. À la révision c623790 (16/10/2025), <a {...sortant(LIENS.readmeDepart)}>le README du projet<span class="fleche" aria-hidden="true">&nbsp;↗</span></a> donne le jeu en 3.0.1 et le français en «&nbsp;Last Updated 2.3.1&nbsp;». Le Console Manager affiche le badge «&nbsp;locales 19&nbsp;» dans <a {...sortant(LIENS.outilCode)}>son dépôt<span class="fleche" aria-hidden="true">&nbsp;↗</span></a>&nbsp;; il est entré dans le dépôt officiel par <a {...sortant(LIENS.pr23)}>la pull request #23<span class="fleche" aria-hidden="true">&nbsp;↗</span></a>, fusionnée le 31/10/2025.</p>
      <p><b>Couverture.</b> Mesurée par clé sur la branche principale du <a {...sortant(LIENS.amont)}>projet multilingue<span class="fleche" aria-hidden="true">&nbsp;↗</span></a>&nbsp;: pour chaque révision, les entrées présentes en anglais, la langue pivot, et absentes en français, dans les fiches des plantes, celles des zombies et les textes d’interface. Huit révisions, de c623790 (16/10/2025) à 13d63b1 (12/10/2026), relevées le 13/10/2026. Une entrée présente mais obsolète n’est pas comptée&nbsp;: c’est une mesure de couverture, pas de qualité.</p>
      <p><b>Volumes.</b> Le <a {...sortant(LIENS.bilanFige)}>bilan du pôle, figé au 26/09/2026<span class="fleche" aria-hidden="true">&nbsp;↗</span></a>, déclare 5&nbsp;179 nouvelles traductions&nbsp;: 4&nbsp;862 dans mon bilan, 317 dans ceux des douze autres membres crédités. Ce sont des entrées cumulées au fil des versions, pas des textes uniques ni un taux de couverture. Les 583 ajustements se comptent à part&nbsp;; les 637 relectures sont mon compteur, pas celui du pôle.</p>
      <p><b>Pull requests.</b> Les <a {...sortant(LIENS.prs)}>35 pull requests<span class="fleche" aria-hidden="true">&nbsp;↗</span></a> ont été ouvertes par mon compte entre le 16/10/2025 et le 26/09/2026, et toutes fusionnées&nbsp;; elles ne correspondent pas à 35 semaines consécutives. La 4.0&nbsp;: textes d’origine versés le 20/09/2026, pull request française fusionnée le 26/09, version multilingue publiée le 01/10.</p>
      <p><b>Rôles et équipe.</b> Dates des rôles et des arrivées&nbsp;: journaux publics des membres du pôle, dont <a {...sortant(LIENS.journalFige)}>le mien<span class="fleche" aria-hidden="true">&nbsp;↗</span></a>&nbsp;; c’est aussi là que se lisent les corrections citées. Les 20 personnes formées, le pic de dix contributeurs en même temps, le tableau commun, le classement hebdomadaire, les récapitulatifs individuels et le rythme d’une pull request par semaine viennent de mon témoignage du 13/10/2026&nbsp;; aucun message privé n’est reproduit. Les extraits de menus viennent des <a {...sortant(LIENS.textesSources)}>textes sources, lignes 40 à 51<span class="fleche" aria-hidden="true">&nbsp;↗</span></a>.</p>
    </SourcesProjet>
  </CorpsProjet>
</Base>

<script>
  import { brancherAnimationsFigures } from '../../scripts/figure-animations';
  brancherAnimationsFigures();
</script>

<style>
  /* La capture du jeu : un contexte, pas une preuve ; à côté de sa légende. */
  .pvz-jeu {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--s4);
    align-items: end;
    margin-top: var(--s5);
  }

  .pvz-jeu :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--r2);
  }

  .pvz-jeu figcaption {
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--eteint);
  }

  .pvz-legende-titre {
    margin: 0 0 var(--s4);
    line-height: 1.4;
    font-size: var(--t-s);
    font-weight: 600;
    color: var(--encre);
  }

  .pvz-citation {
    margin: var(--s5) 0 0;
    font-size: var(--t-xl);
  }

  .pvz-equipe {
    max-width: 38rem;
  }

  .pvz-equipe .petit {
    margin-top: var(--s3);
  }

  /* Les trois temps de la formation, chacun sous sa case du triptyque
     PVZ-02 : en bureau, les trois cases se touchent et se lisent d’un seul
     regard ; sous 860 px, chaque case passe au-dessus de son temps. */
  .pvz-temps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--s7) 0 0;
    padding: 0;
    list-style: none;
  }

  .pvz-temps__temps {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
  }

  .pvz-temps__temps :global(.pvz-temps__visuel) {
    border-radius: 0;
  }

  .pvz-temps__temps:first-child :global(.pvz-temps__visuel) {
    border-radius: var(--r2) 0 0 var(--r2);
  }

  .pvz-temps__temps:last-child :global(.pvz-temps__visuel) {
    border-radius: 0 var(--r2) var(--r2) 0;
  }

  .pvz-temps__texte {
    margin-top: var(--s4);
    padding: var(--s3) var(--s5) 0 0;
    border-top: 1px solid var(--trait);
  }

  .pvz-temps__rang {
    font-size: var(--t-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--eteint);
  }

  .pvz-temps h3 {
    margin-top: var(--s1);
    font-size: var(--t-l);
  }

  .pvz-temps p {
    margin-top: var(--s2);
    font-size: var(--t-s);
    color: var(--eteint);
  }

  /* L’outil du pôle : la nuit dans le jour, là où l’outil attend sa capture. */
  .pvz-outil {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: var(--s5) var(--s7);
    align-items: center;
    margin-top: var(--s6);
    padding: clamp(24px, 3.4vw, 40px);
    border-radius: var(--r2);
  }

  .pvz-outil h3 {
    font-size: var(--t-xl);
  }

  .pvz-outil__texte p {
    margin-top: var(--s3);
    max-width: var(--mesure);
  }

  .pvz-outil__liens {
    margin-top: var(--s3);
  }

  :global(.pvz-rattrapage) {
    margin-top: var(--s7);
  }

  :global(.pvz-rattrapage.foyer)::before {
    inset: -6% -4%;
  }

  :global(.pvz-volumes) {
    margin-top: var(--s5);
  }

  .pvz-metier {
    margin-top: var(--s7);
  }

  .pvz-metier__tete {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }

  .pvz-metier__tete :global(.pvz-metier__visuel) {
    flex: none;
    width: 96px;
  }

  .pvz-metier__tete h3 {
    font-size: var(--t-xl);
  }

  .pvz-metier__grille {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s5) var(--s6);
    align-items: start;
    margin-top: var(--s5);
  }

  .pvz-corrections table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-s);
  }

  .pvz-corrections thead th:first-child {
    width: 38%;
  }

  .pvz-corrections caption {
    margin-bottom: var(--s2);
    font-size: var(--t-xs);
    color: var(--eteint);
    text-align: left;
  }

  .pvz-corrections th,
  .pvz-corrections td {
    padding: var(--s3) var(--s3) var(--s3) 0;
    border-bottom: 1px solid var(--filet);
    text-align: left;
    vertical-align: top;
  }

  .pvz-corrections thead th {
    padding-block: var(--s2);
    border-bottom-color: var(--trait);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--eteint);
  }

  .pvz-corrections tbody th {
    font-weight: 600;
  }

  /* Un texte barré ne se coupe pas : guillemets et mots restent ensemble. */
  .pvz-corrections del {
    color: var(--eteint);
    text-decoration-thickness: 1px;
    white-space: nowrap;
  }

  .pvz-corrections ins {
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }

  .pvz-corrections .petit {
    margin-top: var(--s3);
  }

  @media (max-width: 1100px) {
    .pvz-metier__grille {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 860px) {
    .pvz-temps {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s6);
    }

    .pvz-temps__temps :global(.pvz-temps__visuel),
    .pvz-temps__temps:first-child :global(.pvz-temps__visuel),
    .pvz-temps__temps:last-child :global(.pvz-temps__visuel) {
      border-radius: var(--r2);
    }

    .pvz-temps__texte {
      margin-top: var(--s3);
      padding-right: 0;
    }

    .pvz-jeu {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s2);
    }

    .pvz-outil {
      grid-template-columns: minmax(0, 1fr);
      /* Le reliquat éclairé côté visuel : sous le texte, sur mobile. */
      --veille-foyer: 50% 88%;
    }

    .pvz-outil :global(.pvz-outil__visuel) {
      max-width: 320px;
    }

    /* Les corrections en lignes empilées : l’entrée en titre, puis
       « 7,5 s → 30 s » sur une ligne. Les rôles explicites du tableau
       gardent sa sémantique quand ses lignes ne s’affichent plus en tableau. */
    .pvz-corrections thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .pvz-corrections tr {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s1) var(--s3);
      padding-block: var(--s3);
      border-bottom: 1px solid var(--filet);
    }

    .pvz-corrections tbody th {
      flex-basis: 100%;
    }

    .pvz-corrections th,
    .pvz-corrections td {
      padding: 0;
      border-bottom: 0;
    }

    .pvz-corrections td + td::before {
      content: '→\00a0' / '';
      color: var(--eteint);
      font-weight: 400;
    }
  }
</style>
