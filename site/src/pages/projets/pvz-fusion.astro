---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import FilAriane from '../../components/pages/FilAriane.astro';
import ContinuerLecture from '../../components/pages/ContinuerLecture.astro';
import GesteCollectif from '../../components/projets/GesteCollectif.astro';
import { SITE } from '../../config/site';
import capture from '../../assets/captures/pvz-fusion.webp';
import '../../styles/profondeur.css';
import '../../styles/pvz-fusion.css';

const titre = `PvZ Fusion, une aventure collective — ${SITE.nom}`;
const description = 'Faire grandir le pôle français de PvZ Fusion : former 20 contributeurs, organiser le travail et livrer plus de 5 000 ajouts de traduction.';
const revision = 'eda0b63fbacda194465144c9ec20cb975c7a9c6a';
const depot = 'https://github.com/LINDECKER-Charles/PVZF-Translation-fr';
const bilan = `${depot}/blob/${revision}/Docs/french-contributions.md`;
const textes = `${depot}/blob/${revision}/PvZ_Fusion_Translator/Localization/French/Strings/translation_strings.json#L40-L51`;
const sortant = { 'data-umami-event': 'lien-sortant', 'data-umami-event-domaine': 'github.com', 'data-umami-event-emplacement': 'preuves' };
const commandes = [
  { origine: '选择你的植物', francais: 'Choisissez Vos Plantes' },
  { origine: '一起摇滚吧！', francais: 'C’est Parti\u00a0!' },
  { origine: '查看图鉴', francais: 'Voir l’Almanach' },
  { origine: '返回游戏', francais: 'Reprendre' },
  { origine: '重新开始', francais: 'Recommencer' },
];
const rituels = [
  { geste: 'organiser' as const, outil: 'Trello', titre: 'Un endroit pour avancer ensemble.', texte: 'J’ai centralisé le travail sur un tableau commun pour que chacun puisse retrouver ce qu’il y avait à faire.' },
  { geste: 'motiver' as const, outil: 'Classement hebdomadaire', titre: 'Donner envie de se dépasser.', texte: 'Chaque semaine, un leaderboard mettait en avant les contributions et donnait au groupe un nouveau rendez-vous.' },
  { geste: 'remercier' as const, outil: 'Récapitulatif individuel', titre: 'Prendre le temps de dire merci.', texte: 'J’envoyais à chaque contributeur un petit bilan de sa semaine, pour le féliciter et le remercier de son travail.' },
  { geste: 'livrer' as const, outil: 'Une PR chaque semaine', titre: 'Faire du travail une livraison.', texte: 'Je regroupais les contributions dans une pull request, une proposition de mise à jour adressée au projet multilingue.' },
];
---

<Base titre={titre} description={description} chemin="/projets/pvz-fusion">
  <article class="wrap profondeur cas-pvz">
    <FilAriane courant="PVZF Translation" projet />
    <header class="pvz-couverture">
      <div class="pvz-couverture__texte">
        <p class="pvz-repere">PVZF Translation <span aria-hidden="true">/</span> Pôle francophone</p>
        <h1>Traduire un jeu.<br /><span>Faire grandir une équipe.</span></h1>
        <p class="pvz-intro">Je suis arrivé pour traduire. J’ai appris à accueillir, former et donner à chacun l’envie de continuer.</p>
        <p class="pvz-role">Lead du pôle français · Mainteneur du projet multilingue</p>
        <a class="btn btn--plein" href="#le-collectif">Découvrir l’aventure <span aria-hidden="true">↓</span></a>
      </div>
      <figure class="pvz-couverture__visuel">
        <Picture src={capture} formats={['avif']} fallbackFormat="webp" widths={[480, 768, 1080, 1440]} sizes="(min-width: 1000px) 48vw, calc(100vw - 48px)" alt="Une partie de Plants vs. Zombies Fusion : des plantes fusionnées défendent le jardin contre les zombies." loading="eager" />
        <figcaption>
          <span class="pvz-repere">Le jeu qui nous a réunis</span>
          <p>Combiner des plantes pour défendre son jardin. Notre rôle&nbsp;: le rendre accessible en français.</p>
        </figcaption>
      </figure>
    </header>

    <dl class="pvz-reperes" aria-label="Le pôle en trois repères">
      <div><dt>Ajouts de traduction recensés</dt><dd><mark class="surligne">5&nbsp;000+</mark><span>Bilan public du pôle, septembre 2026</span></dd></div>
      <div><dt>Contributeurs que j’ai formés</dt><dd>20<span>De leurs premiers pas à l’autonomie</span></dd></div>
      <div><dt>PR fusionnées dans le projet amont</dt><dd>35<span>Mes propositions, octobre 2025 → septembre 2026</span></dd></div>
    </dl>
    <nav class="pvz-sommaire" aria-label="Dans cette page">
      <a href="#le-collectif"><span>01</span> Le collectif</a>
      <a href="#les-traductions"><span>02</span> Les traductions</a>
      <a href="#gestion-de-projet"><span>03</span> Gestion de projet</a>
      <a href="#les-sources"><span>04</span> Les sources</a>
    </nav>

    <section class="pvz-section pvz-collectif" id="le-collectif" aria-labelledby="collectif-titre">
      <div class="pvz-tete-section">
        <div><p class="pvz-repere">01 / L’aventure humaine</p><h2 id="collectif-titre">Arriver pour aider.<br />Trouver sa place.</h2></div>
        <p>Certains arrivaient sans compétences techniques. Les voir apprendre, puis devenir des piliers de la communauté, reste ce dont je suis le plus fier.</p>
      </div>
      <ol class="pvz-parcours">
        <li><span class="pvz-parcours__numero" aria-hidden="true">01</span><h3>Accueillir</h3><p>Faire une place aux nouveaux et les accompagner dans leurs premières contributions.</p></li>
        <li><span class="pvz-parcours__numero" aria-hidden="true">02</span><h3>Former et relire</h3><p>Apprendre en faisant, expliquer les corrections et construire des repères communs.</p></li>
        <li><span class="pvz-parcours__numero" aria-hidden="true">03</span><h3>Faire confiance</h3><p>Laisser chacun contribuer en autonomie et prendre sa place dans le pôle.</p></li>
      </ol>
      <div class="pvz-passage">
        <p class="pvz-passage__roles">Traducteur <span aria-hidden="true">→</span> Lead <span aria-hidden="true">→</span> Mainteneur</p>
        <blockquote>«&nbsp;La seule chose qui a changé,<br />c’est le titre.&nbsp;»</blockquote>
        <p>Quand le rôle de lead m’a été confié, je m’occupais déjà de l’accueil, de la formation et de l’organisation.</p>
      </div>
    </section>

    <section class="pvz-section" id="les-traductions" aria-labelledby="traductions-titre">
      <div class="pvz-tete-section">
        <div><p class="pvz-repere">02 / Le travail du pôle</p><h2 id="traductions-titre">Des milliers de textes.<br />Un jeu plus accessible.</h2></div>
        <p>Menus, descriptions des plantes, zombies et fusions&nbsp;: derrière chaque texte, il y a aussi des corrections et de la relecture.</p>
      </div>
      <div class="pvz-traductions">
        <div class="pvz-bilan">
          <p class="pvz-repere">Contributions françaises</p>
          <p class="pvz-bilan__nombre">5&nbsp;000<span>+</span></p>
          <h3>ajouts de traduction<br />recensés par le pôle</h3>
          <p class="pvz-bilan__precision">Un travail cumulé au fil des versions, porté par plusieurs contributeurs.</p>
          <div class="pvz-bilan__relecture"><strong>637</strong><span>relectures consignées<br />dans mon bilan</span></div>
          <a href={bilan} {...sortant}>Lire le bilan des contributions <span aria-hidden="true">↗</span></a>
          <p class="pvz-bilan__date">État du 26 septembre 2026 · <a href="#les-sources">Méthode et sources</a></p>
        </div>
        <div class="pvz-demo" data-pvz-traduction>
          <div class="pvz-demo__entete">
            <h3>Ce que ça change pour un joueur</h3>
            <div class="pvz-langues" role="group" aria-label="Langue des extraits" hidden>
              <button type="button" data-langue="origine" aria-pressed="false" aria-controls="extraits-origine">Texte d’origine</button>
              <button type="button" data-langue="francais" aria-pressed="true" aria-controls="extraits-francais">Français</button>
            </div>
          </div>
          <div class="pvz-demo__contenu" aria-live="polite" aria-atomic="true">
            <ul class="pvz-extraits" id="extraits-origine" data-extraits="origine" lang="zh-CN" aria-label="Commandes dans le texte chinois d’origine" hidden>
              {commandes.map((commande) => <li>{commande.origine}</li>)}
            </ul>
            <ul class="pvz-extraits" id="extraits-francais" data-extraits="francais" lang="fr" aria-label="Commandes traduites en français">
              {commandes.map((commande) => <li>{commande.francais}</li>)}
            </ul>
            <p class="pvz-demo__note" data-langue-affichee>Les commandes en français.</p>
          </div>
          <p class="pvz-demo__legende">Extraits des menus, mis en page pour cette démonstration. <a href={textes} {...sortant}>Voir les textes sources</a>.</p>
        </div>
      </div>
    </section>

    <section class="pvz-section" id="gestion-de-projet" aria-labelledby="gestion-titre">
      <div class="pvz-tete-section">
        <div><p class="pvz-repere">03 / Gestion de projet</p><h2 id="gestion-titre">Un cadre commun.<br />De l’attention pour chacun.</h2></div>
        <p>Dans une équipe bénévole, donner de la visibilité au travail compte autant que reconnaître le temps que chacun y consacre.</p>
      </div>
      <ol class="pvz-rituels">
        {rituels.map((rituel, index) => <li>
          <div class="pvz-rituels__dessin"><GesteCollectif geste={rituel.geste} /></div>
          <div class="pvz-rituels__texte">
            <p class="pvz-repere"><span aria-hidden="true">0{index + 1} / </span>{rituel.outil}</p>
            <h3>{rituel.titre}</h3>
            <p>{rituel.texte}</p>
          </div>
        </li>)}
      </ol>
      <div class="pvz-livraisons">
        <div><p class="pvz-repere">Le travail rejoint le jeu</p><h3>Un rendez-vous chaque semaine.</h3><p>Le rythme que j’avais mis en place pour proposer le travail du pôle au projet multilingue.</p></div>
        <div class="pvz-livraisons__preuve"><strong>35</strong><p>PR ouvertes par mes soins<br />et fusionnées dans le dépôt amont</p><a href="https://github.com/Teyliu/PVZF-Translation/pulls?q=is%3Apr+is%3Amerged+author%3ALINDECKER-Charles+created%3A2025-10-16..2026-09-26" {...sortant}>Parcourir les contributions <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="pvz-sources" id="les-sources" aria-labelledby="sources-titre">
      <div><p class="pvz-repere">04 / Les traces du projet</p><h2 id="sources-titre">Un travail à plusieurs,<br />des contributions publiques.</h2></div>
      <div class="pvz-sources__contenu">
        <div class="page-liens">
          <a href={depot} {...sortant}>Le dépôt francophone <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/Teyliu/PVZF-Translation" {...sortant}>Le projet multilingue <span aria-hidden="true">↗</span></a>
        </div>
        <details>
          <summary>Comment lire ces chiffres</summary>
          <div class="prose">
            <p>Sources publiques consultées le 13 octobre 2026, sur la version du 26 septembre 2026. Les synthèses du pôle déclarent 5&nbsp;179 nouvelles traductions. Le chiffre affiché est arrondi à 5&nbsp;000+, car les synthèses et les journaux hebdomadaires présentent quelques écarts.</p>
            <p>Il s’agit d’un cumul de contributions, pas du nombre de textes uniques dans le jeu ni d’un taux de couverture. Les 637 relectures figurent dans mon bilan personnel. Les 35 PR ont été ouvertes par mon compte entre le 16 octobre 2025 et le 26 septembre 2026, et fusionnées au plus tard le 26 septembre&nbsp;; elles ne correspondent pas à 35 semaines consécutives.</p>
            <p>J’ai formé 20 contributeurs, dont certains ne figurent pas dans le rapport public. Ce chiffre, le classement, les bilans individuels et le rythme hebdomadaire sont issus de mon témoignage du 13 octobre 2026. Le bilan public documente aussi la coordination, le recrutement et l’utilisation de Trello. Les dessins illustrent cette organisation.</p>
            <a href={bilan} {...sortant}>Consulter la version du bilan utilisée</a>
          </div>
        </details>
      </div>
    </section>
    <ContinuerLecture liens={[
      { href: '/projets/omnicard', titre: 'Omnicard', detail: 'Une autre façon de faire évoluer un jeu.' },
      { href: '/projets/gup', titre: 'GUP', detail: 'Une commande pour faire ses mises à jour.' },
      { href: '/projets', titre: 'Tous les projets', detail: 'Revenir aux réalisations.' },
      { href: '/contact', titre: 'Discutons', detail: 'Parlons de votre projet.' },
    ]} />
  </article>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-pvz-traduction]').forEach((demo) => {
    const choix = demo.querySelector<HTMLElement>('.pvz-langues');
    const boutons = demo.querySelectorAll<HTMLButtonElement>('[data-langue]');
    const extraits = demo.querySelectorAll<HTMLElement>('[data-extraits]');
    const note = demo.querySelector<HTMLElement>('[data-langue-affichee]');
    boutons.forEach((bouton) => {
      bouton.addEventListener('click', () => {
        const langue = bouton.dataset.langue;
        boutons.forEach((autre) => autre.setAttribute('aria-pressed', String(autre === bouton)));
        extraits.forEach((extrait) => { extrait.hidden = extrait.dataset.extraits !== langue; });
        if (note) note.textContent = langue === 'francais'
          ? 'Les commandes en français.'
          : 'Les commandes dans le texte chinois d’origine.';
      });
    });
    if (choix) choix.hidden = false;
  });
</script>
