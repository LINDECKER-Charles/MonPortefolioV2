---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import FilAriane from '../../components/pages/FilAriane.astro';
import ContinuerLecture from '../../components/pages/ContinuerLecture.astro';
import RituelsBloodborne from '../../components/projets/RituelsBloodborne.astro';
import FabricationBloodborne from '../../components/projets/FabricationBloodborne.astro';
import BoutiqueBloodborne from '../../components/projets/BoutiqueBloodborne.astro';
import AccesBloodborne from '../../components/projets/AccesBloodborne.astro';
import { SITE } from '../../config/site';
import parcours from '../../assets/projets/bloodborne/parcours-desktop.webp';
import atlas from '../../assets/projets/bloodborne/atlas.webp';
import fiche from '../../assets/projets/bloodborne/fiche-objectif.webp';
import personnages from '../../assets/projets/bloodborne/personnages.webp';
import guide from '../../assets/projets/bloodborne/guide.webp';
import yharnam from '../../assets/projets/bloodborne/yharnam.webp';
import amis from '../../assets/projets/bloodborne/social-amis.webp';
import comparaison from '../../assets/projets/bloodborne/social-comparaison.webp';
import objectifCompare from '../../assets/projets/bloodborne/social-objectif.webp';
import boutiqueFonds from '../../assets/projets/bloodborne/boutique-fonds.webp';
import boutiqueBannieres from '../../assets/projets/bloodborne/boutique-bannieres.webp';
import boutiquePortraits from '../../assets/projets/bloodborne/boutique-portraits.webp';
import ajoutAmi from '../../assets/projets/bloodborne/social-ajout.webp';
import '../../styles/profondeur.css';
import '../../styles/bloodborne.css';

const titre = `Bloodborne Legendary Run — ${SITE.nom}`;
const description = 'Un compagnon de Bloodborne où chaque objectif devient une étoile. Découvrez les constellations, le guide et les choix derrière ce projet web et Android.';
const captures = [
  { id: '0', image: parcours, titre: 'La carte des parcours', alt: 'La carte des parcours de Bloodborne Legendary Run, avec la progression du personnage Gehrman et une invitation à reprendre l’Arsenal de Yharnam.' },
  { id: '1', image: atlas, titre: 'Retrouver sa progression sur mobile', alt: 'La carte des parcours sur téléphone, avec les objectifs accomplis et le parcours à reprendre.' },
  { id: '2', image: fiche, titre: 'Un objectif dans la constellation', alt: 'Une étoile de la constellation avec la fiche de Rom, l’Araignée stupide, son objectif et le bouton pour l’éveiller.' },
  { id: '3', image: guide, titre: 'Préparer le combat contre le Père Gascoigne', alt: 'La fiche du Père Gascoigne avec le choix du cycle de la partie, sa faiblesse au feu et les conseils de combat.' },
  { id: '4', image: personnages, titre: 'Une progression pour chaque personnage', alt: 'Le profil avec les personnages Gehrman, Lady Maria et Eileen, leurs progressions et les emplacements pour créer un personnage.' },
  { id: '5', image: amis, titre: 'Retrouver ses amis et leurs dernières chasses', alt: 'La liste des amis avec une demande reçue, le personnage actif de chaque ami et sa dernière chasse.' },
  { id: '6', image: comparaison, titre: 'Comparer deux constellations', alt: 'La constellation comparée avec Eileen, ses étoiles signalées en turquoise et les progressions des deux personnages.' },
  { id: '7', image: objectifCompare, titre: 'Un même objectif, deux parcours', alt: 'La fiche d’un objectif comparé, éteint pour son propre personnage et allumé pour Eileen.' },
  { id: '8', image: ajoutAmi, titre: 'Partager son code et trouver un ami', alt: 'Le volet d’ajout d’un ami avec son code partageable, un champ de recherche par code et l’annuaire des chasseurs.' },
  { id: 'boutique-fonds', image: boutiqueFonds, titre: 'Les fonds de constellation', alt: 'Le rayon des fonds de constellation dans la boutique, avec ses paysages et leurs prix en échos de sang.' },
  { id: 'boutique-bannieres', image: boutiqueBannieres, titre: 'Les bannières de profil', alt: 'Le rayon des bannières dans la boutique, avec les décors de profil et leurs prix en échos de sang.' },
  { id: 'boutique-portraits', image: boutiquePortraits, titre: 'Les portraits de chasseur', alt: 'Le rayon des portraits dans la boutique, avec les visages de chasseurs et leurs prix en échos de sang.' },
];
const reprise = [
  { index: 4, titre: 'Votre personnage', detail: 'Chaque partie garde sa progression.', classe: 'personnages' },
  { index: 1, titre: 'Votre parcours', detail: 'La carte retrouve la chasse à poursuivre.', classe: 'atlas' },
  { index: 2, titre: 'Votre prochaine étape', detail: 'L’objectif à atteindre, à portée de main.', classe: 'objectif' },
];
const social = [
  { index: 5, titre: 'Retrouver ses amis', detail: 'Un code ou l’annuaire, une invitation acceptée. Les dernières chasses donnent des nouvelles.', classe: 'amis' },
  { index: 6, titre: 'Croiser les constellations', detail: 'Choisissez un personnage de chaque côté. Les étoiles de votre ami apparaissent en turquoise.', classe: 'comparaison' },
  { index: 7, titre: 'Comparer une réussite', detail: 'Un même objectif peut être éteint chez vous et allumé chez votre ami. Chacun suit son chemin.', classe: 'objectif' },
];
---

<Base titre={titre} description={description} chemin="/projets/bloodborne-legendary-run">
  <article class="profondeur cas-bloodborne" data-bloodborne-page>
    <div class="wrap"><FilAriane courant="Bloodborne Legendary Run" projet /></div>
    <header class="blr-hero wrap">
      <div class="blr-hero__titre">
        <p class="blr-nom">Bloodborne Legendary Run</p>
        <h1>Chaque chasse mérite sa constellation.</h1>
      </div>
      <figure class="blr-hero__visuel">
        <div class="blr-paysage" aria-hidden="true">
          <Picture src={yharnam} formats={['avif']} fallbackFormat="webp" widths={[640, 1000, 1400]} sizes="(min-width: 900px) 700px, 100vw" alt="" loading="eager" />
        </div>
        <div class="blr-fenetre">
          <div class="blr-fenetre__barre" aria-hidden="true"><span></span><span></span><span></span><p>La carte de votre chasse</p></div>
          <a href={parcours.src} data-blr-capture="0" aria-label="Agrandir la carte des parcours">
            <Picture src={parcours} formats={['avif']} fallbackFormat="webp" widths={[640, 1000, 1400, 2200]} sizes="(min-width: 900px) 630px, 90vw" alt={captures[0].alt} loading="eager" fetchpriority="high" />
          </a>
        </div>
        <div class="blr-telephone">
          <a href={atlas.src} data-blr-capture="1" aria-label="Agrandir la carte sur mobile">
            <Picture src={atlas} formats={['avif']} fallbackFormat="webp" widths={[240, 390, 780]} sizes="(min-width: 900px) 180px, 120px" alt={captures[1].alt} loading="eager" />
          </a>
        </div>
        <figcaption>Le jeu sur console. Le compagnon à côté.</figcaption>
      </figure>
      <div class="blr-hero__texte">
        <p class="blr-intro">Vos objectifs deviennent des étoiles. Retrouvez votre partie, préparez vos combats et comparez votre ciel à celui de vos amis. Un compagnon pour Bloodborne, à côté de la manette.</p>
        <div class="blr-actions">
          <a class="btn btn--plein" href="#le-compagnon">Découvrir le compagnon</a>
          <a class="blr-lien" href="https://bloodborne-legendary-run.com" data-umami-event="lien-sortant" data-umami-event-domaine="bloodborne-legendary-run.com" data-umami-event-emplacement="hero">Ouvrir l’application <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
        </div>
        <dl class="blr-identite">
          <div><dt>Un projet personnel</dt><dd>Conception et développement</dd></div>
          <div><dt>À portée de main</dt><dd>Web et Android</dd></div>
        </dl>
      </div>
    </header>
    <nav class="blr-sommaire" aria-label="Dans cette page">
      <div class="wrap"><a href="#le-compagnon">Reprendre</a><a href="#la-constellation">Les rituels</a><a href="#le-guide">Le guide</a><a href="#entre-amis">Entre amis</a><a href="#acces-compagnon">Essayer</a><a href="#la-fabrication">La fabrication</a></div>
    </nav>
    <div class="wrap">
      <section class="blr-section blr-reprise" id="le-compagnon" aria-labelledby="compagnon-titre">
        <div class="blr-tete-section"><div><p class="blr-repere">01 · Retrouver le fil</p><h2 id="compagnon-titre">Où en étais-je,<br />déjà&nbsp;?</h2></div><p>J’ai créé ce compagnon pour retrouver mes repères entre deux sessions. Un personnage, un parcours, une prochaine étoile&nbsp;: la chasse peut reprendre.</p></div>
        <ol class="blr-reprise__parcours">
          {reprise.map((etape, position) => <li>
            <a class={`blr-reprise__capture blr-reprise__capture--${etape.classe}`} href={captures[etape.index].image.src} data-blr-capture={etape.index} aria-label={`Agrandir : ${etape.titre}`}>
              <Picture src={captures[etape.index].image} formats={['avif']} fallbackFormat="webp" widths={[390, 780]} sizes="(min-width: 800px) 330px, 280px" alt={captures[etape.index].alt} loading="lazy" />

            </a>
            <div class="blr-reprise__legende"><span aria-hidden="true">0{position + 1}</span><div><h3>{etape.titre}</h3><p>{etape.detail}</p></div></div>
          </li>)}
        </ol>
        <p class="blr-defiler">Faites défiler les trois étapes →</p>
        <p class="blr-precision">Le joueur indique ses réussites dans le compagnon. La sauvegarde du jeu reste sur la console.</p>
      </section>
      <RituelsBloodborne><BoutiqueBloodborne /></RituelsBloodborne>
      <section class="blr-section blr-guide" id="le-guide" aria-labelledby="guide-titre">
        <div class="blr-guide__texte">
          <p class="blr-repere">03 · Préparer la suite</p><h2 id="guide-titre">Ce boss vous arrête&nbsp;?<br />Ouvrez sa fiche.</h2>
          <p>Avant le Père Gascoigne, le guide rassemble les repères utiles. Le cycle choisi adapte les données à votre partie.</p>
          <ul class="blr-guide__repères">
            <li><span aria-hidden="true">01</span><div><h3>Repérer sa faiblesse</h3><p>Ici, le feu.</p></div></li>
            <li><span aria-hidden="true">02</span><div><h3>Préparer le combat</h3><p>Stratégie, parades et déroulé des phases.</p></div></li>
            <li><span aria-hidden="true">03</span><div><h3>Voir ce qu’il rapporte</h3><p>Récompenses et suite de la chasse.</p></div></li>
          </ul>
          <p class="blr-guide__volume"><span class="surligne">864 fiches</span> dans 12 familles, sans compte.</p>
          <p class="blr-guide__familles">Boss · armes · runes · objets · lieux · quêtes…</p>
        </div>
        <figure class="blr-ecran-mobile blr-guide__capture">
          <a href={guide.src} data-blr-capture="3" aria-label="Agrandir la fiche du Père Gascoigne">
            <Picture src={guide} formats={['avif']} fallbackFormat="webp" widths={[320, 480, 780]} sizes="(min-width: 800px) 310px, 280px" alt={captures[3].alt} loading="lazy" />

          </a><figcaption>Le guide du compagnon, sur une première partie.</figcaption>
        </figure>
      </section>
      <section class="blr-section blr-social" id="entre-amis" aria-labelledby="social-titre">
        <div class="blr-tete-section"><div><p class="blr-repere">04 · Entre amis</p><h2 id="social-titre">Deux chasseurs.<br />Deux chemins à croiser.</h2></div><p>La progression devient une conversation. Retrouvez la dernière chasse d’un ami et regardez ce qu’il a découvert dans son ciel.</p></div>
        <div class="blr-social__legende"><span class="blr-social__etoile" aria-hidden="true">✦</span> Turquoise&nbsp;: les réussites de votre ami.</div>
        <div class="blr-social__ecrans">
          {social.map((etape, position) => <figure>
            <a href={captures[etape.index].image.src} data-blr-capture={etape.index} aria-label={`Agrandir : ${etape.titre}`}>
              <Picture src={captures[etape.index].image} formats={['avif']} fallbackFormat="webp" widths={[390, 780]} sizes="(min-width: 800px) 280px, 260px" alt={captures[etape.index].alt} loading="lazy" />

            </a>
            <figcaption><span class="blr-social__numero" aria-hidden="true">0{position + 1}</span><h3>{etape.titre}</h3><p>{etape.detail}</p>{position === 0 && <a class="blr-lien-detail" href={ajoutAmi.src} data-blr-capture="8">Voir l’ajout d’un ami <span aria-hidden="true">↗</span></a>}</figcaption>
          </figure>)}
        </div>
        <p class="blr-defiler">Sur téléphone, faites défiler les trois écrans →</p>
        <p class="blr-precision">On partage sa progression. Les notes, les morts et les captures restent personnels. La comparaison peut se mettre à jour en direct lorsque les deux amis ont l’application ouverte.</p>
      </section>
      <AccesBloodborne />
      <FabricationBloodborne />

      <aside class="blr-credits" aria-label="À propos des captures et des visuels"><p>Écrans et vidéos de la véritable application, avec des personnages et des progressions d’exemple. Les rituels sont enregistrés sur mobile, sans piste audio. Les chiffres visibles ne mesurent pas l’adoption du projet.</p><p>Projet de fan indépendant, sans affiliation à Sony Interactive Entertainment ni à FromSoftware. Vue de Yharnam&nbsp;: capture de MoonlightGhost, Bloodborne Wiki. Visuels du jeu © Sony Interactive Entertainment / FromSoftware.</p><p><a href="https://angular.dev/press-kit" data-umami-event="lien-sortant" data-umami-event-domaine="angular.dev" data-umami-event-emplacement="preuves">Logo Angular</a> © Google / Angular team, utilisé sous <a href="https://creativecommons.org/licenses/by/4.0/" data-umami-event="lien-sortant" data-umami-event-domaine="creativecommons.org" data-umami-event-emplacement="preuves">CC BY 4.0</a>.</p></aside>
      <ContinuerLecture liens={[
        { href: '/projets/gup', titre: 'gup', detail: 'Retrouver un point d’entrée pour ses mises à jour.' },
        { href: '/projets/pvz-fusion', titre: 'PVZF Translation', detail: 'Rendre un jeu accessible dans une autre langue.' },
        { href: '/projets', titre: 'Les projets', detail: 'Revenir à la sélection.' },
        { href: '/contact', titre: 'Discutons', detail: 'Parlons de ce que nous pourrions construire.' },
      ]} />
    </div>
    <dialog class="blr-visionneuse" data-blr-dialog aria-labelledby="blr-capture-titre" aria-describedby="blr-capture-aide">
      <h2 class="sr" id="blr-capture-titre" data-blr-caption>Les écrans du compagnon</h2>
      <div class="blr-visionneuse__images">{captures.map((capture) => <div data-blr-full={capture.id} hidden>
        <button class="blr-visionneuse__image" type="button" data-blr-close aria-label={`Fermer la capture : ${capture.titre}`}>
          <Picture src={capture.image} formats={['avif']} fallbackFormat="webp" widths={[780, 1400, 2200]} sizes="(orientation: portrait) 95vw, 90vh" alt={capture.alt} loading="lazy" />
        </button><p data-blr-image-title hidden>{capture.titre}</p>
      </div>)}</div>
      <p class="blr-visionneuse__aide" id="blr-capture-aide">Cliquez sur l’image ou appuyez sur Échap pour revenir.</p>
    </dialog>
  </article>
</Base>
<script>
  import '../../scripts/bloodborne-captures';
</script>
