---
/**
 * La vitrine des projets (cahier des charges, § 5.2) : un titre, une phrase,
 * l’index des étiquettes de preuve, puis les cinq projets dans l’ordre de ce
 * qu’ils prouvent — PvZ Fusion en vedette, puis League Of Data Base,
 * Omnicard, Bloodborne Legendary Run et gup. Chaque carte mène à sa page
 * (« Voir le projet → ») et porte un chiffre sourcé, un rôle, un statut et
 * ses liens publics. Suivent la rangée « Aussi », les projets archivés
 * (discrets), « Contribuer » et l’appel « Discutons ».
 *
 * Ordre et noms : config/projets.ts (VITRINE) ; contenu des cartes :
 * config/vitrine.ts. Page complète sans JavaScript.
 */
import Base from '../../layouts/Base.astro';
import AppelDiscutons from '../../components/pages/AppelDiscutons.astro';
import CarteProjet from '../../components/pages/CarteProjet.astro';
import FilAriane from '../../components/pages/FilAriane.astro';
import IndexPreuves from '../../components/pages/IndexPreuves.astro';
import Vitrine from '../../components/pages/Vitrine.astro';
import CadreCapture from '../../components/ui/CadreCapture.astro';
import Visuel from '../../components/ui/Visuel.astro';
import ArchivesProjets from '../../components/vitrine/ArchivesProjets.astro';
import BlocContribuer from '../../components/vitrine/BlocContribuer.astro';
import RangeeAussi from '../../components/vitrine/RangeeAussi.astro';
import atlas from '../../assets/projets/bloodborne/atlas.webp';
import gup from '../../assets/projets/gup-selection.webp';
import { SITE } from '../../config/site';
import { VITRINE } from '../../config/projets';
import { CARTES, RELEVE } from '../../config/vitrine';
import { typo } from '../../lib/typo';

const titre = `Projets — ${SITE.nom}`;
const description = 'Cinq projets menés au bout, rangés par ce qu’ils prouvent : une équipe bénévole, un système en production, un jeu inventé, un produit complet, un outil open source.';
---

<Base titre={titre} description={description} chemin="/projets">
  <header class="vitrine-tete conteneur">
    <FilAriane courant="Projets" />
    <div class="vitrine-tete__grille">
      <div class="vitrine-tete__texte foyer">
        <h1 data-pli="titre">Projets</h1>
        <p class="chapeau" data-pli="identite">Des projets menés au bout&nbsp;: une équipe, des systèmes en production, des outils publiés.</p>
      </div>
      <IndexPreuves entrees={VITRINE.map(({ id, preuve }) => ({ id, preuve }))} />
    </div>
  </header>

  <div class="conteneur vitrine-corps">
    <Vitrine label="Cinq projets, ordonnés par ce qu’ils prouvent">
      {
        VITRINE.map((projet, index) => {
          const carte = CARTES[projet.id];
          return (
            <CarteProjet
              variante={index === 0 ? 'vedette' : 'ligne'}
              id={projet.id}
              rang={index + 1}
              href={projet.href}
              nom={projet.nom}
              preuve={projet.preuve}
              besoin={carte.besoin}
              chiffre={carte.chiffre}
              role={carte.role}
              statut={carte.statut}
              liens={[...carte.liens]}
              technos={[...carte.technos]}
              aConfirmer={carte.aConfirmer}
              pli={index === 0 ? 'preuve' : undefined}
            >
              {/* La vedette garde le 16:10 sur mobile : son chiffre reste au premier écran. */}
              {projet.id === 'pvz' && <Visuel slot="visuel" id="PRJ-01" ratioMobile="16 / 10" loading="eager" sizes="(max-width: 860px) 100vw, 720px" class="vitrine-visuel vitrine-visuel--vedette" />}
              {projet.id === 'league' && <Visuel slot="visuel" id="PRJ-02" alt="" sizes="(max-width: 860px) 100vw, 300px" class="vitrine-visuel vitrine-visuel--ligne" />}
              {projet.id === 'omnicard' && <Visuel slot="visuel" id="PRJ-03" alt="" sizes="(max-width: 860px) 100vw, 300px" class="vitrine-visuel vitrine-visuel--ligne" />}
              {
                projet.id === 'bloodborne' && (
                  <CadreCapture
                    slot="visuel"
                    type="telephone"
                    src={atlas}
                    alt="L’atlas de Bloodborne Legendary Run sur téléphone : chaque constellation d’objectifs avec sa progression, et la chasse à reprendre en tête."
                    ratioMobile="4 / 5"
                    widths={[390, 780]}
                    sizes="(max-width: 860px) 200px, 150px"
                    class="vitrine-telephone"
                  />
                )
              }
              {
                projet.id === 'gup' && (
                  <CadreCapture
                    slot="visuel"
                    type="terminal"
                    src={gup}
                    alt="gup en français dans un terminal : les mises à jour classées par source, et une source en échec qui ne bloque pas les autres."
                    widths={[640, 1280]}
                    sizes="(max-width: 860px) 100vw, 300px"
                    class="vitrine-terminal"
                  />
                )
              }
            </CarteProjet>
          );
        })
      }
    </Vitrine>
    <p class="petit vitrine-releve">{typo(RELEVE)}</p>
  </div>

  <RangeeAussi />
  <ArchivesProjets />
  <BlocContribuer />

  <div class="conteneur vitrine-fin">
    <AppelDiscutons emplacement="discutons">Un projet commence souvent par une discussion.</AppelDiscutons>
  </div>
</Base>

<style>
  .vitrine-tete {
    padding-bottom: var(--s6);
  }

  /* Le titre à gauche, l’index des preuves à droite, en colonne (greffe de B). */
  .vitrine-tete__grille {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 25rem);
    align-items: end;
    gap: var(--s5) var(--s8);
    padding-top: var(--s3);
  }

  .vitrine-tete__texte {
    max-width: 52rem;
    padding-bottom: var(--s2);
  }

  h1 {
    font-size: var(--t-3xl);
    line-height: 0.98;
    letter-spacing: var(--ls-affiche);
  }

  .chapeau {
    max-width: 34em;
    margin-top: var(--s4);
    color: var(--eteint);
  }

  /* Les visuels des cartes : à la taille de leur cadre. */
  .vitrine-corps :global(.vitrine-visuel) {
    width: 100%;
  }

  /* Le téléphone entier sur ordinateur, à la hauteur de la carte. */
  .vitrine-corps :global(.vitrine-telephone) {
    justify-self: center;
    width: min(150px, 100%);
  }

  .vitrine-corps :global(.vitrine-terminal) {
    width: 100%;
  }

  .vitrine-releve {
    margin-top: var(--s4);
    color: var(--eteint);
  }

  /* Sur ordinateur, le visuel d’une carte « ligne » remplit tout son panneau
     (portrait) au lieu d’un 16:10 perdu au milieu du noir ; la composition
     du registre se lit recadrée au centre (consigne de PRJ-02 et PRJ-03). */
  @media (min-width: 861px) {
    .vitrine-corps :global(.carte-projet--ligne .carte-projet__visuel:has(.vitrine-visuel--ligne)) {
      align-items: stretch;
    }

    .vitrine-corps :global(.vitrine-visuel--ligne) {
      height: 100%;
      min-height: 240px;
      aspect-ratio: auto;
    }

    /* gup : le terminal remplit le panneau, recadré sur la liste des paquets
       (sources, versions, et Scoop en échec) ; entier sur mobile. */
    .vitrine-corps :global(.carte-projet__visuel:has(.vitrine-terminal)) {
      align-items: stretch;
      padding: var(--s3);
    }

    .vitrine-corps :global(.vitrine-terminal),
    .vitrine-corps :global(.vitrine-terminal .capture__cadre) {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .vitrine-corps :global(.vitrine-terminal .capture__cadre),
    .vitrine-corps :global(.vitrine-terminal .capture__vue) {
      flex: 1;
    }

    .vitrine-corps :global(.vitrine-terminal .capture__vue) {
      min-height: 240px;
      overflow: hidden;
    }

    .vitrine-corps :global(.vitrine-terminal .capture__vue img) {
      position: absolute;
      inset: 0;
      height: 100%;
      object-fit: cover;
      object-position: 56% 0;
    }
  }

  .vitrine-fin {
    padding-bottom: var(--s8);
  }

  @media (max-width: 860px) {
    .vitrine-tete {
      padding-bottom: var(--s5);
    }

    .vitrine-tete__grille {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s5);
      padding-top: var(--s2);
    }

    .vitrine-tete__texte {
      padding-bottom: 0;
    }

    .chapeau {
      margin-top: var(--s3);
    }

    .vitrine-corps :global(.vitrine-telephone) {
      width: min(200px, 70%);
    }
  }
</style>
