---
import Base from '../layouts/Base.astro';
import FilAriane from '../components/pages/FilAriane.astro';
import ContinuerLecture from '../components/pages/ContinuerLecture.astro';
import CopierAdresse from '../components/ui/CopierAdresse.astro';
import Picto from '../components/ui/Picto.astro';
import { CONTACT, MAILTO, SITE } from '../config/site';
import '../styles/profondeur.css';

const titre = `Contact — ${SITE.nom}`;
const description = 'Un projet, une question technique ou une idée à partager ? Écrire à Charles Lindecker par le formulaire de contact ou directement par e-mail.';
---

<Base titre={titre} description={description} chemin="/contact">
  <div class="wrap profondeur page-contact">
    <FilAriane courant="Contact" />
    <div class="contact-grille">
      <header class="contact-intro">
        <h1>Une conversation pour commencer.</h1>
        <p>Un projet, une question technique ou une idée à partager&nbsp;? Parlons de ce qu’on peut construire à plusieurs.</p>
      </header>
      <section class="contact-lettre" aria-labelledby="formulaire-titre">
        <div class="contact-lettre__entete">
          <div><h2 id="formulaire-titre">M’écrire</h2><p>Quelques mots suffisent pour commencer.</p></div>
          <Picto nom="plume" />
        </div>
        <form method="post" action="/api/contact" data-contact-form aria-labelledby="formulaire-titre">
          <p class="contact-obligatoire"><span class="contact-requis" aria-hidden="true">*</span> Tous les champs sont obligatoires.</p>
          <fieldset class="contact-champs">
            <legend class="sr">Votre message</legend>
            <div class="contact-identite">
              <div class="contact-champ">
                <label for="contact-name">Votre nom <span class="contact-requis" aria-hidden="true">*</span><span class="sr"> (obligatoire)</span></label>
                <input id="contact-name" name="name" autocomplete="name" required aria-describedby="contact-name-error" />
                <p class="contact-erreur" id="contact-name-error" hidden></p>
              </div>
              <div class="contact-champ">
                <label for="contact-email">Votre e-mail <span class="contact-requis" aria-hidden="true">*</span><span class="sr"> (obligatoire)</span></label>
                <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="contact-email-error" />
                <p class="contact-erreur" id="contact-email-error" hidden></p>
              </div>
            </div>
            <div class="contact-champ">
              <label for="contact-subject">Le sujet <span class="contact-requis" aria-hidden="true">*</span><span class="sr"> (obligatoire)</span></label>
              <input id="contact-subject" name="subject" required aria-describedby="contact-subject-error" />
              <p class="contact-erreur" id="contact-subject-error" hidden></p>
            </div>
            <div class="contact-champ">
              <label for="contact-message">Votre message <span class="contact-requis" aria-hidden="true">*</span><span class="sr"> (obligatoire)</span></label>
              <textarea id="contact-message" name="message" rows="7" required aria-describedby="contact-message-aide contact-message-longueur contact-message-count contact-message-error"></textarea>
              <p class="contact-aide" id="contact-message-aide">Ce que vous avez en tête, et ce que vous aimeriez qu’on en fasse.</p>
              <div class="contact-longueur"><span id="contact-message-longueur">10 caractères minimum</span><span id="contact-message-count" data-contact-count>0 / 5&#8239;000 caractères</span></div>
              <p class="contact-erreur" id="contact-message-error" hidden></p>
            </div>
            <div class="contact-piege" aria-hidden="true">
              <label for="contact-website">Laissez ce champ vide</label>
              <input id="contact-website" name="website" tabindex="-1" aria-hidden="true" autocomplete="off" />
            </div>
          </fieldset>
          <div class="contact-envoi">
            <button class="btn btn--plein" type="submit" disabled><span class="contact-attente" data-contact-spinner aria-hidden="true" hidden></span><span data-contact-submit-label>Envoyer le message</span><Picto nom="interface/email" /></button>
            <p class="contact-confidentialite">Vos coordonnées et votre message servent à vous répondre. <a href="/mentions-legales#donnees">À propos de vos données</a>.</p>
          </div>
          <p class="contact-statut" role="status" tabindex="-1" data-contact-status hidden></p>
          <noscript><p class="contact-sans-js">Activez JavaScript pour utiliser le formulaire, ou <a href={MAILTO}>écrivez-moi directement par e-mail</a>.</p></noscript>
        </form>
      </section>
      <div class="contact-conversation">
        <section class="contact-direct" aria-labelledby="email-titre">
          <h2 id="email-titre">Vous préférez l’e-mail&nbsp;?</h2>
          <a class="adresse-email" href={MAILTO} data-umami-event="contact-email" data-umami-event-emplacement="contact">
            <Picto nom="interface/email" /><span data-adresse>{CONTACT.email}</span>
          </a>
          <CopierAdresse adresse={CONTACT.email} emplacement="contact" />
        </section>
        <section class="contact-profils" aria-labelledby="profils-titre">
          <h2 id="profils-titre">Retrouvons-nous aussi ici</h2>
          <ul>
            <li><a href={CONTACT.github} data-umami-event="lien-sortant" data-umami-event-domaine="github.com" data-umami-event-emplacement="contact"><Picto nom="reseaux/github" /><span><strong>GitHub</strong><span>Les projets et les contributions.</span></span></a></li>
            <li><a href={CONTACT.linkedin} data-umami-event="lien-sortant" data-umami-event-domaine="www.linkedin.com" data-umami-event-emplacement="contact"><Picto nom="reseaux/linkedin" /><span><strong>LinkedIn</strong><span>Le parcours professionnel.</span></span></a></li>
          </ul>
        </section>
      </div>
    </div>
    <ContinuerLecture liens={[
      { href: '/projets', titre: 'Les projets', detail: 'Des réalisations et les décisions derrière.' },
      { href: '/parcours', titre: 'Le parcours', detail: 'Du développement à la transmission.' },
      { href: '/', titre: 'Le récit', detail: 'Découvrir ma façon de travailler.' },
    ]} />
  </div>
</Base>

<script>
  import { brancherContact } from '../scripts/contact';
  brancherContact();
</script>

<style>
  .contact-grille { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); column-gap: clamp(40px, 6vw, 88px); row-gap: var(--s7); grid-template-rows: auto 1fr; align-items: start; padding-block: var(--s6) var(--s8); }
  .contact-intro { grid-column: 1; grid-row: 1; }
  .contact-conversation { grid-column: 1; grid-row: 2; }
  .contact-lettre { grid-column: 2; grid-row: 1 / span 2; }
  .contact-intro h1 { font-size: clamp(2.8rem, 1.9rem + 3.3vw, 5.1rem); line-height: 1.04; letter-spacing: -0.045em; max-width: 12ch; }
  .contact-intro > p { margin-top: var(--s6); max-width: 37ch; font-size: var(--t-chapeau); line-height: 1.5; }
  .contact-direct { padding-top: var(--s6); border-top: 1px solid var(--filet); }
  .contact-direct h2, .contact-profils h2 { font-size: 1.125rem; font-weight: 700; letter-spacing: 0; }
  .adresse-email { display: flex; align-items: center; gap: var(--s3); padding-block: var(--s4); font-size: clamp(1.1rem, 1rem + 0.35vw, 1.4rem); font-weight: 700; }
  .adresse-email span { overflow-wrap: anywhere; min-width: 0; user-select: all; }
  .adresse-email :global(svg) { width: 22px; height: 22px; flex-shrink: 0; }
  .contact-profils { margin-top: var(--s7); }
  .contact-profils ul { padding: 0; margin: var(--s4) 0 0; list-style: none; }
  .contact-profils a { display: flex; align-items: center; gap: var(--s4); min-height: 72px; padding-block: var(--s3); text-decoration: none; }
  .contact-profils a :global(svg) { width: 24px; height: 24px; flex-shrink: 0; }
  .contact-profils strong { display: block; font-size: 1.125rem; text-decoration: underline; text-underline-offset: 0.22em; }
  .contact-profils a > span > span { display: block; color: var(--graphite); font-size: var(--t-petit); }
  .contact-profils a:hover strong { text-decoration-thickness: 2px; }
  .contact-lettre { position: relative; padding: clamp(24px, 3.5vw, 48px); border: 1px solid var(--filet); border-top: 4px solid var(--bleu); border-radius: var(--rayon); background: var(--blanc); }
  .contact-lettre__entete { display: flex; justify-content: space-between; align-items: start; gap: var(--s5); }
  .contact-lettre__entete h2 { font-size: 2rem; letter-spacing: -0.03em; }
  .contact-lettre__entete p { color: var(--bleu); font-family: var(--font-note); font-style: italic; font-size: 1.25rem; margin-top: var(--s2); }
  .contact-lettre__entete > :global(svg) { color: var(--bleu); width: 38px; height: 38px; flex-shrink: 0; }
  .contact-obligatoire { margin-block: var(--s6) var(--s5); color: var(--graphite); font-size: 0.9375rem; }
  .contact-requis { color: var(--bleu); font-weight: 700; }
  .contact-champs { display: grid; gap: var(--s5); border: 0; padding: 0; margin: 0; min-width: 0; }
  .contact-identite { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s4); }
  .contact-champ label { display: block; font-size: var(--t-petit); font-weight: 700; margin-bottom: var(--s2); }
  .contact-champ input, .contact-champ textarea { display: block; width: 100%; min-height: 48px; border: 1px solid var(--trait); border-radius: var(--rayon); background: var(--papier); color: var(--encre); font: inherit; font-size: var(--t-petit); line-height: 1.5; padding: 12px 14px; transition: border-color 150ms ease, background-color 150ms ease; }
  .contact-champ textarea { resize: vertical; min-height: 176px; }
  .contact-champ input:focus, .contact-champ textarea:focus { outline: 2px solid var(--bleu); outline-offset: 2px; background: var(--blanc); }
  .contact-champ:focus-within label { color: var(--bleu); }
  .contact-champ [data-valid='true'] { border-color: var(--bleu); }
  .contact-aide { margin-top: var(--s2); font-size: 0.9375rem; line-height: 1.4; color: var(--graphite); }
  .contact-longueur { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s2) var(--s4); margin-top: var(--s3); color: var(--graphite); font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  .contact-longueur [data-state='limite'] { color: var(--encre); font-weight: 700; }
  .contact-longueur [data-state='error'] { color: #a62929; font-weight: 700; }
  .contact-erreur { color: #a62929; margin-top: var(--s2); font-size: var(--t-petit); line-height: 1.4; }
  .contact-champ [aria-invalid='true'] { border-color: #a62929; }
  :global([data-theme='nuit']) .contact-erreur { color: #ffaaaa; }
  :global([data-theme='nuit']) .contact-longueur [data-state='error'] { color: #ffaaaa; }
  :global([data-theme='nuit']) .contact-champ [aria-invalid='true'] { border-color: #ffaaaa; }
  .contact-piege { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .contact-envoi { display: grid; justify-items: start; gap: var(--s4); margin-top: var(--s6); }
  .contact-envoi button { gap: var(--s3); }
  .contact-envoi button :global(svg) { width: 20px; height: 20px; }
  .contact-envoi button:disabled { cursor: wait; opacity: 0.65; }
  form[data-contact-cooldown] .contact-envoi button { cursor: not-allowed; }
  form[aria-busy='true'] .contact-envoi button :global(svg) { display: none; }
  .contact-attente { width: 18px; height: 18px; flex-shrink: 0; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: contact-tour 800ms linear infinite; }
  .contact-attente[hidden] { display: none; }
  @keyframes contact-tour { to { transform: rotate(360deg); } }
  .contact-confidentialite { color: var(--graphite); font-size: 0.9375rem; line-height: 1.5; max-width: 48ch; }
  .contact-statut { margin-top: var(--s5); padding: var(--s4); border-left: 3px solid var(--bleu); background: var(--papier); font-size: var(--t-petit); overflow-wrap: anywhere; }
  .contact-statut[data-state='success'] { border-left-width: 5px; font-weight: 700; }
  .contact-statut[data-state='error'] { border-color: #a62929; color: #a62929; }
  :global([data-theme='nuit']) .contact-statut[data-state='error'] { border-color: #ffaaaa; color: #ffaaaa; }
  .contact-sans-js { margin-top: var(--s5); font-size: var(--t-petit); }
  @media (max-width: 1050px) { .contact-identite { grid-template-columns: minmax(0, 1fr); gap: var(--s5); } }
  @media (max-width: 800px) {
    .contact-grille { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; gap: var(--s7); padding-bottom: var(--s7); }
    .contact-intro, .contact-lettre, .contact-conversation { grid-column: auto; grid-row: auto; }
    .contact-intro h1 { max-width: 17ch; }
    .contact-intro > p { max-width: 48ch; }
    .contact-profils ul { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s6); }
    .contact-identite { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 540px) {
    .contact-lettre { padding: var(--s5); }
    .contact-identite { grid-template-columns: minmax(0, 1fr); }
    .contact-envoi button { width: 100%; }
    .contact-profils ul { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-envoi button, .contact-champ input, .contact-champ textarea { transition: none; }
    .contact-attente { animation: none; }
  }
</style>
