---
import Base from '../layouts/Base.astro';
import FilAriane from '../components/pages/FilAriane.astro';
import Picto from '../components/ui/Picto.astro';
import { PAGES_PARCOURS } from '../config/parcours';
import { SITE } from '../config/site';
import '../styles/profondeur.css';
const titre = `Parcours de ${SITE.nom}`;
const description = 'Découvrez le parcours de Charles Lindecker à travers ses expériences professionnelles, ses compétences, sa formation et ses certifications.';
---

<Base titre={titre} description={description} chemin="/parcours">
  <div class="wrap profondeur parcours-hub">
    <FilAriane courant="Parcours" />
    <header class="page-hero">
      <h1>Mon parcours</h1>
      <p class="page-hero__intro">Mes expériences, mes compétences et les étapes de ma formation.</p>
    </header>
    <nav class="entrees-parcours" aria-label="Explorer le parcours">
      <ul role="list">
        {PAGES_PARCOURS.map((page, index) => <li>
          <a href={page.href} aria-labelledby={`entree-parcours-${index}`} aria-describedby={`description-parcours-${index}`}>
            <span class="entrees-parcours__picto"><Picto nom={page.picto} taille={56} /></span>
            <h2 id={`entree-parcours-${index}`}>{page.titre}</h2>
            <p id={`description-parcours-${index}`}>{page.description}</p>
            <span class="entrees-parcours__repere">{page.repere}</span>
            <span class="entrees-parcours__action" aria-hidden="true">Ouvrir la page</span>
          </a>
        </li>)}
      </ul>
    </nav>
    <p class="parcours-hub__suite">Les projets montrent ce que ce parcours a fait naître. <a href="/projets">Voir les projets</a></p>
  </div>
</Base>

<style>
  .parcours-hub { padding-bottom: var(--s8); }
  .parcours-hub .page-hero { padding-block: var(--s5) var(--s7); }
  .parcours-hub .page-hero h1 { font-size: clamp(2.5rem, 1.8rem + 3vw, 4.5rem); }
  .parcours-hub .page-hero__intro { margin-top: var(--s4); font-size: var(--t-corps); max-width: 60ch; }
  .entrees-parcours ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s5); padding: 0; margin: 0; list-style: none; }
  .entrees-parcours li { min-width: 0; }
  .entrees-parcours a { display: flex; flex-direction: column; align-items: start; height: 100%; padding: var(--s6); border: 1px solid var(--filet); border-radius: var(--rayon); background: var(--blanc); color: var(--encre); text-decoration: none; }
  .entrees-parcours a:hover { border-color: var(--bleu); }
  .entrees-parcours__picto { color: var(--bleu); margin-bottom: var(--s5); }
  .entrees-parcours h2 { font-size: clamp(1.4rem, 1.1rem + 0.7vw, 1.75rem); line-height: 1.2; margin-bottom: var(--s4); }
  .entrees-parcours p { font-size: var(--t-petit); max-width: 30ch; }
  .entrees-parcours__repere { display: block; margin-top: var(--s4); font-size: var(--t-etiquette); color: var(--graphite); line-height: 1.5; }
  .entrees-parcours__action { display: flex; align-items: center; gap: var(--s2); padding-top: var(--s6); margin-top: auto; color: var(--bleu); font-size: var(--t-petit); font-weight: 700; text-decoration: underline; text-underline-offset: 0.2em; }
  .parcours-hub__suite { margin-top: var(--s6); color: var(--graphite); font-size: var(--t-petit); }
  .parcours-hub__suite a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 900px) { .entrees-parcours ul { grid-template-columns: minmax(0, 1fr); } .entrees-parcours a { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 0 var(--s5); padding: var(--s5); } .entrees-parcours__picto { grid-row: span 4; margin-bottom: 0; } .entrees-parcours h2, .entrees-parcours p, .entrees-parcours__repere, .entrees-parcours__action { grid-column: 2; } .entrees-parcours h2 { margin-bottom: var(--s3); } .entrees-parcours__repere { margin-top: var(--s3); } .entrees-parcours__action { padding-top: var(--s4); } }
  @media (max-width: 440px) { .entrees-parcours a { grid-template-columns: 36px minmax(0, 1fr); gap: 0 var(--s4); padding: var(--s4); } .entrees-parcours__picto :global(svg) { width: 36px; height: 36px; } }
  @media print { .entrees-parcours a { break-inside: avoid; } }
</style>
