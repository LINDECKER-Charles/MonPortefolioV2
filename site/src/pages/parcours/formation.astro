---
import Parcours from '../../layouts/Parcours.astro';
import VisuelFormation from '../../components/parcours/VisuelFormation.astro';
import { DOMAINES_CERTIFICATIONS, NOMBRE_CERTIFICATIONS } from '../../config/formation';
---

<Parcours
  titre="Formation et certifications · Charles Lindecker"
  description="Mon parcours de formation, du titre DWWM aux premiers apprentissages, mes douze certifications et ma pratique sur Frontend Mentor."
  chemin="/parcours/formation"
  courant="Formation et certifications"
  introduction="Études, certifications et pratique."
  compact
>
  <nav class="reperes-formation" aria-label="Repères de formation">
    <a href="#formation"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M5 4v16m0-13h14M5 12h10M5 17h14"/><circle cx="5" cy="7" r="2" fill="currentColor" stroke="none"/><circle cx="5" cy="12" r="2" fill="currentColor" stroke="none"/><circle cx="5" cy="17" r="2" fill="currentColor" stroke="none"/></svg>Formations</a>
    <a href="#certifications"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h4m0 5 2 2 4-4"/></svg>Certifications</a>
    <a href="#frontend-mentor"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18m-14 5 3 3 3-3m4-1v5"/></svg>Frontend Mentor</a>
  </nav>

  <section class="formation-section" id="formation" tabindex="-1" aria-labelledby="formation-titre">
    <header class="section-tete formation-tete">
      <div><h2 id="formation-titre">Parcours de formation</h2></div>
    </header>

    <ol class="formation-timeline" role="list">
      <li class="formation-etape formation-etape--diplome">
        <div class="timeline-date"><time datetime="2025">2025</time></div>
        <div class="timeline-contenu">
          <article class="diplome" aria-labelledby="dwwm-titre">
            <div class="diplome-contenu">
              <p class="diplome-statut"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="m7 12 3 3 7-7"/></svg>Titre professionnel obtenu</p>
              <h3 id="dwwm-titre">Développeur Web<br />et Web Mobile</h3>
              <p class="diplome-organisme">Elan Formation, Mulhouse</p>
              <dl class="diplome-reperes">
                <div><dt class="sr">Période de formation</dt><dd class="formation-date"><time datetime="2025-04">Avril</time>–<time datetime="2025-10">octobre 2025</time></dd></div>
                <div><dt class="sr">Niveau du titre</dt><dd>RNCP niveau 5 <span>(bac + 2)</span></dd></div>
              </dl>
            </div>
            <div class="diplome-figure"><VisuelFormation type="diplome" /></div>
          </article>
          <aside class="complement-cda" id="complement-cda" aria-labelledby="cda-titre">
            <div><p class="complement-statut">Programme étudié en complément</p><h3 id="cda-titre">Concepteur Développeur d’Applications</h3><p class="complement-contexte">Pendant le DWWM</p></div>
            <div class="complement-reperes"><p><strong>≈&nbsp;80&nbsp;%</strong> du programme</p><div class="complement-jauge" aria-hidden="true"></div><p class="complement-statut">Titre non passé</p></div>
          </aside>
        </div>
      </li>
      <li class="formation-etape formation-etape--secondaire">
        <div class="timeline-date timeline-date--relative"><span>Avant<br /> le DWWM</span></div>
        <article class="timeline-contenu carte-etude carte-etude--piscine" aria-labelledby="piscine-titre">
          <div class="cursus-contenu"><p class="etudes-organisme">Sélection d’entrée</p><h3 id="piscine-titre">Piscine de 42</h3><p class="etudes-statut">Candidature non retenue</p></div>
          <div class="cursus-visuel"><VisuelFormation type="piscine" /></div>
        </article>
      </li>
      <li class="formation-etape">
        <div class="timeline-date"><span class="timeline-periode"><time datetime="2023">2023</time><span aria-hidden="true">–</span><time datetime="2024">2024</time></span></div>
        <article class="timeline-contenu carte-etude carte-etude--reseaux" aria-labelledby="reseaux-titre">
          <div class="cursus-contenu"><p class="etudes-organisme">IUT Nancy-Brabois</p><h3 id="reseaux-titre">BUT Réseaux<br />&amp; Télécoms</h3><p class="cursus-annee">Première année suivie</p><p class="etudes-statut">Cursus non poursuivi</p></div>
          <div class="cursus-visuel"><VisuelFormation type="reseaux" /></div>
        </article>
      </li>
      <li class="formation-etape formation-etape--secondaire">
        <div class="timeline-date timeline-date--relative"><span>Université</span></div>
        <article class="timeline-contenu carte-etude carte-etude--sciences" aria-labelledby="physique-titre">
          <div class="cursus-contenu"><h3 id="physique-titre">Physique-chimie</h3><p class="cursus-annee">Première année suivie</p><p class="etudes-statut">Cursus non poursuivi</p></div>
          <div class="cursus-visuel"><VisuelFormation type="sciences" /></div>
        </article>
      </li>
      <li class="formation-etape formation-etape--secondaire">
        <div class="timeline-date timeline-date--relative"><span>IUT</span></div>
        <article class="timeline-contenu carte-etude carte-etude--informatique" aria-labelledby="informatique-titre">
          <div class="cursus-contenu"><h3 id="informatique-titre">BUT Informatique</h3><p class="cursus-annee">Première année suivie</p><p class="etudes-statut">Cursus non poursuivi</p></div>
          <div class="cursus-visuel"><VisuelFormation type="informatique" /></div>
        </article>
      </li>
      <li class="formation-etape formation-etape--origine">
        <div class="timeline-date timeline-date--relative"><span>Vers 13&nbsp;ans</span></div>
        <article class="timeline-contenu carte-etude carte-etude--origine" aria-labelledby="autodidacte-titre">
          <div class="cursus-contenu"><h3 id="autodidacte-titre">Programmation en autodidacte</h3><p class="etudes-organisme">C avec OpenClassrooms</p></div>
          <div class="cursus-visuel"><VisuelFormation type="autodidacte" /></div>
        </article>
      </li>
    </ol>
  </section>

  <section class="formation-section certifications-section" id="certifications" tabindex="-1" aria-labelledby="certifications-titre">
    <header class="section-tete certifications-tete">
      <div><h2 id="certifications-titre">Certifications</h2></div>
      <p class="certifications-repere"><strong>{NOMBRE_CERTIFICATIONS}</strong><span>certifications<br /> 2024–2026</span></p>
    </header>
    <div class="certifications-intro"><a class="profil-certifications" href="https://www.freecodecamp.org/hexanti" data-umami-event="lien-sortant" data-umami-event-domaine="www.freecodecamp.org" data-umami-event-emplacement="preuves">Mon profil freeCodeCamp<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M14 4h6v6m0-6L10 14m0-10H4v16h16v-6"/></svg></a></div>
    <div class="certifications-catalogue">
      {DOMAINES_CERTIFICATIONS.map((domaine) => <article class="certification-domaine" aria-labelledby={`certification-${domaine.id}`}>
        <header class="domaine-tete">
          <div class="domaine-visuel"><VisuelFormation type={domaine.id} /></div>
          <h3 id={`certification-${domaine.id}`}>{domaine.titre}</h3>
          <p class="domaine-organisme">{domaine.id === 'csharp' ? 'Microsoft et freeCodeCamp' : 'freeCodeCamp'}</p>
        </header>
        <ul class="certification-liste" role="list">
          {domaine.certifications.map((certification) => <li class="certification-ligne">
            <a class="certification-intitule" href={certification.url} data-umami-event="lien-sortant" data-umami-event-domaine="www.freecodecamp.org" data-umami-event-emplacement="preuves"><span lang="en">{certification.titre}</span><span class="certification-suffixe">{'version' in certification && <span class="certification-version">{certification.version}</span>}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M14 4h6v6m0-6L10 14m0-10H4v16h16v-6"/></svg></span></a>
            <time datetime={certification.date}>{certification.periode}</time>
          </li>)}
        </ul>
      </article>)}
    </div>
  </section>

  <section class="frontend-mentor-section" id="frontend-mentor" tabindex="-1" aria-labelledby="frontend-mentor-titre">
    <div class="frontend-mentor-contenu">
      <p class="frontend-mentor-repere">Pratique du développement web</p>
      <h2 id="frontend-mentor-titre">Frontend Mentor</h2>
      <p>Interfaces réalisées à partir de maquettes.</p>
      <dl class="frontend-mentor-chiffres"><div><dt>Projets réalisés</dt><dd><strong>20</strong> projets</dd></div><div><dt>Points du profil</dt><dd><strong>385</strong> points</dd></div></dl>
      <p class="frontend-mentor-date">Repères relevés en octobre 2026.</p>
      <a class="btn btn--contour" href="https://www.frontendmentor.io/profile/LINDECKER-Charles" data-umami-event="lien-sortant" data-umami-event-domaine="www.frontendmentor.io" data-umami-event-emplacement="preuves">Voir mon profil Frontend Mentor</a>
    </div>
    <div class="frontend-mentor-visuel"><VisuelFormation type="web" /></div>
  </section>
</Parcours>

<style>
  .reperes-formation { display: flex; flex-wrap: wrap; gap: var(--s2); padding-bottom: var(--s5); margin-bottom: var(--s5); border-bottom: 1px solid var(--filet); }
  .reperes-formation a { display: inline-flex; align-items: center; gap: var(--s2); min-height: 44px; padding: var(--s2) var(--s4); border-radius: var(--rayon); color: var(--bleu); background: color-mix(in srgb, var(--bleu) 8%, var(--papier)); text-decoration: none; font-size: var(--t-petit); font-weight: 700; }
  .reperes-formation svg { width: 20px; height: 20px; flex-shrink: 0; }
  .reperes-formation a:hover { background: var(--bleu); color: var(--sur-bleu); }
  .formation-section { padding-block: var(--s7) var(--s8); }
  .section-tete { display: flex; align-items: end; justify-content: space-between; gap: var(--s5); margin-bottom: var(--s7); }
  .section-tete h2 { font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem); letter-spacing: -0.035em; }
  .formation-timeline { --colonne-date: 8.5rem; position: relative; display: grid; gap: var(--s5); padding: 0; margin: 0; list-style: none; }
  .formation-timeline::before { content: ''; position: absolute; top: 16px; bottom: 0; left: var(--colonne-date); border-left: 2px solid var(--bleu); }
  .formation-etape { position: relative; display: grid; grid-template-columns: var(--colonne-date) minmax(0, 1fr); gap: var(--s7); }
  .formation-etape::before { content: ''; position: absolute; top: 9px; left: calc(var(--colonne-date) - 7px); width: 16px; height: 16px; border: 3px solid var(--bleu); border-radius: 50%; background: var(--papier); }
  .formation-etape--diplome::before { width: 22px; height: 22px; top: 6px; left: calc(var(--colonne-date) - 10px); background: var(--bleu); box-shadow: 0 0 0 6px var(--papier); }
  .timeline-date { display: flex; flex-direction: column; align-items: start; gap: var(--s2); padding-right: var(--s4); }
  .timeline-date > time, .timeline-periode { color: var(--bleu); font-size: 2rem; line-height: 1; letter-spacing: -0.04em; font-weight: 800; }
  .timeline-periode { display: flex; align-items: baseline; gap: 0; font-size: 1.35rem; line-height: 1.4; white-space: nowrap; }
  .timeline-periode > span { font-size: inherit; }
  .timeline-date > span:last-child:not(.timeline-periode) { font-size: var(--t-etiquette); color: var(--graphite); }
  .timeline-date--relative { padding-top: var(--s1); }
  .timeline-date--relative > span:last-child { color: var(--encre); font-size: var(--t-petit); line-height: 1.4; font-weight: 700; }
  .timeline-contenu { min-width: 0; }
  .diplome { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); border: 1px solid var(--bleu); border-radius: var(--rayon); overflow: hidden; background: var(--bleu); color: var(--sur-bleu); }
  .diplome-contenu { align-self: center; padding: var(--s6) 0 var(--s6) var(--s6); }
  .diplome-statut { display: flex; align-items: center; gap: var(--s2); margin-bottom: var(--s5); font-weight: 700; font-size: var(--t-petit); }
  .diplome-statut svg { width: 22px; height: 22px; flex-shrink: 0; }
  .diplome h3 { font-size: clamp(2rem, 1.4rem + 1.65vw, 3rem); line-height: 1.08; letter-spacing: -0.03em; }
  .diplome-organisme { margin-top: var(--s4); font-size: var(--t-chapeau); }
  .diplome-reperes { display: grid; gap: var(--s2); margin-top: var(--s5); font-size: var(--t-petit); }
  .diplome-reperes dd { font-weight: 700; }
  .diplome-reperes dd span { font-weight: 400; }
  .diplome-figure { --formation-visuel-encre: var(--sur-bleu); --formation-visuel-papier: var(--bleu); display: grid; align-content: center; padding: var(--s4); }
  .complement-cda { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s6); padding: var(--s5); margin-top: var(--s3); border: 1px solid var(--filet); border-radius: var(--rayon); background: var(--blanc); }
  .complement-statut { font-size: var(--t-etiquette); color: var(--graphite); margin-bottom: var(--s2); }
  .complement-cda h3 { font-size: 1.25rem; line-height: 1.3; }
  .complement-contexte { margin-top: var(--s2); font-size: var(--t-etiquette); color: var(--graphite); }
  .complement-reperes { min-width: 10rem; font-size: var(--t-etiquette); }
  .complement-reperes strong { color: var(--bleu); font-size: 1.65rem; font-weight: 800; }
  .complement-jauge { height: 5px; margin-block: var(--s2); background: var(--filet); }
  .complement-jauge::before { content: ''; display: block; width: 80%; height: 100%; background: var(--bleu); }
  .complement-reperes .complement-statut { margin-bottom: 0; }
  .carte-etude { display: grid; grid-template-columns: minmax(0, 1fr) 220px; overflow: hidden; border: 1px solid var(--filet); border-radius: var(--rayon); background: var(--blanc); }
  .cursus-contenu { align-self: center; padding: var(--s5) var(--s6); }
  .cursus-contenu h3 { max-width: 24ch; font-size: 1.55rem; line-height: 1.15; }
  .cursus-visuel { --formation-visuel-papier: var(--blanc); display: grid; align-items: center; padding: var(--s3); background: color-mix(in srgb, var(--bleu) 7%, var(--papier)); }
  .cursus-visuel :global(svg) { width: 100%; max-height: 190px; }
  .carte-etude--reseaux { grid-template-columns: minmax(0, 1fr) minmax(260px, 0.9fr); border-color: var(--trait-doux); }
  .carte-etude--reseaux h3 { font-size: 2rem; }
  .carte-etude--reseaux .cursus-visuel { padding: var(--s5); background-image: radial-gradient(color-mix(in srgb, var(--bleu) 15%, transparent) 1px, transparent 1px); background-size: 18px 18px; }
  .carte-etude--piscine .cursus-visuel { --formation-visuel-encre: var(--papier); --formation-visuel-papier: var(--encre); background: var(--encre); }
  .carte-etude--sciences .cursus-visuel { --formation-visuel-encre: var(--sur-bleu); --formation-visuel-papier: var(--bleu); background: var(--bleu); }
  .carte-etude--origine { grid-template-columns: minmax(0, 1fr) 180px; border-style: dashed; background: transparent; }
  .carte-etude--origine .cursus-visuel { --formation-visuel-papier: var(--papier); padding: var(--s2); background: transparent; }
  .carte-etude--origine .etudes-organisme { margin-block: var(--s3) 0; }
  .etudes-organisme { font-size: var(--t-petit); color: var(--graphite); margin-bottom: var(--s3); }
  .cursus-annee { margin-top: var(--s4); font-size: var(--t-petit); }
  .etudes-statut { margin-top: var(--s2); font-size: var(--t-etiquette); color: var(--graphite); }
  .carte-etude--piscine .etudes-statut { margin-top: var(--s4); }
  .formation-etape--secondaire::before, .formation-etape--origine::before { width: 12px; height: 12px; left: calc(var(--colonne-date) - 5px); top: 12px; border-width: 2px; }
  .certifications-section { margin-top: var(--s6); border-top: 4px solid var(--bleu); }
  .certifications-tete { padding: var(--s6); margin-bottom: 0; background: color-mix(in srgb, var(--bleu) 10%, var(--blanc)); }
  .certifications-repere { display: flex; align-items: center; gap: var(--s4); color: var(--bleu); flex-shrink: 0; }
  .certifications-repere strong { font-size: 3.5rem; line-height: 1; font-weight: 800; letter-spacing: -0.05em; }
  .certifications-repere span { font-size: var(--t-etiquette); line-height: 1.4; }
  .certifications-intro { display: flex; justify-content: end; margin-block: var(--s3) var(--s5); }
  .profil-certifications { display: inline-flex; align-items: center; gap: var(--s3); min-height: 44px; font-size: var(--t-petit); }
  .profil-certifications svg { width: 18px; height: 18px; flex-shrink: 0; }
  .certifications-catalogue { display: grid; gap: var(--s5); }
  .certification-domaine { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 2fr); border: 1px solid var(--trait-doux); border-radius: var(--rayon); background: var(--blanc); overflow: hidden; }
  .domaine-tete { display: grid; align-content: center; padding: var(--s5) var(--s6); border-right: 1px solid var(--filet); background: var(--papier); }
  .domaine-visuel { width: 88px; margin-bottom: var(--s3); }
  .domaine-tete h3 { font-size: 1.5rem; line-height: 1.2; }
  .domaine-organisme { margin-top: var(--s2); color: var(--graphite); font-size: var(--t-etiquette); }
  .certification-liste { display: grid; align-content: center; list-style: none; padding: var(--s4) var(--s6); margin: 0; }
  .certification-ligne { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: var(--s4); padding-block: var(--s4); font-size: var(--t-petit); line-height: 1.45; }
  .certification-ligne + .certification-ligne { border-top: 1px solid var(--filet); }
  .certification-intitule { padding-block: var(--s1); font-weight: 700; overflow-wrap: anywhere; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .certification-intitule svg { display: inline-block; vertical-align: -2px; width: 15px; height: 15px; margin-left: var(--s2); }
  .certification-intitule:hover { text-decoration-thickness: 2px; }
  .certification-suffixe { white-space: nowrap; }
  .certification-version { display: inline-block; padding-inline: var(--s2); margin-left: var(--s2); border: 1px solid var(--trait-doux); border-radius: var(--rayon); color: var(--graphite); font-size: var(--t-etiquette); font-weight: 400; white-space: nowrap; }
  .certification-ligne time { font-size: var(--t-etiquette); color: var(--graphite); white-space: nowrap; }
  .frontend-mentor-section { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: var(--s7); align-items: center; padding: var(--s6); margin-bottom: var(--s7); border: 1px solid var(--trait-doux); border-left: 4px solid var(--bleu); border-radius: var(--rayon); background: var(--blanc); }
  .frontend-mentor-repere { color: var(--graphite); font-size: var(--t-etiquette); margin-bottom: var(--s3); }
  .frontend-mentor-section h2 { font-size: clamp(1.8rem, 1.4rem + 1.5vw, 2.5rem); letter-spacing: -0.03em; }
  .frontend-mentor-section h2 + p { max-width: 55ch; margin-top: var(--s3); font-size: var(--t-petit); }
  .frontend-mentor-chiffres { display: flex; flex-wrap: wrap; gap: var(--s5) var(--s7); margin-top: var(--s5); }
  .frontend-mentor-chiffres dt { font-size: var(--t-etiquette); color: var(--graphite); }
  .frontend-mentor-chiffres dd { margin-top: var(--s1); font-size: var(--t-petit); }
  .frontend-mentor-chiffres strong { margin-right: var(--s1); font-size: 2rem; font-weight: 800; color: var(--bleu); }
  .frontend-mentor-date { margin-block: var(--s3) var(--s5); font-size: var(--t-etiquette); color: var(--graphite); }
  .frontend-mentor-visuel { width: min(100%, 280px); justify-self: center; }
  @media (max-width: 1050px) {
    .formation-timeline { --colonne-date: 6rem; }
    .formation-etape { gap: var(--s6); }
    .diplome { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); }
    .diplome-contenu { padding: var(--s5); }
    .diplome-figure { padding: var(--s3); }
    .diplome h3 { font-size: 2rem; }
    .carte-etude { grid-template-columns: minmax(0, 1fr) 180px; }
    .cursus-contenu { padding: var(--s5); }
    .carte-etude--reseaux { grid-template-columns: minmax(0, 1fr) 220px; }
    .carte-etude--reseaux h3 { font-size: 1.65rem; }
    .carte-etude--reseaux .cursus-visuel { padding: var(--s3); }
    .carte-etude--origine { grid-template-columns: minmax(0, 1fr) 150px; }
    .certification-domaine { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); }
    .domaine-tete, .certification-liste { padding-inline: var(--s5); }
    .certification-ligne { grid-template-columns: minmax(0, 1fr); gap: var(--s2); }
  }
  @media (max-width: 700px) {
    .reperes-formation { gap: var(--s2); padding-bottom: var(--s4); margin-bottom: var(--s4); }
    .reperes-formation a { padding: var(--s2) var(--s3); font-size: var(--t-etiquette); }
    .reperes-formation svg { width: 17px; height: 17px; }
    .formation-section { padding-block: var(--s6) var(--s7); }
    .section-tete { align-items: start; flex-direction: column; gap: var(--s3); margin-bottom: var(--s6); }
    .formation-timeline { --colonne-date: 7px; gap: var(--s5); }
    .formation-etape { display: block; padding-left: var(--s6); }
