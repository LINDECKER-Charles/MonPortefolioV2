---
/**
 * Formation et certifications (cahier, § 5.11) : « ce que j’ai dans mon
 * sac », en diagonale. Le titre obtenu domine, le programme CDA reste
 * distinct, le chemin d’avant tient en cinq stations datées, lues du plus
 * récent au plus ancien (le repère le dit au-dessus du trait), puis les douze
 * certifications (versions réunies, chacune avec son certificat) et la
 * pratique sur Frontend Mentor. Données : config/formation.ts.
 */
import Parcours from '../../layouts/Parcours.astro';
import AppelDiscutons from '../../components/pages/AppelDiscutons.astro';
import NavigationPage from '../../components/pages/NavigationPage.astro';
import LienAction from '../../components/ui/LienAction.astro';
import Picto from '../../components/ui/Picto.astro';
import PreuveChiffree from '../../components/ui/PreuveChiffree.astro';
import PreuvesChiffrees from '../../components/ui/PreuvesChiffrees.astro';
import Statut from '../../components/ui/Statut.astro';
import Visuel from '../../components/ui/Visuel.astro';
import javascript from '../../assets/stacks/javascript.svg?url';
import python from '../../assets/stacks/python.svg?url';
import postgresql from '../../assets/stacks/postgresql.svg?url';
import csharp from '../../assets/stacks/csharp.svg?url';
import {
  ANNEES_CERTIFICATIONS, certificationsGroupees, COMPLEMENT_CDA, DIPLOME, DOMAINES_CERTIFICATIONS, ETUDES_AVANT,
  FRONTEND_MENTOR, NOMBRE_CERTIFICATIONS, PROFIL_FREECODECAMP,
} from '../../config/formation';
import { attributsMesure } from '../../lib/liens';

const LOGOS: Record<string, string> = { javascript, python, postgresql, csharp };
const SECTIONS = [
  { id: 'formation', titre: 'Formations' },
  { id: 'certifications', titre: 'Certifications' },
  { id: 'frontend-mentor', titre: 'Frontend Mentor' },
];
const preuve = (href: string) => attributsMesure(href, { emplacement: 'preuves' });
---

<Parcours
  titre="Formation et certifications · Charles Lindecker"
  description={`La formation de Charles Lindecker : le titre DWWM, les études d’avant, ${NOMBRE_CERTIFICATIONS} certifications et la pratique sur Frontend Mentor.`}
  chemin="/parcours/formation"
  courant="Formation et certifications"
  introduction="Études, certifications et pratique."
  sommaire={SECTIONS}
  compact
>
  <NavigationPage entrees={SECTIONS}>
    <section class="formation" id="formation" tabindex="-1" aria-labelledby="formation-titre">
      <h2 id="formation-titre" class="section-titre">Parcours de formation</h2>
      <ol class="formation-timeline" role="list">
        <li class="etape etape--titre">
          <article class="dwwm foyer" id="dwwm" aria-labelledby="dwwm-titre">
            <div class="dwwm__texte">
              <Statut class="dwwm__statut">{DIPLOME.statut}</Statut>
              <h3 id="dwwm-titre">{DIPLOME.titre}</h3>
              <p class="dwwm__organisme">{DIPLOME.organisme}</p>
              <dl class="dwwm__reperes">
                <div>
                  <dt>Période</dt>
                  <dd class="formation-date"><time datetime={DIPLOME.debut}>Avril</time><span aria-hidden="true"> – </span><span class="sr"> à </span><time datetime={DIPLOME.fin}>octobre 2025</time></dd>
                </div>
                <div>
                  <dt>Niveau</dt>
                  <dd>{DIPLOME.niveau} <span>({DIPLOME.equivalence})</span></dd>
                </div>
              </dl>
              <PreuveChiffree as="div" class="dwwm__preuve" valeur={DIPLOME.preuve.valeur} libelle={DIPLOME.preuve.libelle} source={DIPLOME.preuve.source} surligne />
            </div>
            <Visuel id={DIPLOME.visuel} alt="" class="dwwm__visuel" sizes="(max-width: 760px) 100vw, 520px" loading="eager" />
          </article>
          <aside class="cda" id="complement-cda" aria-labelledby="cda-titre">
            <Visuel id={COMPLEMENT_CDA.visuel} alt="" class="cda__visuel" sizes="(max-width: 760px) 100vw, 180px" />
            <div class="cda__texte">
              <p class="cda__statut">{COMPLEMENT_CDA.statut}</p>
              <h3 id="cda-titre">{COMPLEMENT_CDA.titre}</h3>
              <p class="cda__contexte">{COMPLEMENT_CDA.contexte} · {COMPLEMENT_CDA.niveau}</p>
            </div>
            <div class="cda__part">
              <p><strong>≈&nbsp;{COMPLEMENT_CDA.part}&nbsp;%</strong> du programme</p>
              <div class="cda__jauge" style={`--part:${COMPLEMENT_CDA.part}%`} aria-hidden="true"></div>
              <p class="cda__statut">{COMPLEMENT_CDA.titreNonPasse}</p>
            </div>
          </aside>
          <p class="formation-sens" id="formation-sens">Avant le titre, du plus récent au plus ancien</p>
        </li>
        {
          ETUDES_AVANT.map((etude) => (
            <li class="etape etape--station" id={etude.id}>
              <article class="station" aria-labelledby={`${etude.id}-titre`}>
                <Visuel id={etude.visuel} alt="" class="station__visuel" sizes="72px" />
                <div class="station__texte">
                  <p class="station__quand">
                    {etude.quand.debut && etude.quand.fin ? (
                      <>
                        <time datetime={etude.quand.debut}>{etude.quand.debut}</time>–<time datetime={etude.quand.fin}>{etude.quand.fin}</time>
                      </>
                    ) : etude.quand.debut ? (
                      <time datetime={etude.quand.debut}>{etude.quand.texte}</time>
                    ) : (
                      etude.quand.texte
                    )}
                  </p>
                  <h3 id={`${etude.id}-titre`}>{etude.titre}</h3>
                  <p class="station__organisme">{etude.organisme}</p>
                  {etude.suivi && <p class="station__suivi">{etude.suivi}</p>}
                  {etude.statut && <Statut etat="eteint" class="station__statut">{etude.statut}</Statut>}
                  {etude.lien && <LienAction href={etude.lien.href} emplacement="preuves" class="station__lien">{etude.lien.libelle}</LienAction>}
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="certifications acte-teinte" id="certifications" tabindex="-1" aria-labelledby="certifications-titre">
      <header class="certifications__tete">
        <h2 id="certifications-titre" class="section-titre">Certifications</h2>
        <p class="certifications__repere">
          <span>{NOMBRE_CERTIFICATIONS} certifications, {ANNEES_CERTIFICATIONS}</span>
          <LienAction href={PROFIL_FREECODECAMP} emplacement="preuves">Mon profil freeCodeCamp</LienAction>
        </p>
      </header>
      <div class="certifications__catalogue">
        {
          DOMAINES_CERTIFICATIONS.map((domaine) => (
            <article class="domaine" aria-labelledby={`certification-${domaine.id}`}>
              <header class="domaine__tete">
                <span class="domaine__logo" aria-hidden="true">
                  {domaine.logo ? <img src={LOGOS[domaine.logo]} alt="" width="28" height="28" loading="lazy" decoding="async" /> : <Picto nom="interface/langue" taille={24} />}
                </span>
                <h3 id={`certification-${domaine.id}`}>{domaine.titre}</h3>
                <p class="domaine__organisme">{domaine.organisme}</p>
              </header>
              <ul class="certification-liste" role="list">
                {certificationsGroupees(domaine).map((groupe) => (
                  <li class="certification-ligne">
                    <span class="certification-intitule" lang="en">{groupe.titre}</span>
                    <span class="certification-versions">
                      {groupe.versions.map((version) => (
                        <a class="certification-preuve" href={version.url} rel="external" {...preuve(version.url)}>
                          <span class="sr" lang="en">{groupe.titre} </span>
                          {'version' in version && <span class="certification-version">{version.version}</span>}
                          <time datetime={version.date}>{version.periode}</time>
                          <span class="fleche" aria-hidden="true">&nbsp;↗</span>
                        </a>
                      ))}
                    </span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="frontend-mentor" id="frontend-mentor" tabindex="-1" aria-labelledby="frontend-mentor-titre">
      <div class="frontend-mentor__texte">
        <p class="frontend-mentor__repere">Pratique du développement web</p>
        <h2 id="frontend-mentor-titre" class="section-titre">Frontend Mentor</h2>
        <p>Interfaces réalisées à partir de maquettes.</p>
        <PreuvesChiffrees label="Mon profil Frontend Mentor en chiffres" class="frontend-mentor__chiffres">
          <PreuveChiffree valeur={FRONTEND_MENTOR.projets} libelle="solutions publiées" source="Profil public" />
          <PreuveChiffree valeur={FRONTEND_MENTOR.points} libelle="points" source="Profil public" />
        </PreuvesChiffrees>
        <p class="frontend-mentor__date">{FRONTEND_MENTOR.releve}</p>
        <LienAction href={FRONTEND_MENTOR.profil} emplacement="preuves">Voir mon profil Frontend Mentor</LienAction>
      </div>
      <Visuel id={FRONTEND_MENTOR.visuel} class="frontend-mentor__visuel" sizes="(max-width: 760px) 100vw, 520px" />
    </section>
  </NavigationPage>

  <AppelDiscutons slot="fin" emplacement="discutons">Une question sur mon parcours, un sujet à creuser&nbsp;?</AppelDiscutons>
</Parcours>

<style>
  .section-titre {
    font-size: var(--t-2xl);
    line-height: 1.05;
  }

  section {
    scroll-margin-top: calc(var(--entete) + var(--s5));
  }

  section:focus {
    outline: none;
  }

  /* ===== La frise de formation ===== */
  .formation-timeline {
    --ligne: 2px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--s6) var(--s4);
    margin: var(--s5) 0 0;
    padding: 0;
    list-style: none;
  }

  .etape--titre {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s3);
  }

  /* Le titre obtenu */
  .dwwm {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--s5) var(--s6);
    align-items: center;
    padding: clamp(20px, 2.6vw, 32px);
    border-radius: var(--r2);
    background: var(--surface);
    box-shadow: var(--ombre-1);
  }

  .dwwm__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s3);
  }

  .dwwm h3 {
    font-size: var(--t-3xl);
    line-height: 0.98;
  }

  .dwwm__organisme {
    font-size: var(--t-l);
    color: var(--encre);
  }

  .dwwm__reperes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s6);
    font-size: var(--t-s);
  }

  .dwwm__reperes dt {
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .dwwm__reperes dd {
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .dwwm__reperes dd span {
    font-weight: 400;
    color: var(--eteint);
  }

  .dwwm :global(.dwwm__preuve) {
    margin-top: var(--s2);
  }

  /* Le complément CDA, accolé au titre */
  .cda {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) minmax(180px, 240px);
    gap: var(--s4) var(--s5);
    align-items: center;
    padding: var(--s4);
    /* Contenu réel : un filet plein (le pointillé reste aux emplacements à générer). */
    border: 1px solid var(--filet);
    border-radius: var(--r2);
  }

  .cda__statut {
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .cda h3 {
    margin-top: var(--s1);
    font-size: var(--t-l);
    line-height: 1.15;
  }

  .cda__contexte {
    margin-top: var(--s1);
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .cda__part {
    font-size: var(--t-xs);
  }

  .cda__part strong {
    font-family: var(--police-texte);
    font-size: var(--t-xl);
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
  }

  .cda__jauge {
    height: 6px;
    margin-block: var(--s2);
    border-radius: var(--r1);
    background: repeating-linear-gradient(-45deg, var(--trait) 0 1px, transparent 1px 5px);
    box-shadow: inset 0 0 0 1px var(--trait);
    overflow: hidden;
  }

  .cda__jauge::before {
    content: '';
    display: block;
    width: var(--part);
    height: 100%;
    background: var(--encre);
  }

  /* Le repère de lecture, juste au-dessus du trait des stations : le
     chemin d’avant se lit du plus récent (à gauche, en haut sur mobile) au
     plus ancien. */
  .formation-sens {
    margin-top: var(--s3);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-petit);
    color: var(--eteint);
  }

  /* Le chemin d’avant : cinq stations compactes sur une ligne, reliées par un
     trait qui finit sur la dernière pastille. La vignette se tient à gauche du
     texte ; dans une colonne étroite, elle passe au-dessus. */
  .etape--station {
    position: relative;
    padding-top: var(--s5);
    container-type: inline-size;
  }

  .etape--station::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: calc(-1 * var(--s4));
    border-top: var(--ligne) solid var(--trait);
  }

  .etape--station:last-child::before {
    right: calc(100% - 12px);
  }

  .etape--station::after {
    content: '';
    position: absolute;
    top: -5px;
    left: 0;
    width: 12px;
    height: 12px;
    border: 2px solid var(--trait);
    border-radius: 50%;
    background: var(--fond);
  }

  /* La vignette à 72 px à gauche de l’intitulé, comme sur mobile : à 56 px,
     la nuit n’en laissait qu’un gris sur noir et une lanterne de 5 px. */
  .station {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: var(--s3);
    align-items: start;
  }

  .station :global(.station__visuel) {
    width: 72px;
  }

  /* La nuit, la mosaïque de captures Frontend Mentor, claire et saturée,
     accrocherait l’œil plus que les lanternes : un peu baissée, cernée d’un
     filet. L’impression la garde telle quelle. */
  @media screen {
    :global(:root[data-theme='nuit']) :global(.frontend-mentor__visuel) {
      outline: 1px solid var(--filet);
      outline-offset: -1px;
    }

    :global(:root[data-theme='nuit']) :global(.frontend-mentor__visuel img) {
      filter: brightness(0.88);
    }
  }

  @media screen and (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) :global(.frontend-mentor__visuel) {
      outline: 1px solid var(--filet);
      outline-offset: -1px;
    }

    :global(:root:not([data-theme])) :global(.frontend-mentor__visuel img) {
      filter: brightness(0.88);
    }
  }

  /* Dans une colonne étroite (tablette), la vignette passe au-dessus de
     l’intitulé, en 56 px : la station reste compacte face au titre obtenu. */
  @container (max-width: 180px) {
    .station {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s2);
    }

    .station :global(.station__visuel) {
      width: 56px;
    }
  }

  .station__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .station__quand {
    min-height: 1.4em;
    font-size: var(--t-s);
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--encre);
  }

  .station h3 {
    font-size: var(--t-m);
    line-height: 1.2;
  }

  .station__organisme,
  .station__suivi {
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .station__organisme {
    color: var(--encre);
  }

  .station :global(.station__statut) {
    margin-top: var(--s1);
  }

  .station :global(.station__lien) {
    min-height: 44px;
    font-size: var(--t-xs);
  }

  /* ===== Certifications ===== */
  .certifications {
    margin-top: var(--entre-sections);
    padding: clamp(20px, 2.6vw, 32px);
    border-radius: var(--r2);
  }

  .certifications__tete {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s2) var(--s5);
    margin-bottom: var(--s5);
  }

  .certifications__repere {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s5);
    font-size: var(--t-s);
    color: var(--eteint);
  }

  .certifications__catalogue {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s4);
    align-items: start;
  }

  .domaine {
    padding: var(--s4) var(--s5);
    border-radius: var(--r2);
    background: var(--surface);
  }

  .domaine:first-child {
    grid-row: span 2;
  }

  .domaine__tete {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: var(--s3);
    align-items: center;
    padding-bottom: var(--s3);
    border-bottom: 1px solid var(--filet);
  }

  .domaine__logo {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r1);
    background: var(--papier-logo);
    box-shadow: inset 0 0 0 1px var(--filet);
    color: var(--suie);
  }

  .domaine__logo img {
    width: 26px;
    height: 26px;
  }

  .domaine h3 {
    font-size: var(--t-l);
    line-height: 1.15;
  }

  .domaine__organisme {
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .certification-liste {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .certification-ligne {
    display: grid;
    gap: 0;
    padding-block: var(--s2) var(--s1);
    font-size: var(--t-s);
    line-height: 1.4;
  }

  .certification-ligne + .certification-ligne {
    border-top: 1px solid var(--filet);
  }

  .certification-intitule {
    font-weight: 600;
  }

  .certification-versions {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s4);
  }

  .certification-preuve {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-height: 44px;
    padding-inline: 4px;
    margin-inline: -4px;
    font-size: var(--t-xs);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .certification-version {
    padding: 0 var(--s1);
    border: 1px solid currentColor;
    border-radius: var(--r1);
    font-weight: 600;
  }

  /* ===== Frontend Mentor ===== */
  .frontend-mentor {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--s5) var(--s7);
    align-items: center;
    margin-top: var(--entre-sections);
  }

  .frontend-mentor__texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s3);
  }

  .frontend-mentor__repere {
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--eteint);
  }

  .frontend-mentor :global(.frontend-mentor__chiffres) {
    width: 100%;
    margin-top: var(--s2);
  }

  .frontend-mentor__date {
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  @media (max-width: 760px) {
    .formation-timeline {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s4);
    }

    .dwwm {
      grid-template-columns: minmax(0, 1fr);
    }

    .dwwm h3 {
      font-size: var(--t-2xl);
    }

    .cda {
      grid-template-columns: 96px minmax(0, 1fr);
    }

    .cda__part {
      grid-column: 1 / -1;
    }

    /* Les stations en colonne, reliées par un trait vertical. */
    .etape--station {
      padding: 0 0 0 var(--s5);
    }

    .etape--station::before {
      top: 0;
      bottom: calc(-1 * var(--s4));
      left: 5px;
      right: auto;
      border-top: 0;
      border-left: var(--ligne) solid var(--trait);
    }

    .etape--station:last-child::before {
      bottom: auto;
      height: 12px;
    }

    .etape--station::after {
      top: 0;
    }

    .station,
    .etape--station {
      container-type: normal;
    }

    .station {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: var(--s4);
    }

    .station :global(.station__visuel) {
      width: 72px;
    }

    .certifications {
      margin-inline: calc(-1 * var(--s2));
      padding: var(--s5) var(--s3);
    }

    .certifications__catalogue {
      grid-template-columns: minmax(0, 1fr);
    }

    .domaine:first-child {
      grid-row: auto;
    }

    .domaine {
      padding: var(--s4);
    }

    .frontend-mentor {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media print {
    .formation-timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .etape--station::before,
    .etape--station::after {
      display: none;
    }

    .dwwm,
    .cda,
    .domaine,
    .station {
      break-inside: avoid;
      box-shadow: inset 0 0 0 1px var(--trait);
    }

    .formation :global(.visuel),
    .frontend-mentor :global(.visuel) {
      display: none;
    }

    .certifications__catalogue {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
