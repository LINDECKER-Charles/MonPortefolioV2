---
/**
 * Page introuvable, servie avec le vrai statut 404 par server/server.mjs
 * (cahier, § 5.15). Elle dit ce qui s’est passé, avec le seul clin d’œil au
 * « mode d’emploi » hors du pied de page, et réoriente : le bouton vers
 * l’accueil, puis cinq tuiles (Accueil et ses trois chapitres, Projets,
 * Parcours, Blog, Contact). Si l’adresse cassée commençait par /projets/ ou
 * /parcours/, les pages de cette section passent en tête (rendues ici, révélées
 * par le script : sans JavaScript, les tuiles suffisent).
 *
 * Mesure : `erreur-404` avec l’origine du lien cassé, pour réparer ce qui peut
 * l’être ; les liens de la page ne sont pas mesurés.
 */
import Base from '../layouts/Base.astro';
import Bouton from '../components/ui/Bouton.astro';
import Portrait from '../components/ui/Portrait.astro';
import Visuel from '../components/ui/Visuel.astro';
import photo from '../assets/visuels/etats/ERR-PHO_800x1000.webp';
import { CHAPITRES } from '../config/chapitres';
import { PAGES_PARCOURS } from '../config/parcours';
import { VITRINE } from '../config/projets';

const tuiles = [
  { href: '/projets', titre: 'Projets', detail: 'Ce que chaque projet prouve.' },
  { href: '/parcours', titre: 'Parcours', detail: 'Mes rôles, mes compétences, ma formation.' },
  { href: '/blog', titre: 'Blog', detail: 'Ce que j’apprends et ce que je construis.' },
  { href: '/contact', titre: 'Contact', detail: 'Écrire en quelques mots.' },
];

const sections = [
  { id: 'projets', titre: 'Dans les projets', pages: VITRINE.map(({ href, nom }) => ({ href, titre: nom })) },
  { id: 'parcours', titre: 'Dans le parcours', pages: PAGES_PARCOURS.map(({ href, titre }) => ({ href, titre })) },
];
---

<Base
  titre="Page introuvable, Charles Lindecker"
  description="Cette adresse ne mène à aucune page du site. Les projets, le parcours, le blog et le contact restent à un clic, et l’accueil raconte tout le reste."
  chemin="/404"
  horsIndex
>
  <div class="conteneur introuvable">
    <section class="introuvable__scene" aria-labelledby="introuvable-titre">
      <div class="introuvable__texte">
        <p class="introuvable__code">Erreur 404</p>
        <h1 id="introuvable-titre" data-pli="titre">Cette page ne figure pas dans ce mode d’emploi.</h1>
        <p class="chapeau" data-pli="identite">L’adresse est peut-être mal recopiée, ou la page a changé de place.</p>
        <div class="actions introuvable__actions">
          <Bouton href="/" attributs={{ 'data-pli': 'action' }}>Revenir à l’accueil</Bouton>
        </div>
        <Portrait src={photo} alt="Charles Lindecker en chemise bleu roi, le regard tourné vers la gauche." widths={[160, 320]} sizes="(max-width: 560px) 104px, 160px" cadrage="50% 30%" lueur="40% 32%" loading="eager" class="introuvable__portrait" />
      </div>
      <div class="introuvable__image">
        <Visuel id="ERR-01" alt="" foyer loading="eager" sizes="(max-width: 860px) 80vw, 560px" />
      </div>
    </section>

    <nav class="introuvable__suite" aria-label="Où aller">
      {
        sections.map(({ id, titre, pages }) => (
          <div class="introuvable__section" data-section={id} hidden>
            <p class="introuvable__section-titre">{titre}</p>
            <ul>
              {pages.map(({ href, titre: nom }) => (
                <li><a href={href}>{nom}<span class="fleche" aria-hidden="true">&nbsp;→</span></a></li>
              ))}
            </ul>
          </div>
        ))
      }
      <ul class="introuvable__tuiles">
        <li class="introuvable__tuile introuvable__tuile--accueil">
          <a href="/" class="introuvable__lien">
            <span class="introuvable__nom">Accueil<span class="fleche" aria-hidden="true">&nbsp;→</span></span>
            <span class="introuvable__detail">Le récit, en trois chapitres.</span>
          </a>
          <ol class="introuvable__chapitres" aria-label="Les chapitres de l’accueil">
            {CHAPITRES.map((c) => <li><a href={`/#${c.id}`}><span class="introuvable__num">{c.num}</span>{c.titre}</a></li>)}
          </ol>
        </li>
        {
          tuiles.map(({ href, titre, detail }) => (
            <li class="introuvable__tuile">
              <a href={href} class="introuvable__lien">
                <span class="introuvable__nom">{titre}<span class="fleche" aria-hidden="true">&nbsp;→</span></span>
                <span class="introuvable__detail">{detail}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Base>

<script>
  import { mesurer } from '../scripts/mesure';

  let origine = 'directe';
  try {
    if (document.referrer) origine = new URL(document.referrer).host === window.location.host ? 'interne' : 'externe';
  } catch {
    origine = 'externe';
  }
  mesurer('erreur-404', { origine });

  // L’adresse cassée visait une section : ses pages passent en tête.
  const section = window.location.pathname.split('/')[1];
  const liste = document.querySelector<HTMLElement>(`[data-section="${section === 'projets' || section === 'parcours' ? section : ''}"]`);
  if (liste) liste.hidden = false;
</script>

<style>
  .introuvable {
    padding-block: var(--s6) var(--s8);
  }

  .introuvable__scene {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
    gap: var(--s6) clamp(40px, 6vw, 96px);
  }

  .introuvable__code {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-petit);
    color: var(--eteint);
    font-variant-numeric: tabular-nums;
  }

  .introuvable h1 {
    margin-top: var(--s3);
    max-width: 14ch;
    font-size: var(--t-3xl);
    line-height: 1;
    letter-spacing: var(--ls-affiche);
  }

  .introuvable .chapeau {
    margin-top: var(--s5);
    max-width: 32ch;
  }

  .introuvable__actions {
    margin-top: var(--s6);
  }

  /* La photo, à part de l’illustration : à droite du texte, alignée sur le
     bouton, le regard tourné vers le titre. L’illustration reste seule
     éclairée dans sa colonne. */
  .introuvable__texte {
    display: grid;
    grid-template-columns: minmax(0, max-content) 160px;
    justify-content: start;
    column-gap: var(--s7);
  }

  .introuvable__texte > :not(:global(.introuvable__portrait)) {
    grid-column: 1;
  }

  .introuvable__texte :global(.introuvable__portrait) {
    grid-column: 2;
    grid-row: 1 / span 4;
    align-self: end;
    width: 160px;
    aspect-ratio: 4 / 5;
    border-radius: var(--r2);
    box-shadow: var(--ombre-1);
  }

  .introuvable__suite {
    margin-top: var(--s8);
  }

  .introuvable__section {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s5);
    margin-bottom: var(--s5);
    padding: var(--s4) var(--s5);
    border-radius: var(--r2);
    background: var(--surface);
    box-shadow: var(--ombre-1);
  }

  .introuvable__section[hidden] {
    display: none;
  }

  .introuvable__section-titre {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-petit);
    color: var(--eteint);
  }

  .introuvable__section ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .introuvable__section a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  .introuvable__tuiles {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) repeat(4, minmax(0, 1fr));
    gap: 0 var(--s5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .introuvable__tuile {
    border-top: 1px solid var(--trait);
  }

  .introuvable__lien {
    display: block;
    min-height: 68px;
    padding-top: var(--s3);
    color: var(--encre);
    text-decoration: none;
  }

  .introuvable__nom {
    display: block;
    font-family: var(--police-titre);
    font-size: var(--t-xl);
    line-height: 1.1;
  }

  .introuvable__nom .fleche {
    color: var(--accent);
    font-size: var(--t-s);
  }

  .introuvable__lien:hover .introuvable__nom {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }

  .introuvable__detail {
    display: block;
    margin-top: var(--s2);
    font-size: var(--t-xs);
    color: var(--eteint);
  }

  .introuvable__chapitres {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-xs);
  }

  .introuvable__chapitres a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
  }

  .introuvable__num {
    color: var(--eteint);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1100px) {
    .introuvable__tuiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s4) var(--s5);
    }
  }

  @media (max-width: 860px) {
    .introuvable {
      padding-top: var(--s5);
    }

    .introuvable__scene {
      grid-template-columns: minmax(0, 1fr);
    }

    .introuvable__suite {
      margin-top: var(--s6);
    }

    .introuvable__tuiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .introuvable__tuile--accueil {
      grid-column: 1 / -1;
    }

    .introuvable__nom {
      font-size: var(--t-l);
    }
  }

  /* Sur téléphone, la photo se range à côté du chapeau et du bouton. */
  @media (max-width: 560px) {
    .introuvable__texte {
      grid-template-columns: minmax(0, 1fr) 104px;
      column-gap: var(--s4);
    }

    .introuvable__texte > :not(:global(.introuvable__portrait)) {
      grid-column: 1 / -1;
    }

    .introuvable__texte > .chapeau,
    .introuvable__texte > .introuvable__actions {
      grid-column: 1;
    }

    .introuvable__texte :global(.introuvable__portrait) {
      grid-row: 3 / span 2;
      width: 104px;
    }
  }
</style>
