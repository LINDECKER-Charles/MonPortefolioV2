---
/**
 * Le blog : la page qui accueillera les articles le jour où ils existent
 * (cahier, § 5.13). Tant qu’il n’y en a aucun, un seul bloc : le titre, le
 * livre ouvert sous la lanterne (BLG-01), une phrase et un lien vers les
 * projets.
 *
 * Contrat avec server/blog.mjs (tests : server/blog-dist.test.mjs) : le
 * serveur remplace tout ce qui va de `<div id="blog-publications">` au premier
 * `</section></div>` par la liste des articles publiés (`.blog-list`). L’état
 * vide est donc une seule <section> fermée juste avant la </div> du bloc, et le
 * titre de la page reste hors du bloc. Les classes `.blog-*` vivent dans
 * styles/blog.css, partagée avec le gabarit des articles (blog-modele.astro).
 */
import Base from '../layouts/Base.astro';
import AppelDiscutons from '../components/pages/AppelDiscutons.astro';
import FilAriane from '../components/pages/FilAriane.astro';
import ContinuerLecture from '../components/pages/ContinuerLecture.astro';
import LienAction from '../components/ui/LienAction.astro';
import Visuel from '../components/ui/Visuel.astro';
import { SITE } from '../config/site';
import '../styles/blog.css';

const titre = `Blog de ${SITE.nom}`;
const description = 'Les articles de Charles Lindecker sur le développement, les projets et la transmission. Prendre le temps d’expliquer ce que j’apprends et ce que je construis.';
---

<Base titre={titre} description={description} chemin="/blog">
  <div class="conteneur blog-page">
    <FilAriane courant="Blog" />
    <div class="blog-scene">
      <header class="blog-entete">
        <h1 data-pli="titre">Le blog</h1>
        <p class="chapeau" data-pli="identite">Prendre le temps d’expliquer ce que j’apprends et ce que je construis.</p>
      </header>

      <div id="blog-publications">
      <section class="blog-vide" aria-labelledby="blog-vide-titre">
        <div class="blog-vide__texte">
          <p class="blog-vide__etat">Aucun article publié pour l’instant</p>
          <p class="blog-vide__phrase" id="blog-vide-titre">Le premier article reste à&nbsp;écrire.</p>
          <LienAction href="/projets" attributs={{ 'data-pli': 'action' }}>En attendant, lire les projets</LienAction>
        </div>
        <Visuel id="BLG-01" alt="" foyer loading="eager" class="blog-vide__visuel" sizes="(max-width: 860px) 100vw, 640px" />
      </section>
      </div>
    </div>

    <AppelDiscutons emplacement="discutons">Une idée à confronter, un sujet à creuser&nbsp;?</AppelDiscutons>

    <ContinuerLecture liens={[
      { href: '/projets/omnicard', titre: 'Omnicard', detail: 'Le jeu papier devenu jeu en ligne, avec son moteur de règles.' },
      { href: '/parcours', titre: 'Le parcours', detail: 'Apprendre, construire et transmettre.' },
    ]} />
  </div>
</Base>
