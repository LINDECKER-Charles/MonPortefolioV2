---
/**
 * Gabarit racine : balises de partage et JSON-LD, icônes, polices, thème
 * appliqué avant le rendu, chargeur de mesure, lien d'évitement, en-tête et
 * pied de page.
 *
 * Aucun script en ligne : /theme.js et /mesure.js sont des fichiers (le
 * second est écrit au démarrage du serveur selon l'environnement), et les
 * scripts des composants sont des modules construits par Astro.
 *
 * Contrats avec le serveur (server/blog.mjs, gabarits blog et blog-modele) :
 * une balise <title>, des <meta name|property> à l'attribut name/property
 * avant content, le JSON-LD en <script type="application/ld+json">, /mesure.js
 * en <script defer src>, et aucun <noscript> dans la coque (le serveur retire
 * ceux du gabarit d'article).
 *
 * `sommaire` : les sections de la page, proposées par le bouton « Sommaire »
 * de l'en-tête sur mobile et tablette.
 *
 * `titre` : le titre court de la page ; le <title> et og:title suivent un seul
 * gabarit, « Titre — Charles Lindecker » (lib/seo.ts, titreDePage). Le JSON-LD
 * décrit la page et sa date, Charles, le fil d’Ariane (BreadcrumbList), le
 * site sur l’accueil et, sur une page de projet, le projet lui-même.
 */
import { existsSync } from 'node:fs';
import path from 'node:path';
import { Font, getImage } from 'astro:assets';
import Entete from '../components/layout/Entete.astro';
import Favicons from '../components/layout/Favicons.astro';
import PiedDePage from '../components/layout/PiedDePage.astro';
import photo from '../assets/photos/charles-4.webp';
import { PAGES_SITEMAP } from '../config/pages';
import { SITE } from '../config/site';
import type { EntreeSommaire } from '../config/navigation';
import { imagePartageDe, PARTAGE_DEFAUT } from '../lib/partage';
import { absolue, jsonLd, noeudAriane, noeudPage, noeudPersonne, noeudProjet, noeudSite, titreDePage } from '../lib/seo';
import '../styles/global.css';

interface Props {
  titre: string;
  description: string;
  /** Chemin canonique ('/' pour l'accueil). */
  chemin: string;
  /** Page d'erreur ou utilitaire : hors index, sans canonical ni JSON-LD. */
  horsIndex?: boolean;
  /** Accueil : la marque de l'en-tête ramène en haut de page au lieu de recharger. */
  accueil?: boolean;
  /** Sections de la page pour le sommaire de l'en-tête (mobile et tablette). */
  sommaire?: readonly EntreeSommaire[];
  /** Image de partage propre à la page (adresse sous public/, 1 200 × 630) ; sinon lib/partage.ts. */
  ogImage?: string;
  /** Texte alternatif de `ogImage`. */
  ogImageAlt?: string;
}

const { titre: titreDonne, description, chemin, horsIndex = false, accueil = false, sommaire, ogImage, ogImageAlt } = Astro.props;
const titre = titreDePage(titreDonne, chemin);
const canonique = absolue(chemin);
/** La barre du navigateur mobile : bleu roi le jour, suie la nuit. */
const COULEUR_NUIT = '#0b0d12';
/* L’image de partage de la page (lib/partage.ts, rendue en JPEG par
   tools/generer-partage.mjs) : la sienne, sinon l’image par défaut (GLO-07).
   Une page peut passer la sienne (`ogImage`, adresse sous public/, et
   `ogImageAlt`). */
const prevue = imagePartageDe(chemin);
const livree = (fichier: string) => existsSync(path.resolve(fichier));
const fichierPartage = livree(prevue.fichier) ? prevue : PARTAGE_DEFAUT;
const imagePartage = {
  url: absolue(ogImage ?? fichierPartage.fichier.replace(/^public/, '')),
  largeur: 1200,
  hauteur: 630,
  alt: ogImageAlt ?? fichierPartage.alt,
};

let donnees: string | undefined;
if (!horsIndex) {
  const portrait = await getImage({ src: photo, width: 800, format: 'jpg', quality: 80 });
  const maj = PAGES_SITEMAP.find((page) => page.chemin === chemin)?.maj;
  donnees = jsonLd(
    [
      chemin === '/' ? noeudSite() : undefined,
      noeudPage({ chemin, titre, description, maj }),
      noeudPersonne({ url: absolue(portrait.src), largeur: 800, hauteur: Math.round((800 * photo.height) / photo.width) }, { complet: chemin === '/' }),
      noeudAriane(chemin, titreDonne),
      noeudProjet(chemin, description, imagePartage.url),
    ].filter((noeud): noeud is NonNullable<typeof noeud> => Boolean(noeud)),
  );
}
---

<!doctype html>
<html lang={SITE.langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {
      horsIndex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <>
          <link rel="canonical" href={canonique} />
          <meta name="robots" content="index, follow, max-image-preview:large" />
        </>
      )
    }
    {chemin === '/' && <meta name="google-site-verification" content={SITE.verificationGoogle} />}
    <meta name="author" content={SITE.nom} />
    <meta name="theme-color" content={SITE.couleurTheme} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={COULEUR_NUIT} media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={chemin === '/' ? 'profile' : 'website'} />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    {!horsIndex && <meta property="og:url" content={canonique} />}
    <meta property="og:image" content={imagePartage.url} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(imagePartage.largeur)} />
    <meta property="og:image:height" content={String(imagePartage.hauteur)} />
    <meta property="og:image:alt" content={imagePartage.alt} />
    {chemin === '/' && <meta property="profile:first_name" content="Charles" />}
    {chemin === '/' && <meta property="profile:last_name" content="Lindecker" />}
    <meta name="twitter:card" content="summary_large_image" />
    <Favicons />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261013-embleme" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Le flux des articles, rendu par le serveur (server/blog.mjs). */}
    <link rel="alternate" type="application/rss+xml" title={`Le blog de ${SITE.nom}`} href="/blog/rss.xml" />
    {/* Synchrone, avant les styles : le thème est posé avant le premier rendu. */}
    <script is:inline src="/theme.js"></script>
    {/* Le texte et les titres composent le premier écran : préchargés. L'italique attend. */}
    <Font cssVariable="--police-texte" preload />
    <Font cssVariable="--police-titre" preload={[{ style: 'normal' }]} />
    <script is:inline defer src="/mesure.js"></script>
    {donnees && <script type="application/ld+json" set:html={donnees} />}
  </head>
  <body id="top">
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <Entete accueil={accueil} chemin={chemin} sommaire={sommaire} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <PiedDePage />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
