# Environnement de PRODUCTION (branche `main`, hote mutualise).
#
# Ce fichier est un MODELE. Sa version remplie n'est jamais deposee a la main sur
# le serveur : elle est collee telle quelle dans le secret GitHub `ENV_PROD`, et
# le job _deploy l'ecrit dans ${PROD_PATH}/.env en chmod 600 avant chaque
# `docker compose up`. Voir docs/secrets.md.
#
# Aucun reglage de l'edge ici (contact Let's Encrypt, certificats) : il
# appartient au depot infra-vps, seul proprietaire de l'edge sur l'hote.
#
# !! AVERTISSEMENT — PAS AVANT LE DEPART DE LA V1 !!
# Aujourd'hui la V1 (depot MonPortfolio, piles monportfolio-staging et
# monportfolio-prod) declare deja charles-lindecker.com, www.charles-lindecker.com
# et test.charles-lindecker.com sur l'edge de cet hote. Deux conteneurs qui
# declarent le meme domaine se marchent dessus : l'edge reunit leurs
# declarations dans un meme bloc de site, et l'on ne maitrise plus qui repond.
# La production de la V2 ne se deploie donc qu'APRES le deplacement de la V1 sur
# son sous-domaine d'archive (docs/brief.md section 6, sous-domaine encore a
# choisir). D'ici la, seul l'environnement de test de la V2 tourne. Le
# deploiement le verifie : il refuse de demarrer tant qu'un conteneur d'un autre
# projet declare l'un des domaines ci-dessous. Ordre de bascule :
# docs/deploiement.md.

# ── Isolation Compose ─────────────────────────────────────────────────────────
# Distinct de portfolio-test, et des piles de la V1 : c'est ce qui garantit que
# les piles co-localisees sur le meme VPS ne partagent aucun conteneur, reseau ni
# volume.
COMPOSE_PROJECT_NAME=portfolio-prod

# Confort d'exploitation : Compose lit cette cle dans le .env, si bien qu'un
# `docker compose logs -f web` lance a la main dans ce repertoire charge les bons
# calques sans rien avoir a exporter. Le script de deploiement choisit les siens
# d'apres le reste de ce fichier et signale tout ecart avec cette ligne : a
# completer le jour ou la mesure d'audience est activee ici (voir plus bas).
COMPOSE_FILE=compose.yaml:compose.deploy.yaml

# ── Image ─────────────────────────────────────────────────────────────────────
# `prod` est pose par _promote sur l'image DEJA construite et deployee en test :
# la production sert exactement l'artefact valide, jamais une recompilation.
WEB_IMAGE=ghcr.io/lindecker-charles/monportefoliov2
BACKEND_IMAGE=ghcr.io/lindecker-charles/monportefoliov2-backend
IMAGE_TAG=prod

# Adresse publique et destinataire du formulaire, injectés au démarrage.
CONTACT_EMAIL=charles.lindecker@outlook.fr
# Générer une valeur propre à cet environnement : openssl rand -hex 32.
BACKEND_PROXY_TOKEN=
# Renseigner le relais et l'expéditeur autorisé pour activer l'envoi réel.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Domaines publics ──────────────────────────────────────────────────────────
# Chaque domaine liste obtient son certificat et arrive au meme conteneur ;
# c'est le serveur du site qui renvoie ensuite www vers l'apex (ci-dessous).
# Les enregistrements DNS pointent deja sur l'hote (la V1 y est servie) : rien a
# changer tant que la V2 est deployee sur ce meme hote.
CADDY_DOMAINS=charles-lindecker.com, www.charles-lindecker.com

# ── Hote canonique ────────────────────────────────────────────────────────────
# Toute requete arrivee par un hote de REDIRECT_HOSTS part en 301 vers
# CANONICAL_ORIGIN, meme chemin, meme requete : une seule adresse par page pour
# Google, un seul stockage local (donc un seul choix d'opposition a la mesure)
# par visiteur. Les deux cles vont ensemble ; une seule, ou une valeur
# invalide, et le conteneur refuse de demarrer.
REDIRECT_HOSTS=www.charles-lindecker.com
CANONICAL_ORIGIN=https://charles-lindecker.com

# ── Indexation ────────────────────────────────────────────────────────────────
# `all` = aucune restriction, la valeur explicite par defaut de X-Robots-Tag.
# C'est le SEUL environnement qui doit porter autre chose que `noindex` : le
# defaut du calque de deploiement est restrictif, pour qu'un environnement qui
# oublie de se declarer ne finisse pas indexe par accident.
ROBOTS_TAG=all

# ── Mesure d'audience (Umami, site "Portfolio") : PLUS TARD ───────────────────
# Preparee, pas activee. A activer apres la recette en test, et apres la purge
# a 25 mois cote infra-vps (condition de l'exemption CNIL, voir
# docs/mesure-audience.md). Ce jour-la : decommenter les trois lignes, et
# completer COMPOSE_FILE ci-dessus avec :compose.umami.yaml.
#
# L'UUID est genere une fois pour toutes et distinct de celui du test. Il
# appartient au projet (contrat infra-vps, docs/APPLICATIONS.md section 6) : ne
# jamais le regenerer, ce serait repartir d'un site Umami vide.
# UMAMI_WEBSITE_ID=0450b7ff-eb45-4328-a93e-496cd25b3348
# UMAMI_SITE_DOMAIN=charles-lindecker.com
# UMAMI_SITE_NAME=Portfolio

# ── Bascule de migration ──────────────────────────────────────────────────────
# 1 = le deploiement echoue si un domaine public ne sert pas un certificat de
# confiance. A ne passer a 0 que pendant une bascule DNS (deploiement sur un
# autre hote que celui de la V1), et a remettre a 1 des que les enregistrements
# pointent sur cet hote. Voir docs/deploiement.md.
TLS_ASSERT=1
